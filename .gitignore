.vscode/
.DS_Store

# Build output and everything downloaded to produce it. The kernel source
# unpacks to linux/, which is what that directory is: the upstream tree, not
# part of this repository.
/artifacts/
/dist/
/fs/
/linux/
/dev/

# `build asm` writes a .S beside each .asm and kbuild assembles it there, because
# src/ is symlinked into the kernel tree as kernel/moonwater.
/src/*.S
/src/*.asm_tmp

*.log
*.a
*.o
*.o.d
*.cmd
*.order
*.exe
*.dll
*.so
*.dylib
*.dwo

# patch leftovers, which have shipped by accident once
*.orig
*.rej

# test/assembly regenerates this from src/lib.c and the two are a fixed
# point -- byte for byte identical once the pipeline has been run. Keeping a
# copy in the repository would only be a second place to edit.
/src/library.next.c
__pycache__/

# Agent worktrees and local session state.
.claude/

# The build tool, compiled from src/build/build.c by build.sh.
/build

# Working files: nothing here is part of the tree.
scratch/
TODO.md
bridge.py
bowl_2.md