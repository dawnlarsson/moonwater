                *(.text.positive_into_string)
                *(.text.string_copy_max_end)
                *(.text.string_digits)
                *(.text.string_first_of)
                *(.text.string_first_of_or_end)
                *(.text.string_hash_33_length)
                *(.text.string_set_add)
                *(.text.system_call)
                *(.text.system_call_5)
                *(.text.system_call_6)
                *(.text.log_failed)
                *(.text.system_call_1)
                *(.text.system_call_4)
                *(.text.memory)
                *(.text.program_arguments_use)
                *(.text.argument_option_take)
                *(.text.system_read_retry)
                *(.text.string_get_environment)
                *(.text.memory_reserve)
                *(.text.system_call_2)
                *(.text.memory_copy_apart_end)
                *(.text.memory_span_byte)
                *(.text.string_span_max)
                *(.text.string_table_find)
                *(.text.memory_free)
                *(.text.system_wait4_retry)
                *(.text.wait_status_code)
                *(.text.wait_status_code_base)
                *(.text.env_write_destination)
                *(.text.log)
                *(.text.memory_give)
                *(.text.buffered_write)
                *(.text.buffered_write_core)
                *(.text.memory_take)
                *(.text.positive_into)
                *(.text.bipolar_into_core)
                *(.text.bipolar_into_string)
                *(.text.memory_release)
                *(.text.memory_search_prepare)
                *(.text.memory_search_prepared)
                *(.text.positive_digits_core)
                *(.text.string_copy)
                *(.text.bytes_reverse_16)
                *(.text.bytes_reverse_32)
                *(.text.get_cpu_time)
                *(.text.lock_release)
                *(.text.lock_take)
                *(.text.log_error)
                *(.text.memory_compare_ascii_case)
                *(.text.memory_into_spelled)
                *(.text.memory_nth_of)
                *(.text.memory_offsets_fields_blank)
                *(.text.memory_offsets_fields_x64)
                *(.text.memory_span_byte_reverse)
                *(.text.memory_translate)
                *(.text.path_split_core)
                *(.text.path_tail_copy)
                *(.text.positive_to_padded)
                *(.text.positive_to_string)
                *(.text.socket_close)
                *(.text.socket_connect)
                *(.text.socket_new)
                *(.text.socket_option_set)
                *(.text.string_digits_max)
                *(.text.string_format)
                *(.text.string_report)
                *(.text.string_to_host)
                /* hot_asm end */
                spark_hot_end = .;
                *(.text.*)
        }

        . = ALIGN(4096);

        .data : {
                *(.data.hot)
                *(.data .data.*)
                *(.got .got.plt)
                /* And small writable ones here, one section each because the
                   programs are built with -fdata-sections. Unmatched, they
                   were placed wherever the linker felt like, which on riscv64
                   is outside every region the loader maps. */
                *(.sdata .sdata.*)
                /* Whole pages in the file, so that the kernel has no tail of
                   the last one to zero before the bss starts: that zeroing
                   copies a page of the file at every exec. */
                . = ALIGN(4096);
        }

        /* RISC-V _start establishes gp as required by its psABI.  Ordinary
           ELF linker scripts provide this anchor themselves; spark owns its
           complete layout and therefore has to provide it explicitly.  The
           conventional 0x800 bias reaches the full signed twelve-bit window
           around small data.  Other architectures simply leave it unused. */
        PROVIDE(__global_pointer$ = . + 0x800);

        . = ALIGN(4096);

        .bss : {
                __bss_start = .;
                /* What every command writes, on the first page and no
                   other, so a fork copies the one page (HOT_STATE). */
                *(.bss.hot)
                /* Library state every process writes before main, one section
                   each because it is written in assembly (ASM_BSS_OBJECT_BEGIN). */
                *(.bss.program_stack_base .bss.thread_main .bss.threads_live
                  .bss.log_writer_buffer_length .bss.log_writer_failed
                  .bss.writer_stderr_failed
                  .bss.program_vdso_clock .bss.program_entry_identity .bss.program_entry_facts
                  .bss.program_words
                  .bss.cpu_has_* .bss.cpu_hash_probed
                  .bss.program_words_count)
                /* The big ones last, each written at its first bytes: they
                   start on the page the small ones leave half empty. */
                *(.bss.hot.tail)
                *(.bss.log_writer_buffer .bss.working_directory)
                /* The pool tables and store blocks are carved from (lib.c), after
                   the statics so that its first page is the last of theirs. */
                *(.bss.memory_pool_block)
                *(.bss .bss.*)
                *(.sbss .sbss.*)
                *(COMMON)
                . = ALIGN(4096);
                __bss_end = .;
        }

        /* Nothing else is loadable: the format has no section table, no
           dynamic linking and no unwind information. */
        /DISCARD/ : {
                /* A __thread object would be reached at a link-time offset
                   from the thread register, and the register points at the
                   explicit thread block in library.c, not at a TLS
                   image. Discarding the sections turns any such object into a
                   link error naming it, instead of a store into another
                   field of the block. */
                *(.tdata .tdata.* .tbss .tbss.*)
                *(.comment)
                *(.note .note.*)
                *(.eh_frame .eh_frame_hdr)
                *(.gnu.hash .hash .dynsym .dynstr)
        }
}

/* What a start touches ends at spark_hot_end, and the image begins on a 2 MiB
   boundary (SPARK_BASE is 4 MiB), so while it ends inside the first 2 MiB the
   page cache can hold the whole of it as one huge page and a start maps it
   with one entry (kernel/profile/any: TMPFS_HUGE_WITHIN_SIZE). A product link
   passes SPARK_HOT_LIMIT, the 2 MiB, and a hot set that has grown past it is
   not linked; a program linked without it is not checked. */
PROVIDE(SPARK_HOT_LIMIT = 0);
ASSERT(SPARK_HOT_LIMIT == 0 || spark_hot_end - SPARK_BASE <= SPARK_HOT_LIMIT,
       "the hot set of the image ends past the first 2 MiB: a start no longer maps it with one huge page")
