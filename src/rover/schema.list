# The part of rover's schema nothing in the code says yet, written by hand.
#
# test/rover_schema.py reads this with spark's event table, lib.c's
# inventory and the shell's tool list, and writes src/rover/schema.inc.
# One record a line; a name with a space in it is quoted.
#
#   state NAME PAGE TYPE              a state, at the next offset of its page
#   event ID SOURCE NAME [FIELD:TYPE ...]
#   primitive ID RUNS CLASS NAME [ARG:TYPE ...]
#   switch ID NAME TYPE [deliberate:VALUE]   a switch of the machine's, set with set NAME VALUE
#
# TYPE is int:LOW:HIGH, percent, duration, clock, weekday, onoff,
# enum:WORD,WORD..., chord, word or text; a primitive's last argument may be
# words, none or more words up to an action's four arguments. A state is never moved: a new one
# goes at the end of its page. An id is never given to another event or
# primitive.

# The kernel's page: what the module knows as its events arrive.
state lid kernel enum:open,closed
state power.source kernel enum:ac,battery
state battery.percent kernel percent
state battery.state kernel enum:unknown,charging,discharging,full,not-charging
state headphone kernel onoff
state dock kernel onoff
state tablet kernel onoff
state canvas kernel onoff
# The screens the kernel's display client sees connected, and how many of
# them are not the machine's own panel (eDP, LVDS, DSI): Canvas counts them at
# its DRM hotplug, so a rule in the kernel can read them.
state display.count kernel int:0:16
state display.external kernel int:0:16
# USB devices plugged in, root hubs not counted; network links with a carrier
# (loopback and other namespaces not counted).
state usb.count kernel int:0:255
state net.link kernel int:0:64

# The desktop's page: the compositor's own.
state window.fullscreen desktop onoff
state window.app desktop word

# Kernel events past spark's 1 to 22, posted by the module's own hooks
# (src/moonwater/rules.c), each at the earliest point the kernel offers:
# input in the input core's filter, before evdev and so before any reader;
# power at the power supply notifier; USB at the USB notifier; links at the
# netdevice notifier; displays at Canvas's DRM client hotplug; sleep at the
# pm notifier. A key's chord is the modifiers held as it went down (or up)
# and Linux's key number; a button is its place in the enum, Linux's order.
event 23 kernel "key down" chord:chord
event 24 kernel "key up" chord:chord
event 25 kernel "mouse down" button:enum:left,right,middle,side,extra,forward,back,task
event 26 kernel "mouse up" button:enum:left,right,middle,side,extra,forward,back,task
event 27 kernel "pad down" button:enum:south,east,c,north,west,z,tl,tr,tl2,tr2,select,start,mode,thumbl,thumbr,up,down,left,right
event 28 kernel "pad up" button:enum:south,east,c,north,west,z,tl,tr,tl2,tr2,select,start,mode,thumbl,thumbr,up,down,left,right
event 29 kernel "touch down"
event 30 kernel "touch up"
event 31 kernel "switch on" which:enum:lid,tablet,headphone,rfkill,microphone,dock,lineout,jack,videoout,camera-cover,keypad,proximity,rotate-lock,linein,mute,pen,cover
event 32 kernel "switch off" which:enum:lid,tablet,headphone,rfkill,microphone,dock,lineout,jack,videoout,camera-cover,keypad,proximity,rotate-lock,linein,mute,pen,cover
event 33 kernel "power ac"
event 34 kernel "power battery"
event 35 kernel battery percent:percent state:enum:unknown,charging,discharging,full,not-charging
event 36 kernel "usb added" class:enum:other,audio,comm,hid,image,printer,storage,hub,data,smartcard,video,wireless,vendor vendor:int:0:65535 product:int:0:65535 port:word
event 37 kernel "usb removed" class:enum:other,audio,comm,hid,image,printer,storage,hub,data,smartcard,video,wireless,vendor vendor:int:0:65535 product:int:0:65535 port:word
event 38 kernel "input added" kind:enum:keyboard,mouse,touchpad,touchscreen,pad,tablet,switch,other name:word
event 39 kernel "input removed" kind:enum:keyboard,mouse,touchpad,touchscreen,pad,tablet,switch,other name:word
event 40 kernel "display connected" connector:word
event 41 kernel "display disconnected" connector:word
event 42 kernel "link up" interface:word
event 43 kernel "link down" interface:word
event 44 kernel sleep

# Events the compositor posts. Kernel events (ids 1 to 63) are spark's to 22, then the module's.
event 64 desktop chord chord:chord
event 65 desktop "fullscreen on" app:word
event 66 desktop "fullscreen off" app:word
event 67 desktop "window opened" app:word
event 68 desktop "window closed" app:word
event 69 desktop "display added" connector:word
event 70 desktop "display removed" connector:word
# A press of the desktop's own: the panel's launcher button, the tray's volume, microphone and notices cells,
# its clock pressed twice, and a pinned program's task, whose slot and program the compositor says.
event 71 desktop button name:enum:launcher,volume,mic,notices,tray-double,pin slot:int:0:63 app:word

# The rules' own event, which emit posts.
event 96 runner cue name:word

# The runner's word on a service: up when its ready path is there (or it has
# started, when it names none), down when it ended, failed when it was given up.
event 97 runner "service up" name:word
event 98 runner "service down" name:word
event 99 runner "service failed" name:word

# A Settings row changed: its name as its state says it, without setting. (on setting canvas.gpu).
event 100 runner setting name:word

# Boot's verdict, once a boot, as moonwater_init's $1 was: live (nothing on a
# disk is kept this session), disk and its name, or ask (a disk holds another
# build).
event 101 runner boot verdict:enum:live,disk,ask disk:word

# The runner's clocks: every DURATION and at CLOCK are rules on these, the
# period or the minute of the day (the zone's) their first field.
event 102 runner every period:duration
event 103 runner at time:clock

# Moonwater's mechanisms. RUNS is where the call is a direct one.
primitive 1 kernel any poweroff
primitive 2 kernel any reboot
primitive 3 kernel any suspend
primitive 4 kernel any backlight level:percent
primitive 5 kernel any latency limit:duration
primitive 6 kernel any "latency off"
primitive 7 kernel lower-only "radio off" which:enum:wifi,bluetooth,all
primitive 8 kernel deliberate "radio on" which:enum:wifi,bluetooth,all
primitive 9 kernel lower-only "usb lock"
primitive 10 kernel deliberate "usb allow"
primitive 11 kernel any log message:text
primitive 12 desktop any "display off"
primitive 13 desktop any "display on"
primitive 14 desktop any open app:word words:words
primitive 15 desktop any notify message:text
primitive 16 runner any start service:word
primitive 17 runner any stop service:word
primitive 18 runner any restart service:word
primitive 19 runner any "desktop rest"
# The program of the pin the person pressed last (on button pin): the runner starts it only when it is a kit program
# or a bowl's launcher, root's and written by root alone, with no word of the window's.
primitive 20 desktop any "open pin"

# The machine's switches, which set NAME VALUE changes as moonwater's tune
# verbs do (src/sh/host/tune.c). A value marked deliberate raises the
# machine's exposure and is a person's to set, never a rule's: airplane off
# turns the radios back on. power's words are tune.c's tune_modes, read there.
switch 1 brightness percent
switch 2 power enum:@tune_modes
switch 3 "cpu boost" onoff
switch 4 "cpu smt" onoff
switch 5 "charge limit" int:20:100
switch 6 airplane onoff deliberate:off

# lib.c's routines with integer arguments, and the values each argument
# takes: PARAM:LOW:HIGH, by the prototype's names, or total when every value
# of the argument's C type is one the routine answers. A rule's argument is
# held to the range when the routine is called; a routine with an integer
# argument and no row here is not bound at all, because a selector past its
# cases or a byte past 255 is a read the routine never promised to bound.
function absolute_whole total
function absolute_wide total
function bits_counted total
function bits_first_set total
function bits_first_set_wide total
function bits_leading_zeros total
function bits_trailing_zeros total
function byte_class_holds which:0:11
function byte_is_alnum value:0:255
function byte_is_alpha value:0:255
function byte_is_ascii value:0:255
function byte_is_blank value:0:255
function byte_is_control value:0:255
function byte_is_digit value:0:255
function byte_is_graphic value:0:255
function byte_is_hexadecimal value:0:255
function byte_is_lower value:0:255
function byte_is_printable value:0:255
function byte_is_punctuation value:0:255
function byte_is_space value:0:255
function byte_is_upper value:0:255
function byte_to_ascii value:0:255
function byte_to_lower value:0:255
function byte_to_upper value:0:255
function bytes_reverse_16 total
function bytes_reverse_32 total
function hash_crc32 total
function hash_crc32_msb total
function hash_crc32c total
function hash_crc64 total
function hash_xxh64 total
function memory_checksum_bsd16 total
function memory_count total
function memory_escape_index policy:0:64
function memory_growth total
function pointer_gain total
function positive_digits total
function string_compare_folded_max total
function string_compare_max total
function string_length_max total
function unicode_case total
function unicode_width variant:0:1
function wait_status_code total
function wait_status_code_base total

# The shell's tools a rule may run: each reads and says, and none writes a file, sets the machine, runs a
# program it is handed, or reaches the network. Every tool not listed is deliberate, never a rule's: one that
# writes (cp, dd, tee, sed's w, sort -o, tar), one that runs another (env, find -exec, xargs, nice, timeout,
# setsid, unshare, nsenter), one that sets the machine (rfkill, ip, mount, chroot, ctrlaltdel, date, hostname,
# kill, dmesg's -C and -n) and moonwater itself (moonwater wifi on is radio on). A new tool is deliberate until
# it is listed here.
tools-any b2sum base32 base64 basenc cat cksum cmp comm cut diff expand expr factor fmt fold false grep head
tools-any join nl od paste pr ptx rev sum tac tail tr true unexpand uniq wc basename bits cal col colcrt colrm
tools-any column dircolors dirname df du findmnt groups hostid id isosize logger logname look ls lsblk lscpu
tools-any lsfd lsipc lslocks lsmem lsns lsclocks mcookie md5sum mountpoint namei nproc numfmt pathchk printenv
tools-any readlink realpath seq sha1sum sha224sum sha256sum sha384sum sha512sum sleep stat tsort tty uname
tools-any users uuidgen uuidparse whoami who whereis yes
