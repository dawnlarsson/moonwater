// Gen9 glass (op 3): the picture s laid over the ground g into d, with the ground's grain first, as the processor's
// memory_glass_over_u32 (src/canvas/compositor/glass.c's grain, src/lib.c's body). Per pixel, for each of the red, green
// and blue bytes, the ground's byte plus the grain level (dark: v = 0) or minus it (light: v != 0), clamped to 0..255; the
// alpha byte of the ground is left as it is. Then each byte of the ground times (255 - the picture's alpha) divided by 255
// rounded, as (t + (t >> 8) + 1) >> 8 of t = product + 127 per 16-bit lane (tone's division, equal to the processor's
// (t + (t >> 8)) >> 8 of t = product + 128 for every product), plus the picture's byte, clamped at 255 per lane.
// The grain level of pixel x of row y is 2 * ((x + x0 ^ y + y0) & 1) + ((y + y0) & 1): the processor's 4x4 ordered table
// reduces to it. Four pixels a thread: thread group X (r0.1) is the 16-byte block, group Y (r0.6) the row.
// Binding table: entry 0 = the destination (written), entry 1 = the picture, entry 2 = the ground (both read). The CURBE:
// dword 0 = v, dword 1 = x0, dword 2 = y0 (r1.0, r1.1, r1.2). Scalars: r20.0 = x0 & 1, r20.1 = (y + y0) & 1, r20.2 = the
// xor of those; r21 = the levels of the even and odd pixels (Le, Lo), r22.0 = light (v != 0), r22.1 = dark (v = 0); r23 the
// four levels; r24/r25 the dark and light adds per dword (the factor of r22.2:uw is the dark flag, word 2 = dword 1) (ground's R,G,B at word 0), r26/r27 the same at both words of a
// dword (R and B). Vectors per 16-bit lane: r7 R and B of the ground, r8 G and A; r9 the picture's 255 - alpha (word 0 of
// each dword), r10/r11 the picture's R and B, G and A; r12-r15 the products and results. The multiply takes its factor as a
// word (r9 at stride 2) and the signed word adds and sel clamps keep the signed grain exact.
// Assemble with: iga64 -a -p=9 src/canvas/gpu_i915_glass.iga -o glass.krn (the words are in src/canvas/gpu_i915.asm).
mul (1|M0)               r2.0<1>:ud    r0.1<0;1,0>:ud    0x10:ud
mov (1|M0)               r2.1<1>:ud    r0.6<0;1,0>:ud
mov (8|M0)               r4.0<1>:ud    r0.0<8;8,1>:ud
mov (2|M0)               r4.0<1>:ud    r2.0<2;2,1>:ud
mov (1|M0)               r4.2<1>:ud    0xF:ud
send (16|M0)             r5:ud         r4:ud     0xC  0x02190001     // media block read of the picture (entry 1), header, 1 GRF
send (16|M0)             r6:ud         r4:ud     0xC  0x02190002     // media block read of the ground (entry 2), header, 1 GRF
and (1|M0)               r20.0<1>:ud   r1.1<0;1,0>:ud    1:ud
add (1|M0)               r20.1<1>:ud   r0.6<0;1,0>:ud    r1.2<0;1,0>:ud
and (1|M0)               r20.1<1>:ud   r20.1<0;1,0>:ud   1:ud
xor (1|M0)               r20.2<1>:ud   r20.0<0;1,0>:ud   r20.1<0;1,0>:ud
shl (1|M0)               r21.0<1>:ud   r20.2<0;1,0>:ud   1:ud
add (1|M0)               r21.0<1>:ud   r21.0<0;1,0>:ud   r20.1<0;1,0>:ud
shl (1|M0)               r21.1<1>:ud   r20.2<0;1,0>:ud   1:ud
add (1|M0)               r21.1<1>:ud   -r21.1<0;1,0>:ud  2:ud
add (1|M0)               r21.1<1>:ud   r21.1<0;1,0>:ud   r20.1<0;1,0>:ud
mov (1|M0)               r22.0<1>:ud   0:ud
cmp (1|M0)   (ne)f0.0    null:ud       r1.0<0;1,0>:ud    0:ud
(f0.0) mov (1|M0)        r22.0<1>:ud   1:ud
add (1|M0)               r22.1<1>:ud   -r22.0<0;1,0>:ud  1:ud
mov (1|M0)               r23.0<1>:ud   r21.0<0;1,0>:ud
mov (1|M0)               r23.1<1>:ud   r21.1<0;1,0>:ud
mov (1|M0)               r23.2<1>:ud   r21.0<0;1,0>:ud
mov (1|M0)               r23.3<1>:ud   r21.1<0;1,0>:ud
mul (4|M0)               r24.0<1>:ud   r23.0<1;1,0>:ud   r22.2<0;1,0>:uw
mul (4|M0)               r25.0<1>:ud   r23.0<1;1,0>:ud   r22.0<0;1,0>:uw
shl (4|M0)               r26.0<1>:ud   r24.0<1;1,0>:ud   16:ud
or (4|M0)                r26.0<1>:ud   r26.0<1;1,0>:ud   r24.0<1;1,0>:ud
shl (4|M0)               r27.0<1>:ud   r25.0<1;1,0>:ud   16:ud
or (4|M0)                r27.0<1>:ud   r27.0<1;1,0>:ud   r25.0<1;1,0>:ud
and (4|M0)               r7.0<1>:ud    r6.0<1;1,0>:ud    0x00ff00ff:ud
shr (4|M0)               r8.0<1>:ud    r6.0<1;1,0>:ud    8:ud
and (4|M0)               r8.0<1>:ud    r8.0<1;1,0>:ud    0x00ff00ff:ud
add (8|M0)               r7.0<1>:w     r7.0<8;8,1>:w     r26.0<8;8,1>:w
add (8|M0)               r7.0<1>:w     r7.0<8;8,1>:w     -r27.0<8;8,1>:w
add (8|M0)               r8.0<1>:w     r8.0<8;8,1>:w     r24.0<8;8,1>:w
add (8|M0)               r8.0<1>:w     r8.0<8;8,1>:w     -r25.0<8;8,1>:w
sel (8|M0) (ge)f0.0      r7.0<1>:w     r7.0<8;8,1>:w     0:w
sel (8|M0) (lt)f0.0      r7.0<1>:w     r7.0<8;8,1>:w     255:w
sel (8|M0) (ge)f0.0      r8.0<1>:w     r8.0<8;8,1>:w     0:w
sel (8|M0) (lt)f0.0      r8.0<1>:w     r8.0<8;8,1>:w     255:w
shr (4|M0)               r9.0<1>:ud    r5.0<1;1,0>:ud    24:ud
add (4|M0)               r9.0<1>:ud    -r9.0<1;1,0>:ud   255:ud
and (4|M0)               r10.0<1>:ud   r5.0<1;1,0>:ud    0x00ff00ff:ud
shr (4|M0)               r11.0<1>:ud   r5.0<1;1,0>:ud    8:ud
and (4|M0)               r11.0<1>:ud   r11.0<1;1,0>:ud   0x00ff00ff:ud
mul (4|M0)               r12.0<1>:ud   r7.0<1;1,0>:ud    r9.0<8;4,2>:uw
add (4|M0)               r12.0<1>:ud   r12.0<1;1,0>:ud   0x007f007f:ud
shr (4|M0)               r13.0<1>:ud   r12.0<1;1,0>:ud   8:ud
and (4|M0)               r13.0<1>:ud   r13.0<1;1,0>:ud   0x00ff00ff:ud
add (4|M0)               r13.0<1>:ud   r13.0<1;1,0>:ud   r12.0<1;1,0>:ud
add (4|M0)               r13.0<1>:ud   r13.0<1;1,0>:ud   0x00010001:ud
shr (4|M0)               r13.0<1>:ud   r13.0<1;1,0>:ud   8:ud
and (4|M0)               r13.0<1>:ud   r13.0<1;1,0>:ud   0x00ff00ff:ud
add (4|M0)               r13.0<1>:ud   r13.0<1;1,0>:ud   r10.0<1;1,0>:ud
sel (8|M0) (lt)f0.0      r13.0<1>:uw   r13.0<8;8,1>:uw   0x00ff:uw
mul (4|M0)               r14.0<1>:ud   r8.0<1;1,0>:ud    r9.0<8;4,2>:uw
add (4|M0)               r14.0<1>:ud   r14.0<1;1,0>:ud   0x007f007f:ud
shr (4|M0)               r15.0<1>:ud   r14.0<1;1,0>:ud   8:ud
and (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   0x00ff00ff:ud
add (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   r14.0<1;1,0>:ud
add (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   0x00010001:ud
shr (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   8:ud
and (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   0x00ff00ff:ud
add (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   r11.0<1;1,0>:ud
sel (8|M0) (lt)f0.0      r15.0<1>:uw   r15.0<8;8,1>:uw   0x00ff:uw
shl (4|M0)               r15.0<1>:ud   r15.0<1;1,0>:ud   8:ud
or (4|M0)                r5.0<1>:ud    r13.0<1;1,0>:ud   r15.0<1;1,0>:ud
send (16|M0)             acc0:uw       r4:d      0xC  0x060A8000     // media block write of the destination (entry 0), as the fill
mov (8|M0)               r112.0<1>:ud  r0.0<8;8,1>:ud
send (16|M0)             null:uw       r112:d    0x27 0x02000010 {EOT}
