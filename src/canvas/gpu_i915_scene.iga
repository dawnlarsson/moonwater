// Gen9 scene (op 6): fill (0), tone over (1), image copy (4) and premultiplied image over (11), the images with an optional R/B
// swap (0x80), drawn in order over one 8 by 8 pixel tile of the damage. Each thread is one tile: walker group X (r0.1) and Y (r0.6),
// the tile's first pixel at x = px0 + 8 X, y = py0 + 8 Y. Every ALU instruction is SIMD8 (a register, one row of the tile), so the
// Gen7 and Gen7.5 patch of these words (gpu.c's gpu_start) has no compressed instruction to change.
//
// CURBE (r1): r1.0 = the record count, r1.1 = px0, r1.2 = py0, r1.3 = px1, r1.4 = py1 (the damage, in the picture's pixels).
// Binding table entry 0 is the damage (the tile read once, only when no record covers it whole and opaque, and written once);
// entry 1 the records, one a 64-byte row (32 bytes used: kind, x0, y0, x1, y1, then colour or the image's x and row bias and its
// entry), read eight at a time; entries 2 and up are the records' images, a surface each (its own base and pitch), read a tile at a
// time at byte x = word 5 + 4 x and row = word 6 + y. The records are clipped to the damage by the encoder (gpu_i915_scene_batch).
//
// Two passes over the records: the first finds the last that covers the tile whole and writes every pixel of it (a fill, or a copy:
// what was under it cannot show), the second draws from it on (or from the first, over the tile as it was read). A tile row is
// written under its lanes' mask, x in [x0, x1) and the row's y in [y0, y1).
//
// Registers: r2 scalars (.0 bx .1 by .2 the tile's right end .3 its bottom .4 the record .5 the first drawn .6 records left in the
// batch .7 4 bx), r3 the lanes' x, r7 the lane numbers 0 to 7, r8 scratch, r9 the x mask, r10 the rows' y masks (lane r: row r),
// r11 r12 r13 the headers of the records', the image's and the tile's block messages, r14-r21 the tile, r22-r29 the image's tile,
// r30-r38 scratch, r40-r47 the records batch (the record drawn is r40: the batch is moved down one register after each).
mov (1|M0)               r7.0<1>:ud    0:ud
mov (1|M0)               r7.1<1>:ud    1:ud
mov (1|M0)               r7.2<1>:ud    2:ud
mov (1|M0)               r7.3<1>:ud    3:ud
mov (1|M0)               r7.4<1>:ud    4:ud
mov (1|M0)               r7.5<1>:ud    5:ud
mov (1|M0)               r7.6<1>:ud    6:ud
mov (1|M0)               r7.7<1>:ud    7:ud
shl (1|M0)               r2.0<1>:ud    r0.1<0;1,0>:ud    3:ud
add (1|M0)               r2.0<1>:ud    r2.0<0;1,0>:ud    r1.1<0;1,0>:ud
shl (1|M0)               r2.1<1>:ud    r0.6<0;1,0>:ud    3:ud
add (1|M0)               r2.1<1>:ud    r2.1<0;1,0>:ud    r1.2<0;1,0>:ud
add (1|M0)               r2.2<1>:ud    r2.0<0;1,0>:ud    8:ud
sel (1|M0)   (lt)f1.1    r2.2<1>:ud    r2.2<0;1,0>:ud    r1.3<0;1,0>:ud
add (1|M0)               r2.3<1>:ud    r2.1<0;1,0>:ud    8:ud
sel (1|M0)   (lt)f1.1    r2.3<1>:ud    r2.3<0;1,0>:ud    r1.4<0;1,0>:ud
shl (1|M0)               r2.7<1>:ud    r2.0<0;1,0>:ud    2:ud
add (8|M0)               r3.0<1>:ud    r7.0<8;8,1>:ud    r2.0<0;1,0>:ud
// the tile's header: x in bytes and the row, in the damage's surface; 32 bytes by 8 rows
mov (8|M0)               r13.0<1>:ud   r0.0<8;8,1>:ud
shl (1|M0)               r13.0<1>:ud   r0.1<0;1,0>:ud    5:ud
shl (1|M0)               r13.1<1>:ud   r0.6<0;1,0>:ud    3:ud
mov (1|M0)               r13.2<1>:ud   0x0007001f:ud
// pass 1: the last record that covers the tile whole and opaque (kind 0, or 4 with or without the swap): r2.5, all ones for none
mov (1|M0)               r2.4<1>:ud    0:ud
mov (1|M0)               r2.5<1>:ud    0xffffffff:ud
mov (1|M0)               r2.6<1>:ud    0:ud
first_loop:
cmp (16|M0)  (ge)f0.1    null:ud       r2.4<0;1,0>:ud    r1.0<0;1,0>:ud
(W&f0.1) jmpi first_end
cmp (16|M0)  (ne)f0.1    null:ud       r2.6<0;1,0>:ud    0:ud
(W&f0.1) jmpi first_have
mov (8|M0)               r11.0<1>:ud   r0.0<8;8,1>:ud
mov (1|M0)               r11.0<1>:ud   0:ud
mov (1|M0)               r11.1<1>:ud   r2.4<0;1,0>:ud
mov (1|M0)               r11.2<1>:ud   0x0007001f:ud
send (16|M0)             r40:ud        r11:ud    0xC  0x02890001
mov (1|M0)               r2.6<1>:ud    8:ud
first_have:
// (bx - x0) | (x1 - right) | (by - y0) | (y1 - bottom) | -(kind & 0x7b): not negative when it covers the tile and is opaque
add (1|M0)               r8.3<1>:ud    r2.0<0;1,0>:ud    -r40.1<0;1,0>:ud
add (1|M0)               r8.4<1>:ud    r40.3<0;1,0>:ud   -r2.2<0;1,0>:ud
or (1|M0)                r8.3<1>:ud    r8.3<0;1,0>:ud    r8.4<0;1,0>:ud
add (1|M0)               r8.4<1>:ud    r2.1<0;1,0>:ud    -r40.2<0;1,0>:ud
or (1|M0)                r8.3<1>:ud    r8.3<0;1,0>:ud    r8.4<0;1,0>:ud
add (1|M0)               r8.4<1>:ud    r40.4<0;1,0>:ud   -r2.3<0;1,0>:ud
or (1|M0)                r8.3<1>:ud    r8.3<0;1,0>:ud    r8.4<0;1,0>:ud
and (1|M0)               r8.4<1>:ud    r40.0<0;1,0>:ud   0x7b:ud
