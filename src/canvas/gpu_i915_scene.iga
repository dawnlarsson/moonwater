or (1|M0)                r8.3<1>:ud    r8.3<0;1,0>:ud    r8.4<0;1,0>:ud
cmp (16|M0)  (lt)f0.1    null:d        r8.3<0;1,0>:d     0:d
(W&f0.1) jmpi first_next
mov (1|M0)               r2.5<1>:ud    r2.4<0;1,0>:ud
first_next:
mov (8|M0)               r40.0<1>:ud   r41.0<8;8,1>:ud
mov (8|M0)               r41.0<1>:ud   r42.0<8;8,1>:ud
mov (8|M0)               r42.0<1>:ud   r43.0<8;8,1>:ud
mov (8|M0)               r43.0<1>:ud   r44.0<8;8,1>:ud
mov (8|M0)               r44.0<1>:ud   r45.0<8;8,1>:ud
mov (8|M0)               r45.0<1>:ud   r46.0<8;8,1>:ud
mov (8|M0)               r46.0<1>:ud   r47.0<8;8,1>:ud
add (1|M0)               r2.6<1>:ud    r2.6<0;1,0>:ud    0xffffffff:ud
add (1|M0)               r2.4<1>:ud    r2.4<0;1,0>:ud    1:ud
(W) jmpi first_loop
first_end:
// pass 2 reads its batches at whole batches of eight (r2.4 from r2.5 rounded down) and passes over the records before r2.5
and (1|M0)               r2.4<1>:ud    r2.5<0;1,0>:ud    0xfffffff8:ud
mov (1|M0)               r2.6<1>:ud    0:ud
cmp (16|M0)  (ne)f0.1    null:ud       r2.5<0;1,0>:ud    0xffffffff:ud
(W&f0.1) jmpi draw_loop
// no record covers the tile: it is read, and drawn over from the first record (each row read before any is written)
mov (1|M0)               r2.4<1>:ud    0:ud
mov (1|M0)               r2.5<1>:ud    0:ud
send (16|M0)             r14:ud        r13:ud    0xC  0x02890000
or (8|M0)                r38.0<1>:ud   r14.0<8;8,1>:ud   r15.0<8;8,1>:ud
or (8|M0)                r38.0<1>:ud   r38.0<8;8,1>:ud   r16.0<8;8,1>:ud
or (8|M0)                r38.0<1>:ud   r38.0<8;8,1>:ud   r17.0<8;8,1>:ud
or (8|M0)                r38.0<1>:ud   r38.0<8;8,1>:ud   r18.0<8;8,1>:ud
or (8|M0)                r38.0<1>:ud   r38.0<8;8,1>:ud   r19.0<8;8,1>:ud
or (8|M0)                r38.0<1>:ud   r38.0<8;8,1>:ud   r20.0<8;8,1>:ud
or (8|M0)                r38.0<1>:ud   r38.0<8;8,1>:ud   r21.0<8;8,1>:ud
// pass 2
draw_loop:
cmp (16|M0)  (ge)f0.1    null:ud       r2.4<0;1,0>:ud    r1.0<0;1,0>:ud
(W&f0.1) jmpi done
cmp (16|M0)  (ne)f0.1    null:ud       r2.6<0;1,0>:ud    0:ud
(W&f0.1) jmpi draw_have
mov (8|M0)               r11.0<1>:ud   r0.0<8;8,1>:ud
mov (1|M0)               r11.0<1>:ud   0:ud
mov (1|M0)               r11.1<1>:ud   r2.4<0;1,0>:ud
