#!/bin/sh
#
#       Every edit this repository makes to Linux's own source.
#
#           sh kernel/patch/apply
#
#       WHY THIS IS A FILE AND NOT A PARAGRAPH OF build.sh
#
#       Everything under kernel/ touches Linux. Everything under src/ is ours
#       and touches nothing. That is the whole rule, and it is only useful if
#       it is true of the code as well as of the intention -- so the edits
#       themselves live here, where somebody asking "what did you change about
#       the kernel" can read the answer in one place instead of finding it
#       spread through a build script that also downloads tarballs and links
#       userspace.
#
#       Linux is GPL-2.0. These edits are modifications of it. Nothing here
#       changes that and nothing here is meant to: this file exists so the
#       edge is a directory rather than a judgement made file by file.
#
#       WHAT IT DOES, in four kinds:
#
#         claims     tells an architecture's string.h that it owns a symbol,
#                    so lib/string.c stops defining it and ours links instead
#         displaces  comments an object out of an architecture's lib/Makefile,
#                    for the three where a claim is not enough because the
#                    architecture wrote its own assembly
#         grafts     adds our Kconfig and our objects to the kernel's own
#                    lists, and points kernel/moonwater at src/
#         replaces   kernel/replace/, applied separately by its own script
#
#       ALL OF IT IS REVERSIBLE BY DELETING linux/ AND UNPACKING AGAIN, which
#       is what --clean does. Nothing here is a patch file that has to be
#       rebased; every edit is idempotent and re-applying is a no-op.
#
#       Run from the repository root, after the configuration is composed --
#       key_one reads artifacts/.config.
#
set -u

. src/build/host.sh

#
#       Stopping, which this file needs a word of its own for.
#
#       build.sh has a die, but the build runs this as a program of its own,
#       so nothing build.sh defines is defined here -- and without one every
#       `|| die` below was a command not found that let the script carry on
#       and exit 0 with the edit it guarded never made. An edit whose line has
#       moved in a new kernel must stop the build: an image built without it
#       is a kernel nobody chose, and it looks exactly like the one they did.
#
die() {
        echo "kernel/patch/apply: $*" >&2
        exit 1
}

arch=$(key_one arch) && [ -n "$arch" ] || die "no '#> arch' in artifacts/.config"

#
#       Handing a symbol over to src/*.asm means telling the
#       architecture's own string.h that it owns it, or
#       lib/string.c defines it as well and vmlinux does not
#       link. Which symbols there are to hand over differs per
#       architecture, and that is the whole shape of this:
#
#       x86_64's asm/string_64.h claims memcpy, memmove and
#       memset and leaves the other ten to the byte loops, so
#       x86 is catching up on all ten. memcmp is the newest of
#       them and the reason it is here rather than in the two
#       lists below: arm64 and riscv64 ship their own memcmp
#       in assembly already, and claiming it there is a second
#       definition rather than a first. arm64 and riscv did
#       most of that work already and ship their own; what is
#       left is what nobody bothered with -- strchrnul and
#       strnchr on both, and memchr on riscv, which are still
#       running the byte loop in lib/string.c today.
#
#       The spellings below are the ones `build asm` normalizes, so
#       a profile is free to say arm64 or aarch64 and mean the
#       same machine here as it does there.
#
case "$arch" in
x86_64 | amd64 | x64)
        header=linux/arch/x86/include/asm/string_64.h
        fold_header=$header
        #
        #       The three the architecture wrote for itself.
        #       Re-measured on a 9950X in kernel shape, in
        #       cycles, ours against what they actually run --
        #       which on this part is rep movsb and rep stosb,
        #       because it reports fsrm and arch/x86/kernel/
        #       cpu/amd.c gives FSRS to anything that does.
        #
        #       At thirty two bytes and below, ours over theirs
        #       over the ladder 4 8 12 16 24 32: memcpy 1.7x to
        #       3.1x, memmove 2.3x to 3.3x, memset 1.0x to
        #       2.1x. Above thirty two, from thirty three bytes
        #       to sixteen megabytes: memcpy a flat 0.90x,
        #       memmove 0.97x to 1.04x, memset 0.97x to 1.01x.
        #
        #       There is no crossover any more, and the numbers
        #       that used to stand here -- 5.7x at 256, 0.87x
        #       at a megabyte -- do not describe this tree.
        #       KERNEL_BULK_COPY in src/lib.c hands
        #       anything over thirty two bytes to the same rep
        #       movsb memcpy_64.S uses, so above that line the
        #       two are the identical instruction and ours only
        #       pays the dispatch to reach it. The whole of the
        #       win is at thirty two and below, where it is two
        #       to three times, and that is where a kernel
        #       copies -- headers, structures, names, table
        #       entries.
        #
        #       memcpy is the one of the three that is worse
        #       above the line rather than level, and the ten
        #       per cent is the overlap test memory_copy makes
        #       and the kernel's own __memcpy does not. It is a
        #       flat ten per cent and not a growing one, since
        #       both sides converge on the one instruction, so
        #       it is a bounded price on the tail for twice the
        #       speed at the mode. Pointing the memcpy alias at
        #       memory_copy_apart instead measured 0.99x to
        #       1.00x above the line while keeping the win
        #       below it, and matches what memcpy already
        #       promises about regions that do not overlap.
        #
        displaces="linux/arch/x86/lib/Makefile:memcpy_\$(BITS).o
linux/arch/x86/lib/Makefile:memmove_64.o
linux/arch/x86/lib/Makefile:memset_64.o"
        claims="STRCPY:char *strcpy(char *, const char *)
STRSTR:char *strstr(const char *, const char *)
STRCAT:char *strcat(char *, const char *)
STRLEN:__kernel_size_t strlen(const char *)
STRNCMP:int strncmp(const char *, const char *, __kernel_size_t)
STRNLEN:__kernel_size_t strnlen(const char *, __kernel_size_t)
STRCHR:char *strchr(const char *, int)
MEMCHR:void *memchr(const void *, int, __kernel_size_t)
MEMCMP:int memcmp(const void *, const void *, __kernel_size_t)
STRCMP:int strcmp(const char *, const char *)
STRRCHR:char *strrchr(const char *, int)
STRCHRNUL:char *strchrnul(const char *, int)
STRNCHR:char *strnchr(const char *, __kernel_size_t, int)
"
        ;;
arm64 | aarch64)
        header=linux/arch/arm64/include/asm/string.h
        #
        #       memset32 and memset64 are the two lib/string.c still writes
        #       as "while (count--) *xs++ = v" on this machine. Instructions
        #       per call against that loop, counted with a qemu plugin, both
        #       sides built with this architecture's own kernel flags:
        #       2.27x at eight words, 2.87x at sixteen, 3.63x at sixty four,
        #       3.95x at five hundred and twelve. It is behind at a count of
        #       zero and a count of one, by seven instructions and by two,
        #       and ahead from three words up -- which is under every caller:
        #       vt.c fills vc_cols, i915 fills fifteen to a hundred and
        #       twenty eight, page table work fills five hundred and twelve.
        #
        #       Not memset16, which has no caller this tree can reach at
        #       all: outside its own tests the only one in Linux is
        #       arch/arc/net/bpf_jit_core.c, on an architecture nothing here
        #       builds. A routine at this parity costs three bodies, and
        #       three bodies for nought call sites is not a trade.
        #
        claims="STRCHRNUL:char *strchrnul(const char *, int)
STRNCHR:char *strnchr(const char *, __kernel_size_t, int)
MEMSET32:void *memset32(uint32_t *, uint32_t, __kernel_size_t)
MEMSET64:void *memset64(uint64_t *, uint64_t, __kernel_size_t)"
        ;;
riscv64 | riscv)
        #
        #       Two names, and the reason it is not more is
        #       mostly arch/riscv/kernel/pi rather than anything
        #       about how fast the routines are. The three pi
        #       leaves alone are refused further down, on their
        #       measurements.
        #
        #       That directory compiles a second private copy of
        #       lib/string.c into .init.pi and objcopies every
        #       symbol in it to __pi_, because the code there
        #       runs before the MMU and cannot call the ordinary
        #       kernel. A claim tells lib/string.c to stop
        #       defining a name, and it stops defining it in that
        #       copy as well, so the __pi_ name standing in front
        #       of it has nothing left behind it:
        #
        #           hidden symbol `__pi_memchr' isn't defined
        #
        #       Six names are reached from there and so none of
        #       them can be claimed here. strstr is
        #       cmdline_early.c; memchr, memcmp, strcspn, strpbrk
        #       and strncasecmp are fdt_early.c and the two
        #       libfdt files compiled beside it. memcmp is worth
        #       naming twice, because the paragraph at the top of
        #       this switch says arm64 and riscv64 both ship
        #       their own and only arm64 does: there is no
        #       memcmp.S in arch/riscv/lib and no
        #       __HAVE_ARCH_MEMCMP in its string.h. riscv's
        #       memcmp is lib/string.c's byte loop, and pi is the
        #       only reason it stays there.
        #
        #       arm64 does not hit any of this -- its pi builds
        #       no string.c at all and aliases __pi_ onto its own
        #       assembly. Handing riscv's pi an alias to a
        #       function outside .init.pi would link and might
        #       even boot, and would be a wrong answer about what
        #       that code is allowed to reach.
        #
        #       The nine the architecture wrote for itself are
        #       shut behind the same door from the other side.
        #       memcpy, memmove, memset, strlen, strnlen, strcmp,
        #       strncmp, strchr and strrchr already define
        #       __HAVE_ARCH_, so taking one means displacing its
        #       object out of arch/riscv/lib the way x86 does --
        #       and the SYM_FUNC_ALIAS that gives pi its __pi_
        #       name is inside that same object.
        #
        #       Measuring them anyway said not to want them.
        #       Executed instructions under a qemu plugin, ours
        #       against the architecture's own with Zbb patched
        #       in, which is what CONFIG_RISCV_ISA_ZBB=y in
        #       profile/arch/riscv gets on any core that reports
        #       it: strlen 0.50x at four thousand bytes, strcmp
        #       0.64x, strnlen 0.56x, strncmp 0.83x. orc.b and
        #       ctz are one instruction each and ours spends
        #       seven getting the same answer, so the wide body
        #       loses to the wide body it has no instructions for.
        #
        #       What is left is strcpy, strcat and bcmp, and
        #       measuring those said no as well. Ours against
        #       lib/string.c, averaged over all eight starting
        #       alignments:
        #
        #           strcpy   0.33x at 4 bytes, 0.48x at 8,
        #                    0.79x at 16, level at 24, 1.86x at 64
        #           strcat   0.23x at 4, 0.35x at 8, 0.58x at 16,
        #                    level at 32, 1.49x at 64
        #
        #       and the kernel's own string literals have a
        #       median length of six, with 86 per cent of the
        #       ones handed to strcpy and strcat under twelve.
        #       Both are losses at the length the kernel is
        #       actually at. bcmp would be free to take and is
        #       not worth taking: gcc on riscv lowers memcmp == 0
        #       to memcmp rather than to bcmp, and nothing
        #       outside arch/x86 calls it.
        #
        #       stpcpy cannot be claimed by any architecture.
        #       lib/string.c defines it outside any __HAVE_ARCH_
        #       guard, so a define here changes nothing and ours
        #       would be a second definition rather than a first.
        #
        #       The two below stay, with the number that says
        #       where they earn it. The prologue was the thing to
        #       shorten rather than the claim to drop, and it has
        #       been shortened: strchrnul takes the branch past
        #       the whole prefix fixup on an eight byte aligned
        #       pointer that strchr beside it always had, and
        #       builds the byte that stands in for the bytes in
        #       front of the string as ~c with bit zero forced on
        #       -- neither zero nor c, for every c -- out of the
        #       broadcast already in a register rather than out
        #       of a second multiply. Eleven instructions to the
        #       first compare on an aligned pointer where there
        #       were twenty two, and twenty where it is not.
        #
        #       Guest instructions per call against lib/string.c's
        #       byte loop, counted with a qemu plugin over a scan
        #       that runs the whole string, aligned: 0.74x at
        #       four bytes, 0.94x at eight, 1.35x at twelve,
        #       1.37x at sixteen, 1.83x at thirty two. The
        #       crossover was about eighteen bytes of scan and is
        #       about nine; unaligned it is about eleven. strnchr
        #       is unchanged and crosses at about fifteen. The
        #       callers this used to cost are of_node_name_eq and
        #       of_find_node_opts_by_path hunting an at sign or a
        #       slash in a device tree node name, which is most
        #       of what riscv does at boot and is mostly under
        #       twelve bytes -- which is now over the line rather
        #       than under it.
        #
        header=linux/arch/riscv/include/asm/string.h
        #
        #       memset32 and memset64 for the reason the arm64 arm above
        #       gives, and the numbers are that architecture's; here the same
        #       count is 1.38x at eight words, 1.62x at sixteen, 1.88x at
        #       sixty four and 1.98x at five hundred and twelve, with
        #       memset32 behind through a count of two because it proves the
        #       pointer eight byte aligned before it stores a doubleword.
        #
        #       Neither of these is in arch/riscv/kernel/pi. That code
        #       compiles its own copy of lib/string.c and reaches nothing
        #       outside .init.pi, which is what stops memchr going over --
        #       but nothing in pi, and nothing in the libfdt it builds, fills
        #       a span of words.
        #
        claims="STRCHRNUL:char *strchrnul(const char *, int)
STRNCHR:char *strnchr(const char *, __kernel_size_t, int)
MEMSET32:void *memset32(uint32_t *, uint32_t, __kernel_size_t)
MEMSET64:void *memset64(uint64_t *, uint64_t, __kernel_size_t)"
        ;;
*)
        #
        #       An architecture with no arm here claims
        #       nothing, which is correct only because every
        #       src/*.asm carries an empty "#> arch other"
        #       block and so emits no symbol for it either.
        #       Those two facts have to move together: an asm
        #       block for a new architecture without an arm
        #       here defines what lib/string.c also defines,
        #       and vmlinux does not link.
        #
        header=
        claims=
        ;;
esac

#
#       The same switch src/moonwater/Makefile reads. With it set the
#       kernel keeps every symbol it came with, so an image
#       built this way and one built without it differ in
#       exactly the thing being measured.
#
if [ -n "${MOONWATER_STOCK:-}" ]; then
        claims=
        displaces=
        fold_header=
        echo "  MOONWATER_STOCK: the kernel keeps its own"
fi

#       Loops read here-documents rather than a pipe: the far end of a pipe is
#       a subshell, and a die there would stop only the loop.
if [ -n "$header" ]; then
        [ -f "$header" ] || die "no $header to claim symbols in"

        while IFS=: read -r name signature; do
                [ -n "$name" ] || continue
                line_add "$header" "#define __HAVE_ARCH_$name" &&
                        line_add "$header" "extern $signature;" ||
                        die "claiming $name in $header"
        done <<EOF
$claims
EOF
fi

#
#       Taking a routine the architecture wrote itself.
#
#       A claim above tells lib/string.c not to define a symbol,
#       which is enough where the generic C is the only other
#       definition. It is not enough for memcpy, memset and
#       memmove on x86_64: the architecture has its own
#       assembly for those, arch/x86/lib/memcpy_64.S and its
#       neighbours, and __HAVE_ARCH_MEMCPY is already defined
#       in its own string_64.h. Claiming what is already
#       claimed changes nothing and the link then has two.
#
#       So the object has to stop being built. Commenting the
#       line out of the architecture's lib/Makefile is the
#       whole of it, and it is reversible by --clean because
#       the kernel tree is unpacked fresh.
#
#       Each entry is a makefile, then the object to displace.
#
#       Every line naming the object is commented out under a line saying so.
#       The name is matched as written rather than as a pattern -- a
#       memcpy_$(BITS).o is full of what a pattern means -- and a makefile that
#       names it nowhere is a kernel that would link two of it, or none of
#       ours, so that stops the build. awk and a copy rather than sed -i, which
#       GNU and BSD spell differently: the core_state harness runs this file on
#       macOS, where sed -i took the edit for a backup suffix and made none.
if [ -n "${displaces:-}" ]; then
        displace_work=$(mktemp) || die "no temporary file to displace objects with"

        while IFS=: read -r makefile object; do
                [ -n "$makefile" ] || continue
                [ -f "$makefile" ] || die "no $makefile to displace $object from"

                if grep -q -F "# moonwater took $object" "$makefile"; then
                        continue
                fi

                awk -v object="$object" '
                        index($0, object) && index($0, "# moonwater took ") != 1 {
                                print "# moonwater took " object
                                print "#" $0
                                taken++
                                next
                        }
                        { print }
                        END { if (!taken) exit 3 }
                ' "$makefile" > "$displace_work" ||
                        die "$makefile no longer builds $object, so nothing was displaced"
                sudo cp "$displace_work" "$makefile" || die "displacing $object"
                echo "  took $object from $(basename "$(dirname "$makefile")")"
        done <<EOF
$displaces
EOF
        rm -f "$displace_work"
fi

#
#       The fold, which is the fourth kind of edit and the only one that
#       changes what a kernel CALL SITE compiles to rather than what a name
#       resolves to. It is measured in kernel/patch/fold-x86.h.
#
#       It goes INSIDE the header's own guards, before "#endif /* __KERNEL__
#       */", and not appended at the end the way the claims above are. Those
#       sit after the file's final #endif and work by luck; a macro there
#       would be re-processed on every inclusion, and a static function
#       beside it would be a redefinition on the second include.
#
#       x86_64 only: the other two have no claims to fold against yet and the
#       size distribution was counted on this one.
#
if [ -n "${fold_header:-}" ] && [ -f kernel/patch/fold-x86.h ] &&
   ! grep -q MOONWATER_FOLD_X86 "$fold_header"
then
        fold_work=$(mktemp)
        awk -v add=kernel/patch/fold-x86.h '
                /^#endif \/\* __KERNEL__ \*\/$/ && !placed {
                        while ((getline line < add) > 0)
                                print line
                        placed = 1
                }
                { print }
                END { if (!placed) exit 3 }
        ' "$fold_header" > "$fold_work" &&
        sudo cp "$fold_work" "$fold_header" ||
                die "folding constant sizes into $fold_header, which has no #endif /* __KERNEL__ */ to place them before"
        rm -f "$fold_work"
        echo "  folded constant memcpy and memset into $(basename "$fold_header")"
fi

#
#       Settings kept in the boot image, which is the fifth kind of edit: the
#       image's own layout, and the EFI stub that reads it.
#
#       bootx64.efi carries a section of its own, .mwset, beside .data in the
#       decompressor where nothing compresses it: two 16 KiB slots, each
#       starting on a page of its own, laid down by the linker script with
#       their magic and the rest zero. The moonwater command rewrites the
#       older slot in place, so the section's file offset never moves once
#       an image is built, and src/moonwater/spark.c says what the bytes mean.
#
#       The stub copies the section into EFI pool memory of the type the
#       random seed table uses and installs it as a configuration table, and
#       efi.c records where, the way it records the seed. It reads nothing:
#       src/moonwater/core.c checks both slots, keeps the newest that holds, and boots
#       on the defaults when neither does, so a torn write can never stop a
#       machine starting. A kernel started any other way -- QEMU's -kernel,
#       a loader using the handover entry with no image -- has no table and
#       the defaults.
#
#       Configuration table rather than setup_data because the same table
#       and the same reader work on arm64 and riscv64, which have no
#       setup_data. Each machine lays the section out in its own image.
#
#       Every edit is placed by an exact line of the kernel's and guarded by
#       a word of its own, so a second run changes nothing, and a kernel
#       whose line moved stops the build here rather than building without.
#
tab=$(printf '\t')
settings_work=$(mktemp -d)


#       A sed edit written back through a copy, as the displacements are: GNU
#       and BSD sed spell editing in place differently, and sed answers 0
#       whether or not it matched, which is why each caller checks its line
#       first.
settings_replace() {
        sed "$2" "$1" > "$settings_work/replace" &&
                sudo cp "$settings_work/replace" "$1"
}

settings_insert() {
        file=$1
        marker=$2
        anchor=$3
        where=$4
        text=$5

        [ -f "$file" ] || die "${6:-settings}: no $file"

        #       A marker already there is this edit, applied before -- or an
        #       older text of it, and then the tree is a kernel nobody chose.
        if grep -q -F -- "$marker" "$file"; then
                awk 'BEGIN { RS = "\001" }
                        FNR == NR { sub(/\n+$/, ""); block = $0; next }
                        index($0, block) { found = 1 }
                        END { exit !found }' "$text" "$file" && return 0
                die "${6:-settings}: $file carries another text of $marker; build --clean unpacks the kernel again"
        fi

        awk -v anchor="$anchor" -v where="$where" -v add="$text" '
                index($0, anchor) == 1 && !placed {
                        if (where == "after")
                                print
                        while ((getline line < add) > 0)
                                print line
                        close(add)
                        if (where == "before")
                                print
                        placed = 1
                        next
                }
                { print }
                END { if (!placed) exit 3 }
        ' "$file" > "$settings_work/edit" &&
                sudo cp "$settings_work/edit" "$file" ||
                die "${6:-settings}: $file no longer has the line this edit is placed by"
        echo "  ${6:-settings}: $(basename "$file") gains $marker"
}

cat > "$settings_work/guid" <<EOF
#define LINUX_EFI_MOONWATER_SETTINGS_GUID${tab}EFI_GUID(0x7097ac1c, 0x01db, 0x4db4,  0x8a, 0xcb, 0x11, 0x8e, 0x8a, 0x46, 0x2d, 0x8e)
EOF
settings_insert linux/include/linux/efi.h LINUX_EFI_MOONWATER_SETTINGS_GUID \
        "#define LINUX_EFI_RANDOM_SEED_TABLE_GUID${tab}" after "$settings_work/guid"

cat > "$settings_work/extern" <<EOF
extern unsigned long __ro_after_init efi_moonwater_settings;${tab}/* Moonwater settings table */
EOF
settings_insert linux/include/linux/efi.h "efi_moonwater_settings;" \
        "extern unsigned long __ro_after_init efi_rng_seed;" after "$settings_work/extern"

cat > "$settings_work/struct" <<EOF
/* Moonwater's settings: the image's .mwset section as the EFI stub found it. */
struct linux_efi_moonwater_settings {
${tab}u32${tab}size;
${tab}u32${tab}reserved;
${tab}u8${tab}bytes[];
};

EOF
settings_insert linux/include/linux/efi.h "struct linux_efi_moonwater_settings {" \
        "struct linux_efi_random_seed {" before "$settings_work/struct"

cat > "$settings_work/variable" <<EOF
unsigned long __ro_after_init efi_moonwater_settings = EFI_INVALID_TABLE_ADDR;
EOF
settings_insert linux/drivers/firmware/efi/efi.c "efi_moonwater_settings =" \
        "unsigned long __ro_after_init efi_rng_seed = EFI_INVALID_TABLE_ADDR;" after \
        "$settings_work/variable"

cat > "$settings_work/table" <<EOF
${tab}{LINUX_EFI_MOONWATER_SETTINGS_GUID,${tab}&efi_moonwater_settings,${tab}"Moonwater"${tab}},
EOF
settings_insert linux/drivers/firmware/efi/efi.c "&efi_moonwater_settings" \
        "${tab}{LINUX_EFI_RANDOM_SEED_TABLE_GUID," after "$settings_work/table"

case "$(key_one arch)" in
x86_64 | amd64 | x64)
        cat > "$settings_work/stub" <<EOF
extern char _mwset[], _emwset[];

/*
 * Moonwater's settings: the image's .mwset section, copied where the kernel
 * finds it once boot services are gone, in pool memory of the type the random
 * seed table uses. Nothing here reads the bytes; the kernel checks them.
 */
static void efi_moonwater_settings_table(void)
{
${tab}efi_guid_t guid = LINUX_EFI_MOONWATER_SETTINGS_GUID;
${tab}struct linux_efi_moonwater_settings *table;
${tab}unsigned long size = _emwset - _mwset;
${tab}efi_status_t status;

${tab}status = efi_bs_call(allocate_pool, EFI_ACPI_RECLAIM_MEMORY,
${tab}${tab}${tab}     struct_size(table, bytes, size), (void **)&table);
${tab}if (status != EFI_SUCCESS)
${tab}${tab}return;

${tab}table->size = size;
${tab}table->reserved = 0;
${tab}memcpy(table->bytes, _mwset, size);

${tab}status = efi_bs_call(install_configuration_table, &guid, table);
${tab}if (status != EFI_SUCCESS)
${tab}${tab}efi_bs_call(free_pool, table);
}
EOF
        settings_insert linux/drivers/firmware/efi/libstub/x86-stub.c \
                "efi_moonwater_settings_table(void)" "extern char _bss[], _ebss[];" after \
                "$settings_work/stub"

        printf '%sefi_moonwater_settings_table();\n' "$tab" > "$settings_work/call"
        settings_insert linux/drivers/firmware/efi/libstub/x86-stub.c \
                "efi_moonwater_settings_table();" "${tab}efi_random_get_seed();" before \
                "$settings_work/call"

        cat > "$settings_work/lds" <<EOF
${tab}/* Moonwater's settings: two slots on pages of their own, never compressed. */
${tab}.mwset : ALIGN(0x1000) {
${tab}${tab}_mwset = . ;
${tab}${tab}QUAD(0x474e54544553574d) SHORT(1) SHORT(64) LONG(16384)
${tab}${tab}. = _mwset + 16384;
${tab}${tab}QUAD(0x474e54544553574d) SHORT(1) SHORT(64) LONG(16384)
${tab}${tab}. = _mwset + 32768;
${tab}${tab}_emwset = . ;
${tab}}
EOF
        settings_insert linux/arch/x86/boot/compressed/vmlinux.lds.S "_mwset" \
                "${tab}.data :${tab}ALIGN(0x1000) {" before "$settings_work/lds"

        cat > "$settings_work/section" <<'EOF'
	# Moonwater's settings, uncompressed and rewritten in place
	.ascii	".mwset\0\0"
	.long	ZO__emwset - ZO__mwset		# VirtualSize
	.long	setup_size + ZO__mwset		# VirtualAddress
	.long	ZO__emwset - ZO__mwset		# SizeOfRawData
	.long	setup_size + ZO__mwset		# PointerToRawData

	.long	0, 0, 0
	.long	IMAGE_SCN_CNT_INITIALIZED_DATA	| \
		IMAGE_SCN_MEM_READ		# Characteristics

EOF
        #       awk -v reads escapes in what it is handed, so the line is named
        #       without its \0s: there is one .data in the section table.
        settings_insert linux/arch/x86/boot/header.S '".mwset' \
                "${tab}.ascii${tab}\".data" before "$settings_work/section"

        #       .text ends where the settings begin, not where .data does.
        if ! grep -q -F "textsize, ZO__mwset" linux/arch/x86/boot/header.S; then
                grep -q -F "${tab}.set${tab}textsize, ZO__data" linux/arch/x86/boot/header.S &&
                        settings_replace linux/arch/x86/boot/header.S \
                                "s/^${tab}\\.set${tab}textsize, ZO__data\$/${tab}.set${tab}textsize, ZO__mwset/" ||
                        die "settings: header.S no longer sets textsize from ZO__data"
                echo "  settings: header.S ends .text at the settings"
        fi

        if ! grep -q -F '_e\?mwset' linux/arch/x86/boot/Makefile; then
                grep -q -F '\|_e\?sbat\|' linux/arch/x86/boot/Makefile &&
                        settings_replace linux/arch/x86/boot/Makefile \
                                's/\\|_e\\?sbat\\|/\\|_e\\?sbat\\|_e\\?mwset\\|/' ||
                        die "settings: the boot Makefile no longer exports _e?sbat"
                echo "  settings: the boot Makefile exports the settings' offsets"
        fi
        ;;
arm64 | aarch64 | riscv64 | riscv)
        #
        #       arm64 and riscv64 have no decompressor: the image is the kernel,
        #       so the section is the kernel's own, on a page of its own between
        #       the end of init text and the start of init data, where it is
        #       covered by a PE section of its own and freed with the rest of
        #       init once the stub has copied it. Both machines' stubs are the
        #       generic efi-stub.c, which makes the table the way x86's does.
        #       Its PE section runs from the settings to where init data starts,
        #       so the sections still cover the image end to end: the
        #       alignment padding after the two slots is the section's, and
        #       the table the stub makes is the two slots alone.
        #
        case "$(key_one arch)" in
        arm64 | aarch64)
                kernel_arch=arm64
                lds_anchor="${tab}__inittext_end = .;"
                lds_where=before
                # The assembler cannot take one linker symbol from another
                # here, so the linker says the size, as __pecoff_data_size.
                section_size=__mwset_pecoff_size
                header_start=.L_head
                ;;
        *)
                kernel_arch=riscv
                lds_anchor="${tab}__init_text_end = .;"
                lds_where=after
                section_size="__pecoff_text_end - _mwset"
                header_start=_start
                ;;
        esac

        cat > "$settings_work/stub" <<EOF
#if defined(CONFIG_ARM64) || defined(CONFIG_RISCV)
extern char _mwset[], _emwset[];

/*
 * Moonwater's settings: the image's .mwset section, copied where the kernel
 * finds it once boot services are gone, in pool memory of the type the random
 * seed table uses. Nothing here reads the bytes; the kernel checks them.
 */
static void efi_moonwater_settings_table(void)
{
${tab}efi_guid_t guid = LINUX_EFI_MOONWATER_SETTINGS_GUID;
${tab}struct linux_efi_moonwater_settings *table;
${tab}unsigned long size = _emwset - _mwset;
${tab}efi_status_t status;

${tab}status = efi_bs_call(allocate_pool, EFI_ACPI_RECLAIM_MEMORY,
${tab}${tab}${tab}     struct_size(table, bytes, size), (void **)&table);
${tab}if (status != EFI_SUCCESS)
${tab}${tab}return;

${tab}table->size = size;
${tab}table->reserved = 0;
${tab}for (unsigned long at = 0; at < size; at++)
${tab}${tab}table->bytes[at] = _mwset[at];

${tab}status = efi_bs_call(install_configuration_table, &guid, table);
${tab}if (status != EFI_SUCCESS)
${tab}${tab}efi_bs_call(free_pool, table);
}
#endif

EOF
        settings_insert linux/drivers/firmware/efi/libstub/efi-stub.c \
                "efi_moonwater_settings_table(void)" \
                "efi_status_t efi_stub_common(efi_handle_t handle," before \
                "$settings_work/stub"

        printf '#if defined(CONFIG_ARM64) || defined(CONFIG_RISCV)\n%sefi_moonwater_settings_table();\n#endif\n' \
                "$tab" > "$settings_work/call"
        settings_insert linux/drivers/firmware/efi/libstub/efi-stub.c \
                "${tab}efi_moonwater_settings_table();" "${tab}efi_random_get_seed();" \
                before "$settings_work/call"

        cat > "$settings_work/lds" <<EOF
${tab}/* Moonwater's settings: two slots on pages of their own, never compressed. */
${tab}. = ALIGN(PECOFF_SECTION_ALIGN_MWSET);
${tab}.mwset : {
${tab}${tab}_mwset = . ;
${tab}${tab}QUAD(0x474e54544553574d) SHORT(1) SHORT(64) LONG(16384)
${tab}${tab}. = _mwset + 16384;
${tab}${tab}QUAD(0x474e54544553574d) SHORT(1) SHORT(64) LONG(16384)
${tab}${tab}. = _mwset + 32768;
${tab}}
${tab}_emwset = _mwset + 32768;
EOF
        if [ "$kernel_arch" = arm64 ]; then
                sed 's/PECOFF_SECTION_ALIGN_MWSET/SEGMENT_ALIGN/' "$settings_work/lds" > "$settings_work/lds.arch"
                printf '%s. = ALIGN(SEGMENT_ALIGN);\n%s__mwset_pecoff_size = ABSOLUTE(. - _mwset);\n' \
                        "$tab" "$tab" >> "$settings_work/lds.arch"
        else
                sed 's/PECOFF_SECTION_ALIGN_MWSET/0x1000/' "$settings_work/lds" > "$settings_work/lds.arch"
        fi
        settings_insert "linux/arch/$kernel_arch/kernel/vmlinux.lds.S" "_mwset" \
                "$lds_anchor" "$lds_where" "$settings_work/lds.arch"

        #       The stub's own names for the two symbols.
        if [ "$kernel_arch" = arm64 ]; then
                printf 'PROVIDE(__efistub__mwset%s= _mwset);\nPROVIDE(__efistub__emwset%s= _emwset);\n' \
                        "$tab$tab" "$tab$tab" > "$settings_work/vars"
                settings_insert linux/arch/arm64/kernel/image-vars.h "__efistub__mwset" \
                        "PROVIDE(__efistub__edata" after "$settings_work/vars"
        else
                printf '__efistub__mwset%s= _mwset;\n__efistub__emwset%s= _emwset;\n' \
                        "$tab$tab" "$tab$tab" > "$settings_work/vars"
                settings_insert linux/arch/riscv/kernel/image-vars.h "__efistub__mwset" \
                        "__efistub__edata" after "$settings_work/vars"
        fi

        cat > "$settings_work/section" <<EOF
${tab}// Moonwater's settings, uncompressed and rewritten in place
${tab}.ascii${tab}".mwset\\0\\0"
${tab}.long${tab}$section_size${tab}${tab}// VirtualSize
${tab}.long${tab}_mwset - $header_start${tab}${tab}${tab}// VirtualAddress
${tab}.long${tab}$section_size${tab}${tab}// SizeOfRawData
${tab}.long${tab}_mwset - $header_start${tab}${tab}${tab}// PointerToRawData

${tab}.long${tab}0, 0, 0
${tab}.long${tab}IMAGE_SCN_CNT_INITIALIZED_DATA | \\
${tab}${tab}IMAGE_SCN_MEM_READ${tab}${tab}${tab}// Characteristics

EOF
        header=linux/arch/$kernel_arch/kernel/efi-header.S
        settings_insert "$header" '".mwset' "${tab}.ascii${tab}\".data" before \
                "$settings_work/section"

        #       .text ends where the settings begin.
        if [ "$kernel_arch" = arm64 ]; then
                text_was='__initdata_begin - \.Lefi_header_end'
                text_now='_mwset - .Lefi_header_end'
        else
                text_was='__pecoff_text_end - efi_header_end'
                text_now='_mwset - efi_header_end'
        fi
        if ! grep -q -F "$text_now" "$header"; then
                [ "$(grep -c "^${tab}\\.long${tab}$text_was${tab}// \\(VirtualSize\\|SizeOfRawData\\)\$" "$header")" = 2 ] &&
                        settings_replace "$header" \
                                "s/^\\(${tab}\\.long${tab}\\)$text_was\\(${tab}\\/\\/ \\(VirtualSize\\|SizeOfRawData\\)\\)\$/\\1$text_now\\2/" ||
                        die "settings: $header no longer sizes .text by $text_was"
                echo "  settings: $(basename "$header") ends .text at the settings"
        fi
        ;;
esac

#
#       WHERE A NEW PROCESS STARTS
#
#       A command is a process made and gone in a few dozen microseconds,
#       and its parent waits for it. Linux sends every new task, forked or
#       exec'd, to the idlest CPU it can find, so a short command lands on
#       an idle CPU that has to be woken, and its exit wakes the parent back
#       on the CPU it left: two cross-CPU wakeups for a program that is
#       often done before either lands. Measured on a two-CPU guest, that is
#       55-65% of a command -- 120-140 us a spawn against 50 on one CPU --
#       and about a fifth of a fork on bare metal.
#
#       So a new task starts where it was made while nothing else is
#       runnable there. The parent is about to sleep in wait4 and the CPU is
#       as good as idle. A CPU with anything else on it still spreads the
#       work -- the second stage of a pipeline, the second job make starts --
#       and a child that keeps running is the load balancer's to move. Exec
#       keeps the CPU fork chose, rather than migrating a task that fork
#       placed with the same knowledge, and a parent woken by its child's
#       exit stays on the CPU both last ran on instead of hopping to the
#       idle one, as a task woken by a finished per-CPU kthread already does
#       -- and does not preempt the exiting child, which would otherwise sit
#       on the runqueue while the parent starts its next command and send
#       that one to the other CPU after all.
#
cat > "$settings_work/start" <<EOF
${tab}/*
${tab} * Moonwater: a new task starts on the CPU that made it while nothing
${tab} * else is runnable there, since its parent is about to wait for it,
${tab} * and exec keeps the CPU fork chose; see kernel/patch/apply, where a
${tab} * new process starts.
${tab} */
${tab}if (((wake_flags & WF_EXEC) ||
${tab}     ((wake_flags & WF_FORK) && this_rq()->nr_running <= 1)) &&
${tab}    cpumask_test_cpu(cpu, p->cpus_ptr))
${tab}${tab}return cpu;

EOF
settings_insert linux/kernel/sched/fair.c "Moonwater: a new task starts on the CPU" \
        "${tab}lockdep_assert_held(&p->pi_lock);" after "$settings_work/start" scheduler

cat > "$settings_work/exiting" <<EOF
${tab}/*
${tab} * Moonwater: a task woken by one that is exiting and has already let
${tab} * its memory go -- a parent woken by its child's exit -- stacks on the
${tab} * exiting task's CPU when it last ran there and nothing else is
${tab} * runnable, for the reason the per-CPU kthread case above does: the
${tab} * waker is about to be gone.
${tab} */
${tab}if ((current->flags & PF_EXITING) && !current->mm && in_task() &&
${tab}    prev == smp_processor_id() && this_rq()->nr_running <= 1 &&
${tab}    asym_fits_cpu(task_util, util_min, util_max, prev))
${tab}${tab}return prev;

EOF
settings_insert linux/kernel/sched/fair.c "Moonwater: a task woken by one that is exiting" \
        "${tab}/* Check a recently used CPU as a potential idle candidate: */" before "$settings_work/exiting" scheduler

cat > "$settings_work/yield" <<EOF
${tab}/*
${tab} * Moonwater: nor does it preempt that task, which is about to schedule
${tab} * away for good; preempted, it lingers on the runqueue and sends the
${tab} * parent's next new task to another CPU. An interrupt, or a task still
${tab} * tearing its memory down, preempts as ever.
${tab} */
${tab}if (rq->curr == current && (current->flags & PF_EXITING) &&
${tab}    !current->mm && in_task())
${tab}${tab}return;

EOF
settings_insert linux/kernel/sched/fair.c "Moonwater: nor does it preempt that task" \
        "${tab}if (test_tsk_need_resched(rq->curr))" before "$settings_work/yield" scheduler

#
#       KERNEL FUNCTIONS IN ASSEMBLY
#
#       kernel/kernel.c holds functions of Linux rewritten from the top in
#       assembly, in lib.c's style, and tags above each one say what it
#       replaces and what it needs from the kernel. kernel/patch/functions
#       reads the tags and edits the tree to match: the C original is retired
#       to a prototype so the asm symbol takes its place, a function the asm
#       has to call loses its static, the structure offsets the asm reads are
#       asked of the compiler through the architecture's asm-offsets.c, and a
#       value the asm takes as a literal is asserted where the kernel keeps it.
#       Only the architectures a routine covers are touched; MOONWATER_STOCK
#       touches nothing.
#
sh kernel/patch/functions || die "kernel/kernel.c: its functions were not put in place"

rm -rf "$settings_work"

line_add_padded "linux/Kconfig" "source \"kernel/moonwater/Kconfig\"" ||
        die "grafting kernel/moonwater/Kconfig into linux/Kconfig"
line_add_padded "linux/kernel/Makefile" "obj-y += moonwater/" ||
        die "grafting kernel/moonwater into linux/kernel/Makefile"

#
#       The module source is this tree's src/, and the check
#       used to be "does the link exist" -- which follows it.
#       A build directory copied from somewhere else, or shared
#       with another session, carries a link pointing at that
#       tree's src, and -e says yes because that directory is
#       real. The kernel module then keeps building from source
#       nobody here has edited while userspace builds from this
#       one, and the two halves of the image disagree without
#       a word said about it.
#
#       So: where does it actually point, and is that here.
#
want_src="$(pwd)/src/moonwater"
have_src=$(readlink linux/kernel/moonwater 2>/dev/null || true)

if [ "$have_src" != "$want_src" ]; then
        if [ -e linux/kernel/moonwater ] && [ ! -L linux/kernel/moonwater ]; then
                die "linux/kernel/moonwater is not a symlink; preserving it"
        fi

        if [ -n "$have_src" ]; then
                echo "  the kernel module link pointed at $have_src"
                echo "  it should be $want_src -- repointing it"
        fi
        sudo rm -f linux/kernel/moonwater
        sudo ln -s "$want_src" linux/kernel/moonwater || die "linking kernel module source"
fi
