#!/bin/sh
#
#       Puts a .asm from kernel/replace/ in the place of a file the kernel already
#       builds, which is the other half of what `build asm` is for: not everything
#       worth writing in assembly can live in a module.
#
#       Its own directory, and that is not tidiness. src/moonwater/Makefile globs every
#       .asm beside it and links the result into the module, so a replacement
#       left in src/ is built twice -- once as part of moonwater and once over
#       the kernel file it replaces -- and the link fails on a multiple
#       definition of whatever it defines. The two kinds of .asm are different
#       things: one is module source, the other is a patch to the kernel.
#
#       A profile asks for one with
#
#               #> asm <file in kernel/replace/> <path under linux/>
#
#       for example
#
#               #> asm entry.asm arch/x86/entry/entry_64.S
#
#       The target has to be a file the kernel's own Makefiles already
#       compile. This replaces what is there; it cannot add a new object to
#       somebody else's directory, because nothing would reference it.
#
#       The original is kept beside it as <name>.original the first time
#       it is replaced, and never read again -- every build regenerates from
#       the .asm, so building twice does the same thing as building once.
#       Removing the #> asm line from the profile puts the original back on
#       the next build, which is what artifacts/asm.applied is for.
#
set -e

. src/build/host.sh

manifest=artifacts/asm.applied
stamp=artifacts/asm.arch

arch=$(key_one arch) || exit 1

# Read here rather than through key(), which joins every match onto one line.
# That is what flags wants and the opposite of what a pair of paths
# wants: two #> asm lines would come back as four words with nothing saying
# where one ended.
requested=artifacts/asm.requested
sed -n 's/^#> asm //p' artifacts/.config > "$requested"

cleanup() { rm -f "$requested" "$manifest.keep"; }
trap cleanup EXIT INT TERM

if [ ! -s "$requested" ] && [ ! -f "$manifest" ]; then
        echo "Nothing to replace"
        exit 0
fi

if [ -z "$arch" ]; then
        echo "replace: no '#> arch' in artifacts/.config" >&2
        exit 1
fi

# A different architecture means every replacement has to be generated again
# even where nothing was edited, since the .S is only ever right for one.
rearch=0

if [ "$(cat "$stamp" 2>/dev/null)" != "$arch" ]; then
        rearch=1
fi

# Anything a previous build replaced and this one does not ask for goes back
# to what the kernel shipped, before the kernel build reads any of it.
if [ -f "$manifest" ]; then
        : > "$manifest.keep"

        while read -r target; do
                [ -n "$target" ] || continue

                if awk -v t="$target" '$2 == t { found = 1 } END { exit !found }' "$requested"; then
                        echo "$target" >> "$manifest.keep"
                        continue
                fi

                # The manifest is read back here before anything is claimed again: an entry that
                # climbs out of linux/ is not restored, and is dropped from the manifest.
                case "$target" in
                /* | *..*)
                        echo "replace: ignoring a manifest entry outside linux/: $target" >&2
                        continue
                        ;;
                esac

                original="linux/$target.original"

                if [ -f "$original" ]; then
                        echo "Restoring $target"
                        mv "$original" "linux/$target"
                fi
        done < "$manifest"

        mv "$manifest.keep" "$manifest"
fi

#
#       The manifest has to be true at every moment, not only once the loop
#       below has run to the end.
#
#       It was written to a second file and moved into place afterwards. A
#       malformed "#> asm" line stops the loop, and anything replaced before
#       that line had already had its original moved aside and the kernel file
#       overwritten -- but the move never happened, so the manifest still
#       described the previous build. Take the bad line back out along with
#       the good one next to it and nothing would ever restore that file: the
#       kernel tree keeps our assembly in place of its own, silently, until
#       somebody deletes the tree.
#
#       So each target is recorded as it is claimed, before the file is
#       touched. Recording one that then fails to generate costs a restore
#       that puts back a file that was never changed, which is harmless; the
#       other way round loses a kernel source file.
#
claim() {
        grep -qxF "$1" "$manifest" 2>/dev/null && return 0
        echo "$1" >> "$manifest"
}

[ -f "$manifest" ] || : > "$manifest"

while read -r source target extra; do
        [ -n "${source:-}" ] || continue

        if [ -z "${target:-}" ] || [ -n "${extra:-}" ]; then
                echo "replace: '#> asm $source $target $extra' is not <source.asm> <target>" >&2
                exit 1
        fi

        # A target escaping the kernel tree would be a profile writing
        # anywhere on the machine as root.
        case "$target" in
        /* | *..*)
                echo "replace: target must be a path inside linux/: $target" >&2
                exit 1
                ;;
        esac

        asm="kernel/replace/$source"
        destination="linux/$target"
        original="$destination.original"

        if [ ! -f "$asm" ]; then
                echo "replace: no such source: $asm" >&2
                exit 1
        fi

        if [ ! -f "$destination" ] && [ ! -f "$original" ]; then
                echo "replace: $target is not a file in the kernel tree" >&2
                echo "replace: only a file the kernel already builds can be replaced" >&2
                exit 1
        fi

        claim "$target"

        # Still the file the kernel shipped: it has to be written whatever
        # the timestamps say, since a freshly unpacked tarball is newer than
        # the .asm that replaces it.
        untouched=0

        if [ ! -f "$original" ]; then
                cp "$destination" "$original"
                untouched=1
        fi

        # Rewriting an unchanged file would give it a new timestamp and make
        # the kernel rebuild everything downstream of it on every build.
        if [ "$untouched" = 0 ] && [ "$rearch" = 0 ] && ! is_newer "$asm" "$destination"; then
                continue
        fi

        echo "Replacing $target with $source"
        ./build asm "$arch" "$asm" "$destination"
done < "$requested"

echo "$arch" > "$stamp"
