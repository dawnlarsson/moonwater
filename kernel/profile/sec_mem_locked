#
# Security region: memory, locked
#
# sec_mem_hardened and what a machine that does one job and should never
# carry on after a corrupted structure asks for on top. See sec_mem_hardened
# for the region, and for why the two are not named together.
#
# What it adds costs on every allocation and on every free, and on every
# return: freed memory is zeroed again (init_on_free, which is about the
# cost of a second memset per object), every call-used register is cleared at
# a return so a value in one cannot be steered into the next function's
# gadget, and the sampling allocator (KFENCE) guards one object in a hundred
# milliseconds' worth with a page of its own, and holds 2 MiB of the machine
# for it.
#
#> includes sec_baseline
#> overrides CONFIG_INIT_ON_ALLOC_DEFAULT_ON CONFIG_INIT_ON_FREE_DEFAULT_ON CONFIG_INIT_STACK_NONE CONFIG_INIT_STACK_ALL_ZERO CONFIG_SLAB_MERGE_DEFAULT CONFIG_PANIC_ON_OOPS

CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_NONE=n
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_ZERO_CALL_USED_REGS=y

CONFIG_SLAB_MERGE_DEFAULT=n
CONFIG_SLAB_BUCKETS=y

# Sixteen copies of every general-purpose cache, and the one an allocation
# uses is picked from its call site and a seed made at boot: an overflow
# cannot be aimed at a neighbour it has not seen. The copies hold slabs of
# their own, which at idle is most of a megabyte.
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y

CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SCHED_STACK_END_CHECK=y

# Corruption stops the machine. With this off a hardened list refuses the
# operation and goes on; for a kiosk that is a state nobody tested.
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_WX=y

# An oops is the kernel saying its own state is not what it thinks, and a
# machine that does one job is better restarted than left to carry on in it:
# a task that oopses panics the machine, and a panic reboots after five
# seconds.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5

CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255
CONFIG_KFENCE_STATIC_KEYS=y

#> cmdline slab_nomerge page_alloc.shuffle=1 init_on_alloc=1 init_on_free=1
