#> compiler aarch64-linux-gnu-gcc

#> kernel_image linux/arch/arm64/boot/Image
#> kernel_export dist/bootaa64.efi

#> arch arm64
#> make_flags ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-
#> virt qemu-system-aarch64

#
#       GCC for aarch64 defaults to -moutline-atomics, which turns every atomic
#       into a call to a libgcc helper (__aarch64_ldadd4_sync and friends) that
#       picks LSE or exclusives at run time. Programs here link no libgcc, so
#       the shell failed to link on seventy of them. Inline exclusives are the
#       ARMv8.0 floor every arm64 core runs.
#
#> program_flags -mno-outline-atomics
#> program_flags -ffunction-sections

#
#       The generic arm64 machine: a device tree or ACPI from firmware, a
#       GICv3, PSCI, PCIe behind an ECAM window and a PL011. That is QEMU's
#       "virt" machine, which is what an Apple Silicon Mac boots natively under
#       hvf, and it is also what a server-class or UEFI ARM board presents. The
#       Raspberry Pi is none of that, and it has its own profile, arch/arm.pi.
#
#       The image is exported as bootaa64.efi because an arm64 Image built with
#       the EFI stub is both things at once: its header is a PE/COFF one that
#       firmware loads as \EFI\BOOT\BOOTAA64.EFI, and the same bytes are the
#       raw Image QEMU's -kernel takes with no firmware at all. build.sh boots
#       it the second way, which skips edk2 and hands the kernel QEMU's own
#       device tree.
#

# Architecture selection
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y

# ARM specific options
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_EPAN=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_PMEM=y
CONFIG_ARM64_CNP=y

CONFIG_SMP=y
CONFIG_NR_CPUS=64

# Firmware: PSCI brings up the other cores and powers the machine off, which
# is what makes poweroff end a QEMU run.
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ACPI=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y

# Device Tree support
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_RESERVED_MEM=y

# Clock support
CONFIG_COMMON_CLK=y

# PCIe through the ECAM window virt and most ARM servers describe. Without
# the generic host every virtio-*-pci device and qemu-xhci on virt is on a bus
# nothing enumerates: no display, no keyboard, no network.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_ECAM=y

# The console. PL011 is ttyAMA0; earlycon finds it from the device tree's
# stdout-path when the command line says earlycon with no argument.
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_OF_PLATFORM=y

# The clock virt keeps across boots, and the button it wires to a PL061.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_DRV_EFI=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# virtio on both transports: virt puts its own devices on MMIO, and the ones a
# command line adds on PCI.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_INPUT=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# USB: xHCI on PCI, the way the x86 guest gets its keyboard and tablet.
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_HID=y

# The carry-less multiply GHASH takes, which the kernel's GCM uses.
CONFIG_CRYPTO_GHASH_ARM64_CE=y
