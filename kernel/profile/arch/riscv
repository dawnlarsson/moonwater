#> compiler riscv64-linux-gnu-gcc

#> kernel_image linux/arch/riscv/boot/Image
#> kernel_export dist/bootriscv64.efi

#> arch riscv64
#> make_flags ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu-
#> virt qemu-system-riscv64

#
#       A section per function, which profile/any deliberately does not ask
#       for. On x86_64 and arm64 a section per function only makes the linker
#       pad each one back up to the target's function alignment: 20,480 and
#       21,056 bytes of text for nothing. Here it goes the other way by
#       18,048 bytes, because riscv64 relaxes calls at link time and the
#       relaxation is what pays for the boundaries. Measured on the shell,
#       built at this profile's floor with gcc 15.1.
#
#> program_flags -ffunction-sections

#
#       Like arch/arm, this profile is the generic platform rather than one
#       board: SBI firmware, a device tree, PLIC and CLINT. That is what QEMU's
#       "virt" machine is and also what a VisionFive or an Unmatched is, so
#       there is no second profile to compose. The console is in here for the
#       same reason.
#

CONFIG_64BIT=y
CONFIG_RISCV=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_PAGE_OFFSET=0xff60000000000000
CONFIG_ARCH_VIRT=y

#
#       Supervisor mode under firmware, which is every RISC-V machine that is
#       not a microcontroller. RISCV_M_MODE is the other half of that choice
#       and would build a kernel that owns machine mode itself.
#
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_RISCV_BOOT_SPINWAIT=y

CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_FPU=y

#
#       Instruction set.
#
#       Base rv64gc, and no more than that. The riscv64 strchrnul in
#       src/lib.c counts trailing
#       bytes with a multiply rather than Zbb's ctz for exactly this reason:
#       QEMU's virt machine reports "riscv: base ISA extensions acdfhim", so a
#       kernel that assumed Zbb would take an illegal instruction inside
#       strchrnul on the machine it is developed on. A floor nothing here can
#       boot is not a floor.
#
#       The symbols below are about the kernel's own use of the extensions,
#       which goes through the kernel's alternatives and is decided at runtime
#       against what the hardware actually reports (always built since 7.4,
#       which dropped RISCV_ALTERNATIVE). That is safe on any machine; ours
#       would not have been.
#
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_ZBA=y
CONFIG_RISCV_ISA_ZBB=y
CONFIG_RISCV_ISA_ZICBOM=y
CONFIG_RISCV_ISA_ZICBOZ=y

#
#       V, on the same terms: the kernel turns it on only for a hart that
#       reports it, and saves and restores it per task. Canvas draws with it
#       inside kernel_vector_begin (canvas_simd_begin) when the hart has it,
#       and userspace gets it by default the way every other distribution
#       ships it. Preemptive, so a long compose in vector registers can
#       still be preempted rather than holding the hart.
#
CONFIG_RISCV_ISA_V=y
CONFIG_RISCV_ISA_V_DEFAULT_ENABLE=y
CONFIG_RISCV_ISA_V_PREEMPTIVE=y

# Interrupts and time: the two controllers every SBI platform has.
CONFIG_RISCV_INTC=y
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y
CONFIG_CLINT_TIMER=y

# CPU idle through SBI. CPU_IDLE comes with the always-composed
# general profile, but the RISC-V driver does not: without this the
# hart never leaves WFI at the firmware's shallowest state.
CONFIG_CPU_IDLE=y
CONFIG_RISCV_SBI_CPUIDLE=y

# Device tree, which is how any of the above is found.
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_RESERVED_MEM=y

#
#       Console. virt exposes an ns16550a; SBI's debug console is what
#       earlycon speaks before the 8250 driver is up, and is the difference
#       between a silent boot and a watchable one.
#
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# virt puts its disks and network behind virtio-mmio and a generic PCIe host.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_HOST_COMMON=y

# Display, for the same reason the other architectures carry it.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
