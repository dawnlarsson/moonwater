#
# Gaming and Performance
#
# Tick rate lives in the latency profile (250 Hz, NO_HZ_IDLE). Pinning
# 1000 Hz here used to win last and keep every busy core interrupting
# a thousand times a second.
#
CONFIG_X86_INTEL_TSX_MODE_ON=y
CONFIG_SCHED_OMIT_FRAME_POINTER=y
CONFIG_NTSYNC=y

#
# Game controllers: Steam Input's virtual gamepad and its remapping write
# events through /dev/uinput, and SDL and Proton read a pad through
# /dev/input/js* (JOYDEV) as well as evdev. Both are a way for a program to
# put events into the machine or to read a pad, so they are root's. devtmpfs
# makes both nodes at mode 0600 owned by root: a driver that names no mode gets
# that default (drivers/base/devtmpfs.c), uinput names none, and nothing in the
# image runs a rule that changes it. The tier lane reads /dev/uinput's mode
# back. A process that is not root cannot open either node, so a desktop
# user's Steam Input virtual pad needs a rule of its own choosing before it
# works. The hardened and locked tiers and the server profile switch both off
# again (each names them with #> overrides).
#
# INPUT_MISC is the menu uinput sits in: without it the option is dropped
# from the kernel on every build (allnoconfig leaves the menu off), and the
# configuration check reports it as not built. The menu adds no driver of
# its own.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y

# The input device nodes are mode 0660 in the input group, so a bowl's user
# (every bowl's, and Steam's among them) can open the pad and its events.
# Every process of that group reads every key and pointer event of the
# machine: this is the posture the desktop image takes for game controllers,
# and SECURITY.md says what it costs. See kernel/patch/apply and
# src/moonwater/Kconfig (MOONWATER_INPUT_GROUP, MOONWATER_INPUT_GID).
CONFIG_MOONWATER_INPUT_GROUP=y
CONFIG_MOONWATER_INPUT_GID=104

#
# Rendering Vendors
#
# AMD is in every build (profile gpu.amd, which the default set and the
# always-on set both name): nothing here switches it off.
# NVIDIA Nouveau is enabled with pre-GSP signed Falcon firmware pinned below
# (Maxwell GM20x through Ampere GA10x, ~2.0 MiB zstd across 367 entries).
# Large GSP-RM images (tu102/ga102/gsp-570.144.bin, ~63 MiB zstd combined) are
# omitted from the initramfs EFI image: Turing/Ampere fall back to Falcon
# firmware cleanly, while Ada/Blackwell remain on simpledrm unless GSP blobs
# are supplied externally.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

