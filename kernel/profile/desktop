CONFIG_DRM_NOUVEAU=y
CONFIG_NOUVEAU_DEBUG=0
CONFIG_NOUVEAU_DEBUG_DEFAULT=0

#
# NVME Support
#
CONFIG_NVME_KEYRING=y
CONFIG_NVME_AUTH=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_VERBOSE_ERRORS=n
CONFIG_NVME_HWMON=y
CONFIG_NVME_FABRICS=y
CONFIG_NVME_RDMA=y
CONFIG_NVME_FC=y
CONFIG_NVME_TCP=y
CONFIG_NVME_TCP_TLS=y
CONFIG_NVME_HOST_AUTH=y
CONFIG_NVME_TARGET=y
# Off because DEBUG_FS is: nvmet_init makes its debugfs directory before
# anything else, gets -ENODEV from a kernel with no debugfs, and unwinds --
# so the target never registered on any boot of this image, and tearing
# down its four reclaim workqueues again cost 18 to 24 ms of initcalls on
# the way to /init. Without the directory it initialises.
CONFIG_NVME_TARGET_DEBUGFS=n
CONFIG_NVME_TARGET_PASSTHRU=y
CONFIG_NVME_TARGET_LOOP=y
CONFIG_NVME_TARGET_RDMA=y
CONFIG_NVME_TARGET_FC=y
CONFIG_NVME_TARGET_FCLOOP=y
CONFIG_NVME_TARGET_TCP=y
CONFIG_NVME_TARGET_TCP_TLS=y
CONFIG_NVME_TARGET_AUTH=y

#
# USB
#
CONFIG_USB_COMMON=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DEFAULT_PERSIST=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_ULPI_BUS=y
CONFIG_TYPEC_TCPCI=y
CONFIG_UCSI_ACPI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_MOUSE=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_UCSI=y
CONFIG_USB_ROLE_SWITCH=y
# TYPEC is PD and alt-mode negotiation. USB4 is the tunnel that a
# Thunderbolt dock actually is; without it a USB4 port is just USB.
CONFIG_USB4=y

#
# Webcams
#
# V4L2 and the USB video class, which is nearly every webcam made and what
# a program in a bowl -- ffmpeg, a browser -- opens as /dev/video*. Their
# microphones are USB audio, already in general. A bowl cannot bring a
# kernel driver of its own, so without these no camera exists for it.
# The filter keeps the other media families (TV, radio, DVB) out.
#
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n
CONFIG_MEDIA_CAMERA_SUPPORT=y
# The sensor and lens menus are for cameras wired to a board over I2C;
# on by default, they drag in the media controller and fwnode glue.
CONFIG_VIDEO_CAMERA_SENSOR=n
CONFIG_VIDEO_CAMERA_LENS=n
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=n

#
# USB ethernet
#
# The Steam Deck dock's port and most USB-C adapters are Realtek RTL8152
# or RTL8153, the rest mostly speak CDC ECM or NCM or are ASIX AX88179;
# a cable is how a machine with no screen is reached when the wifi is not.
#
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_NET1080=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_ZAURUS=n

# Above BITS_PER_LONG, small_cpumask_bits becomes the runtime nr_cpu_ids and
# disables the single-word bitmap/find inlines: 727/1232 call sites reload it.
# Keeping a desktop in one word measured 1.55x on its profiled _find_next_bit.
#> overrides CONFIG_NR_CPUS
CONFIG_NR_CPUS=64
