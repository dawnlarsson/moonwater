CONFIG_DRM_I915=y
# Userptr, as the AMD profile has it: a program's own pages read and written by the GPU, which is how a window's picture
# reaches the card in the compositor's shared memory. Without it the GEM userptr ioctl is refused. It selects MMU_NOTIFIER.
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_I915_FORCE_PROBE=""
CONFIG_DRM_I915_CAPTURE_ERROR=n
CONFIG_DRM_I915_COMPRESS_ERROR=n
CONFIG_INTEL_GTT=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y

# Modern Intel Arc (Battlemage) & Lunar Lake+ driver. Note upstream Linux 7.3
# restricts CONFIG_DRM_XE_DISPLAY to DRM_XE=m (shared i915-display objects);
# building DRM_XE=y avoids runtime module loading and gives render/compute on
# Xe2+ alongside i915 display+render up to Alchemist/Meteor Lake.
CONFIG_DRM_XE=y

#
# Virtual machines
#
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MENU=y
# A virtual machine's tablet, keyboard and touch screen (QEMU's virtio-tablet,
# virtio-keyboard and virtio-multitouch-pci; arm64 had it already). The touch
# screen is how the canvas lane puts fingers on the desktop: QEMU has no USB one.
CONFIG_VIRTIO_INPUT=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_QXL=y

# vmwgfx additionally depends on HYPERVISOR_GUEST, which is a paravirt option
# rather than a graphics one, so it is left to whoever actually targets VMware
# to compose in.

#
# Fallback: the framebuffer the firmware set up (SIMPLEDRM and SYSFB_SIMPLEFB
# are in general, which every build composes)
#

#
# The framebuffer console is built but normally has nothing to attach to.
#
# fbcon binds to an fbdev device, and the only thing that creates one is the
# fbdev DRM client -- which drm_client_lib.active= keeps from registering. So
# with the usual command line the compositor owns the screen and fbcon sits
# idle; boot the same image without that argument and you get the kernel log
# on the monitor instead. On a machine with no serial port that is the
# difference between debugging a black screen and guessing at it.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y

#
# Backlight, which laptops and some all-in-ones need to show anything at all
#
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y
