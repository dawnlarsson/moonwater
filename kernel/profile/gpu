#
# Graphics
#
# Kernel modesetting with the atomic API, which is what a compositor needs:
# atomic commits are how you move a cursor plane and flip a framebuffer in one
# tear-free operation, without any GPU rendering involved.
#
# Core display, DMA-BUF, and Intel/VM drivers:
#
#   i915, xe    Intel integrated & Arc discrete graphics. Gen12+ parts require
#               GuC/HuC firmware to initialize and DMC for runtime power
#               management, pinned below at linux-firmware's commit (~7.3 MiB
#               zstd across 57 i915/xe blobs).
#   virtio-gpu  how a virtual machine gets KMS, and what the compositor is
#               developed against
#   bochs, qxl  the other two display devices QEMU commonly presents
#   simpledrm   whatever the firmware left on the screen, as a last resort
#
# AMD lives in profile/gpu.amd and Nouveau lives in profile/desktop.
#

#
# The in-kernel compositor draws through the DRM client API
#
CONFIG_MOONWATER_CANVAS=y

# Booted from a USB stick there is no bootloader to pass a command line, and
# the EFI stub falls back to this one. A bootloader that does pass a command
# line still wins, so QEMU is unaffected.
#
# drm_client_lib.active= keeps the fbdev client away from the display, which
# is the one argument the compositor cannot do without.
#
# usbhid.mousepoll=1 and kbpoll=1 ask a mouse and a keyboard for a report
# every millisecond, where the interval the device reports is typically 8 ms:
# a mouse that moves is then heard within one millisecond of the movement
# and not within eight, which is the larger part of what a pointer's latency
# is from the device to the kernel, and a keystroke likewise. They were taken
# out for the wakeup a poll every millisecond was thought to be. It is not
# one: a device with nothing to say answers the controller's poll with a NAK
# in hardware and the CPU hears of it only when a report arrives, so an idle
# machine sleeps as it did and what is paid is the controller's polling
# while a device is plugged in. jspoll is left to the device (a gamepad's
# reports are not a pointer's). A machine that would rather have the device's
# own interval says `#> cmdline -usbhid.mousepoll=1 -usbhid.kbpoll=1`.
#
# The command line for the image is every profile's `#> cmdline` words, in the
# order the profiles are composed (build.c writes the one CONFIG_CMDLINE from
# them). A profile that wants one of these words gone says `#> cmdline -WORD`
# and keeps the rest; it does not spell the string again.
CONFIG_CMDLINE_BOOL=y
#
# C-states are allowed. intel_idle.max_cstate=1 / processor.max_cstate=1
# used to keep the processor out of anything deeper than C1, which is why
# a quiet machine never slept. TEO still picks a shallow state when wakeups
# are frequent and a deep one when they are not.
#
# intel_pstate=active / amd_pstate=active keep hardware P-states (HWP,
# EPP) so the package can run from its lowest clock to turbo. Without
# them, SCHEDUTIL as the Kconfig default puts intel_pstate in passive
# mode and the climb is a software ramp. hwp_dynamic_boost raises the
# floor on I/O wakeups, which is the interactive burst.
#
# idle=poll refuses to halt at all. It is not here: it costs every core
# spinning at full power for the whole uptime.
#
# The network's and the mount table's hashes are held small. The kernel sizes
# them from memory, so a 16 GiB desktop carried megabytes of TCP established
# and bind buckets, UDP and mount buckets for the handful of sockets and mounts
# it has; with these, used memory at the first prompt of an idle guest is about
# 0.8 MiB lower at 2 GiB and 4 MiB lower at 16 GiB, twice that at 32.
# thash_entries is 4096 rather than 2 GiB's 16384 because naming it also sizes
# the TCP listen hash, which otherwise scales at one slot per 2 MiB: 16384 grew
# that table from 16 to 256 KiB at 2 GiB. 4096 buckets is still more than a
# desktop's connections. The dentry and inode hashes are left to scale:
# capping them at 2 GiB's size too frees another 21 MiB at 16 GiB, but stat
# over a million names in a tmpfs went from about 500 to 750-820 ns. A machine
# that is a server takes the server profile, which has a command line of its
# own.
#
# swiotlb=1024 starts the bounce buffers at 2 MiB (1024 slots of 2 KiB, more
# where there are more processors to give each an area of its own). The
# kernel's default set 64 MiB aside at boot on every machine with memory
# above 4 GiB; with SWIOTLB_DYNAMIC, in the any profile, a device that runs
# the pool dry gets another made for it.
#
#> cmdline drm_client_lib.active= usbhid.mousepoll=1 usbhid.kbpoll=1 intel_pstate=active amd_pstate=active intel_pstate.hwp_dynamic_boost=1 thash_entries=4096 uhash_entries=1024 mhash_entries=4096 mphash_entries=4096 swiotlb=1024

#
# Core modesetting
#
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_CLIENT=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_CLIENT_LIB=y

# On despite nothing here wanting an fbdev: DRM_CLIENT_LIB, which the
# compositor is built on, is only selected by this or by DRM_CLIENT_LOG.
# Turning it off takes DRM_CLIENT with it and the compositor stops existing.
# The client it registers is kept away from the display at boot instead, with
# drm_client_lib.active= on the kernel command line.
CONFIG_DRM_FBDEV_EMULATION=y

CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_TTM=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y

#
# Windows the display shows straight from where their programs drew them.
# The compositor's table of windows is a memfd, and udmabuf makes a window's
# buffer in it a dma-buf the card imports as a framebuffer: a window that fills
# the output is scanned out with no copy, and the compositor writes only what
# lies over it (the tabs, a glass window). Without it every frame is copied.
#
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

#
# Intel
#
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

