#> program_flags -static -s -flto -nostdlib -nostartfiles -ffreestanding -fno-builtin
#
# -fdata-sections but not -ffunction-sections. Small writable globals need
# their own sections for spark.ld to place them: riscv64 otherwise drops
# .sdata wherever the linker likes, which is outside every region the loader
# maps, and the script says so where it matches them. Code needs no such
# thing. The x86_64 profile asks for -falign-functions=1, and a section per
# function takes that back: every .text.* carries the target's sixteen byte
# function alignment and the linker pads between them. Measured on the shell,
# one section per function cost 20,480 bytes of text on x86_64 and 21,056 on
# arm64 for no other effect, since -fwhole-program already removes what
# --gc-sections would have. riscv64 is the exception -- it saves 18,048 bytes
# there, because that target relaxes calls at link time -- and profile/arch/
# riscv asks for the flag back on its own account. The hot and cold grouping the script relies on survives: the
# compiler emits .text.hot and .text.unlikely for the HOT and COLD routines
# whether or not every other function gets a section of its own.
#
#> program_flags -fdata-sections
#> program_flags -Qn -Wl,--build-id=none -Wl,--gc-sections -Wl,--strip-all -Wl,--strip-debug -Wl,-x -Wl,-s
#> program_flags -O2 -fwhole-program -fipa-pta -Wl,-nmagic -fno-asynchronous-unwind-tables -fomit-frame-pointer -fno-stack-protector
#> program_flags -Wl,--defsym=SPARK_HOT_LIMIT=0x200000

#
# Any profile, essential for all
#

CONFIG_MOONWATER_CORE=y

#
# Floodlight: every runtime allowance on this machine, in one array.
#
# Essential rather than optional. It is the thing that decides what programs
# are allowed to do, and a machine built without it is one where the shell's
# built-in answers are the only answers -- which is safe, but leaves no way to
# grant an exception and nothing to read when somebody asks what is allowed.
#
CONFIG_MOONWATER_FLOODLIGHT=y

#
# /proc/PID/task/TID/children, which the shell reads before it replaces
# itself with a command: a supervised shell may only exec in place when it
# has no child to hand over, and without this file it cannot tell, so it
# refuses and forks instead. Every `cmd &` then ran under a forked copy of
# the shell, $! named that copy, and `kill $!` left the command running.
#
CONFIG_PROC_CHILDREN=y

CONFIG_INITRAMFS_SOURCE="../fs"

CONFIG_RD_GZIP=y

# The built-in initramfs goes in as a plain cpio. The image around it is
# already zstd, so gzip inside it was a second compression that zstd could
# not see through: the image comes out 250 KB smaller without it, and the
# gunzip -- 6.9 ms, which the module's initcall waits out in
# wait_for_initramfs before it can mount /dev -- is gone, in exchange for
# the kernel decompressor producing 2.6 MB more. Twelve paired KVM boots:
# the wait from 7.0 ms to 0.1 in every one, Run /init 8.4 ms sooner at the
# median. RD_GZIP above stays for an initrd handed in by a boot loader.
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=n
#
# Nine options were removed from this file because they could never take:
# GENERIC_IRQ_CHIP, GENERIC_IRQ_INJECTION, GENERIC_IRQ_STAT_SNAPSHOT,
# IRQ_SIM and IRQ_MSI_IOMMU are internal bools a driver selects and no
# fragment can set; ZONE_DEVICE and MEMORY_FAILURE need memory hotplug
# and machine check support that this kernel does not build; KEXEC_ELF
# follows KEXEC, which debug_none turns off on purpose; and KERNEL_GZIP
# is the other half of a choice already settled as zstd.
#
# They cost nothing except nine lines in verify_config's report on every
# build, which is how a check stops being read.
#
CONFIG_HAVE_KERNEL_GZIP=y
CONFIG_HAVE_KERNEL_ZSTD=y
# Measured, because "compression is slow" is the kind of thing that sounds
# true. The boot decompressor was instrumented with rdtsc either side of
# decompress_kernel: 85,368,635 cycles at 4291.6 MHz, which is 19.9 ms to
# turn 8.5 MB back into 34 MB. That is 5.8% of a 341 ms boot.
#
# There is no headroom in it worth taking. The same payload through upstream's
# own libzstd, in memory with no file work, best of seven: 19.1 ms. The
# kernel's in-tree decoder is within four percent of the tuned reference
# library, so a hand-written replacement is competing with something already
# at the floor, for a ceiling of eight tenths of a millisecond.
#
# LZ4 was tried and is worse here for a reason that has nothing to do with
# decode speed. It decompresses the same payload in about the same time, and
# the image it makes is 13.3 MB against zstd's 9.8 -- 36% more to read. On a
# USB stick at 30 MB/s those 3.5 MB cost about 117 ms of reading to save ten
# of decoding. The compression ratio is the thing that matters on real boot
# media, which is what this image is for.
#
# The lever for the 19.9 ms is a smaller vmlinux, not a faster decoder.
CONFIG_KERNEL_ZSTD=y

