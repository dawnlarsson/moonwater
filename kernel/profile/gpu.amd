#> firmware_licence LICENSE.amdgpu 572872598565dc3513470de971a32bf9db301f47afeef3636345eadae33b2eee
#
# Compose it explicitly when you know the machine has an AMD card:
#
#       sudo sh build.sh arch/x64 debug_none limbo desktop wifi serial gpu.amd
#
# The firmware files are compressed; the loader has to read them without wifi.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

CONFIG_DRM_AMDGPU=y

# Userptr: the card reading and writing a program's own pages (a window's picture in the compositor's shared memory). Without it amdgpu's
# amdgpu_hmm_register is a stub that answers -ENODEV (error 19) to every AMDGPU_GEM_USERPTR, and the GPU compose and the apps' draw lists
# have no picture to read or write: a Steam Deck composed 1 of 1311 presents on a kernel built without it. It selects HMM_MIRROR and
# MMU_NOTIFIER, which need nothing else.
CONFIG_DRM_AMDGPU_USERPTR=y

# ROCm / KFD heterogeneous compute (/dev/kfd); selects HMM_MIRROR,
# MMU_NOTIFIER and DRM_AMDGPU_USERPTR.
CONFIG_HSA_AMD=y

# GCN 1.0 (SI) and GCN 1.1 (CIK): since CONFIG_DRM_RADEON is off, amdgpu
# claims these GPUs by default (support_by_default) with their pinned blobs above.
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y

CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
