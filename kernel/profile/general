#
# General hardware baseline
#
# This profile is on by default: build.sh composes it into every image
# alongside "any". It is what makes the difference between a kernel that
# boots on one emulated machine and one that boots on a real desktop.
#
# Targets any x86_64 desktop from roughly 2012 onward -- Sandy/Ivy Bridge and
# Bulldozer era through current parts. That cutoff is what lets everything
# below stay small: it assumes PCIe, AHCI, xHCI or EHCI, UEFI, and a 64-bit
# CPU, so none of the buses and controllers that existed to support older
# machines need to be carried.
#
# Deliberately absent, and why:
#
#   ISA, EISA, MCA, VLB     gone from consumer boards well before 2012
#   IDE / PATA              AHCI has been the default since ~2008
#   floppy, parallel port   not present on the target machines
#   UHCI / OHCI             USB 1.1 host controllers; EHCI and xHCI cover
#                           full and low speed devices on this hardware
#   OSS, AC97               superseded by HD Audio
#   pre-PCIe network cards  ne2000, 3c59x and friends
#
# Leave it out only for targets it does not suit -- an embedded ARM board, or
# a deliberately minimal image -- by editing the composition in build.sh.
#
# Graphics beyond the UEFI framebuffer are separate profiles, because a single
# GPU driver is larger than everything here put together.
#

#
# Buses
#
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_DEFAULT=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_PCI_IOV=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y

#
# Firmware and platform
#
CONFIG_EFI_MIXED=n
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_CPU_FREQ_PSS=y
# Named rather than inherited: they default y under ACPI, and EXPERT
# builds have dropped quieter defaults before. Without them a laptop
# cannot tell AC from battery, so platform-profile and s2idle guess.
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_POWER_SUPPLY=y
CONFIG_DMI=y
CONFIG_DMIID=y

#
# CPU: microcode matters for errata and speculative execution fixes, and
# 32-bit emulation is what lets a 64-bit system run 32-bit game binaries.
#
CONFIG_MICROCODE=y
CONFIG_IA32_EMULATION=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
# 3 is active (EPP): firmware picks the P-state across the whole range,
# and it is the 7.2 default. The numbering is 1 disabled, 2 passive, 3
# active, 4 guided -- this said 2 and called it active, which is passive,
# the software ramp this line was meant to avoid. The command line in
# profile/gpu names amd_pstate=active and x86 always prepends it, so no
# image booted passive; a kernel built without that line would have.
#
# In active mode on a desktop or laptop firmware profile, 7.2 starts the
# powersave policy with EPP balance_performance, on AC and battery alike
# unless amd_dynamic_epp is asked for. That is the choice: a busy core
# climbs to boost at once, an idle one drops to the floor and a deep
# C-state, and performance (EPP 0) would hold the clock up for nothing.
# A server or undefined firmware profile starts at performance instead.
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
# Zen 2+ uses amd-pstate; Bulldozer through Zen 1 still need ACPI _PSS.
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
# I/O and IRQ time is not busy time. Without this, schedutil holds the
# clock up because a core looks utilised while it was only taking
# interrupts.
CONFIG_IRQ_TIME_ACCOUNTING=y
# A latency-critical task can raise its util clamp and get the top of
# the P-state range without pinning every other core there.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

#
# The rest of the package, not just the cores.
#
# intel_idle / TEO only idle the CPU. On a notebook the PMC/SMU is what
# lets PCIe, LPC and DRAM leave S0; without those drivers a "suspended"
# machine is still drawing several watts. INTEL_PMC_CORE needs the PMT
# telemetry stack; AMD_PMC needs the CMOS RTC class or it cannot even
# be selected.
#
# RTC_CLASS itself defaults n, so the PC CMOS clock was simply not in
# the image -- no wall clock after a power loss, and no s2idle on Ryzen
# notebooks.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_INTEL_VSEC=y
CONFIG_INTEL_PMT_TELEMETRY=y
CONFIG_INTEL_PMC_CORE=y
CONFIG_AMD_PMC=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_X86_PKG_TEMP_THERMAL=y

#
# Sensors and power a desktop can read.
#
# The Super I/O chips are where a desktop board's fan tachometers and
# board temperatures live: Nuvoton NCT67xx on ASUS, ASRock, MSI and
# Gigabyte's newer boards, NCT6683 on some MSI and Intel ones, ITE IT87xx
# on Gigabyte's. Probing them only reads, apart from switching monitoring
# on: nct6775 sets the start bit, the temperature enables and VBAT
# sampling, it87 its tachometer and voltage enables; neither touches a
# fan's mode or duty unless somebody writes pwm*_enable (it87 rewrites
# PWM polarity only under fix_pwm_polarity=1, off by default). The BIOS
# or EC fan curve keeps running exactly as it did.
#
# drivetemp is a SATA drive's temperature through SCT, one ATA command
# per read; monitor reads it every five seconds, not every frame.
#
# POWERCAP and INTEL_RAPL are the package energy counter under
# /sys/class/powercap, which the same driver reads on AMD from Zen on.
# This is not prod's PERF_EVENTS_INTEL_RAPL=n: that one is the perf PMU
# over the same MSRs, and stays out.
CONFIG_SENSORS_NCT6775=y
CONFIG_SENSORS_NCT6683=y
CONFIG_SENSORS_IT87=y
CONFIG_SENSORS_DRIVETEMP=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y

#
# Storage: AHCI for SATA, NVMe for anything since about 2014.
#
CONFIG_ATA=y
CONFIG_ATA_ACPI=y
CONFIG_SATA_PMP=y
# 3 is med_power_with_dipm, which is already the 7.2 default. Named so a
# later fragment cannot put it back to 0 (max performance, link never
# sleeps).
CONFIG_SATA_MOBILE_LPM_POLICY=3
CONFIG_ATA_GENERIC=y
CONFIG_SCSI=y
CONFIG_SCSI_MOD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_LOOP=y
# None made at boot. Eight idle loop devices were 512 KiB of request tags plus
# their sysfs, about 630 KiB of an idle guest's used memory, and nothing in
# the image opens one; losetup and mount -o loop ask /dev/loop-control for a
# device, which makes it then.
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y

#
# USB: xHCI covers USB 3 and everything below it on this hardware, EHCI is
# there for the 2012 machines that predate native xHCI.
#
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

#
# Input
#
CONFIG_INPUT=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_MICROSOFT=y
#
# I2C is off unless asked. Almost every laptop pointer since about 2015
# is HID-over-I2C, sitting on Intel LPSS or AMD ACPI2platform. Without
# the bus and those adapters the pad never arrives, and on a lot of
# boards the lid and sleep keys live on the same HID device.
CONFIG_I2C=y
CONFIG_ACPI_I2C_OPREGION=y
CONFIG_I2C_I801=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_SONY=y
CONFIG_HID_STEAM=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

#
# Network: two drivers cover the overwhelming majority of desktops of this
# era -- Intel on business machines, Realtek on consumer boards.
#
CONFIG_NET=y
CONFIG_INET=y
#
# SYN cookies. Kconfig leaves them off, and then there is no
# net.ipv4.tcp_syncookies at all: a listener (a bowl's sshd or web server,
# anything bound with the kernel's 128-deep SYN backlog) that meets a SYN
# flood refuses every real client until the flood stops. On, the kernel
# answers with a cookie once the queue fills, at no cost while it does not.
#
CONFIG_SYN_COOKIES=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
#
#       E1000 as well as E1000E, and they are not the same card. E1000E drives
#       the 82574 and the PCIe parts; E1000 drives the 82540EM, which is what
#       every qemu without an explicit -device presents. Without it our own
#       virtual machine came up with loopback and nothing else -- the card sat
#       on the bus unclaimed while the whole stack was up and waiting -- which
#       is a strange way for a system that means to just work to behave inside
#       its own test.
#
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
#
#       And the card a modern hypervisor offers when it is not pretending to
#       be hardware at all. A cloud instance or a kvm guest with virtio and no
#       driver for it has no network by any other route.
#
CONFIG_VIRTIO_NET=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

#
# Audio
#
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y
# 0, the kernel default, never powers the codec down. 10 s is what the
# driver's own documentation calls a good choice; 1 s is too eager
# because players reopen the device constantly.
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=10

#
# Display: the UEFI framebuffer alone gives a console on anything that boots,
# with no vendor driver and almost no size. Accelerated graphics is a separate
# profile.
#
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y

# The framebuffer console is configured in profile/gpu, where the reasoning
# about who owns the screen belongs.

#
# Filesystems. ntfs3 is here because these machines dual boot with Windows
# more often than not, and exfat because that is what removable media is
# formatted as.
#
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_NTFS3_FS=y
CONFIG_BTRFS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_NLS_ISO8859_1=y

#
# Random number generation, needed by anything doing cryptography. Trusting
# the CPU instruction is a boot parameter now (random.trust_cpu=) rather than
# a build option.
#
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_HW_RANDOM_VIRTIO=y
