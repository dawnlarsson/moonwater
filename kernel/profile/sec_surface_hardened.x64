#
# sec_surface_hardened on x86-64.
#
#> overrides CONFIG_X86_MSR CONFIG_X86_CPUID CONFIG_X86_IOPL_IOPERM CONFIG_ACPI_TABLE_UPGRADE CONFIG_EFI_CUSTOM_SSDT_OVERLAYS

CONFIG_X86_MSR=n
CONFIG_X86_CPUID=n
CONFIG_X86_IOPL_IOPERM=n
CONFIG_ACPI_TABLE_UPGRADE=n
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n
CONFIG_X86_VSYSCALL_EMULATION=n
