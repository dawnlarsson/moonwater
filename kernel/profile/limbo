#
# System
#
CONFIG_DMI_SYSFS=y
CONFIG_RELAY=y
CONFIG_AUXDISPLAY=y
# Compatible SLUB caches share their backing slabs.  Keeping every cache
# separate retained about 0.5 MiB of otherwise empty slab immediately after a
# 512 MiB Canvas boot (7-boot median). `slab_nomerge` remains available when
# allocator debugging or cache isolation needs exact cache identities.
CONFIG_SLAB_MERGE_DEFAULT=y

#
# CPU
#
# NR_CPUS is the desktop profile's (64, one word of cpumask) and the server and
# console profiles' (128); this profile's own 128 never took, since desktop is
# composed after it in every build that has both.
CONFIG_COMPAT_32=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_COMPAT=y

CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y

# Power

CONFIG_ACPI_IPMI=y
CONFIG_ACPI_PROCESSOR_AGGREGATOR=y
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_ACPI_APEI_PCIEAER=y
CONFIG_ACPI_APEI_MEMORY_FAILURE=y
CONFIG_ACPI_DPTF=y
# DPTF is only the policy half. INT340X is the thermal zones and
# cooling devices it acts on; without it the DPTF lines above do
# not see a laptop's skin sensors or the display brightness cooler.
CONFIG_INT340X_THERMAL=y
CONFIG_INT3406_THERMAL=y
CONFIG_ACPI_WATCHDOG=y
CONFIG_ACPI_ADXL=y
CONFIG_ACPI_FFH=y
CONFIG_PMIC_OPREGION=y
CONFIG_BYTCRC_PMIC_OPREGION=y
CONFIG_CHTCRC_PMIC_OPREGION=y
CONFIG_XPOWER_PMIC_OPREGION=y
CONFIG_BXT_WC_PMIC_OPREGION=y
CONFIG_CHT_WC_PMIC_OPREGION=y
CONFIG_CHT_DC_TI_PMIC_OPREGION=y
CONFIG_TPS68470_PMIC_OPREGION=y
CONFIG_ACPI_VIOT=y
CONFIG_CPU_FREQ_GOV_COMMON=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_X86_ACPI_CPUFREQ_CPB=y

#
# Modules
#
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULES_TREE_LOOKUP=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_MODULE_ALLOW_MISSING_NAMESPACE_IMPORTS=y

#
# Rendering (Basic) / TTY Terminal
#
CONFIG_TTY=y
CONFIG_VGA_CONSOLE=y
CONFIG_NULL_TTY=y

CONFIG_FB_DEVICE=y
CONFIG_FB_VGA16=y
CONFIG_FB_VESA=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_KVM=y
CONFIG_FB_MODE_HELPERS=y
