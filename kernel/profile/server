#
# Console/server image with no Canvas code
#
# This is the hard build boundary: compositor C, fill/glyph assembly, window
# ioctls, input stack and DRM probing are absent from Moonwater core. Spark,
# the shell/coreutils image, PID 1 supervision, DHCP/link watching and ordinary
# serial/virtual/framebuffer consoles remain.
#
# Compose this last:
#
#   sh build.sh arch/x64 debug_none limbo desktop serial server
#
#> overrides CONFIG_MOONWATER_CANVAS
CONFIG_MOONWATER_CANVAS=n

# The gpu profile's Canvas-first command line must not leave a local server
# console blank. A bootloader may still choose serial, netconsole or another
# console explicitly.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
#> cmdline -drm_client_lib.active=

#
# Game controllers are off. /dev/uinput lets a program put events into the
# machine, and a joystick node reads a pad: the desktop profile turns both
# on, and this tier does not run games. See profile/desktop.
#> overrides CONFIG_INPUT_UINPUT CONFIG_INPUT_JOYDEV CONFIG_MOONWATER_INPUT_GROUP
CONFIG_INPUT_UINPUT=n
CONFIG_INPUT_JOYDEV=n
CONFIG_MOONWATER_INPUT_GROUP=n

# Servers may exceed the desktop's single-word cpumask limit.
#> overrides CONFIG_NR_CPUS
CONFIG_NR_CPUS=128
