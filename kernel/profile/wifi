#
# Compose it with desktop (the default image already does):
#
#       sudo sh build.sh arch/x64 debug_none limbo desktop wifi serial
#
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=n
# Not a choice this profile has: the option has no prompt without
# CFG80211_CERTIFICATION_ONUS and is y by default, so the n that stood here was
# dropped and the kernel has always required the signature. It says what is.
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_MAC80211=y
#> overrides CONFIG_MAC80211_MESH
CONFIG_MAC80211_MESH=n
CONFIG_RFKILL=y

CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_PCI=y
CONFIG_RTW88_8822C=y
CONFIG_RTW88_8822CE=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT76_CONNAC_LIB=y
CONFIG_MT792x_LIB=y
CONFIG_MT7921_COMMON=y
CONFIG_MT7921E=y

#
# Bluetooth for pads (moonwater bluetooth pair, src/sh/host/bluetooth.c):
# HIDP carries a classic pad's reports to its driver in the kernel, and an LE
# pad's come through uhid (UHID, the desktop profile's). btusb selects Intel's
# and Broadcom's protocol code by itself, so they are said as what is built;
# Realtek's and MediaTek's are asked for. Autosuspend stays off: a suspended
# radio wakes late for a pad's first report (the desktop's
# usbcore.autosuspend=-1 says the same for every device).
#
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_INTEL=y
CONFIG_BT_BCM=y
CONFIG_BT_QCA=n
CONFIG_BT_MTK=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=n
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_RTL=y
CONFIG_BT_HIDP=y
