#
# Security tier: hardened
#
# Everything built, and STRICT=2: refuse where the default sanitises, and
# tighten what a careful operator would want tightened even though ordinary
# use never arrives there. A script that meets one of those refusals was
# meant to. See sec_default for the tiers and how to pick one.
#
#   sh build.sh debug_none limbo desktop wifi serial sec_hardened
#

CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_INTEGRITY=n

CONFIG_MOONWATER_STRICT=2

#
# Floodlight: the denials the default refused before 2026-09-28 (awk
# starting programs, script and setarch starting a shell), every
# dangerous-flag switch off, and the policy sealed at boot so no later
# line to /dev/floodlight loosens it. Each switch's help in
# src/moonwater/Kconfig names the exploit class it closes.
#
CONFIG_MOONWATER_FLOODLIGHT_POLICY="awk spawn deny; script spawn deny; setarch spawn deny"
CONFIG_MOONWATER_FLOODLIGHT_SEAL=y
CONFIG_MOONWATER_FLOODLIGHT_AWK_SPAWN=n
CONFIG_MOONWATER_FLOODLIGHT_SHELL_ESCAPES=n
CONFIG_MOONWATER_FLOODLIGHT_FIND_EXEC=n
CONFIG_MOONWATER_FLOODLIGHT_FIND_DELETE=n
CONFIG_MOONWATER_FLOODLIGHT_FIND_WRITE=n
CONFIG_MOONWATER_FLOODLIGHT_XARGS=n
CONFIG_MOONWATER_FLOODLIGHT_SPLIT_FILTER=n
CONFIG_MOONWATER_FLOODLIGHT_SORT_COMPRESS=n
CONFIG_MOONWATER_FLOODLIGHT_ENV_SPLIT=n
CONFIG_MOONWATER_FLOODLIGHT_LAUNCHERS=n
CONFIG_MOONWATER_FLOODLIGHT_NAMESPACES=n
CONFIG_MOONWATER_FLOODLIGHT_NETWORK_FETCH=n
