#!/bin/sh
#
#       Run the suite where the reference tools are.
#
#           sh test/onbox <name> [lane ...]      run lanes for this working copy
#
#       This tree is developed on a Mac and compared against GNU coreutils and
#       dash, which are not on a Mac: BSD's head, sed and sort answer different
#       questions and comparing against them proves the wrong thing. So the
#       working copy is copied to the build machine and the lanes run there.
#
#       <name> is this working copy's own directory on that machine, so two
#       people -- or two agents -- working at once do not overwrite each other.
#
set -u

[ "$#" -ge 1 ] || { echo "onbox: needs a name for this working copy" >&2; exit 1; }

name=$1
shift

case "$name" in
        *[!A-Za-z0-9_.-]*|"")
                echo "onbox: the name uses only letters, digits, dot, dash and underscore" >&2
                exit 1 ;;
esac

host=${MOONWATER_BUILD_HOST:-box}

# A host is a word of ssh's and rsync's command lines, where one that begins
# with a dash is an option (-oProxyCommand=CMD runs CMD here): no name is that.
case $host in
-* | *[[:space:][:cntrl:]]*)
        echo "onbox: not a machine to build on: $host" >&2
        exit 1 ;;
esac

remote="dawning-$name"

# shellcheck disable=SC1007
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$here/src/build/host.sh"

rsync -az --delete \
      --exclude '.git' --exclude '.claude' --exclude 'dist' --exclude 'linux' --exclude 'artifacts' \
      --exclude 'fs' --exclude '*.o' \
      "$here/" "$host:~/$remote/" || {
        echo "onbox: could not copy to $host" >&2
        exit 1
}

# TMPDIR inside the copy, because /tmp on that machine has a per user quota
# and a build that cannot write its assembly file fails in a way that reads
# like a test failure rather than like a full disk.
# shellcheck disable=SC2029
lanes=""
for lane in "$@"; do lanes="$lanes $(shell_quote "$lane")"; done
ssh "$host" "cd ~/$remote && mkdir -p scratch && TMPDIR=\$PWD/scratch sh test/run$lanes"
