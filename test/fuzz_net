#!/bin/sh
#
#       Continuous / longer local fuzz for the TLS net parsers, plus an
#       optional machine-readable release attach.
#
#           sh test/fuzz_net
#               Continuous local run: defaults one hour / unbounded run count.
#               Override with MOONWATER_FUZZ_RUNS / MOONWATER_FUZZ_SECONDS.
#
#           sh test/fuzz_net --report [OUT]
#               Run tls_der_fuzz then tls_hs_fuzz and emit a machine-readable
#               summary (stdout always; also written to OUT, default
#               artifacts/fuzz-report.txt). Budget defaults to the same short
#               lane_net smoke (20000 runs / 5s) unless MOONWATER_FUZZ_* is
#               already set — so a release attach is quick and matches lane
#               smoke. For longer evidence:
#                   MOONWATER_FUZZ_SECONDS=3600 sh test/fuzz_net --report
#
#       Deeper-than-smoke local campaign (still short of a full hour):
#                   MOONWATER_FUZZ_SECONDS=120 MOONWATER_FUZZ_RUNS=200000 \
#                       sh test/fuzz_net --report
#               or: sh test/fuzz_campaign
#
#       lane_net keeps the bounded smoke only; this entry point does not
#       change that. Coverage here means seed inventory + ASan/UBSan
#       libFuzzer clean completion under the recorded budget — not LLVM
#       source-coverage percentages.
#
#       Seed *.bin files are gitignored; materialize from
#       test/fuzz_corpus/generate_seeds.py before counting/running. Attach
#       generate_seeds.py (or a generated tarball) with the report — see
#       SECURITY_CHECKLIST.md / SECURITY_TEST_MATRIX.md /
#       test/fuzz_corpus/README.md.
#
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd -- "$root"

python3 test/fuzz_corpus/generate_seeds.py >/dev/null

mode=run
out=
case "${1:-}" in
--report)
        mode=report
        out=${2:-artifacts/fuzz-report.txt}
        ;;
'' )
        ;;
*)
        echo "usage: sh test/fuzz_net [--report [OUT]]" >&2
        exit 2
        ;;
esac

if [ "$mode" = report ]; then
        # Smoke budget unless the caller already chose continuous knobs.
        : "${MOONWATER_FUZZ_RUNS:=20000}"
        : "${MOONWATER_FUZZ_SECONDS:=5}"
else
        # -1 runs = unbounded by count; time is the primary stop.
        : "${MOONWATER_FUZZ_RUNS:=-1}"
        : "${MOONWATER_FUZZ_SECONDS:=3600}"
fi
export MOONWATER_FUZZ_RUNS MOONWATER_FUZZ_SECONDS

count_seeds() {
        dir=$1
        if [ ! -d "$dir" ]; then
                echo 0
                return
        fi
        # Only materialized *.bin seeds (ignore stray README/pyc).
        find "$dir" -type f -name '*.bin' ! -name '.*' | wc -l | tr -d ' '
}

clang_bin=$(command -v clang || true)
if [ -n "$clang_bin" ]; then
        clang_version=$("$clang_bin" --version 2>/dev/null | head -n 1)
else
        clang_version='(no clang)'
fi

git_commit=$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)
host_system=$(uname -s)
host_arch=$(uname -m)
der_seeds=$(count_seeds test/fuzz_corpus/tls_der)
hs_seeds=$(count_seeds test/fuzz_corpus/tls_hs)

echo "fuzz_net: der then hs then verify (runs=$MOONWATER_FUZZ_RUNS seconds=$MOONWATER_FUZZ_SECONDS)"

# Harness chatter stays on this process's stdout/stderr; only the status
# triple (name exit duration) is captured from the helper's stdout.
run_harness() {
        name=$1
        started=$(date +%s)
        set +e
        python3 test/differential.py --harness "$name" >&2
        exit_code=$?
        set -e
        ended=$(date +%s)
        duration=$((ended - started))
        printf '%s %s %s\n' "$name" "$exit_code" "$duration"
}

der_line=$(run_harness tls_der_fuzz)
hs_line=$(run_harness tls_hs_fuzz)
verify_line=$(run_harness tls_verify_fuzz)

der_exit=${der_line#* }
der_exit=${der_exit%% *}
der_duration=${der_line##* }
hs_exit=${hs_line#* }
hs_exit=${hs_exit%% *}
hs_duration=${hs_line##* }
verify_exit=${verify_line#* }
verify_exit=${verify_exit%% *}
verify_duration=${verify_line##* }
# Overall: hard fail (1) wins; else NOT RUN (2) if any skipped; else 0.
overall=0
for code in "$der_exit" "$hs_exit" "$verify_exit"; do
        if [ "$code" = 1 ]; then
                overall=1
                break
        fi
        if [ "$code" = 2 ] && [ "$overall" = 0 ]; then
                overall=2
        fi
done

if [ "$mode" = run ]; then
        exit "$overall"
fi

# --report: emit JSON (python for portable encoding).
report=$(MOONWATER_FUZZ_RUNS="$MOONWATER_FUZZ_RUNS" \
        MOONWATER_FUZZ_SECONDS="$MOONWATER_FUZZ_SECONDS" \
        REPORT_GIT="$git_commit" \
        REPORT_HOST_SYSTEM="$host_system" \
        REPORT_HOST_ARCH="$host_arch" \
        REPORT_CLANG_BIN="$clang_bin" \
        REPORT_CLANG_VERSION="$clang_version" \
        REPORT_DER_SEEDS="$der_seeds" \
        REPORT_HS_SEEDS="$hs_seeds" \
        REPORT_DER_EXIT="$der_exit" \
        REPORT_DER_DURATION="$der_duration" \
        REPORT_HS_EXIT="$hs_exit" \
        REPORT_HS_DURATION="$hs_duration" \
        REPORT_VERIFY_EXIT="$verify_exit" \
        REPORT_VERIFY_DURATION="$verify_duration" \
        REPORT_OVERALL="$overall" \
        python3 - <<'PY'
import json, os, time

def i(name):
    return int(os.environ[name])

report = {
    "schema": "moonwater.fuzz_report.v1",
    "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "git_commit": os.environ["REPORT_GIT"],
    "host": {
        "system": os.environ["REPORT_HOST_SYSTEM"],
        "arch": os.environ["REPORT_HOST_ARCH"],
    },
    "sanitizer": {
        "clang": os.environ["REPORT_CLANG_BIN"] or None,
        "version": os.environ["REPORT_CLANG_VERSION"],
        "flags": "-fsanitize=fuzzer,address,undefined",
        "note": (
            "Harness builds with ASan+UBSan+libFuzzer when clang links "
            "libclang_rt.fuzzer; otherwise targets exit 2 (NOT RUN)."
        ),
    },
    "corpora": {
        "tls_der": {
            "path": "test/fuzz_corpus/tls_der",
            "seed_count": i("REPORT_DER_SEEDS"),
        },
        "tls_hs": {
            "path": "test/fuzz_corpus/tls_hs",
            "seed_count": i("REPORT_HS_SEEDS"),
        },
    },
    "budget": {
        "runs": i("MOONWATER_FUZZ_RUNS"),
        "seconds": i("MOONWATER_FUZZ_SECONDS"),
    },
    "targets": [
        {
            "name": "tls_der_fuzz",
            "seeds": i("REPORT_DER_SEEDS"),
            "runs": i("MOONWATER_FUZZ_RUNS"),
            "max_total_time_seconds": i("MOONWATER_FUZZ_SECONDS"),
            "duration_seconds": i("REPORT_DER_DURATION"),
            "exit": i("REPORT_DER_EXIT"),
        },
        {
            "name": "tls_hs_fuzz",
            "seeds": i("REPORT_HS_SEEDS"),
            "runs": i("MOONWATER_FUZZ_RUNS"),
            "max_total_time_seconds": i("MOONWATER_FUZZ_SECONDS"),
            "duration_seconds": i("REPORT_HS_DURATION"),
            "exit": i("REPORT_HS_EXIT"),
        },
        {
            "name": "tls_verify_fuzz",
            "seeds": i("REPORT_DER_SEEDS"),
            "runs": i("MOONWATER_FUZZ_RUNS"),
            "max_total_time_seconds": i("MOONWATER_FUZZ_SECONDS"),
            "duration_seconds": i("REPORT_VERIFY_DURATION"),
            "exit": i("REPORT_VERIFY_EXIT"),
            "note": "parse/policy + production tls_verify_one; WR2/GTS prove; not lane_net smoke",
        },
    ],
    "coverage_note": (
        "Seed inventory plus ASan/UBSan libFuzzer completion under the "
        "recorded budget. Not LLVM source-line coverage. Attach this file "
        "and test/fuzz_corpus/generate_seeds.py (hex source of truth; "
        "*.bin is gitignored) or a tarball of materialized seeds."
    ),
    "overall_exit": i("REPORT_OVERALL"),
}
print(json.dumps(report, indent=2, sort_keys=False))
PY
)

printf '%s\n' "$report"
# Tree may be read-only (e.g. Lima shared mount). Prefer the caller OUT;
# fall back to TMPDIR so a failed write never confuses harness overall_exit.
wrote=
outdir=$(dirname -- "$out")
if [ "$outdir" != . ]; then
        mkdir -p -- "$outdir" 2>/dev/null || true
fi
# Probe creatability first so a RO mount does not spam a shell redirect error.
if : >"$out" 2>/dev/null; then
        printf '%s\n' "$report" >"$out"
        wrote=$out
        echo "fuzz_net: wrote $out" >&2
else
        fallback=${TMPDIR:-/tmp}/moonwater-fuzz-report.txt
        if printf '%s\n' "$report" >"$fallback"; then
                wrote=$fallback
                echo "fuzz_net: could not write $out (read-only?); wrote $wrote" >&2
        else
                echo "fuzz_net: could not write $out or $fallback; stdout only" >&2
        fi
fi

exit "$overall"
