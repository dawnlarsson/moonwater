                printf 'trace baseline\n' > "$work/history-regression/close"
                timeout 10 strace -qq -yy \
                        -o "$work/history-regression/close.trace" \
                        -e trace=close \
                        "$history_shell" -c "$history_command" history \
                        "$work/history-regression/close" \
                        > /dev/null 2>&1
                history_trace_status=$?
                history_close_when=$(awk '
/^close\(/ { count++ }
/\.moonwater-stage-/ { print count; exit }
' "$work/history-regression/close.trace")

                printf 'close preserved\n' > "$work/history-regression/close"
                if [ "$history_trace_status" = 0 ] &&
                        [ -n "$history_close_when" ]; then
                        timeout 10 strace -qq -yy \
                                -o "$work/history-regression/close-injected.trace" \
                                -e trace=close \
                                -e "inject=close:error=EIO:when=$history_close_when" \
                                "$history_shell" -c "$history_command" history \
