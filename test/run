f=/mnt/EFI/BOOT/BOOTX64.EFI
pe=$(od -An -tu4 -j60 -N4 $f | tr -d ' ')
sections=$(od -An -tu2 -j$((pe + 6)) -N2 $f | tr -d ' ')
table=$((pe + 24 + $(od -An -tu2 -j$((pe + 20)) -N2 $f | tr -d ' ')))
i=0
while [ $i -lt $sections ]; do [ "$(dd if=$f bs=1 skip=$((table + 40 * i)) count=6 2> /dev/null)" = .mwset ] && raw=$(od -An -tu4 -j$((table + 40 * i + 20)) -N4 $f | tr -d ' '); i=$((i + 1)); done
printf '\377\377\377\377' | dd of=$f bs=1 seek=$((raw + 44)) conv=notrunc 2> /dev/null
printf '\377\377\377\377' | dd of=$f bs=1 seek=$((raw + 16384 + 44)) conv=notrunc 2> /dev/null
cp $f /tmp/before
dd if=/dev/zero of=/mnt/fill bs=1M 2> /dev/null
umount /mnt
moonwater setup update nvme0n1 > /tmp/upd 2>&1
printf 'damaged-%s\n' $(( $(grep -c 'settings slots on nvme0n1 are damaged' /tmp/upd) * 7 ))
mount -t vfat /dev/nvme0n1p1 /mnt
cmp $f /tmp/before > /dev/null 2>&1
printf 'full-kept-%s\n' $(( $? + 30 ))
printf 'leftover-%s\n' $(( $(ls /mnt/EFI/BOOT /mnt/EFI/moonwater | grep -c -i '\.new$') + 30 ))
