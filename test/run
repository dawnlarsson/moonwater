#!/bin/sh
#
#       Every test in the tree, in one order, and every benchmark beside it.
#
#           sh test/run                 every lane this machine can run
#           sh test/run shell text      only the lanes named
#           sh test/run -j 16           the same, up to 16 lanes at once
#           sh test/run --list          what the lanes are
#
#           sh test/run bench           every benchmark
#           sh test/run bench floor     only the benchmarks named
#           sh test/run bench --list    what the benchmarks are
#
#       Two modes, one command. Tests assert and count; benchmarks measure and
#       report. Neither runs the other: bench is the first word or it is not
#       bench mode, and no lane below builds a benchmark. What used to be
#       kit/bench and the drivers beside it is the section before the walk at
#       the end of this file.
#
#       The suites used to be eight places with four ways of starting them,
#       and the ones that needed a binary built first were started by hand or
#       not at all. Everything a lane needs -- the freestanding link, the
#       shell, all utility names pointing at it -- is built here, once, and
#       handed over.
#
#       A lane is a function named lane_<name>. It prints its own counts
#       through tally and returns non-zero when something failed, and this
#       walks the list and adds up. Nothing is skipped silently: a lane that
#       cannot run here says so and says why.
#
set -u

#       A run started in the background of a non-interactive shell -- the
#       usual `nohup sh test/run &` -- begins with SIGINT and SIGQUIT
#       ignored, and POSIX has every shell below keep them so. The signal
#       checks then read what they are there to catch: a job that Ctrl+C
#       cannot stop. So the run starts over with both at their defaults.
if [ -z "${TEST_SIGNALS_RESET:-}" ] && [ -r "/proc/$$/status" ] &&
        env --default-signal=INT true 2>/dev/null; then
        ignored=$(awk '$1 == "SigIgn:" { print $2 }' "/proc/$$/status")
        if [ -n "$ignored" ] && [ $((0x$ignored & 6)) -ne 0 ]; then
                TEST_SIGNALS_RESET=1
                export TEST_SIGNALS_RESET
                exec env --default-signal=INT,QUIT sh "$0" "$@"
        fi
fi

# shellcheck disable=SC1007
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
root=$(CDPATH= cd -- "$here/.." && pwd)

cd "$root" || exit 1

compiler=${CC:-gcc}
build_label=

host_system=$(uname -s)
case $(uname -m) in
x86_64 | amd64) host_arch=x86_64 ;;
arm64 | aarch64) host_arch=arm64 ;;
riscv64)         host_arch=riscv64 ;;
*)               host_arch=unknown ;;
esac

#       A lane started by `run -j` works in its parent's directory: the
#       shell, the farms and the tally are built there once and shared, and
#       the parent removes it.
if [ -n "${TEST_SHARED_WORK:-}" ]; then
        work=$TEST_SHARED_WORK
else
        work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-test.XXXXXX") || exit 1
        trap 'rm -rf "$work"' EXIT INT TERM
fi

#       Every lane makes its own directory with mktemp, and a lane that is
#       killed never reaches its trap. Nested under this one, whatever a lane
#       leaves behind goes when this run's trap runs, and a run that was
#       itself killed leaves one directory to remove rather than hundreds.
TMPDIR=$work
export TMPDIR

TEST_TALLY="$work/tally"
export TEST_TALLY
[ -n "${TEST_SHARED_WORK:-}" ] || : > "$TEST_TALLY"

#       Lanes run only when named, because they need something a plain run
#       does not have: wifi wants an image built with kernel/profile/hwsim,
#       fuzz an hour a target, msan a clang with MemorySanitizer, ring0 an
#       image and a machine that boots it, best one built with
#       kernel/profile/sec_sanitize.
asked_lanes="wifi fuzz msan ring0 scale desktop chrome"

lanes="standard declare fold allocator reserve utf8 hex codec fixed table error strings stdlib leaving numbers clock math format scan stream spool process signal lock verify exact text_asm shell_asm known socket net waterlink link netem bowl tar zstd gzip xz compression_floor compression reuse_shell audit regex slurp wait writer native probe stack checksum storage_io storage_format machine sensors cli differential_oracle text files misc util_linux shell builtins awk term edit kit switches boot install canvas sleep"

describe()
{
        case $1 in
        standard) echo "the standard library, and that it still builds with no platform under it" ;;
        verify)   echo "the assembly in lib.c against the C it replaced, on three machines" ;;
        exact)    echo "every size that is known where the call is written, and both tiers" ;;
        text_asm) echo "text.c's own assembly against its C, on three machines" ;;
        shell_asm) echo "the shell's own assembly against its C, on three machines" ;;
        known)    echo "the rest of what folds when the call site knows it" ;;
        declare)  echo "the standard names, declared, compiled twice and diffed" ;;
        fold)     echo "the constant-size fold we put in the kernel string header" ;;
        allocator) echo "malloc, free, calloc and realloc against glibc's" ;;
        reserve) echo "movable mappings, growth failures, relocation and sparse-page residency" ;;
        link) echo "moonwater link end to end between two network namespaces: run, shell over a pty, netem loss, refusals, rekeys, on and off" ;;
        netem) echo "the DHCP and SNTP clients against a hostile server over a veth pair with netem loss, duplication, reordering and delay (NOT RUN without unprivileged namespaces, veth and netem)" ;;
        waterlink) echo "the waterlink core as a pure transform: supersession, reliable per-key delivery and congestion over a generated lossy network, the seal, the Noise IK handshake against a reference, and the replay window" ;;
        utf8) echo "bounded UTF-8 character traversal, malformed bytes and guard pages on three machines" ;;
        hex) echo "bounded hexadecimal encoding, alignment and guard pages on three machines" ;;
        codec) echo "bounded radix codecs, malformed symbols and exact spans on three machines" ;;
        fixed) echo "exact decimal records, rounding and bounded batches on three machines" ;;
        bowl) echo "Bowl root, launcher parsing, and Pacman isolation keywords" ;;
        tar) echo "tar checksums, paths, compression magics and pax records" ;;
        zstd) echo "RFC 8878 encode/decode, literal codebooks, frames and checksums" ;;
        gzip) echo "RFC 1952 members around RFC 1951 deflate, encode and decode" ;;
        xz) echo "xz stream and LZMA2 encode and decode" ;;
        compression_floor) echo "codec assembly kernels, boundary states and guard pages on three machines" ;;
        compression) echo "gzip/xz/zstd and a tar member×codec grammar against the system tools" ;;
        audit) echo "the verified builtin repairs, as pure-state regressions" ;;
        regex) echo "fixed-graph searches against their VM fallback, with captures and resource limits on three machines" ;;
        reuse_shell) echo "shared utility formatting, bounded sinks and skip edge policies" ;;
        table) echo "shared table escaping, field widths and multiline boundaries on three machines" ;;
        leaving)  echo "what a program writes on the way out, and what a child must not write twice" ;;
        numbers)  echo "strtod and the integer conversions, in ULP against glibc" ;;
        scan)     echo "scanf's conversions, every one against glibc" ;;
        spool)    echo "the rest of <stdio.h> -- mkstemp, tmpfile, popen" ;;
        process)  echo "directories, exec, sleeping, getopt and realpath" ;;
        signal)   echo "handlers, masks, the return trampoline, and sigsetjmp" ;;
        lock)     echo "a futex lock, two real threads, and what it costs uncontended" ;;
        error)    echo "errno, strerror and the POSIX wrappers that set it" ;;
        strings)  echo "strdup, strtok, strsep and the non-local jump" ;;
        stdlib)   echo "exit, atexit, getenv, qsort and bsearch" ;;
        clock)    echo "the calendar, and strftime, against glibc's" ;;
        math)     echo "pow, exp, log and the trig, measured in ULP" ;;
        format)   echo "printf's conversions, every one against glibc" ;;
        stream)   echo "<stdio.h>'s FILE against glibc's, on three machines" ;;
        socket)   echo "byte order against a reference, and real sockets on three machines" ;;
        net)      echo "the netlink wire, ip against the kernel, and TLS ClientHello groups" ;;
        slurp)    echo "bounded file reads and forced EINTR at open and read, on three machines" ;;
        wait)     echo "wait4 arguments, statuses and forced EINTR retry, on three machines" ;;
        writer)   echo "buffer boundaries, direct policy and write ordering, on three machines" ;;
        native)   echo "arm64 assembly on an arm64 machine, with no emulator in the way" ;;
        probe)    echo "what only a separate process can prove: arguments, status, regions" ;;
        stack)    echo "what each function puts on the stack, and what a deep walk costs" ;;
        differential_oracle) echo "the differential engine's own checks: comparison, covering arrays, ledger and shrinking" ;;
        text)     echo "the text utilities against GNU coreutils, every option combination the grammar reaches, and tr's threaded pieces on one processor and on all" ;;
        files)    echo "the file utilities against coreutils, by output and by effect on the directory" ;;
        misc)     echo "the utilities that are neither text nor files -- dd, diff, ps, the checksums, the process wrappers -- against the system's own" ;;
        util_linux) echo "the util-linux programs against util-linux, mount tables and block identities included" ;;
        shell)    echo "the shell language and its personalities against dash and bash, from generated programs" ;;
        builtins) echo "the commands the shell runs without leaving itself, and the expansions, against bash and dash" ;;
        awk)      echo "awk against the one on the machine, from generated programs" ;;
        checksum) echo "the cksum CRC against a bitwise model, in every mode, on three machines" ;;
        storage_io) echo "positional-read retries, exact bounds, zero padding and ELF table handoff" ;;
        storage_format) echo "GPT, FAT32 and ext4 as an install writes them, checked by sfdisk and e2fsck" ;;
        machine) echo "the machine script: hooks, functions, case arms, overlay lines and file policy" ;;
        sensors) echo "monitor's clocks, temperatures, fans, power and battery against generated sysfs trees" ;;
        cli)      echo "the moonwater command in a namespace: every verb, every zone it names, what it writes" ;;
        term)     echo "the emulator driven a byte and a read at a time, and the line being edited" ;;
        edit)     echo "the full-screen editor, its key protocol, buffer, undo and redraws" ;;
        kit)      echo "build, source-inventory, remote-host and firmware tooling" ;;
        switches) echo "a .config reaching the programs: what a switch turns off is not built, not linked and not found" ;;
        boot)     echo "the image boots, init starts, and the shell answers" ;;
        install)  echo "Moonwater installed to a disk, started from it, asked about and updated from a stick" ;;
        canvas)   echo "what is actually on the screen, read back a pixel at a time" ;;
        sleep)    echo "moonwater sleep from a terminal, woken by a key: the desktop back on a card that lost its pipe, input alive, the log" ;;
        desktop)  echo "a compositor's input in a booted guest: Alpine's libinput over a bowl's udev, keys and a pointer reaching it (NOT RUN without a network, an image or mke2fs)" ;;
        chrome)   echo "a browser that will not run as root, from Debian's package in a booted guest: who a bowl's programs are, and Chromium's sandbox on (NOT RUN without a network, an image or mke2fs)" ;;
        wifi)     echo "networks in the air of a machine with simulated radios, joined and listed" ;;
        fuzz)     echo "every network libFuzzer target for an hour each, or a release report" ;;
        msan)     echo "the net wire parsers under MemorySanitizer" ;;
        ring0)    echo "a hostile program's windows, ioctls, images and log lines against a booted kernel, and what its sanitizers say" ;;
        scale)    echo "every tool against the host's own from a kilobyte to a gigabyte and from one entry to a million: a loss, a cliff, a refusal or a super-linear step fails (NOT RUN off Linux or without the host tools)" ;;
        esac
}

tally()
{
        printf '%s %s %s\n' "$1" "$2" "$3" >> "$TEST_TALLY"
}

note()
{
        printf '  %s\n' "$*"
}

#       One check counted once: run the test, then call this on its status.
#       The message is a single-quoted string that is expanded only when the
#       check failed, so it may read what the failure left behind; VAR, or -
#       for none, is set to 1 on a failure.
verdict()
{
        verdict_status=$?
        if [ "$verdict_status" = 0 ]; then
                tally "$1" 1 1
        else
                tally "$1" 0 1
                [ -z "${3:-}" ] || eval "note \"$3\""
                [ "$2" = - ] || eval "$2=1"
        fi
}

#       Section and failure accounting shared by the shell-driven lanes. A
#       lane sets the counters up before its first section; section writes
#       each finished section's count to the tally the verdict is added up
#       from.
section()
{
        [ -z "$section_name" ] ||
                printf '  %-12s %s of %s\n' \
                        "$section_name" "$section_pass" "$section_total"

        [ -z "$section_name" ] || [ -z "${TEST_TALLY:-}" ] ||
                printf '%s %s %s\n' \
                        "$section_name" "$section_pass" "$section_total" \
                        >> "$TEST_TALLY"

        section_name=${1:-}
        section_pass=0
        section_total=0
}

group() { current=$1; }

won()
{
        pass=$((pass + 1))
        section_pass=$((section_pass + 1))
        section_total=$((section_total + 1))
}

lost()
{
        fail=$((fail + 1))
        section_total=$((section_total + 1))
        printf '  %-*s %-*s %s\n' \
                "$test_group_width" "$current" \
                "$test_case_width" "$1" "$2"
}

same()
{
        if [ "$2" = "$3" ]; then
                won
        else
                lost "$1" "want [$2] got [$3]"
        fi
}

#       A lane counted in one piece starts here, with the name its count goes
#       into the tally under and the widths of a failure line, and ends with
#       counted: the count printed and tallied, then failed before not run
#       before passed.
counting()
{
        pass=0
        fail=0
        current=$1
        section_name=$1
        section_pass=0
        section_total=0
        test_group_width=${2:-12}
        test_case_width=${3:-24}
}

counted()
{
        section
        [ "$fail" = 0 ] || return 1
        return "${1:-0}"
}

#       What a console transcript in $work said, and what it must never have.
says()
{
        if grep -q -F -- "$3" "$work/$1"; then
                won
        else
                lost "$2" "no $3 in $1"
        fi
}

#       The same, for a line the program wrote and the kernel's own lines
#       cut in two: the serial console moves a write 64 bytes at a time and
#       a printk goes out between the pieces (`...installed from another[
#       0.927214] ip: using eth0` and then ` build.`), at a moment that
#       depends on how fast the guest boots. The kernel's lines are taken
#       out first, which is the one thing that makes the program's line one
#       again.
says_whole()
{
        if perl -0pe 's/\[ *[0-9]+\.[0-9]+\][^\n]*\n//g' "$work/$1" | grep -q -F -- "$3"; then
                won
        else
                lost "$2" "no $3 in $1, whole"
        fi
}

never()
{
        if grep -q -F -- "$3" "$work/$1"; then
                lost "$2" "$3 is in $1"
        else
                won
        fi
}

#       The link a spark program gets, which is what lib.c ships inside.
#       Without the script the placement is the toolchain's default, and
#       riscv64 does not survive that. -flto is not here on purpose: the
#       assembly in lib.c calls C functions by name and the link time
#       optimiser cannot see a call written inside a string, so it drops the
#       callee and the link fails.
#       Coverage. `sh test/run coverage DIR lane...` runs the lanes with
#       MOONWATER_COVERAGE=DIR, and every freestanding binary they build --
#       the shell and its farm, each C check, the term and edit fixtures --
#       starts each basic block with a call into COVERAGE_hook in checks.c,
#       which marks the block in DIR/<binary>.XXXXXX.map, a record every
#       process that binary becomes shares. A copy of the binary goes beside
#       it as .elf, and `differential.py --harness coverage_report DIR` reads
#       the two into blocks, lines and functions reached per source file.
#       x86_64 only; any other architecture builds as it always does.
coverage_args=""
coverage_stem=""

coverage_build()
{
        coverage_args=""
        coverage_stem=""
        [ -n "${MOONWATER_COVERAGE:-}" ] && [ "$1" = x86_64 ] || return 0
        coverage_stem=$(mktemp "$MOONWATER_COVERAGE/$(basename "$2").XXXXXX") ||
                return 1
        truncate -s 64M "$coverage_stem.map" || return 1
        $compiler -O2 -c -march=x86-64 -fno-stack-protector -fno-builtin \
                "-DCOVERAGE_PATH=\"$coverage_stem.map\"" -DCOVERAGE_hook \
                test/checks.c -o "$coverage_stem.o" || return 1
        coverage_args="-g -fsanitize-coverage=trace-pc $coverage_stem.o"
}

coverage_keep()
{
        [ -z "$coverage_stem" ] || cp "$1" "$coverage_stem.elf"
}

#       The guest half. An image built with kernel/profile/coverage records
#       what its /shell reached into /coverage.map on the guest's own root,
#       against dist/shell.coverage.elf beside the image -- install, boot,
#       settings, PID 1, the terminal applet and the monitor run nowhere
#       else. A lane that boots such an image under MOONWATER_COVERAGE calls
#       coverage_guest with the image and a work file: the machine then gets
#       a second UART ($coverage_serial, placed after the console's so the
#       console stays ttyS0), coverage_guest_commands makes the machine's
#       last act before poweroff to write the record there, gzipped and in
#       base64, and coverage_guest_collect puts it and a copy of the ELF into
#       the coverage directory as one more binary for the report. A record
#       that arrives cut is said and set aside, never read as blocks missed.
coverage_serial=""
coverage_guest_elf=""
#       The same three lines as the image's /coverage-dump, typed rather
#       than sourced: the boot lane ends with floodlight refusing /shell
#       run, and a script read as a parser source is refused under it too.
coverage_dump='echo begin | base64 > /dev/ttyS1; head -c 16777216 /coverage.map | gzip -c | base64 > /dev/ttyS1; echo ok | base64 > /dev/ttyS1'

coverage_guest()
{
        coverage_serial=""
        coverage_guest_elf=""
        [ -n "${MOONWATER_COVERAGE:-}" ] || return 0
        [ -f "$(dirname "$1")/shell.coverage.elf" ] || return 0
        coverage_guest_elf=$(dirname "$1")/shell.coverage.elf
        coverage_serial="-serial file:$2"
}

#       The driver the canvas, plane and power guests share: qemu started with
#       its QMP and monitor sockets, and the keys, pointer and screen it is
#       driven and read through. Written where the lane's work is, and found
#       through PYTHONPATH.
qmp_guest_module()
{
        cat > "$1/qmp_guest.py" <<'PY'
import json, os, socket, subprocess, time

#       The guest's screen: seventy percent of the preferred mode, so the EDID
#       has to prefer 3658x1543. QEMU's default EDID gives 640x480, where the
#       log fills the width and no window is found.
W, H = 2560, 1080
current = None

def desktop(image):
    """The machine every compositor guest starts from, as qemu arguments."""
    processor = ["-cpu", "Nehalem"]
    if os.access("/dev/kvm", os.R_OK | os.W_OK):
        # The floor is covered by boot.sh. Here the widest host path matters:
        # compositor copies to a trapped device mapping have failed only when
        # a real processor selected the AVX-512 body that KVM then had to
        # emulate.
        processor = ["-cpu", "host", "-enable-kvm"]
    return ["qemu-system-x86_64", "-m", "2G", "-smp", "2"] + processor + [
        "-kernel", image, "-vga", "none", "-device", "virtio-gpu-pci,xres=3658,yres=1543",
        "-device", "qemu-xhci", "-device", "usb-tablet", "-device", "usb-kbd"]

class Guest(subprocess.Popen):
    """A qemu with its QMP socket and, if it has one, its human monitor; the newest is the one the functions below drive."""

    def __init__(self, arguments, qmp, mon=None, work=None, sockets=(), wait=0.2):
        global current
        arguments = arguments + ["-qmp", "unix:" + qmp + ",server,nowait"]
        if mon:
            arguments += ["-monitor", "unix:" + mon + ",server,nowait"]
        super().__init__(arguments, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.work = work
        for _ in range(200):
            if all(os.path.exists(path) for path in (qmp, mon or qmp) + tuple(sockets)):
                break
            time.sleep(wait)
        self.qmp = socket.socket(socket.AF_UNIX)
        self.qmp.connect(qmp)
        self.qmp.settimeout(20)
        self.qf = self.qmp.makefile("rwb")
        self.qf.readline()
        current = self
        qcmd({"execute": "qmp_capabilities"})
        self.hf = None
        if mon:
            hs = socket.socket(socket.AF_UNIX)
            hs.connect(mon)
            self.hf = hs.makefile("rwb")

    def quit(self):
        self.hf.write(b"quit\n")
        self.hf.flush()

def qcmd(obj):
    qf = current.qf
    qf.write((json.dumps(obj) + "\n").encode())
    qf.flush()
    while True:
        line = qf.readline()
        if not line:
            return {}
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if "event" not in msg:
            return msg

def send(events):
    qcmd({"execute": "input-send-event", "arguments": {"events": events}})

def monitor(line):
    return qcmd({"execute": "human-monitor-command",
                 "arguments": {"command-line": line}}).get("return", "")

def press(code, down):
    return {"type": "key", "data": {"down": down, "key": {"type": "qcode", "data": code}}}

def key(code):
    # A real keyboard event, not bytes slipped into the serial console. The
    # window server, terminal, pty and interactive shell all have to carry it.
    send([press(code, True), press(code, False)])
    time.sleep(0.02)

def chord(*codes):
    send([press(c, True) for c in codes] + [press(c, False) for c in reversed(codes)])
    time.sleep(0.2)

def type_text(value):
    names = {" ": "spc", ".": "dot", "/": "slash", "-": "minus", "\n": "ret"}
    for character in value:
        key(names.get(character, character))

def moveto(x, y):
    send([{"type": "abs", "data": {"axis": "x", "value": int(x * 32767 / W)}},
          {"type": "abs", "data": {"axis": "y", "value": int(y * 32767 / H)}}])
    time.sleep(0.1)

def shot(name, settle=2):
    current.hf.write(("screendump %s/%s.ppm\n" % (current.work, name)).encode())
    current.hf.flush()
    time.sleep(settle)

def load(name):
    d = open("%s/%s.ppm" % (current.work, name), "rb").read()
    i, vals = 2, []
    while len(vals) < 3:
        while d[i:i + 1].isspace():
            i += 1
        j = i
        while not d[j:j + 1].isspace():
            j += 1
        vals.append(int(d[i:j]))
        i = j
    return vals[0], vals[1], d[i + 1:]
PY
}

#       A commands file with the dump put in front of its closing poweroff.
coverage_guest_commands()
{
        if [ -n "$coverage_serial" ] && [ "$(tail -n 1 "$1")" = poweroff ]; then
                sed '$d' "$1"
                printf '%s\npoweroff\n' "$coverage_dump"
        else
                cat "$1"
        fi
}

coverage_guest_collect()
{
        [ -n "$coverage_serial" ] || return 0
        coverage_record=${coverage_serial#-serial file:}
        coverage_stem=$(mktemp "$MOONWATER_COVERAGE/guest_shell.$1.XXXXXX") || return 0
        #       Between "begin" and "ok" in base64 (YmVnaW4K, b2sK): what a
        #       firmware wrote to the port before is left out, and a record
        #       with no ok after it was cut short. A cut one is kept as .cut
        #       to look at, and the report never reads it.
        if tr -d '\r' < "$coverage_record" |
                awk '/YmVnaW4K$/ { taking = 1; count = 0; next }
                     taking { line[++count] = $0 }
                     END { if (!taking || line[count] != "b2sK") exit 1
                           for (at = 1; at < count; at++) print line[at] }' \
                        > "$coverage_stem.b64" &&
                base64 -d < "$coverage_stem.b64" 2>/dev/null |
                        gzip -dc > "$coverage_stem.map" 2>/dev/null &&
                [ -s "$coverage_stem.map" ]; then
                cp "$coverage_guest_elf" "$coverage_stem.elf"
        else
                printf '  %-30s the guest record came back cut (%s bytes)\n' \
                        "coverage $1" "$(cat "$coverage_record" 2>/dev/null | wc -c)"
                cp "$coverage_record" "$coverage_stem.cut" 2>/dev/null
                rm -f "$coverage_stem.map"
        fi
        rm -f "$coverage_stem.b64"
        rm -f "$coverage_stem"
        coverage_stem=""
}

freestanding()
{
        source_file=$1
        output=$2
        architecture=${3:-$host_arch}
        if [ "$#" -gt 3 ]; then shift 3; else set --; fi

        #       GCC can lower the AArch64 atomic builtins to libgcc's outline
        #       helpers. A spark binary has no libgcc under it, so keep the
        #       atomics inline just as the other two architectures do.
        #
        #       RISC-V toolchains commonly default to GC. Every executable test
        #       must instead be built at the documented IMAFD+Zicsr+Zicntr
        #       floor, otherwise qemu proving a binary full of compressed
        #       instructions says nothing about whether the floor actually
        #       works.
        #
        #       x86_64 GCC on a modern host emits BMI2 (rorx, shlx) from C
        #       rotates unless the march is pinned. The library floor is
        #       baseline x86-64 without BMI.
        case $architecture in
        x86_64) set -- "$@" -march=x86-64 ;;
        arm64) set -- "$@" -mno-outline-atomics ;;
        riscv64) set -- "$@" -march=rv64imafd_zicsr_zicntr -mabi=lp64d ;;
        esac

        #       MW_UBSAN=1 builds every program and check with the compiler's
        #       undefined-behaviour checks and traps at the first one, which
        #       is a ud2 on x86_64 and so a signal the lane reports as a
        #       program that died, with no runtime library to link: signed
        #       overflow, a shift past the width, an index past an array, a
        #       null or dangling use the optimizer is allowed to build on.
        #       Alignment is left out: the shell's byte stores hand out typed
        #       records at any offset, which x86_64 does not mind.
        #
        #           MW_UBSAN=1 sh test/run clock
        #
        #       A lane that builds with the checks has to be run on its own:
        #       the binaries are the same names as the plain ones.
        if [ -n "${MW_UBSAN:-}" ]; then
                set -- "$@" -fsanitize=undefined -fno-sanitize=alignment \
                        -fsanitize-undefined-trap-on-error
        fi

        coverage_build "$architecture" "$output" || return 1

        # shellcheck disable=SC2086
        if $compiler -O2 -static -nostdlib -nostartfiles -fno-stack-protector \
                -fno-builtin "$@" -w -T src/build/spark.ld -Wl,-e,_start \
                -Wl,--build-id=none -Wl,--no-warn-rwx-segments $coverage_args \
                -o "$output" "$source_file" 2> "$output.err"
        then
                coverage_keep "$output"
                return 0
        fi

        note "${build_label:-$source_file} did not build:"
        sed 's/^/    /' "$output.err" | head -20
        return 1
}

#       The build tool, bootstrapped if this is the first thing to want it.
#
#       Lanes bootstrap src/build/build.c the same way build.sh does.
build_tool()
{
        sh "$root/build.sh" "$@"
}

#       One section of test/checks.c, which is where every C check lives. The
#       name selects the section; anything after the architecture goes to the
#       compiler as well, which is how a variant gets its second definition
#       (-DCHECK_allocator -DALLOCATOR_REFERENCE is the glibc allocator).
freestanding_check()
{
        check_name=$1
        check_output=$2
        check_architecture=${3:-}
        if [ "$#" -gt 3 ]; then shift 3; else set --; fi

        #       A check is the whole program, and saying so lets the
        #       compiler drop whatever its main cannot reach before it
        #       optimizes any of it. A section that includes the shell to
        #       reach a few of its functions compiled all of the shell -- 37
        #       seconds where this takes three -- once for each machine.
        build_label="test/checks.c -DCHECK_$check_name"
        freestanding test/checks.c "$check_output" "$check_architecture" \
                "-DCHECK_$check_name" -fwhole-program "$@"
        check_status=$?
        build_label=
        return "$check_status"
}

#       One binary, and every name it answers to pointing at it. The suites
#       below run $farm/grep and $farm/ls, which is how the image is laid out
#       and so the only shape worth testing.
utilities=$(awk -F '[(),[:space:]]+' \
        '$1 == "SHELL_TOOL" && $2 != "SYSTEM" { print $3 }' \
        src/sh/tools.inc)

shell_binary=""
farm=""

#       Under run -j the parent builds the shell and the policy farm while
#       the lanes that need neither are already running. A lane that needs
#       them waits here until that build is done, rather than starting a
#       second build of the same file beside it.
need_shared_wait()
{
        [ -n "${TEST_SHARED_WORK:-}" ] && [ -e "$work/shared.building" ] ||
                return 0
        while [ ! -e "$work/shared.done" ]; do
                sleep 0.2
        done
        [ ! -e "$work/shared.failed" ]
}

need_shell()
{
        [ -z "$shell_binary" ] || return 0
        need_shared_wait || return 1

        #       A lane is a subshell and cannot hand the shell it built back
        #       to the lanes after it, so the build is skipped when the
        #       binary is already there rather than when the variable is.
        if [ ! -x "$work/shell" ]; then
                freestanding programs/shell.c "$work/shell" || return 1

                mkdir -p "$work/bin" || return 1

                for name in $utilities; do
                        ln -sf "$work/shell" "$work/bin/$name" || return 1
                done

                # Language checks need the Bash personality before the
                # differential runner creates its own private shell-name
                # farm.
                ln -sf "$work/shell" "$work/bin/bash" || return 1
        fi

        shell_binary="$work/shell"
        farm="$work/bin"
}

#       The ISA floor, which the build tool proves and this lane reads.
#
#       `build floor` compiles the library at the floor its settings name and
#       reads the ISA attribute back out of the object, because a normal
#       toolchain defaults to something richer -- rv64gc -- and would let both
#       a compressed instruction and an extension above the floor in unnoticed.
#       It answers 2 when nothing here has that back end, which is a skip and
#       not a pass.
#
#       It lives in the tool rather than here because it is a build-time
#       guarantee about a produced object, not a comparison against a
#       reference, and because what must be present and what must be absent
#       are settings there -- so another tree gets the same proof about its own
#       floor. Which extensions this floor names and why is written beside
#       those settings.
riscv_floor()
{
        build_tool floor riscv64
}


#       A result-only run under qemu cannot prove strict-alignment safety:
#       qemu-user and Linux may emulate the very access the floor forbids us
#       to rely on. Build a linked image so temporary assembler labels and
#       relocations are resolved, then inspect the instructions that ship.
#
#       This is deliberately paired with check_riscv_alignment_floor in
#       verify.c. That check crosses every pointer residue and page edge; this
#       one proves every remaining ld/sd/lw/sw is after an alignment gate, is
#       based on the register that gate establishes, and has a naturally
#       aligned displacement.
riscv_alignment_gate_audit()
{
        gate_disassembly=$1
        gate_routine=$2
        residue_register=$3
        residue_left=$4
        residue_right=$5
        natural_register=$6
        natural_base=$7

        awk -v routine="$gate_routine" -v residue_gate="$residue_register" \
                -v left="$residue_left" -v right="$residue_right" \
                -v natural_gate="$natural_register" \
                -v natural_base="$natural_base" '
                function address_key(value) {
                        sub(/[[:space:]]*<.*/, "", value)
                        gsub(/[[:space:]]/, "", value)
                        value = tolower(value)
                        sub(/^0x/, "", value)
                        sub(/^0+/, "", value)
                        return value == "" ? "0" : value
                }
                function first_is(slot, wanted_register, pieces) {
                        split(operand[slot], pieces, ",")
                        return pieces[1] == wanted_register
                }
                function first_two_are(slot, first, second, pieces) {
                        split(operand[slot], pieces, ",")
                        return pieces[1] == first && pieces[2] == second
                }
                function immediate_is(value, expected) {
                        if (value == expected)
                                return 1
                        if (substr(expected, 1, 1) == "-")
                                return value == "-0x" substr(expected, 2)
                        return value == "0x" expected
                }
                function addi_is(slot, destination, source, immediate,
                                 pieces) {
                        if (mnemonic[slot] != "addi")
                                return 0
                        split(operand[slot], pieces, ",")
                        return pieces[1] == destination &&
                               pieces[2] == source &&
                               immediate_is(pieces[3], immediate)
                }
                function zero_memory_is(slot, operation, destination, base,
                                        pieces) {
                        if (mnemonic[slot] != operation)
                                return 0
                        split(operand[slot], pieces, ",")
                        return pieces[1] == destination &&
                               (pieces[2] == "0(" base ")" ||
                                pieces[2] == "0x0(" base ")")
                }
                function branch_is(slot, operation, source, pieces) {
                        if (mnemonic[slot] != operation)
                                return 0
                        split(operand[slot], pieces, ",")
                        return pieces[1] == source
                }
                function branch_target_slot(slot, operand_number,
                                            pieces, target) {
                        split(operand[slot], pieces, ",")
                        target = pieces[operand_number]
                        sub(/<.*/, "", target)
                        target = address_key(target)
                        if (!(target in instruction_at))
                                return 0
                        return instruction_at[target]
                }
                function jump_targets(slot, wanted) {
                        return mnemonic[slot] == "j" &&
                               branch_target_slot(slot, 1) == wanted
                }
                function li_is(slot, destination, immediate, pieces) {
                        if (mnemonic[slot] != "li")
                                return 0
                        split(operand[slot], pieces, ",")
                        return pieces[1] == destination &&
                               immediate_is(pieces[2], immediate)
                }
                function exchange_alignment_is(   i, pieces, residue,
                                                   fast8, fast4,
                                                   choose8, choose4, choose2,
                                                   align, dispatch, bytes,
                                                   wide8, wide4, wide2) {
                        for (i = 1; i <= instructions; i++) {
                                split(operand[i], pieces, ",")
                                if (mnemonic[i] == "xor" && pieces[1] == "t0" &&
                                    pieces[2] == "a0" && pieces[3] == "a1") {
                                        if (residue)
                                                return 0
                                        residue = i
                                }
                        }
                        if (!residue)
                                return 0

                        for (i = 1; i < residue; i++)
                                if (li_is(i, "t0", "8")) {
                                        split(operand[i + 1], pieces, ",")
                                        if (mnemonic[i + 1] == "bne" &&
                                            pieces[1] == "a2" && pieces[2] == "t0") {
                                                fast8 = i
                                                fast4 = branch_target_slot(i + 1, 3)
                                                break
                                        }
                                }
                        if (!fast8 || !fast4 || !li_is(fast4, "t0", "4") ||
                            branch_target_slot(fast4 + 1, 3) != residue)
                                return 0

                        split(operand[fast8 + 2], pieces, ",")
                        if (mnemonic[fast8 + 2] != "or" ||
                            pieces[1] != "t1" || pieces[2] != "a0" ||
                            pieces[3] != "a1")
                                return 0
                        split(operand[fast8 + 3], pieces, ",")
                        if (mnemonic[fast8 + 3] != "andi" ||
                            pieces[1] != "t1" || pieces[2] != "t1" ||
                            !immediate_is(pieces[3], "7") ||
                            !branch_is(fast8 + 4, "bnez", "t1") ||
                            branch_target_slot(fast8 + 4, 2) != residue ||
                            !zero_memory_is(fast8 + 5, "ld", "t1", "a0") ||
                            !zero_memory_is(fast8 + 6, "ld", "t2", "a1") ||
                            !zero_memory_is(fast8 + 7, "sd", "t2", "a0") ||
                            !zero_memory_is(fast8 + 8, "sd", "t1", "a1") ||
                            mnemonic[fast8 + 9] != "ret")
                                return 0

                        split(operand[fast4 + 2], pieces, ",")
                        if (mnemonic[fast4 + 2] != "or" ||
                            pieces[1] != "t1" || pieces[2] != "a0" ||
                            pieces[3] != "a1")
                                return 0
                        split(operand[fast4 + 3], pieces, ",")
                        if (mnemonic[fast4 + 3] != "andi" ||
                            pieces[1] != "t1" || pieces[2] != "t1" ||
                            !immediate_is(pieces[3], "3") ||
                            !branch_is(fast4 + 4, "bnez", "t1") ||
                            branch_target_slot(fast4 + 4, 2) != residue ||
                            !zero_memory_is(fast4 + 5, "lw", "t1", "a0") ||
                            !zero_memory_is(fast4 + 6, "lw", "t2", "a1") ||
                            !zero_memory_is(fast4 + 7, "sw", "t2", "a0") ||
                            !zero_memory_is(fast4 + 8, "sw", "t1", "a1") ||
                            mnemonic[fast4 + 9] != "ret")
                                return 0

                        split(operand[residue + 1], pieces, ",")
                        if (mnemonic[residue + 1] != "andi" ||
                            pieces[1] != "t1" || pieces[2] != "t0" ||
                            !immediate_is(pieces[3], "7") ||
                            !branch_is(residue + 2, "beqz", "t1"))
                                return 0
                        choose8 = branch_target_slot(residue + 2, 2)

                        split(operand[residue + 3], pieces, ",")
                        if (mnemonic[residue + 3] != "andi" ||
                            pieces[1] != "t1" || pieces[2] != "t0" ||
                            !immediate_is(pieces[3], "3") ||
                            !branch_is(residue + 4, "beqz", "t1"))
                                return 0
                        choose4 = branch_target_slot(residue + 4, 2)

                        split(operand[residue + 5], pieces, ",")
                        if (mnemonic[residue + 5] != "andi" ||
                            pieces[1] != "t1" || pieces[2] != "t0" ||
                            !immediate_is(pieces[3], "1") ||
                            !branch_is(residue + 6, "beqz", "t1"))
                                return 0
                        choose2 = branch_target_slot(residue + 6, 2)
                        bytes = branch_target_slot(residue + 7, 1)

                        if (!choose8 || !choose4 || !choose2 || !bytes ||
                            !li_is(choose8, "a3", "8") ||
                            !li_is(choose4, "a3", "4") ||
                            !li_is(choose2, "a3", "2"))
                                return 0

                        align = choose2 + 1
                        if (!jump_targets(choose8 + 1, align) ||
                            !jump_targets(choose4 + 1, align) ||
                            !addi_is(align, "t0", "a3", "-1"))
                                return 0
                        split(operand[align + 1], pieces, ",")
                        if (mnemonic[align + 1] != "and" ||
                            pieces[1] != "t1" || pieces[2] != "a0" ||
                            pieces[3] != "t0" ||
                            !branch_is(align + 2, "beqz", "t1"))
                                return 0
                        dispatch = branch_target_slot(align + 2, 2)

                        if (!zero_memory_is(align + 3, "lbu", "t1", "a0") ||
                            !zero_memory_is(align + 4, "lbu", "t2", "a1") ||
                            !zero_memory_is(align + 5, "sb", "t2", "a0") ||
                            !zero_memory_is(align + 6, "sb", "t1", "a1") ||
                            !addi_is(align + 7, "a0", "a0", "1") ||
                            !addi_is(align + 8, "a1", "a1", "1") ||
                            !addi_is(align + 9, "a2", "a2", "-1") ||
                            !branch_is(align + 10, "beqz", "a2"))
                                return 0
                        split(operand[align + 11], pieces, ",")
                        if (mnemonic[align + 11] != "and" ||
                            pieces[1] != "t1" || pieces[2] != "a0" ||
                            pieces[3] != "t0" ||
                            !branch_is(align + 12, "bnez", "t1") ||
                            branch_target_slot(align + 12, 2) != align + 3)
                                return 0

                        if (!li_is(dispatch, "t0", "8"))
                                return 0
                        split(operand[dispatch + 1], pieces, ",")
                        if (mnemonic[dispatch + 1] != "beq" ||
                            pieces[1] != "a3" || pieces[2] != "t0")
                                return 0
                        wide8 = branch_target_slot(dispatch + 1, 3)
                        if (!li_is(dispatch + 2, "t0", "4"))
                                return 0
                        split(operand[dispatch + 3], pieces, ",")
                        if (mnemonic[dispatch + 3] != "beq" ||
                            pieces[1] != "a3" || pieces[2] != "t0")
                                return 0
                        wide4 = branch_target_slot(dispatch + 3, 3)
                        wide2 = branch_target_slot(dispatch + 4, 1)

                        return wide8 && wide4 && wide2 &&
                               li_is(wide8, "t0", "8") &&
                               li_is(wide4, "t0", "4") &&
                               li_is(wide2, "t0", "2") &&
                               branch_is(bytes, "beqz", "a2")
                }
                function residue_fallback_is(slot) {
                        if (routine == "string_compare")
                                return addi_is(slot, "a0", "a0", "1") &&
                                       addi_is(slot + 1, "a1", "a1", "1") &&
                                       mnemonic[slot + 2] == "j"

                        # string_compare_max walks to an end address rather
                        # than counting the bound down, so the question its byte
                        # fallback opens with is still "is there a byte left",
                        # spelt against a4 instead of against a2.
                        if (routine == "string_compare_max")
                                return mnemonic[slot] == "bgeu" &&
                                       first_two_are(slot, "a0", "a4") &&
                                       zero_memory_is(slot + 1, "lbu", "t3", "a0") &&
                                       zero_memory_is(slot + 2, "lbu", "t4", "a1")

                        if (mnemonic[slot] != "beqz" ||
                            !first_is(slot, "a2"))
                                return 0
                        if (routine == "memory_compare")
                                return zero_memory_is(slot + 1, "lbu", "t1", "a0") &&
                                       zero_memory_is(slot + 2, "lbu", "t2", "a1")
                        if (routine == "memory_copy_apart")
                                return zero_memory_is(slot + 1, "lbu", "t0", "a1") &&
                                       zero_memory_is(slot + 2, "sb", "t0", "a0")
                        if (routine == "memory_copy")
                                return addi_is(slot + 1, "a4", "a4", "-1") &&
                                       addi_is(slot + 2, "a5", "a5", "-1")
                        return 0
                }
                function natural_peel_is(slot) {
                        if (routine == "string_compare")
                                return addi_is(slot, "a0", "a0", "1") &&
                                       addi_is(slot + 1, "a1", "a1", "1")
                        if (routine == "string_compare_max")
                                return zero_memory_is(slot, "lbu", "t3", "a0") &&
                                       zero_memory_is(slot + 1, "lbu", "t4", "a1") &&
                                       addi_is(slot + 2, "a0", "a0", "1") &&
                                       addi_is(slot + 3, "a1", "a1", "1") &&
                                       mnemonic[slot + 4] == "bne" &&
                                       first_two_are(slot + 4, "t3", "t4") &&
                                       branch_is(slot + 5, "beqz", "t3")
                        if (routine == "memory_count")
                                return zero_memory_is(slot, "lbu", "t4", "a0") &&
                                       mnemonic[slot + 1] == "bne" &&
                                       first_two_are(slot + 1, "t4", "a2") &&
                                       addi_is(slot + 3, "a0", "a0", "1") &&
                                       addi_is(slot + 4, "a1", "a1", "-1") &&
                                       branch_is(slot + 5, "beqz", "a1")
                        if (routine == "memory_compare")
                                return zero_memory_is(slot, "lbu", "t1", "a0") &&
                                       zero_memory_is(slot + 1, "lbu", "t2", "a1") &&
                                       addi_is(slot + 4, "a0", "a0", "1") &&
                                       addi_is(slot + 5, "a1", "a1", "1") &&
                                       addi_is(slot + 6, "a2", "a2", "-1") &&
                                       branch_is(slot + 7, "beqz", "a2")
                        if (routine == "memory_fill")
                                return zero_memory_is(slot, "sb", "a1", "a0") &&
                                       addi_is(slot + 1, "a0", "a0", "1") &&
                                       addi_is(slot + 2, "a2", "a2", "-1") &&
                                       branch_is(slot + 3, "beqz", "a2")
                        if (routine == "memory_frob")
                                return zero_memory_is(slot, "lbu", "t1", "a0") &&
                                       mnemonic[slot + 1] == "xori" &&
                                       zero_memory_is(slot + 2, "sb", "t1", "a0") &&
                                       addi_is(slot + 3, "a0", "a0", "1") &&
                                       addi_is(slot + 4, "a1", "a1", "-1") &&
                                       branch_is(slot + 5, "beqz", "a1")
                        if (routine == "memory_copy_apart")
                                return zero_memory_is(slot, "lbu", "t1", "a1") &&
                                       zero_memory_is(slot + 1, "sb", "t1", "a0") &&
                                       addi_is(slot + 2, "a0", "a0", "1") &&
                                       addi_is(slot + 3, "a1", "a1", "1") &&
                                       addi_is(slot + 4, "a2", "a2", "-1") &&
                                       branch_is(slot + 5, "beqz", "a2")
                        if (routine == "memory_copy")
                                return addi_is(slot, "a4", "a4", "-1") &&
                                       addi_is(slot + 1, "a5", "a5", "-1") &&
                                       addi_is(slot + 4, "a2", "a2", "-1") &&
                                       branch_is(slot + 5, "beqz", "a2")
                        if (routine == "string_to_positive")
                                return addi_is(slot, "a0", "a0", "-1") &&
                                       zero_memory_is(slot + 1, "lbu", "t1", "a0")
                        return 0
                }
                function natural_peel_span() {
                        if (routine == "string_compare_max") return 6
                        if (routine == "memory_count")       return 6
                        if (routine == "memory_compare")     return 8
                        if (routine == "memory_fill")        return 4
                        if (routine == "memory_frob")        return 6
                        if (routine == "memory_copy_apart")   return 6
                        if (routine == "memory_copy")        return 6
                        return 0
                }
                function natural_wide_entry_is(slot) {
                        if (routine == "string_compare_max")
                                return addi_is(slot, "a5", "a4", "-8") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "a5", "a0")
                        if (routine == "string_compare" ||
                            routine == "memory_count")
                                return mnemonic[slot] == "lui" &&
                                       first_is(slot, "t0") &&
                                       mnemonic[slot + 1] == "addi" &&
                                       first_two_are(slot + 1, "t0", "t0")
                        if (routine == "memory_compare")
                                return mnemonic[slot] == "li" &&
                                       first_is(slot, "t0") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "a2", "t0")
                        if (routine == "memory_fill")
                                return mnemonic[slot] == "li" &&
                                       first_is(slot, "t0") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "a2", "t0")
                        if (routine == "memory_frob")
                                return mnemonic[slot] == "li" &&
                                       first_is(slot, "t0") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "a1", "t0")
                        if (routine == "memory_copy_apart")
                                return mnemonic[slot] == "li" &&
                                       first_is(slot, "t4") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "a2", "t4")
                        if (routine == "memory_copy")
                                return mnemonic[slot] == "li" &&
                                       first_is(slot, "t6") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "a2", "t6")
                        if (routine == "string_to_positive")
                                return addi_is(slot, "t3", "a0", "-8") &&
                                       mnemonic[slot + 1] == "bltu" &&
                                       first_two_are(slot + 1, "t3", "t0")
                        return 0
                }
                /^[[:space:]]*[[:xdigit:]]+:/ {
                        address = $0
                        sub(/:.*/, "", address)
                        address = address_key(address)

                        line = $0
                        sub(/^[^:]*:[[:space:]]*/, "", line)
                        while (line ~ /^[[:xdigit:]][[:xdigit:]][[:space:]]+/)
                                sub(/^[[:xdigit:]][[:xdigit:]][[:space:]]+/, "", line)
                        sub(/[[:space:]]*#.*/, "", line)

                        operation = line
                        sub(/[[:space:]].*$/, "", operation)
                        operation = tolower(operation)
                        arguments = line
                        sub(/^[^[:space:]]+[[:space:]]+/, "", arguments)
                        gsub(/[[:space:]]/, "", arguments)

                        instructions++
                        mnemonic[instructions] = operation
                        operand[instructions] = arguments
                        instruction_at[address] = instructions
                }
                END {
                        if (routine == "memory_exchange_apart") {
                                if (!exchange_alignment_is()) {
                                        print routine ": shared-residue alignment control changed"
                                        exit 1
                                }
                                exit 0
                        }

                        if (residue_gate != "-") {
                                residue_matches = 0
                                for (i = 1; i <= instructions; i++) {
                                        split(operand[i], pieces, ",")
                                        if (mnemonic[i] == "xor" &&
                                            pieces[1] == residue_gate &&
                                            pieces[2] == left && pieces[3] == right) {
                                                residue_matches++
                                                residue_index = i
                                        }
                                }

                                if (residue_matches != 1) {
                                        print routine ": expected one exact " residue_gate "=" \
                                              left "^" right " residue gate, found " \
                                              residue_matches
                                        exit 1
                                }

                                split(operand[residue_index + 1], pieces, ",")
                                if (mnemonic[residue_index + 1] != "andi" ||
                                    pieces[1] != residue_gate ||
                                    pieces[2] != residue_gate ||
                                    (pieces[3] != "7" && pieces[3] != "0x7")) {
                                        print routine ": residue xor is not followed by andi " \
                                              residue_gate "," residue_gate ",7"
                                        exit 1
                                }

                                if (!branch_is(residue_index + 2, "bnez",
                                               residue_gate)) {
                                        print routine ": residue mask is not followed by bnez " \
                                              residue_gate
                                        exit 1
                                }

                                target_index = branch_target_slot(residue_index + 2, 2)
                                if (!target_index) {
                                        print routine \
                                              ": residue branch target is outside the routine"
                                        exit 1
                                }

                                if (!residue_fallback_is(target_index)) {
                                        print routine \
                                              ": residue branch does not target its exact byte fallback"
                                        exit 1
                                }
                        }

                        natural_matches = 0
                        for (i = 1; i <= instructions; i++) {
                                split(operand[i], pieces, ",")
                                if (mnemonic[i] == "andi" &&
                                    pieces[1] == natural_gate &&
                                    pieces[2] == natural_base &&
                                    (pieces[3] == "7" || pieces[3] == "0x7")) {
                                        natural_matches++
                                        natural_index[natural_matches] = i
                                }
                        }

                        expected_natural = routine == "string_to_positive" ? 1 : 2
                        if (natural_matches != expected_natural) {
                                print routine ": expected " expected_natural " exact " \
                                      natural_gate "=" natural_base "&7 natural gates, found " \
                                      natural_matches
                                exit 1
                        }

                        first_natural = natural_index[1]
                        if (!branch_is(first_natural + 1, "beqz", natural_gate)) {
                                print routine \
                                      ": initial natural-alignment mask is not followed by beqz " \
                                      natural_gate
                                exit 1
                        }
                        wide_entry = branch_target_slot(first_natural + 1, 2)
                        if (!wide_entry || !natural_wide_entry_is(wide_entry)) {
                                print routine \
                                      ": initial natural gate does not target its aligned path"
                                exit 1
                        }

                        if (routine == "string_to_positive") {
                                if (mnemonic[first_natural - 1] != "beq" ||
                                    !first_two_are(first_natural - 1, "a0", "t0") ||
                                    !natural_peel_is(first_natural + 2) ||
                                    !jump_targets(wide_entry - 1, first_natural - 1)) {
                                        print routine \
                                              ": backward natural peel lost its exact loop control"
                                        exit 1
                                }
                                exit 0
                        }

                        second_natural = natural_index[2]
                        peel_entry = first_natural + 2
                        if (!natural_peel_is(peel_entry)) {
                                print routine ": natural gate lost its exact byte peel"
                                exit 1
                        }

                        if (routine == "string_compare") {
                                if (second_natural != first_natural + 4 ||
                                    !branch_is(second_natural + 1, "beqz", natural_gate) ||
                                    branch_target_slot(second_natural + 1, 2) != wide_entry ||
                                    !zero_memory_is(second_natural + 2, "lbu", "a4", "a0") ||
                                    !zero_memory_is(second_natural + 3, "lbu", "a5", "a1") ||
                                    !jump_targets(second_natural + 6, peel_entry)) {
                                        print routine \
                                              ": forward natural peel lost its exact loop control"
                                        exit 1
                                }
                                exit 0
                        }

                        if (!branch_is(second_natural + 1, "bnez", natural_gate)) {
                                print routine \
                                      ": natural peel mask is not followed by bnez " natural_gate
                                exit 1
                        }
                        if (second_natural != peel_entry + natural_peel_span()) {
                                print routine ": natural peel has an unexpected control shape"
                                exit 1
                        }
                        if (branch_target_slot(second_natural + 1, 2) != peel_entry) {
                                print routine ": natural peel backedge targets the wrong path"
                                exit 1
                        }
                        if (wide_entry != second_natural + 2) {
                                print routine \
                                      ": natural peel does not fall through to the aligned path"
                                exit 1
                        }
                }
        ' "$gate_disassembly"
}

riscv_alignment_audit()
{
        alignment_probe="$work/riscv-alignment-probe.o"
        if command -v riscv64-linux-gnu-gcc > /dev/null 2>&1; then
                alignment_compiler=$(command -v riscv64-linux-gnu-gcc)
                alignment_objdump=${alignment_compiler%gcc}objdump
                set -- "$alignment_compiler"
        else
                alignment_compiler=
                alignment_objdump=
                for alignment_try in "${CLANG:-clang}" \
                        /opt/homebrew/opt/llvm/bin/clang \
                        /usr/local/opt/llvm/bin/clang
                do
                        command -v "$alignment_try" > /dev/null 2>&1 || continue
                        if "$alignment_try" --target=riscv64-unknown-linux-gnu \
                                -march=rv64imafd_zicsr_zicntr -mabi=lp64d \
                                -x c -c -o "$alignment_probe" /dev/null \
                                > /dev/null 2>&1
                        then
                                alignment_compiler=$(command -v "$alignment_try")
                                alignment_objdump=$(dirname -- \
                                        "$alignment_compiler")/llvm-objdump
                                set -- "$alignment_compiler" \
                                        --target=riscv64-unknown-linux-gnu \
                                        -fuse-ld=lld
                                break
                        fi
                done

                [ -n "$alignment_compiler" ] || {
                        note "riscv64 alignment audit: NOT RUN -- no RISC-V compiler"
                        return 2
                }
        fi

        command -v "$alignment_objdump" > /dev/null 2>&1 || {
                note "riscv64 alignment audit: NOT RUN -- no RISC-V objdump"
                return 2
        }

        alignment_image="$work/riscv-alignment.elf"
        alignment_error="$work/riscv-alignment.err"

        if ! "$@" -O2 -static -nostdlib -nostartfiles \
                -fno-stack-protector -fno-builtin -w \
                -march=rv64imafd_zicsr_zicntr -mabi=lp64d \
                -DSTANDARD_NO_PLATFORM -T src/build/spark.ld -Wl,-e,string_length \
                -Wl,--build-id=none -o "$alignment_image" src/lib.c \
                2> "$alignment_error"
        then
                note "the linked RISC-V alignment image did not build:"
                sed 's/^/    /' "$alignment_error" | head -10
                return 1
        fi

        alignment_all="$work/riscv-alignment.dis"
        if ! "$alignment_objdump" -D --no-show-raw-insn "$alignment_image" \
                > "$alignment_all" 2> "$alignment_error"
        then
                note "the linked RISC-V alignment image could not be disassembled:"
                sed 's/^/    /' "$alignment_error" | head -10
                return 1
        fi

        alignment_failed=0

        for alignment_spec in \
                'string_compare:3:a0 a1' \
                'string_compare_max:3:a0 a1' \
                'memory_count:2:a0' \
                'memory_compare:3:a0 a1' \
                'memory_fill:2:a0' \
                'memory_frob:2:a0' \
                'memory_exchange_apart:1:a0 a1' \
                'memory_copy_apart:3:a0 a1' \
                'memory_copy:3:a4 a5' \
                'string_to_positive:1:t3 t6'
        do
                alignment_routine=${alignment_spec%%:*}
                alignment_rest=${alignment_spec#*:}
                alignment_guards=${alignment_rest%%:*}
                alignment_bases=${alignment_rest#*:}
                alignment_dis="$work/riscv-alignment.$alignment_routine.dis"

                # Same-address libc aliases make each objdump choose one name
                # for a function header, and GNU and LLVM do not always choose
                # the same one. Keep auditing the moonwater contract while
                # selecting the label this disassembler actually printed.
                case $alignment_routine in
                string_compare)     alignment_labels="strcmp string_compare" ;;
                string_compare_max) alignment_labels="strncmp string_compare_max" ;;
                memory_compare)     alignment_labels="memcmp memory_compare" ;;
                memory_fill)        alignment_labels="__memset memset memory_fill" ;;
                memory_frob)        alignment_labels="memfrob memory_frob" ;;
                #       Each routine hunts the label its own alias put on it.
                #       memcpy is memory_copy_apart now and memmove is
                #       memory_copy, so looking for "memcpy" at memory_copy's
                #       address finds the other routine and reports this one
                #       as having lost its residue gate -- which is what it
                #       did report. The expected[] map below was already
                #       written for this arrangement.
                memory_copy)        alignment_labels="__memmove memmove memory_copy" ;;
                memory_copy_apart)  alignment_labels="__memcpy memcpy memory_copy_apart" ;;
                *)                  alignment_labels=$alignment_routine ;;
                esac

                alignment_label=
                for alignment_label_try in $alignment_labels; do
                        if grep -Fq "<$alignment_label_try>:" "$alignment_all"; then
                                alignment_label=$alignment_label_try
                                break
                        fi
                done
                if [ -z "$alignment_label" ]; then
                        note "$alignment_routine has no disassembly label"
                        alignment_failed=1
                        continue
                fi

                awk -v wanted="<$alignment_label>:" '
                        index($0, wanted) { found = 1 }
                        found && /^[[:xdigit:]]+ <[^>]+>:/ &&
                            !index($0, wanted) { exit }
                        found { print }
                ' "$alignment_all" > "$alignment_dis"

                alignment_guard_count=$(grep -Ec \
                        '[[:space:]]andi[[:space:]]+[^,]+,[^,]+,[[:space:]]*(0x)?7([[:space:]]|$)' \
                        "$alignment_dis" || true)
                alignment_wide_count=$(grep -Ec \
                        '[[:space:]](ld|sd|lw|sw|lhu|sh)[[:space:]]' \
                        "$alignment_dis" || true)
                alignment_first_guard=$(grep -En \
                        '[[:space:]]andi[[:space:]]+[^,]+,[^,]+,[[:space:]]*(0x)?7([[:space:]]|$)' \
                        "$alignment_dis" | sed -n '1s/:.*//p')
                alignment_first_wide=$(grep -En \
                        '[[:space:]](ld|sd|lw|sw|lhu|sh)[[:space:]]' \
                        "$alignment_dis" | sed -n '1s/:.*//p')

                if [ "$alignment_guard_count" -lt "$alignment_guards" ] || \
                   [ "$alignment_wide_count" -eq 0 ] || \
                   [ -z "$alignment_first_guard" ] || \
                   [ -z "$alignment_first_wide" ] || \
                   [ "$alignment_first_wide" -le "$alignment_first_guard" ]
                then
                        note "$alignment_routine lost its alignment gate" \
                                "($alignment_guard_count guards, $alignment_wide_count wide accesses)"
                        alignment_failed=1
                        continue
                fi

                alignment_residue_register=-
                alignment_residue_left=-
                alignment_residue_right=-
                case $alignment_routine in
                string_compare)
                        alignment_residue_register=a6
                        alignment_residue_left=a0
                        alignment_residue_right=a1
                        alignment_natural_register=a6
                        alignment_natural_base=a0
                        ;;
                string_compare_max)
                        alignment_residue_register=t2
                        alignment_residue_left=a0
                        alignment_residue_right=a1
                        alignment_natural_register=t2
                        alignment_natural_base=a0
                        ;;
                memory_count)
                        alignment_natural_register=t3
                        alignment_natural_base=a0
                        ;;
                memory_compare)
                        alignment_residue_register=t0
                        alignment_residue_left=a0
                        alignment_residue_right=a1
                        alignment_natural_register=t0
                        alignment_natural_base=a0
                        ;;
                memory_fill)
                        alignment_natural_register=t0
                        alignment_natural_base=a0
                        ;;
                memory_frob)
                        alignment_natural_register=t0
                        alignment_natural_base=a0
                        ;;
                memory_exchange_apart)
                        alignment_natural_register=-
                        alignment_natural_base=-
                        ;;
                memory_copy_apart)
                        alignment_residue_register=t0
                        alignment_residue_left=a0
                        alignment_residue_right=a1
                        alignment_natural_register=t0
                        alignment_natural_base=a0
                        ;;
                memory_copy)
                        alignment_residue_register=t0
                        alignment_residue_left=a4
                        alignment_residue_right=a5
                        alignment_natural_register=t0
                        alignment_natural_base=a4
                        ;;
                string_to_positive)
                        alignment_natural_register=t3
                        alignment_natural_base=a0
                        ;;
                esac

                if ! riscv_alignment_gate_audit "$alignment_dis" \
                        "$alignment_routine" "$alignment_residue_register" \
                        "$alignment_residue_left" "$alignment_residue_right" \
                        "$alignment_natural_register" "$alignment_natural_base" \
                        > "$alignment_error"
                then
                        note "$alignment_routine lost its exact alignment control:"
                        sed 's/^/    /' "$alignment_error" | head -10
                        alignment_failed=1
                        continue
                fi

                if ! awk -v routine="$alignment_routine" \
                        -v allowed="$alignment_bases" '
                        function number(text, sign, value, i, digit, c) {
                                sign = 1
                                if (substr(text, 1, 1) == "-") {
                                        sign = -1
                                        text = substr(text, 2)
                                }
                                if (substr(text, 1, 2) != "0x")
                                        return sign * (text + 0)
                                text = substr(text, 3)
                                value = 0
                                for (i = 1; i <= length(text); i++) {
                                        c = tolower(substr(text, i, 1))
                                        digit = index("0123456789abcdef", c) - 1
                                        if (digit < 0)
                                                return 1
                                        value = value * 16 + digit
                                }
                                return sign * value
                        }
                        BEGIN { allowed = " " allowed " " }
                        /^[[:space:]]*[[:xdigit:]]+:/ {
                                line = $0
                                sub(/^[^:]*:[[:space:]]*/, "", line)

                                # GNU objdump normally prints raw bytes before
                                # the mnemonic. Discard every leading hex-byte
                                # field, then inspect the instruction itself.
                                while (line ~ /^[[:xdigit:]][[:xdigit:]][[:space:]]+/)
                                        sub(/^[[:xdigit:]][[:xdigit:]][[:space:]]+/, "", line)

                                mnemonic = line
                                sub(/[[:space:]].*$/, "", mnemonic)
                                if (mnemonic != "ld" && mnemonic != "sd" &&
                                    mnemonic != "lw" && mnemonic != "sw" &&
                                    mnemonic != "lhu" && mnemonic != "sh")
                                        next

                                operand = line
                                sub(/^[^[:space:]]+[[:space:]]+/, "", operand)
                                sub(/^[^,]+,[[:space:]]*/, "", operand)
                                gsub(/[[:space:]]/, "", operand)

                                base = operand
                                sub(/^.*\(/, "", base)
                                sub(/\).*$/, "", base)
                                offset = operand
                                sub(/\(.*/, "", offset)

                                if (index(allowed, " " base " ") == 0) {
                                        print routine ": wide access through ungated " base
                                        bad = 1
                                }

                                if (mnemonic == "lhu" || mnemonic == "sh")
                                        alignment = 2
                                else if (mnemonic == "lw" || mnemonic == "sw")
                                        alignment = 4
                                else
                                        alignment = 8
                                if (number(offset) % alignment) {
                                        print routine ": misaligned displacement " operand
                                        bad = 1
                                }
                                accesses++
                        }
                        END {
                                if (!accesses) {
                                        print routine ": no wide access was decoded"
                                        bad = 1
                                }
                                exit bad
                        }
                ' "$alignment_dis" > "$alignment_error"
                then
                        note "$alignment_routine has an unsafe wide access:"
                        sed 's/^/    /' "$alignment_error" | head -10
                        alignment_failed=1
                fi
        done

        #       Prove the checker is sensitive to the dangerous one-byte
        #       mutation that motivated it. Merely counting an xor, an andi
        #       and a later wide access accepted this inversion: unequal
        #       residues entered the word path while equal ones fell back to
        #       bytes. QEMU normally emulates the resulting misaligned access,
        #       so the semantic half can still agree.
        alignment_mutation_source="$work/riscv-alignment.memory_copy_apart.dis"
        alignment_mutation="$work/riscv-alignment.inverted-residue.dis"
        if ! awk '
                {
                        compact = $0
                        gsub(/[[:space:]]/, "", compact)
                        if (state == 0 && index(compact, "xort0,a0,a1"))
                                state = 1
                        else if (state == 1 &&
                                 (index(compact, "andit0,t0,7") ||
                                  index(compact, "andit0,t0,0x7")))
                                state = 2
                        else if (state == 2 &&
                                 $0 ~ /[[:space:]]bnez[[:space:]]+t0,/) {
                                sub(/bnez/, "beqz")
                                changed = 1
                                state = 3
                        }
                        print
                }
                END { if (!changed) exit 1 }
        ' "$alignment_mutation_source" > "$alignment_mutation"
        then
                note "the RISC-V residue-gate mutation could not be constructed"
                alignment_failed=1
        elif riscv_alignment_gate_audit "$alignment_mutation" \
                memory_copy_apart t0 a0 a1 t0 a0 > "$alignment_error"
        then
                note "the RISC-V alignment audit accepted bnez-to-beqz inversion"
                alignment_failed=1
        fi

        #       The single-pointer half needs the same executable proof. Flip
        #       both decisions around memory_fill's byte peel independently:
        #       the first inversion sends an unaligned pointer to the wide
        #       body, and the second leaves the peel after one byte regardless
        #       of whether alignment was reached.
        alignment_mutation_source="$work/riscv-alignment.memory_fill.dis"
        alignment_mutation="$work/riscv-alignment.inverted-natural-entry.dis"
        if ! awk '
                {
                        compact = $0
                        gsub(/[[:space:]]/, "", compact)
                        if (!seen &&
                            (index(compact, "andit0,a0,7") ||
                             index(compact, "andit0,a0,0x7")))
                                seen = 1
                        else if (seen == 1 &&
                                 $0 ~ /[[:space:]]beqz[[:space:]]+t0,/) {
                                sub(/beqz/, "bnez")
                                changed = 1
                                seen = 2
                        }
                        print
                }
                END { if (!changed) exit 1 }
        ' "$alignment_mutation_source" > "$alignment_mutation"
        then
                note "the RISC-V natural-entry mutation could not be constructed"
                alignment_failed=1
        elif riscv_alignment_gate_audit "$alignment_mutation" \
                memory_fill - - - t0 a0 > "$alignment_error"
        then
                note "the RISC-V alignment audit accepted beqz-to-bnez natural entry"
                alignment_failed=1
        fi

        alignment_mutation="$work/riscv-alignment.inverted-natural-peel.dis"
        if ! awk '
                {
                        compact = $0
                        gsub(/[[:space:]]/, "", compact)
                        if (index(compact, "andit0,a0,7") ||
                            index(compact, "andit0,a0,0x7"))
                                gates++
                        else if (gates == 2 &&
                                 $0 ~ /[[:space:]]bnez[[:space:]]+t0,/) {
                                sub(/bnez/, "beqz")
                                changed = 1
                                gates = 3
                        }
                        print
                }
                END { if (!changed) exit 1 }
        ' "$alignment_mutation_source" > "$alignment_mutation"
        then
                note "the RISC-V natural-peel mutation could not be constructed"
                alignment_failed=1
        elif riscv_alignment_gate_audit "$alignment_mutation" \
                memory_fill - - - t0 a0 > "$alignment_error"
        then
                note "the RISC-V alignment audit accepted bnez-to-beqz natural peel"
                alignment_failed=1
        fi

        [ "$alignment_failed" = 0 ]
}

#       Where a kernel object may touch the vector registers: nowhere but
#       .text.moonwater_simd (ASM_SIMD_SECTION in lib.c), whose bodies are all
#       named *_wide and are called only by the kernel's own dispatch inside
#       kernel_fpu_begin/kernel_neon_begin/kernel_vector_begin on a RAM buffer.
#       Everything else -- the narrow bodies, memcpy and memset that fbdev
#       calls on device memory, early boot -- stays general register only.
#
#       The disassembly is the authority, since an assembler takes vector
#       instructions whatever -mno-sse or -mgeneral-regs-only says. It fails
#       on a vector instruction in any other section, on a routine in the
#       section that is not *_wide or a *_wide routine outside it, and on any
#       reference from outside the section into it, so a narrow body cannot
#       fall into a wide one. The module's side is held in canvas.c: the wide
#       names appear there only in their declarations and in TARGET_PICK,
#       and every canvas_simd_begin is closed by a canvas_simd_end.
kernel_simd_boundary()
{
        awk -v arch="$1" '
                function vector_line(line,    mnemonic, operands, fields, token, field) {
                        if (arch == "x86")
                                return line ~ /%(xmm|ymm|zmm|mm|st|k)[0-9]/ ||
                                       line ~ /vzero(all|upper)/ ||
                                       line ~ /(^|[[:space:]])f?emms([[:space:]]|$)/
                        # riscv64 is disassembled without the raw bytes;
                        # arm64 has them, and they go before the mnemonic.
                        if (arch == "riscv64")
                                sub(/^[[:space:]]*[[:xdigit:]]+:[[:space:]]+/, "", line)
                        else
                                sub(/^[[:space:]]*[[:xdigit:]]+:[[:space:]]+([[:xdigit:]]+[[:space:]]+)+/, "", line)
                        mnemonic = line
                        sub(/[[:space:]].*/, "", mnemonic)
                        # A branch target such as b30 is an address, not a
                        # register; no branch touches vector state.
                        if (arch == "arm64" && (mnemonic == "b" || mnemonic == "bl" ||
                            mnemonic == "br" || mnemonic == "blr" ||
                            mnemonic ~ /^b\./ || mnemonic ~ /^cb/ || mnemonic ~ /^tb/))
                                return 0
                        if (arch == "arm64" && (mnemonic == "smstart" || mnemonic == "smstop"))
                                return 1
                        if (arch == "riscv64" && mnemonic ~ /^v/)
                                return 1
                        # Nor does a riscv64 branch, whose target prints as a
                        # bare hex address that reads like f22.
                        if (arch == "riscv64" && mnemonic ~ /^(c\.)?(b|j)/)
                                return 0
                        operands = line
                        sub(/^[^[:space:]]+[[:space:]]*/, "", operands)
                        sub(/[[:space:]]*[#<].*$/, "", operands)
                        gsub(/[][{}(),.]/, " ", operands)
                        fields = split(operands, token, /[[:space:]]+/)
                        for (field = 1; field <= fields; field++) {
                                if (arch == "arm64" &&
                                    (token[field] ~ /^(v|q|d|s|h|b|z|p)[0-9]+$/ ||
                                     token[field] ~ /^za[0-9]*$/ ||
                                     token[field] ~ /^fp(cr|sr)$/))
                                        return 1
                                if (arch == "riscv64" &&
                                    (token[field] ~ /^v[0-9]+$/ ||
                                     token[field] ~ /^f(t|s|a)?[0-9]+$/ ||
                                     token[field] ~ /^(fcsr|frm|fflags|vl|vtype|vstart)$/))
                                        return 1
                        }
                        return 0
                }
                BEGIN { wide = ".text.moonwater_simd" }
                /^Disassembly of section / {
                        section = $4
                        sub(/:$/, "", section)
                        next
                }
                # riscv64 keeps its local labels for relaxation, and they
                # print as symbols; they are inside whatever routine they are.
                # Alignment padding before the first routine of a section prints
                # as that routine minus an offset.
                /^[[:xdigit:]]+ <(\.L|[^>]*-0x)/ { next }
                /^[[:xdigit:]]+ <[^+>]+>:/ {
                        routine = $0
                        sub(/^.*</, "", routine)
                        sub(/>:.*/, "", routine)
                        if (section == wide && routine !~ /_wide$/) {
                                print routine " is in " wide " but is not a wide body"
                                bad = 1
                        } else if (section != wide && routine ~ /_wide$/) {
                                print routine " is a wide body outside " wide
                                bad = 1
                        }
                        if (section == wide)
                                bodies++
                        next
                }
                /R_(X86_64|AARCH64|RISCV)_/ {
                        target = $NF
                        if (section != wide &&
                            ((target ~ /_wide([+-]|$)/ && target !~ /^\.L/) ||
                             target ~ /moonwater_simd/)) {
                                print routine " in " section " reaches into " wide " (" target ")"
                                bad = 1
                        }
                        next
                }
                /^[[:space:]]*[[:xdigit:]]+:/ {
                        if (!vector_line($0))
                                next
                        if (section == wide)
                                wide_vector++
                        else {
                                found[routine]++
                                bad = 1
                        }
                }
                END {
                        for (routine in found)
                                print "vector instructions outside " wide " in " \
                                      routine " (" found[routine] ")"
                        if (!bodies || !wide_vector) {
                                print "no wide bodies in " wide ": the audit is looking at the wrong object"
                                bad = 1
                        }
                        exit bad
                }
        ' "$2"
}

#       The module side of the same boundary, over the module's own sources:
#       a wide name only in a declaration, TARGET_PICK or TERM_PICK, Canvas's
#       bracket opened as often as it is closed, the console emulator's
#       term_simd set true only inside it, and the kernel functions in
#       kernel/kernel.c, which call a wide body only between their own
#       kernel_fpu_begin_mask and kernel_fpu_end.
kernel_simd_callers()
{
        # Every wide routine lib.c defines, by name, whichever file calls it.
        kernel_simd_names=$(sed -n 's/^[[:space:]]*ASM_FUNC(\([a-z0-9_]*_wide\)).*/\1/p' \
                src/lib.c | sort -u | tr '\n' '|')

        awk -v names="${kernel_simd_names%|}" '
                BEGIN { named = "(^|[^a-z0-9_])(" names ")([^a-z0-9_]|$)" }
                /^[[:space:]]*(\/?\*|\/\/)/ { next }
                ($0 ~ named || /##_wide/) &&
                    !/^void canvas_[a-z0-9_]*_wide\(/ &&
                    !(/call[[:space:]]+hash_half_md4_wide\\n/ && kernel_held && FILENAME ~ /kernel\.c$/) &&
                    !/^#define TARGET_PICK\(t, name\) \(\(t\)->simd \? name##_wide : name\)$/ &&
                    !/^#define TERM_PICK\(name\) \(term_simd \? name##_wide : name\)$/ {
                        print FILENAME ":" FNR ": a wide body named outside TARGET_PICK or TERM_PICK: " $0
                        bad = 1
                }
                FILENAME ~ /kernel\.c$/ && /^[[:space:]]*"[^#]*call[[:space:]]+kernel_fpu_begin_mask\\n/ { kernel_begins++; kernel_held = 1 }
                FILENAME ~ /kernel\.c$/ && /^[[:space:]]*"[^#]*call[[:space:]]+kernel_fpu_end\\n/ { kernel_ends++; kernel_held = 0 }
                FILENAME ~ /canvas\.c$/ && /canvas_simd_begin\(&/ { begins++; held = 1 }
                FILENAME ~ /canvas\.c$/ && /canvas_simd_end\(&/ { ends++; held = 0 }
                # The emulator takes its wide bodies on term_simd, which only
                # the bracket may set, and only from what the bracket says.
                /term_simd = / && !/term_simd = false;/ &&
                    !(/term_simd = simd\.on;/ && held && FILENAME ~ /canvas\.c$/) {
                        print FILENAME ":" FNR ": term_simd set outside the bracket: " $0
                        bad = 1
                }
                END {
                        if (begins != ends || !begins) {
                                print "canvas_simd_begin " begins + 0 " times, canvas_simd_end " ends + 0
                                bad = 1
                        }
                        if (kernel_begins != kernel_ends || !kernel_begins) {
                                print "kernel.c: kernel_fpu_begin_mask " kernel_begins + 0 " times, kernel_fpu_end " kernel_ends + 0
                                bad = 1
                        }
                        exit bad
                }
        ' src/moonwater/*.c src/canvas/canvas.c src/canvas/window.c \
                src/canvas/term.c kernel/kernel.c
}

x86_kernel_vector_audit()
{
        x86_kernel_compiler=

        if [ "$(uname -s)" = Linux ] &&
           [ "$(uname -m)" = x86_64 ] && command -v "${CC:-gcc}" > /dev/null 2>&1
        then
                x86_kernel_compiler=$(command -v "${CC:-gcc}")
        elif command -v x86_64-linux-gnu-gcc > /dev/null 2>&1
        then
                x86_kernel_compiler=$(command -v x86_64-linux-gnu-gcc)
        fi

        [ -n "$x86_kernel_compiler" ] || {
                note "x86 kernel vector audit: NOT RUN -- no x86-64 compiler"
                return 2
        }

        x86_kernel_objdump=${x86_kernel_compiler%gcc}objdump
        command -v "$x86_kernel_objdump" > /dev/null 2>&1 ||
                x86_kernel_objdump=$(command -v objdump 2> /dev/null)

        [ -n "$x86_kernel_objdump" ] || {
                note "x86 kernel vector audit: NOT RUN -- no x86-64 objdump"
                return 2
        }

        # The standalone object needs only the pre-rewrite meaning of the
        # kernel's ALTERNATIVE macro: keep the old instruction. Supplying the
        # two tiny headers here avoids making this library gate depend on a
        # configured Linux source tree.
        mkdir -p "$work/x86-kernel-include/asm" || return 1
        printf '%s\n' \
                '#define ALTERNATIVE(old_instruction, new_instruction, feature) old_instruction' \
                > "$work/x86-kernel-include/asm/alternative.h"
        printf '%s\n' '#define X86_FEATURE_ERMS 0' \
                > "$work/x86-kernel-include/asm/cpufeatures.h"

        # lib.util.c is included through this umbrella by the real
        # module.  Compiling lib.c alone cannot catch a userspace-only
        # inline body which escaped its KERNEL_MODE boundary.
        if ! "$x86_kernel_compiler" -std=gnu11 -O2 -mno-sse -mno-sse2 \
                -mno-mmx -msoft-float -ffreestanding -fno-builtin -nostdlib \
                -I"$work/x86-kernel-include" \
                -DSTANDARD_MODERN_C_KERNEL '-DEXPORT_SYMBOL(name)=' \
                -c src/lib.util.c -o "$work/x86-kernel-common.o" \
                2> "$work/x86-kernel-common.err"
        then
                note "the x86 KERNEL_MODE common umbrella did not compile:"
                sed 's/^/    /' "$work/x86-kernel-common.err" | head -10
                return 1
        fi

        if ! "$x86_kernel_compiler" -std=gnu11 -O2 -mno-sse -mno-sse2 \
                -mno-mmx -msoft-float -ffreestanding -fno-builtin -nostdlib \
                -I"$work/x86-kernel-include" \
                -DSTANDARD_MODERN_C_KERNEL '-DEXPORT_SYMBOL(name)=' \
                -DCONFIG_MOONWATER_CANVAS -c src/lib.c -o "$work/x86-kernel.o" \
                2> "$work/x86-kernel.err"
        then
                note "the standalone x86 KERNEL_MODE library did not compile:"
                sed 's/^/    /' "$work/x86-kernel.err" | head -10
                return 1
        fi

        if ! "$x86_kernel_objdump" -dr --no-show-raw-insn \
                "$work/x86-kernel.o" > "$work/x86-kernel.dis" \
                2> "$work/x86-kernel.err"
        then
                note "the x86 KERNEL_MODE library could not be disassembled:"
                sed 's/^/    /' "$work/x86-kernel.err" | head -10
                return 1
        fi

        if ! kernel_simd_boundary x86 "$work/x86-kernel.dis" \
                > "$work/x86-kernel-vector.err" ||
           ! kernel_simd_callers >> "$work/x86-kernel-vector.err"
        then
                note "the x86 KERNEL_MODE vector boundary is broken:"
                sed 's/^/    /' "$work/x86-kernel-vector.err" | head -20
                return 1
        fi

        return 0
}

#       AArch64 makes NEON mandatory for userspace, not freely usable by the
#       kernel: code that touches the FP/SIMD register file must be inside
#       kernel_neon_begin, which lib.c cannot see. So the same boundary as
#       x86 (kernel_simd_boundary): general registers everywhere but the wide
#       bodies' section. Compile the real kernel preprocessor path, without an
#       architecture header shim.
arm64_kernel_vector_audit()
{
        arm64_kernel_compiler=
        arm64_kernel_target=

        if command -v aarch64-linux-gnu-gcc > /dev/null 2>&1; then
                arm64_kernel_compiler=$(command -v aarch64-linux-gnu-gcc)
        else
                for arm64_kernel_try in "${CLANG:-clang}" \
                        /opt/homebrew/opt/llvm/bin/clang \
                        /usr/local/opt/llvm/bin/clang
                do
                        command -v "$arm64_kernel_try" > /dev/null 2>&1 || continue
                        if "$arm64_kernel_try" --target=aarch64-unknown-linux-gnu \
                                -march=armv8-a -x c -c /dev/null \
                                -o "$work/arm64-kernel-probe.o" \
                                > /dev/null 2>&1
                        then
                                arm64_kernel_compiler=$(command -v "$arm64_kernel_try")
                                arm64_kernel_target=--target=aarch64-unknown-linux-gnu
                                break
                        fi
                done
        fi

        [ -n "$arm64_kernel_compiler" ] || {
                note "arm64 kernel vector audit: NOT RUN -- no AArch64 compiler"
                return 2
        }

        arm64_kernel_objdump=
        arm64_kernel_prefixed=${arm64_kernel_compiler%gcc}objdump
        if [ "$arm64_kernel_prefixed" != "$arm64_kernel_compiler" ] &&
           command -v "$arm64_kernel_prefixed" > /dev/null 2>&1
        then
                arm64_kernel_objdump=$arm64_kernel_prefixed
        else
                for arm64_kernel_try in llvm-objdump \
                        /opt/homebrew/opt/llvm/bin/llvm-objdump \
                        /usr/local/opt/llvm/bin/llvm-objdump \
                        aarch64-linux-gnu-objdump
                do
                        command -v "$arm64_kernel_try" > /dev/null 2>&1 || continue
                        arm64_kernel_objdump=$(command -v "$arm64_kernel_try")
                        break
                done
        fi

        [ -n "$arm64_kernel_objdump" ] || {
                note "arm64 kernel vector audit: NOT RUN -- no AArch64 objdump"
                return 2
        }

        # The module includes lib.util.c through lib.util.c, not
        # lib.c directly.  Keep that full preprocessor boundary buildable
        # before inspecting the assembly-only library beneath it.
        if ! "$arm64_kernel_compiler" $arm64_kernel_target -std=gnu11 -O2 \
                -march=armv8-a -mgeneral-regs-only -mno-outline-atomics \
                -ffreestanding -fno-builtin \
                -nostdlib -DSTANDARD_MODERN_C_KERNEL '-DEXPORT_SYMBOL(name)=' \
                -c src/lib.util.c -o "$work/arm64-kernel-common.o" \
                2> "$work/arm64-kernel-common.err"
        then
                note "the ARM64 KERNEL_MODE common umbrella did not compile:"
                sed 's/^/    /' "$work/arm64-kernel-common.err" | head -10
                return 1
        fi

        if ! "$arm64_kernel_compiler" $arm64_kernel_target -std=gnu11 -O2 \
                -march=armv8-a -mgeneral-regs-only -mno-outline-atomics \
                -ffreestanding -fno-builtin \
                -nostdlib -DSTANDARD_MODERN_C_KERNEL '-DEXPORT_SYMBOL(name)=' \
                -DCONFIG_MOONWATER_CANVAS -c src/lib.c -o "$work/arm64-kernel.o" \
                2> "$work/arm64-kernel.err"
        then
                note "the standalone ARM64 KERNEL_MODE library did not compile:"
                sed 's/^/    /' "$work/arm64-kernel.err" | head -10
                return 1
        fi

        if ! "$arm64_kernel_objdump" -dr "$work/arm64-kernel.o" \
                > "$work/arm64-kernel.dis" 2> "$work/arm64-kernel.err"
        then
                note "the ARM64 KERNEL_MODE library could not be disassembled:"
                sed 's/^/    /' "$work/arm64-kernel.err" | head -10
                return 1
        fi

        if awk '
                BEGIN {
                        # These are the only cross-symbol tails introduced by
                        # the ARM kernel scalar selection. ARM does not alias
                        # these libc names back onto the moonwater routines.
                        # The full kernel gate must additionally inspect their
                        # linked definitions; the architecture implementations
                        # are GP-register/MOPS assembly in ordinary builds.
                        guarded["string_length"] = 1
                        guarded["string_first_of"] = 1
                        guarded["string_first_of_or_end"] = 1
                        guarded["string_last_of_or_end"] = 1
                        guarded["memory_fill"] = 1
                        guarded["memory_copy_apart"] = 1
                        guarded["memory_copy"] = 1
                        guarded["string_copy"] = 1
                        guarded["string_copy_max"] = 1
                        guarded["string_cut"] = 1

                        expected["string_length"] = "strlen"
                        expected["string_first_of"] = "strchr"
                        expected["string_last_of_or_end"] = "strrchr"
                        expected["memory_fill"] = "memset"
                        expected["memory_copy_apart"] = "memcpy"
                        expected["memory_copy"] = "memmove"

                        allowed["string_last_of_or_end:string_first_of_or_end"] = 1
                }
                /^[[:xdigit:]]+ <[^+>]+>:/ {
                        routine = $0
                        sub(/^.*</, "", routine)
                        sub(/>:.*/, "", routine)
                        if (routine == "strchrnul")
                                routine = "string_first_of_or_end"
                        next
                }
                /R_AARCH64_(JUMP26|CALL26)/ {
                        target = $NF
                        sub(/[+-].*$/, "", target)
                        if (routine in guarded) {
                                key = routine ":" target
                                if (target == expected[routine])
                                        tails[routine]++
                                else if (!(key in allowed)) {
                                        print "unexpected ARM kernel tail " key
                                        bad_relocation = 1
                                }
                        }
                        next
                }
                END {
                        bad = bad_relocation
                        for (routine in expected)
                                if (tails[routine] != 1) {
                                        print routine " has " (tails[routine] + 0) \
                                              " tails to " expected[routine] \
                                              ", expected one"
                                        bad = 1
                                }
                        exit bad
                }
        ' "$work/arm64-kernel.dis" > "$work/arm64-kernel-vector.err" &&
           kernel_simd_boundary arm64 "$work/arm64-kernel.dis" \
                >> "$work/arm64-kernel-vector.err" &&
           kernel_simd_callers >> "$work/arm64-kernel-vector.err"
        then
                return 0
        fi

        note "the ARM64 KERNEL_MODE vector boundary changed:"
        sed 's/^/    /' "$work/arm64-kernel-vector.err" | head -20
        return 1
}

#       riscv64 the same way: V and the F/D registers only in the wide
#       bodies' section, which the kernel reaches inside kernel_vector_begin.
riscv64_kernel_vector_audit()
{
        command -v riscv64-linux-gnu-gcc > /dev/null 2>&1 || {
                note "riscv64 kernel vector audit: NOT RUN -- no riscv64 compiler"
                return 2
        }
        command -v riscv64-linux-gnu-objdump > /dev/null 2>&1 || {
                note "riscv64 kernel vector audit: NOT RUN -- no riscv64 objdump"
                return 2
        }

        if ! riscv64-linux-gnu-gcc -std=gnu11 -O2 -march=rv64imac_zicsr_zifencei \
                -mabi=lp64 -ffreestanding -fno-builtin -nostdlib \
                -DSTANDARD_MODERN_C_KERNEL '-DEXPORT_SYMBOL(name)=' \
                -DCONFIG_MOONWATER_CANVAS -c src/lib.c -o "$work/riscv64-kernel.o" \
                2> "$work/riscv64-kernel.err"
        then
                note "the standalone riscv64 KERNEL_MODE library did not compile:"
                sed 's/^/    /' "$work/riscv64-kernel.err" | head -10
                return 1
        fi

        if ! riscv64-linux-gnu-objdump -dr --no-show-raw-insn -M no-aliases \
                "$work/riscv64-kernel.o" > "$work/riscv64-kernel.dis" \
                2> "$work/riscv64-kernel.err"
        then
                note "the riscv64 KERNEL_MODE library could not be disassembled:"
                sed 's/^/    /' "$work/riscv64-kernel.err" | head -10
                return 1
        fi

        if kernel_simd_boundary riscv64 "$work/riscv64-kernel.dis" \
                > "$work/riscv64-kernel-vector.err" &&
           kernel_simd_callers >> "$work/riscv64-kernel-vector.err"
        then
                return 0
        fi

        note "the riscv64 KERNEL_MODE vector boundary is broken:"
        sed 's/^/    /' "$work/riscv64-kernel-vector.err" | head -20
        return 1
}

#
#       The lanes.
#

#       A compiler that marks an ELF object as branch protected makes a claim
#       about every callable entry in it, including the ones written in global
#       assembly. The compiler inserts its own landing pads into C functions;
#       it cannot insert one after ASM_FUNC's label. Build that exact shape and
#       inspect both halves of the claim: the GNU property and representative
#       assembly entries from the numeric, byte, syscall, and argument groups.
#
#       This is an ELF hardening check. Darwin has different object directives,
#       riscv64 has neither landing-pad mechanism, and a compiler or binutils
#       without the feature says so and skips rather than manufacturing a pass.
hardening_entries()
{
        [ "$host_system" = Linux ] || return 2

        case $host_arch in
        x86_64)
                hardening_flag=-fcf-protection=branch
                hardening_property=IBT
                hardening_landing='([[:space:]]endbr64([[:space:]]|$)|f3[[:space:]]+0f[[:space:]]+1e[[:space:]]+fa)'
                ;;
        arm64)
                hardening_flag=-mbranch-protection=standard
                hardening_property=BTI
                hardening_landing='([[:space:]]bti[[:space:]]+c([[:space:]]|$)|d503245f|5f[[:space:]]+24[[:space:]]+03[[:space:]]+d5)'
                ;;
        *)
                return 2
                ;;
        esac

        if command -v readelf > /dev/null 2>&1; then
                hardening_readelf=readelf
        elif command -v llvm-readelf > /dev/null 2>&1; then
                hardening_readelf=llvm-readelf
        else
                note "no readelf, so branch-protected object properties were not checked"
                return 2
        fi

        if command -v objdump > /dev/null 2>&1; then
                hardening_objdump=objdump
        elif command -v llvm-objdump > /dev/null 2>&1; then
                hardening_objdump=llvm-objdump
        else
                note "no objdump, so branch-protected assembly entries were not checked"
                return 2
        fi

        if ! $compiler -c -O2 -DSTANDARD_NO_PLATFORM -ffreestanding \
                -fno-builtin -w "$hardening_flag" \
                -o "$work/hardening.o" src/lib.c \
                2> "$work/hardening.err"
        then
                if grep -Eiq 'unknown argument|unrecognized .*option|unsupported .*option|not supported' \
                        "$work/hardening.err"
                then
                        note "$compiler has no $hardening_flag; hardening entries skipped"
                        return 2
                fi

                note "the branch-protected library did not compile:"
                sed 's/^/    /' "$work/hardening.err" | head -10
                return 1
        fi

        "$hardening_readelf" -n "$work/hardening.o" \
                > "$work/hardening.notes" 2>&1
        if ! grep -q "$hardening_property" "$work/hardening.notes"; then
                if grep -Eiq 'unknown|processor-specific' "$work/hardening.notes"; then
                        note "$hardening_readelf cannot decode $hardening_property properties"
                        return 2
                fi

                note "the branch-protected object does not advertise $hardening_property"
                sed 's/^/    /' "$work/hardening.notes" | head -10
                return 1
        fi

        "$hardening_objdump" -d "$work/hardening.o" \
                > "$work/hardening.dis" 2>&1 || {
                note "the branch-protected object could not be disassembled"
                return 1
        }

        for hardening_symbol in positive_into string_digits byte_class_holds \
                system_call program_argument
        do
                hardening_first=$(awk -v wanted="<$hardening_symbol>:" '
                        index($0, wanted) { found = 1; next }
                        found && /^[[:space:]]*[0-9a-f]+:/ { print; exit }
                ' "$work/hardening.dis")

                if [ -z "$hardening_first" ] ||
                   ! printf '%s\n' "$hardening_first" | grep -Eq "$hardening_landing"
                then
                        note "$hardening_symbol has no $hardening_property landing pad:"
                        printf '    %s\n' "${hardening_first:-not in disassembly}"
                        return 1
                fi
        done

        return 0
}

lane_standard()
{
        freestanding_check standard "$work/standard" || return 1

        "$work/standard" > "$work/standard.out" 2>&1
        sed -n '/FAILED/p' "$work/standard.out"

        line=$(sed -n 's/^\([0-9]*\) passed, \([0-9]*\) failed$/\1 \2/p' \
                "$work/standard.out")

        [ -n "$line" ] || { note "the standard suite printed no verdict"; return 1; }

        passed=${line% *}
        failed=${line#* }

        tally standard "$passed" "$((passed + failed))"

        #       The library is meant to be usable with nothing under it. The
        #       platform layer is what talks to a kernel; this is the half
        #       that does not, compiled on its own.
        if $compiler -c -O2 -DSTANDARD_NO_PLATFORM -ffreestanding -fno-builtin \
                -w -o "$work/no_platform.o" src/lib.c 2> "$work/no_platform.err"
        then
                tally no-platform 1 1
        else
                tally no-platform 0 1
                note "lib.c does not compile without a platform:"
                sed 's/^/    /' "$work/no_platform.err" | head -10
                failed=$((failed + 1))
        fi

        #       The kernel spells these in its own assembly files, and inside
        #       a string literal here they look like that and are not: the
        #       preprocessor does not expand a macro in a string, so the word
        #       reaches the assembler as a mnemonic and the macro's mitigation
        #       is skipped. Nine routines were written that way and returned
        #       without the thunk; nothing today does, and this is what says so
        #       the next time somebody copies a line out of the kernel tree.
        if bare=$(grep -n -E '"[^"]*\b(RET|ENDBR64|ENDBR32|CALL)\b' \
                src/lib.c)
        then
                tally bare-mnemonic 0 1
                note "a mnemonic inside a string where the macro was meant:"
                printf '%s\n' "$bare" | sed 's/^/    /' | head -10
                failed=$((failed + 1))
        else
                tally bare-mnemonic 1 1
        fi

        floor_outcome=0
        riscv_floor || floor_outcome=$?
        case $floor_outcome in
        0) tally floor-riscv64 1 1 ;;
        2) ;;
        *)
                tally floor-riscv64 0 1
                failed=$((failed + 1))
                ;;
        esac

        alignment_outcome=0
        riscv_alignment_audit || alignment_outcome=$?
        case $alignment_outcome in
        0) tally align-riscv64 1 1 ;;
        2) ;;
        *)
                tally align-riscv64 0 1
                failed=$((failed + 1))
                ;;
        esac

        arm64_kernel_outcome=0
        arm64_kernel_vector_audit || arm64_kernel_outcome=$?
        case $arm64_kernel_outcome in
        0) tally arm64-kernel-vector 1 1 ;;
        2) ;;
        *)
                tally arm64-kernel-vector 0 1
                failed=$((failed + 1))
                ;;
        esac

        riscv64_kernel_outcome=0
        riscv64_kernel_vector_audit || riscv64_kernel_outcome=$?
        case $riscv64_kernel_outcome in
        0) tally riscv64-kernel-vector 1 1 ;;
        2) ;;
        *)
                tally riscv64-kernel-vector 0 1
                failed=$((failed + 1))
                ;;
        esac

        x86_kernel_outcome=0
        x86_kernel_vector_audit || x86_kernel_outcome=$?
        case $x86_kernel_outcome in
        0) tally x86-kernel-vector 1 1 ;;
        2) ;;
        *)
                tally x86-kernel-vector 0 1
                failed=$((failed + 1))
                ;;
        esac

        #       The inventory is also the architectural floor guard: every
        #       routine must exist on all three targets and this file must hold
        #       declarations and assembly, never a C function body. It scans
        #       inactive branches too, so moving a body behind an #if cannot
        #       make the check disappear.
        if command -v python3 > /dev/null 2>&1; then
                if python3 test/assembly/inventory.py --check --target all src/lib.c \
                        > /dev/null 2> "$work/asm-only.err"
                then
                        tally asm-only 1 1
                else
                        tally asm-only 0 1
                        note "lib.c is not assembly-only at full parity:"
                        sed 's/^/    /' "$work/asm-only.err" | head -10
                        failed=$((failed + 1))
                fi
        else
                note "no python3, so assembly-only parity was not checked"
        fi

        hardening_outcome=0
        hardening_entries || hardening_outcome=$?
        case $hardening_outcome in
        0)
                tally hardening-entries 1 1
                ;;
        1)
                tally hardening-entries 0 1
                failed=$((failed + 1))
                ;;
        2)
                note "branch-protected entry check not available on this host"
                ;;
        esac

        [ "$failed" = 0 ]
}

#       lib.c writes its routines three times and only one of them can be
#       run on the machine it was written on. qemu runs the other two, so a
#       routine that is only right here fails here rather than on a board.
target_tools()
{
        target=$1

        #       These cases are Linux ELF spark programs. On Linux the host
        #       architecture runs directly; every other target is built with
        #       its cross compiler and run through qemu-user. Darwin has its
        #       own Mach-O arm64 lane below, so all three ELF targets are
        #       foreign there even when the processor name matches.
        if [ "$host_system" = Linux ] && [ "$host_arch" = "$target" ]; then
                target_compiler=$compiler
                target_runner=
        else
                case $target in
                x86_64)  target_runner=qemu-x86_64 ;;
                arm64)   target_runner=qemu-aarch64 ;;
                riscv64) target_runner=qemu-riscv64 ;;
                esac
                target_compiler=${target_runner#qemu-}-linux-gnu-gcc
        fi

        #       A target whose tools are not here did not run, and says so.
        for tool in $target_compiler $target_runner; do
                command -v "$tool" > /dev/null 2>&1 ||
                        {
                                if [ "${MOONWATER_REQUIRE_ARCHES:-0}" = 1 ]; then
                                        note "$target: REQUIRED BUT MISSING -- no $tool"
                                        return 1
                                fi
                                note "$target: NOT RUN -- no $tool"
                                return 2
                        }
        done
}

#       A build with the target's compiler standing in for the host's.
target_build()
{
        target_saved=$compiler
        compiler=$target_compiler
        "$@"
        target_built=$?
        compiler=$target_saved
        return "$target_built"
}

verify_one()
{
        verify_status=0
        freestanding_checks_one verify verify "$@" || verify_status=$?
        kernel_narrow_one || {
                kernel_narrow_status=$?
                [ "$kernel_narrow_status" = 2 ] || verify_status=1
        }
        return "$verify_status"
}

#       The KERNEL_MODE bodies, asked the verify check's narrow-argument
#       questions (check_dirty_arguments). No lane runs the kernel's half of
#       lib.c as a program otherwise, and an arm64 kernel body kept comparing
#       all of w1 after the userspace one had stopped. lib.c is compiled as
#       the kernel vector audits compile it, each symbol is prefixed kernel_
#       so the object sits beside the library, and the narrow section alone
#       is linked against it and run where verify runs. x86_64 twice: with
#       ALTERNATIVE left as the old instruction, which is early boot, and as
#       the new one, which is every call after alternative_instructions.
#       Canvas is a kernel object of its own beside the core, and the library
#       is one image's: each routine is a global label, so the two objects
#       may not both carry it. The core takes the library and leaves Canvas
#       its six pixel loops (LIBRARY_CANVAS_ELSEWHERE); Canvas takes the
#       declarations and only those (LIBRARY_BODIES_ELSEWHERE). Built the way
#       each object is built, from the umbrella, the three symbol tables have
#       to be the whole library cut in two: nothing in both, nothing in
#       neither, and the only thing that is Canvas's is named canvas_.
kernel_split_one()
{
        kernel_split_name=$1
        kernel_split_base=$2
        shift 2
        kernel_split_nm=${target_compiler%gcc}nm
        command -v "$kernel_split_nm" > /dev/null 2>&1 || kernel_split_nm=nm

        for kernel_split_side in whole core canvas; do
                case $kernel_split_side in
                whole) kernel_split_define=-DCONFIG_MOONWATER_CANVAS ;;
                core) kernel_split_define=-DLIBRARY_CANVAS_ELSEWHERE ;;
                canvas) kernel_split_define=-DLIBRARY_BODIES_ELSEWHERE ;;
                esac
                kernel_split_object=$kernel_split_base.$kernel_split_side
                if ! $target_compiler -std=gnu11 -O2 -ffreestanding -fno-builtin \
                        -nostdlib "$@" -DSTANDARD_MODERN_C_KERNEL \
                        '-DEXPORT_SYMBOL(name)=' -DCONFIG_MOONWATER_CANVAS \
                        $kernel_split_define -c src/lib.util.c \
                        -o "$kernel_split_object.o" 2> "$kernel_split_object.err" ||
                   ! "$kernel_split_nm" -g --defined-only "$kernel_split_object.o" \
                        2>> "$kernel_split_object.err" |
                        awk 'NF == 3 { print $3 }' | sort > "$kernel_split_object.names"
                then
                        note "the $kernel_split_name $kernel_split_side library did not build for the split check:"
                        sed 's/^/    /' "$kernel_split_object.err" | head -10
                        return 1
                fi
        done

        sort "$kernel_split_base.core.names" "$kernel_split_base.canvas.names" \
                > "$kernel_split_base.both.names"
        comm -12 "$kernel_split_base.core.names" "$kernel_split_base.canvas.names" \
                > "$kernel_split_base.shared.names"
        comm -3 "$kernel_split_base.both.names" "$kernel_split_base.whole.names" \
                > "$kernel_split_base.lost.names"
        grep -v '^canvas_' "$kernel_split_base.canvas.names" \
                > "$kernel_split_base.foreign.names"
        grep '^canvas_' "$kernel_split_base.core.names" \
                > "$kernel_split_base.taken.names"

        if [ -s "$kernel_split_base.shared.names" ] ||
           [ -s "$kernel_split_base.lost.names" ] ||
           [ -s "$kernel_split_base.foreign.names" ] ||
           [ -s "$kernel_split_base.taken.names" ] ||
           [ ! -s "$kernel_split_base.canvas.names" ]
        then
                note "the $kernel_split_name library is not cut in two between the core and Canvas:"
                for kernel_split_kind in shared lost foreign taken; do
                        [ -s "$kernel_split_base.$kernel_split_kind.names" ] || continue
                        note "  $kernel_split_kind:"
                        sed 's/^/    /' "$kernel_split_base.$kernel_split_kind.names" | head -8
                done
                return 1
        fi

        kernel_split_count=$(wc -l < "$kernel_split_base.whole.names" | tr -d ' ')
        tally "verify-kernel-split-$kernel_split_name" \
                "$kernel_split_count" "$kernel_split_count"
        return 0
}

kernel_narrow_one()
{
        kernel_narrow_objcopy=${target_compiler%gcc}objcopy
        command -v "$kernel_narrow_objcopy" > /dev/null 2>&1 ||
                kernel_narrow_objcopy=objcopy
        command -v "$kernel_narrow_objcopy" > /dev/null 2>&1 ||
                { note "$target kernel narrow: NOT RUN -- no objcopy"; return 2; }

        case $target in
        x86_64) kernel_narrow_forms="old new" ;;
        *) kernel_narrow_forms=kernel ;;
        esac

        kernel_narrow_failed=0
        for kernel_narrow_form in $kernel_narrow_forms; do
                case $kernel_narrow_form in
                kernel) kernel_narrow_name=$target ;;
                *) kernel_narrow_name=$target-$kernel_narrow_form ;;
                esac
                kernel_narrow_object=$work/narrow.$target.$kernel_narrow_form
                case $target in
                x86_64)
                        mkdir -p "$kernel_narrow_object.include/asm" || return 1
                        printf '#define ALTERNATIVE(old_instruction, new_instruction, feature) %s_instruction\n' \
                                "$kernel_narrow_form" \
                                > "$kernel_narrow_object.include/asm/alternative.h"
                        printf '%s\n' '#define X86_FEATURE_ERMS 0' \
                                > "$kernel_narrow_object.include/asm/cpufeatures.h"
                        set -- -mno-sse -mno-sse2 -mno-mmx -msoft-float \
                                "-I$kernel_narrow_object.include"
                        ;;
                arm64)
                        set -- -march=armv8-a -mgeneral-regs-only -mno-outline-atomics
                        ;;
                riscv64)
                        #       The verify binary's own floor and float ABI, which a
                        #       link needs to agree on; the bodies are the same text.
                        set -- -march=rv64imafd_zicsr_zifencei -mabi=lp64d
                        ;;
                esac

                if ! $target_compiler -std=gnu11 -O2 -ffreestanding -fno-builtin \
                        -nostdlib "$@" -DSTANDARD_MODERN_C_KERNEL \
                        '-DEXPORT_SYMBOL(name)=' -DCONFIG_MOONWATER_CANVAS \
                        -c src/lib.c -o "$kernel_narrow_object.o" \
                        2> "$kernel_narrow_object.err" ||
                   ! "$kernel_narrow_objcopy" --prefix-symbols=kernel_ \
                        --rename-section .noinstr.text=.text.kernel_noinstr \
                        --rename-section .text.moonwater_simd=.text.kernel_simd \
                        "$kernel_narrow_object.o" "$kernel_narrow_object.k.o" \
                        2>> "$kernel_narrow_object.err"
                then
                        note "the $kernel_narrow_name KERNEL_MODE library did not build for the narrow check:"
                        sed 's/^/    /' "$kernel_narrow_object.err" | head -10
                        kernel_narrow_failed=1
                        continue
                fi

                kernel_split_one "$kernel_narrow_name" "$kernel_narrow_object" "$@" ||
                        { kernel_narrow_failed=1; continue; }

                target_build freestanding_check verify "$kernel_narrow_object" \
                        "$target" -DVERIFY_NARROW_ONLY -DVERIFY_NARROW_KERNEL \
                        "$kernel_narrow_object.k.o" ||
                        { kernel_narrow_failed=1; continue; }

                $target_runner "$kernel_narrow_object" \
                        > "$kernel_narrow_object.out" 2>&1
                kernel_narrow_run=$?
                sed -n '/FAIL/p' "$kernel_narrow_object.out"
                line=$(sed -n 's/^\([0-9]*\) checks, \([0-9]*\) failures$/\1 \2/p' \
                        "$kernel_narrow_object.out")
                if [ -z "$line" ]; then
                        note "$kernel_narrow_name kernel narrow check printed no verdict"
                        kernel_narrow_failed=1
                        continue
                fi
                tally "verify-kernel-$kernel_narrow_name" \
                        "$((${line% *} - ${line#* }))" "${line% *}"
                [ "$kernel_narrow_run" = 0 ] && [ "${line#* }" = 0 ] ||
                        kernel_narrow_failed=1
        done

        return "$kernel_narrow_failed"
}

lane_verify() { target_lane verify_one; }

#       The sizes that never reach the routine.
#
#       memory_copy, memory_copy_apart and memory_fill expand in place when the
#       size is a literal, into a line of moves chosen from the number. Nothing
#       in the verify lane can reach any of that: its sizes come from loop
#       counters, so every one of them is a call, and the expansions would ship
#       having never run. The CHECK_exact section of test/checks.c is written
#       with shared literal-size lists for that reason.
#
#       On all three machines, because the expansion differs on each: x86 has a
#       hand written window between thirty three and a hundred and twenty eight
#       bytes and the other two do not.
exact_one() { freestanding_checks_one exact exact "$@"; }

lane_exact()
{
        target_lane exact_one
}

#       The branching assembly the text tools keep in their own source, lifted
#       by the extractor and proven on all three machines: a tool binary cannot
#       run under qemu-user, whose missing seccomp answer floodlight refuses.
text_asm_one()
{
        python3 test/differential.py --harness native_extract --source \
                src/sh/text.c text_blank_field > "$work/text_asm.h" || return 1
        target_build freestanding_check text_asm "$work/text_asm.$target" "$target" \
                "-I$work" || return 1
        $target_runner "$work/text_asm.$target" > "$work/text_asm.$target.out" 2>&1
        status=$?
        sed -n '/FAIL/p' "$work/text_asm.$target.out"
        line=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\) checks, \([0-9][0-9]*\) failures.*/\1 \2/p' \
                "$work/text_asm.$target.out" | tail -1)
        [ -n "$line" ] || { note "$target: text_asm did not say how it went"; return 1; }
        tally "text-asm-$target" "$((${line% *} - ${line#* }))" "${line% *}"
        [ "$status" = 0 ]
}

lane_text_asm() { target_lane text_asm_one; }

#       The same for the branching assembly the shell keeps in its own source.
shell_asm_one()
{
        { python3 test/differential.py --harness native_extract --source \
                src/sh/builtin.c floodlight_status_clear env_find_hashed_span_probe \
                test_operator_kind env_write_destination shell_name_index_probe shell_key_next &&
          python3 test/differential.py --harness native_extract --source \
                src/sh/parse.c parse_keyword_of parse_word_kind &&
          python3 test/differential.py --harness native_extract --source \
                src/sh/exec.c exec_function_slot &&
          python3 test/differential.py --harness native_extract --source \
                src/sh/shell.c shell_assignment_kind &&
          python3 test/differential.py --harness native_extract --source \
                src/sh/expand.c arith_plain_natural arith_plain_scalar; } > "$work/shell_asm.h" || return 1
        target_build freestanding_check shell_asm "$work/shell_asm.$target" "$target" \
                "-I$work" || return 1
        $target_runner "$work/shell_asm.$target" > "$work/shell_asm.$target.out" 2>&1
        status=$?
        sed -n '/FAIL/p' "$work/shell_asm.$target.out"
        line=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\) checks, \([0-9][0-9]*\) failures.*/\1 \2/p' \
                "$work/shell_asm.$target.out" | tail -1)
        [ -n "$line" ] || { note "$target: shell_asm did not say how it went"; return 1; }
        tally "shell-asm-$target" "$((${line% *} - ${line#* }))" "${line% *}"
        [ "$status" = 0 ]
}

lane_shell_asm() { target_lane shell_asm_one; }

#
#       The other things a call site may know: a set literal, a needle length,
#       a bound, a base, a byte. Each file is the same shape as exact.c -- the
#       argument written as a literal, because nothing that takes it from a
#       loop counter reaches the expansion at all.
#
KNOWN_FILES="exact_set needle bounded exact_scan exact_prefix exact_ascii_case hash_length exact_base single exact_family"

known_one()
{
        name=$target
        runner=$target_runner
        checks=0
        bad=0

        for one in $KNOWN_FILES; do
                target_build freestanding_check "$one" \
                        "$work/known.$name.$one" "$name" || return 1

                $runner "$work/known.$name.$one" > "$work/known.$name.$one.out" 2>&1
                status=$?

                sed -n '/FAIL/p' "$work/known.$name.$one.out"

                #       A file may report more than once; the verdict is
                #       the last line it prints, not the first.
                line=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\) checks, \([0-9][0-9]*\) failures.*/\1 \2/p' \
                        "$work/known.$name.$one.out" | tail -1)

                if [ -n "$line" ]; then
                        checks=$((checks + ${line% *}))
                        bad=$((bad + ${line#* }))
                elif [ "$status" != 0 ]; then
                        note "$name: $one did not say how it went"
                        return 1
                else
                        checks=$((checks + 1))
                fi
        done

        tally "known-$name" "$((checks - bad))" "$checks"

        [ "$bad" = 0 ]
}

#       A section's _reference twin: the same cases built by the host compiler
#       over the machine's glibc, whose verdict must be clean too, since an
#       expectation only this tree's code meets is one that agrees with a bug.
#       Each twin said "compare the verdicts" and no lane built it.
glibc_twin()
{
        twin_name=$1
        shift
        if ! ${CC:-gcc} -O2 -w "$@" -DCHECK_${twin_name}_reference \
                -o "$work/$twin_name.reference" test/checks.c -lm 2> "$work/$twin_name.reference.err"
        then
                note "$twin_name-glibc: the reference did not build"
                sed 's/^/    /' "$work/$twin_name.reference.err" | head -10
                return 1
        fi
        "$work/$twin_name.reference" > "$work/$twin_name.reference.out" 2>&1
        twin_status=$?
        twin_line=$(sed -n 's/^\([0-9]*\) checks, \([0-9]*\) failures$/\1 \2/p' \
                "$work/$twin_name.reference.out")
        [ -n "$twin_line" ] || { note "$twin_name-glibc printed no verdict"; return 1; }
        tally "$twin_name-glibc" "$((${twin_line% *} - ${twin_line#* }))" "${twin_line% *}"
        sed -n '/FAIL/p' "$work/$twin_name.reference.out" | head -10
        [ "$twin_status" = 0 ] && [ "${twin_line#* }" = 0 ]
}

lane_declare()   { freestanding_checks_lane declare declare && glibc_twin declare; }
lane_fold()      { freestanding_checks_lane fold fold; }
lane_reserve()   { freestanding_checks_lane reserve reserve; }
#
#       The core, the seal and the handshake in CHECK_waterlink on all three
#       machines, then the handshake's bytes against an independent Noise:
#       the native binary's `noise` mode against one written in the harness
#       and, where it imports, the noiseprotocol package.
#
lane_waterlink()
{
        freestanding_checks_lane waterlink waterlink
        waterlink_outcome=$?
        #       qemu's default riscv64 core has the vector crypto the short
        #       seal asks for, so the run above never takes the body a core
        #       without it keeps. Once more on rv64 -- Zbc and no V -- where
        #       the gate must send every box to the general body, and an
        #       instruction the core lacks is a SIGILL.
        if [ -x "$work/waterlink.riscv64" ] &&
           command -v qemu-riscv64 > /dev/null 2>&1; then
                QEMU_CPU=rv64 qemu-riscv64 "$work/waterlink.riscv64" \
                        > "$work/waterlink.riscv64-scalar.out" 2>&1
                scalar_status=$?
                sed -n '/FAIL/p' "$work/waterlink.riscv64-scalar.out"
                line=$(sed -n 's/^\([0-9]*\) checks, \([0-9]*\) failures$/\1 \2/p' \
                        "$work/waterlink.riscv64-scalar.out")
                if [ "$scalar_status" = 0 ] && [ -n "$line" ] &&
                   [ "${line#* }" = 0 ]; then
                        tally waterlink-riscv64-scalar "${line% *}" "${line% *}"
                else
                        note "the riscv64 checks on a core without V did not agree"
                        tally waterlink-riscv64-scalar 0 1
                        waterlink_outcome=1
                fi
        fi
        #       The service half -- admission, pairing, authorization files,
        #       staging -- on this machine only: it runs in a user namespace
        #       of its own, which qemu-user, being threaded, cannot enter.
        target=$host_arch
        if target_tools "$target"; then
                freestanding_checks_one waterlink_service waterlink_service ||
                        waterlink_outcome=1
        fi
        #       noiseprotocol and dnspython are found through
        #       WATERLINK_NOISE_PATH where the system has neither; the mDNS
        #       half needs neither (its second reader is written in the
        #       harness), and dnspython adds its own reading when it is there.
        #       Each harness named literally: the oracle proves every
        #       registered harness is asked for by finding its word here.
        if [ -x "$work/waterlink.$host_arch" ]; then
                python3 test/differential.py --harness waterlink_noise \
                        --binary "$work/waterlink.$host_arch"
                case $? in 0|2) ;; *) waterlink_outcome=1 ;; esac
                python3 test/differential.py --harness waterlink_mdns \
                        --binary "$work/waterlink.$host_arch"
                case $? in 0|2) ;; *) waterlink_outcome=1 ;; esac
        fi
        #       The parsers and the link core hosted under the sanitizers,
        #       which the freestanding checks (-fno-stack-protector) cannot
        #       see a memory-safety bug in. It builds itself, so it stands
        #       outside the native-binary gate above.
        python3 test/differential.py --harness waterlink_sanitized
        case $? in 0|2) ;; *) waterlink_outcome=1 ;; esac
        #       The core as a state machine under libFuzzer, and command.c's
        #       machine-script scan under ASan: a short smoke here, as long as
        #       the TLS targets under lane_fuzz.
        python3 test/differential.py --harness waterlink_fuzz
        case $? in 0|2) ;; *) waterlink_outcome=1 ;; esac
        python3 test/differential.py --harness waterlink_pre_fuzz
        case $? in 0|2) ;; *) waterlink_outcome=1 ;; esac
        return "$waterlink_outcome"
}

#
#       moonwater link as a person uses it: two network namespaces joined by
#       veth stand for two machines, each with its own /root and /run, and
#       the command under test is the shell binary itself.
#       differential.py --harness waterlink_link says what it asks.
#
lane_link()
{
        need_shell || return 1
        python3 test/differential.py --harness waterlink_link --shell "$shell_binary"
}
#
#       The network clients under adversarial scheduling: DHCP and SNTP as
#       built, in namespaces joined by a veth pair with netem on both ends and
#       a server that answers late, twice, forged or not at all.
#       differential.py --harness net_netem says what it asks; exit 2 (NOT
#       RUN) where the box has no unprivileged namespaces, veth or netem.
#
lane_netem()
{
        need_shell || return 1
        netem_status=0
        python3 test/differential.py --harness net_netem --shell "$shell_binary" ||
                netem_status=$?
        #       The lease epoch walk against sh/net.c with one step taken out:
        #       the first mutant here, every one with MOONWATER_EPOCH_MUTANTS=all.
        python3 test/differential.py --harness net_epoch_mutants || {
                [ $? = 2 ] || netem_status=1
        }
        return "$netem_status"
}
#       qemu's default riscv64 cpu is its richest one, with V at a vector
#       length of 128 bits, so the lane above runs the vector bodies at that
#       length only. It asks again with the cpu that has no V, which is the
#       scalar floor, and with V at 256 and 512 bits: a block is VLENB bytes,
#       and the tail it leaves the walk is not the same length.
lane_utf8()
{
        freestanding_checks_lane utf8 utf8 || return

        target_tools riscv64 || return $?
        failed=0

        for cpu in rv64 rv64,v=true,vlen=256 rv64,v=true,vlen=512; do
                target=riscv64
                target_runner="qemu-riscv64 -cpu $cpu"
                target_label=riscv64-$(printf '%s' "$cpu" | sed 's/rv64,v=true,vlen=/v/')
                freestanding_checks_one utf8 utf8 || failed=1
        done

        target_label=
        [ "$failed" = 0 ]
}
lane_hex()       { freestanding_checks_lane hex hex; }
lane_codec()     { freestanding_checks_lane codec codec; }
lane_fixed()     { freestanding_checks_lane fixed fixed; }
lane_table()     { freestanding_checks_lane table table; }
lane_storage_io() { freestanding_checks_lane storage_io storage_io; }

#
#       What an install writes, judged by the tools that own the formats.
#
#       The checks section asks the arithmetic on all three machines. Run once
#       more natively and given a directory, it writes ext4 filesystems from
#       64 MiB to 2 TiB and two whole disks laid out the way an install lays
#       one out, and e2fsck -fn and sfdisk --verify -- which are not this
#       project's code -- say whether the bytes are what they claim to be.
#
lane_storage_format()
{
        outcome=0
        freestanding_checks_lane storage_format storage_format || outcome=$?
        [ "$outcome" != 1 ] || return 1

        if ! command -v e2fsck > /dev/null 2>&1 ||
                ! command -v sfdisk > /dev/null 2>&1; then
                note "storage_format images: NOT RUN -- no e2fsck or sfdisk here"
                return 2
        fi

        writer="$work/storage_format.$host_arch"
        if [ ! -x "$writer" ]; then
                note "storage_format images: NOT RUN -- no native checks binary"
                return 2
        fi

        images="$work/storage_format.images"
        rm -rf "$images" && mkdir -p "$images" || return 1

        if ! "$writer" "$images" > "$images.out" 2>&1; then
                sed -n '/FAIL/p' "$images.out"
                rm -rf "$images"
                return 1
        fi

        checked=0
        refused=0

        for image in "$images"/ext4-*.img; do
                checked=$((checked + 1))
                if ! e2fsck -fn "$image" > "$images.fsck" 2>&1; then
                        refused=$((refused + 1))
                        note "e2fsck -fn refused ${image##*/}"
                        sed 's/^/    /' "$images.fsck" | head -8
                fi
        done

        for image in "$images"/disk-*.img; do
                checked=$((checked + 2))
                if ! sfdisk --verify "$image" > "$images.sfdisk" 2>&1; then
                        refused=$((refused + 1))
                        note "sfdisk --verify refused ${image##*/}"
                        sed 's/^/    /' "$images.sfdisk" | head -8
                fi

                offset=$(sfdisk -d "$image" 2>/dev/null |
                        awk -F '[=,]' '/name="moonwater-data"/ { print $2 * 512; exit }')
                if [ -z "$offset" ] ||
                        ! e2fsck -fn "$image?offset=$offset" > "$images.fsck" 2>&1; then
                        refused=$((refused + 1))
                        note "e2fsck -fn refused the data partition of ${image##*/}"
                        sed 's/^/    /' "$images.fsck" | head -8
                fi
        done

        rm -rf "$images" "$images.out" "$images.fsck" "$images.sfdisk"
        tally storage_format-images "$((checked - refused))" "$checked"
        [ "$refused" = 0 ]
}

lane_machine() { freestanding_checks_lane machine machine; }

#
#       monitor's clocks, temperatures, fans and power, read from sysfs trees
#       a seeded grammar makes up, against a model of what the rows must say.
#
lane_sensors() { freestanding_checks_lane sensors sensors; }

#
#       The moonwater command, which only the boot lane reached before: run
#       in a user and mount namespace with no network, chrooted into scratch
#       directories standing for /root, /etc, /run, /home and two bowls.
#       differential.py --harness moonwater_cli says what it holds it to.
#
lane_cli()
{
        need_shell || return 1
        python3 test/differential.py --harness moonwater_cli --shell "$shell_binary"
        cli_outcome=$?
        python3 test/differential.py --harness state_cuts --shell "$shell_binary"
        case $? in
        0) ;;
        2) [ "$cli_outcome" != 0 ] || cli_outcome=2 ;;
        *) cli_outcome=1 ;;
        esac
        return "$cli_outcome"
}
lane_leaving()   { freestanding_checks_lane leaving leaving; }
#       strtod and strtof against glibc, over generated text.
#
#       test/checks.c's CHECK_number_differential walks seeded blocks of
#       65,536 inputs and prints one hash a block over the bits, end offset
#       and errno of both conversions; its _reference twin prints the same
#       over the machine's glibc, and every block has to agree. The x86_64
#       glibc is the answer key for all three machines: this tree decides
#       tininess after rounding everywhere and arm64's glibc does not, and
#       the riscv64 cross toolchain carries glibc 2.41, which reads the
#       incomplete prefixes differently from 2.44. A block that disagrees is
#       run again case by case on both sides and the first differing cases
#       are shown. NUMBERS_BLOCKS is how many blocks the native run takes;
#       the two emulated machines take an eighth of that.
numbers_against_glibc()
(
        [ "$host_system" = Linux ] || {
                note "numbers-glibc: NOT RUN -- the reference is Linux glibc"
                exit 2
        }

        host=${CC:-gcc}
        blocks=${NUMBERS_BLOCKS:-16}
        reference=$work/number_differential.reference

        if ! $host -O2 -w -o "$reference" \
                -DCHECK_number_differential_reference test/checks.c \
                2> "$reference.err"
        then
                note "numbers-glibc: the glibc reference did not build -- not run"
                sed 's/^/    /' "$reference.err" | head -10
                exit 2
        fi

        "$reference" 0 "$blocks" > "$reference.out" || {
                note "numbers-glibc: the reference did not finish"
                exit 1
        }

        failed=0
        missing=0

        for target in x86_64 arm64 riscv64; do
                target_tools "$target" || { missing=1; continue; }

                count=$blocks
                [ -z "$target_runner" ] || count=$(( (blocks + 7) / 8 ))
                program=$work/number_differential.$target

                target_build freestanding_check number_differential \
                        "$program" "$target" || { failed=1; continue; }

                $target_runner "$program" 0 "$count" > "$program.out" 2>&1
                head -n "$count" "$reference.out" > "$program.expected"

                differing=$(diff "$program.expected" "$program.out" | grep -c '^>')
                total=$(( count * 65536 ))
                tally "numbers-glibc-$target" \
                        "$(( (count - differing) * 65536 ))" "$total"

                [ "$differing" = 0 ] && continue
                failed=1

                block=$(diff "$program.expected" "$program.out" |
                        sed -n 's/^> block \([0-9]*\) .*/\1/p' | head -1)
                note "numbers-glibc $target: $differing of $count blocks differ from glibc; block ${block:-?} case by case:"
                [ -n "$block" ] || continue

                "$reference" "$block" 1 "$block" > "$program.cases.expected"
                $target_runner "$program" "$block" 1 "$block" > "$program.cases" 2>&1
                diff "$program.cases.expected" "$program.cases" |
                        sed 's/^/    /' | head -24
        done

        [ "$failed" = 0 ] || exit 1
        [ "$missing" = 0 ] || exit 2
        exit 0
)

lane_numbers()
{
        freestanding_checks_lane numbers number
        numbers_outcome=$?
        numbers_against_glibc
        case $numbers_outcome$? in
        *1*) return 1 ;;
        *2*) return 2 ;;
        esac
}
#
#       scanf: CHECK_scan for what a comparison cannot state, and
#       CHECK_scan_differential's grid of formats against inputs compared with
#       the machine's glibc, whose twin CHECK_scan_differential_reference is
#       built by the host compiler. Digests are compared a block of 65536
#       cases at a time and the first block that differs is shown case by case.
#
lane_scan()
{
        scan_outcome=0
        freestanding_checks_lane scan scan || scan_outcome=$?

        if ! ${CC:-gcc} -O2 -w -o "$work/scan_reference" \
                -DCHECK_scan_differential_reference test/checks.c ||
                ! "$work/scan_reference" > "$work/scan_reference.out"
        then
                note "scan_differential: the glibc reference did not build or finish"
                return 1
        fi

        target_lane scan_differential_one || scan_outcome=1
        return "$scan_outcome"
}

scan_differential_one()
{
        sd_binary=$work/scan_differential.$target
        target_build freestanding_check scan_differential "$sd_binary" \
                "$target" || return 1
        $target_runner "$sd_binary" > "$sd_binary.out" 2>&1
        sd_cases=$(sed -n 's/^cases //p' "$work/scan_reference.out")
        sd_agreed=$(awk -v cases="$sd_cases" 'NR == FNR { want[FNR] = $0; next }
                $0 == want[FNR] && $1 == "block" {
                        same += ($2 + 1) * 65536 > cases ? cases - $2 * 65536 : 65536
                } END { print same + 0 }' "$work/scan_reference.out" "$sd_binary.out")
        tally "scan_differential-$target" "$sd_agreed" "$sd_cases"
        cmp -s "$work/scan_reference.out" "$sd_binary.out" && return 0

        sd_block=$(diff "$work/scan_reference.out" "$sd_binary.out" |
                sed -n 's/^< block \([0-9]*\) .*/\1/p' | head -1)
        note "scan_differential-$target: block ${sd_block:-?} differs from glibc:"
        "$work/scan_reference" $((${sd_block:-0} * 65536)) 65536 detail > "$sd_binary.want"
        $target_runner "$sd_binary" $((${sd_block:-0} * 65536)) 65536 detail > "$sd_binary.got" 2>&1
        diff "$sd_binary.want" "$sd_binary.got" | head -20 | sed 's/^/    /'
        return 1
}
lane_process()   { freestanding_checks_lane process process; }
lane_signal()    { freestanding_checks_lane signal signal && glibc_twin signal -no-pie; }
lane_lock()      { freestanding_checks_lane lock lock; }
#
#       A section's lines against glibc's: the section built by the host
#       compiler over the machine's glibc with the given flags prints the
#       lines every target's run of it printed, and the sed range names the
#       lines both have to share. A failure the reference reports is glibc's
#       own and fails the lane too, since a check glibc fails asks the wrong
#       question.
#
transcript_against_glibc()
{
        tg_name=$1 tg_range=$2
        shift 2
        [ "$host_system" = Linux ] || {
                note "$tg_name: the glibc reference needs Linux -- not run"
                return 2
        }
        tg_reference=$work/$tg_name.reference
        if ! gcc -O2 -std=gnu17 -w "$@" -o "$tg_reference" test/checks.c -lm \
                2> "$tg_reference.log"
        then
                note "$tg_name: the glibc reference did not build"
                sed 's/^/    /' "$tg_reference.log" | head -10
                return 1
        fi
        tg_failed=0
        "$tg_reference" > "$tg_reference.out" || {
                note "$tg_name: glibc itself failed a check, which is a bug here"
                sed -n '/FAIL/p' "$tg_reference.out" | head -10
                tg_failed=1
        }
        sed -n "$tg_range" "$tg_reference.out" > "$tg_reference.lines"
        for tg_target in x86_64 arm64 riscv64; do
                tg_out=$work/$tg_name.$tg_target.out
                [ -f "$tg_out" ] || continue
                sed -n "$tg_range" "$tg_out" > "$tg_out.lines"
                tally "$tg_name-glibc-$tg_target" "$(awk 'NR == FNR { want[FNR] = $0; next }
                        $0 == want[FNR] { same++ } END { print same + 0 }' \
                        "$tg_reference.lines" "$tg_out.lines")" "$(wc -l < "$tg_reference.lines")"
                cmp -s "$tg_reference.lines" "$tg_out.lines" && continue
                note "$tg_name on $tg_target differs from glibc:"
                diff "$tg_reference.lines" "$tg_out.lines" | head -20 | sed 's/^/    /'
                tg_failed=1
        done
        return "$tg_failed"
}
#
#       errno and strerror. CHECK_error's TRANSCRIPT lines are the half a
#       reference shows: CHECK_error_reference prints the same lines over the
#       machine's glibc, and every target's lines have to be those.
#
lane_error()
{
        freestanding_checks_lane error error
        error_outcome=$?

        transcript_against_glibc error /TRANSCRIPT/p -DCHECK_error_reference
        case $error_outcome$? in
        *1*) return 1 ;;
        *2*) return 2 ;;
        esac
}
lane_strings()   { freestanding_checks_lane strings strings && glibc_twin strings -no-pie; }
#
#       The environment against glibc's. CHECK_environment walks seeded
#       sequences of setenv, unsetenv, putenv, clearenv and getenv and prints
#       every answer and what environ holds after it; the three machines must
#       print what glibc prints for the same calls.
#
lane_stdlib()
{
        freestanding_checks_lane stdlib stdlib
        stdlib_outcome=$?
        freestanding_checks_lane environment environment
        environment_outcome=$?
        transcript_against_glibc environment '1,/^shared-end$/p' \
                -DCHECK_environment -DENVIRONMENT_REFERENCE
        case $stdlib_outcome$environment_outcome$? in
        *1*) return 1 ;;
        *2*) return 2 ;;
        esac
}
lane_clock()     { freestanding_checks_lane clock clock; }
#
#       fmod and remainder against glibc's libm. CHECK_modulo prints one digest
#       per generator class of every answer, NaNs folded to one pattern, and
#       the digests from all three machines must be the ones glibc gives for
#       the same pairs. -fno-builtin matters: without it GCC expands the
#       reference's fmod as an x87 fprem loop and the lane would compare
#       against the compiler rather than against glibc.
#
#       The math lane's differential half reads glibc's long double answers,
#       from CHECK_math_differential_reference built by the host compiler, on
#       its standard input.
lane_math()
{
        freestanding_checks_lane math math
        math_outcome=$?
        if ${CC:-gcc} -O2 -w -o "$work/math_reference" \
                -DCHECK_math_differential_reference test/checks.c -lm &&
                "$work/math_reference" > "$work/math_reference.out"
        then
                check_input=$work/math_reference.out
                freestanding_checks_lane math_differential math_differential
                case $? in
                1) math_outcome=1 ;;
                2) [ "$math_outcome" != 0 ] || math_outcome=2 ;;
                esac
                check_input=
        else
                note "math_differential: the glibc reference did not build or finish"
                math_outcome=1
        fi
        freestanding_checks_lane modulo modulo
        modulo_outcome=$?
        transcript_against_glibc modulo '/^pairs /,/^shared-end$/p' \
                -fno-builtin -DCHECK_modulo -DMODULO_REFERENCE
        case $math_outcome$modulo_outcome$? in
        *1*) return 1 ;;
        *2*) return 2 ;;
        esac
}
lane_format()
{
        format_status=0
        for format_suite in format format_standalone format_differential; do
                if [ "$format_suite" = format_differential ]; then
                        format_differential && continue
                else
                        freestanding_checks_lane "$format_suite" "$format_suite" && continue
                fi
                case $? in
                2) [ "$format_status" != 0 ] || format_status=2 ;;
                *) format_status=1 ;;
                esac
        done
        return "$format_status"
}

#
#       printf against the machine's glibc, generated.
#
#       CHECK_format_differential has two index spaces. The drawn one takes a
#       double from one of the families its body names, one of %f %F %e %E
#       %g %G, flags, a width and a precision up to 1100, from its index
#       alone. The grid walks every flag spelling against every width,
#       precision, length modifier, conversion and value of each kind in full
#       -- integers, strings, characters, pointers and doubles -- and holds
#       every case CHECK_format used to pin one line at a time. Each prints
#       one digest per 65536 cases of every byte snprintf wrote and every
#       length it answered; CHECK_format_differential_reference is the same
#       body over glibc, built by the host compiler and run once. Each
#       target's digests are compared line for line, and the first block that
#       disagrees is run again on both sides with one line per case.
#
#       Each target is built three times: as it ships; with
#       FORMAT_ESTIMATE_ALWAYS, which sends every scaling through the 128 bit
#       estimate that otherwise only the extremes of the range reach; and in
#       CHECK_format's standalone arrangement, lib.c and lib.util.c alone.
#
#       FORMAT_DIFFERENTIAL_BLOCKS is how many drawn blocks run natively
#       (default 64, which is 4194304 cases) and
#       FORMAT_DIFFERENTIAL_EMULATED_BLOCKS how many run under qemu (default
#       8). The grid always runs whole. A reference that will not build where
#       the host compiler exists is a failure, not a lane that did not run:
#       the pinned cases it replaced needed no glibc.
#
format_differential()
{
        fd_host=${CC:-gcc}
        fd_blocks=${FORMAT_DIFFERENTIAL_BLOCKS:-64}
        fd_emulated=${FORMAT_DIFFERENTIAL_EMULATED_BLOCKS:-8}
        fd_most=$fd_blocks
        [ "$fd_emulated" -le "$fd_most" ] || fd_most=$fd_emulated

        if ! command -v "$fd_host" > /dev/null 2>&1; then
                note "format_differential: no host compiler, the glibc reference cannot be built -- not run"
                return 2
        fi

        if ! $fd_host -O2 -w -o "$work/format_reference" \
                -DCHECK_format_differential_reference test/checks.c \
                2> "$work/format_reference.err" ||
                ! "$work/format_reference" 0 $((fd_most * 65536)) \
                        > "$work/format_reference.out" ||
                ! "$work/format_reference" grid > "$work/format_reference.grid"
        then
                note "format_differential: the glibc reference did not build or finish"
                sed 's/^/    /' "$work/format_reference.err" | head -10
                return 1
        fi

        fd_outcome=0

        for fd_variant in shipped estimate standalone; do
                target_lane format_differential_one "$fd_variant" && continue
                case $? in
                2) [ "$fd_outcome" != 0 ] || fd_outcome=2 ;;
                *) fd_outcome=1 ;;
                esac
        done

        return "$fd_outcome"
}

format_differential_one()
{
        fd_name=$target
        fd_runner=$target_runner
        fd_count=$fd_blocks
        fd_suite=format_differential
        fd_flags=
        [ -z "$fd_runner" ] || fd_count=$fd_emulated

        case $1 in
        estimate) fd_suite=format_differential_estimate fd_flags=-DFORMAT_ESTIMATE_ALWAYS ;;
        standalone) fd_suite=format_differential_standalone fd_flags=-DFORMAT_STANDALONE ;;
        esac

        fd_binary=$work/$fd_suite.$fd_name

        # shellcheck disable=SC2086 # an empty flag is no argument at all
        target_build freestanding_check format_differential "$fd_binary" \
                "$fd_name" $fd_flags || return 1

        $fd_runner "$fd_binary" 0 $((fd_count * 65536)) > "$fd_binary.out" 2>&1
        fd_status=$?
        $fd_runner "$fd_binary" grid >> "$fd_binary.out" 2>&1 || fd_status=$?

        head -n "$fd_count" "$work/format_reference.out" > "$fd_binary.want"
        cat "$work/format_reference.grid" >> "$fd_binary.want"
        fd_grid=$(sed -n 's/^cases //p' "$work/format_reference.grid")
        fd_total=$((fd_count * 65536 + fd_grid))

        #       A block is 65536 cases, the grid's last one what is left, and
        #       the grid's closing count line is worth nothing.
        fd_agreed=$(awk -v grid="$fd_grid" 'NR == FNR { want[FNR] = $0; next }
                $0 == want[FNR] && $1 != "cases" {
                        same += ($1 == "grid" && ($2 + 1) * 65536 > grid) ?
                                grid - $2 * 65536 : 65536
                } END { print same + 0 }' "$fd_binary.want" "$fd_binary.out")

        tally "$fd_suite-$fd_name" "$fd_agreed" "$fd_total"

        [ "$fd_status" = 0 ] && [ "$fd_agreed" = "$fd_total" ] &&
                cmp -s "$fd_binary.want" "$fd_binary.out" && return 0

        fd_line=$(diff "$fd_binary.want" "$fd_binary.out" |
                sed -n 's/^\([0-9][0-9]*\)[acd,].*/\1/p' | head -1)
        fd_line=$(sed -n "${fd_line:-1}p" "$fd_binary.want")
        fd_block=$(echo "$fd_line" | awk '{ print $2 }')
        case $fd_line in
        grid*) fd_space="grid $((fd_block * 65536)) 65536 detail" ;;
        *) fd_space="$((fd_block * 65536)) 65536 detail" ;;
        esac

        note "$fd_suite-$fd_name: status $fd_status, ${fd_line%% *} $fd_block differs from glibc:"
        # shellcheck disable=SC2086 # the space is several arguments
        "$work/format_reference" $fd_space > "$fd_binary.want.detail"
        # shellcheck disable=SC2086
        $fd_runner "$fd_binary" $fd_space > "$fd_binary.detail" 2>&1
        diff "$fd_binary.want.detail" "$fd_binary.detail" | head -20 |
                sed 's/^/    /'
        return 1
}

lane_known()
{
        target_lane known_one
}

#
#       The rest of <stdio.h> against glibc's, on three machines.
#
#           sh test/run spool
#
#       Everything here is a comparison, for the reason the stream lane
#       gives: glibc is on the machine, glibc defines what remove, mkstemp,
#       tmpfile, popen, pclose, fgetpos and the unlocked spellings answer, and
#       an implementation that is merely self-consistent is worth nothing.
#
#       One program, built four times from one body. The reference links glibc
#       through the host compiler; the other three are freestanding spark
#       links for x86_64, arm64 and riscv64 and run under their emulators.
#       Both the trace each one prints and the tree of files each one leaves
#       behind are compared.
#
#       The pipeline half of the trace forks and execs /bin/sh, which is a
#       host binary in every case -- qemu-user hands execve to the host kernel
#       -- so all four runs drive the same shell and any difference in the
#       trace is a difference in this library.
#
#       The reference needs glibc and a host compiler; without them the lane
#       reports that it did not run rather than passing on nothing. Each
#       target needs its cross compiler and its emulator, and a target
#       without them is named, and the lane did not run.
#
lane_spool()
(
work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-spool.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

counting spool 10 34
host=${CC:-gcc}

if ! command -v "$host" > /dev/null 2>&1; then
        printf '  no host compiler, the reference cannot be built -- not run\n'
        exit 2
fi

#
#       The reference, built and run once.
#
mkdir -p "$work/reference"

if ! $host -O2 -w -DWORK="\"$work/reference\"" \
        -o "$work/reference.elf" -DCHECK_spool_reference test/checks.c 2> "$work/ref.err"
then
        printf '  the glibc reference did not build -- not run\n'
        sed 's/^/    /' "$work/ref.err" | head -10
        exit 2
fi

"$work/reference.elf" > "$work/reference.out" 2>&1

if [ ! -s "$work/reference.out" ]; then
        printf '  the glibc reference printed nothing -- not run\n'
        exit 2
fi

#
#       Each target, built, run, and diffed against it.
#
spool_one()
{
        runner=$target_runner
        mkdir -p "$work/$target"

        if ! target_build freestanding_check spool "$work/spool.$target" \
                "$target" "-DWORK=\"$work/$target\""
        then
                lost "$target" "did not build"
                return 0
        fi

        if $runner "$work/spool.$target" > "$work/$target.out" 2>&1; then
                won
        else
                lost "$target" "internal invariant failed"
        fi

        if [ ! -s "$work/$target.out" ]; then
                lost "$target" "printed nothing"
                return 0
        fi

        if diff -u "$work/reference.out" "$work/$target.out" \
                > "$work/$target.diff" 2>&1
        then
                won
        else
                lost "$target" "the trace differs from glibc"
                sed 's/^/    /' "$work/$target.diff" | head -30
        fi

        #       The files each run left behind. Every entry here that creates
        #       something also removes it, so both trees must be empty; a
        #       temporary that outlives its stream, or a remove that removed
        #       nothing, shows up here and nowhere in the trace.
        if diff -r "$work/reference" "$work/$target" \
                > "$work/$target.tree" 2>&1
        then
                won
        else
                lost "$target" "the files left behind differ"
                sed 's/^/    /' "$work/$target.tree" | head -20
        fi
}

target_lane spool_one
counted $?
)

#
#       <stdio.h>'s FILE against glibc's, on three machines.
#
#           sh test/run stream
#
#       Everything here is a comparison. glibc is on the machine, it defines
#       what these functions answer, and a stdio that is merely self-consistent
#       is worth nothing -- so each of the three targets is built, run, and
#       diffed against a reference binary built by the host compiler from the
#       same source body.
#
#       Three programs, because three different things are being asked:
#
#         stream_body            files: seeks, ends, line reads, item counts,
#                                and after every call ftell, feof and ferror.
#                                Both the trace and the files produced are
#                                compared.
#         stream_standard_body   the three standard streams, once with regular
#                                files on them and once with pipes. A pipe
#                                cannot seek and that is the point.
#         stream_buffering_body  which buffering policy a terminal produces
#                                and which a file produces, observed from
#                                outside the process while it is paused.
#
#       The reference needs glibc and a host compiler; without them the lane
#       reports that it did not run rather than passing on nothing. Each
#       target needs its cross compiler and its emulator, and a target
#       without them is named, and the lane did not run.
#
lane_stream()
(
work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-stream.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

counting stream 10 34
host=${CC:-gcc}

if ! command -v "$host" > /dev/null 2>&1; then
        printf '  no host compiler, the reference cannot be built -- not run\n'
        exit 2
fi

#
#       The reference, built once.
#
mkdir -p "$work/reference"

if ! $host -O2 -w -DWORK="\"$work/reference\"" \
        -o "$work/t.reference" -DCHECK_stream_reference test/checks.c \
        2> "$work/ref.err"; then
        printf '  the glibc reference did not build -- not run\n'
        sed 's/^/    /' "$work/ref.err" | head -10
        exit 2
fi

$host -O2 -w -o "$work/s.reference" -DCHECK_stream_standard_reference \
        test/checks.c 2>> "$work/ref.err" || exit 2
$host -O2 -w -o "$work/b.reference" -DCHECK_stream_buffering_reference \
        test/checks.c 2>> "$work/ref.err" || exit 2

"$work/t.reference" > "$work/t.reference.out" 2>&1
if timeout 10 "$work/t.reference" --allocation; then
        won
else
        lost 'reference allocation failure' 'fdopen lost descriptor or ENOMEM'
fi

printf 'alpha\nbeta\n\ngamma' > "$work/input.txt"

"$work/s.reference" < "$work/input.txt" \
        > "$work/s.reference.out" 2> "$work/s.reference.err" 3> "$work/s.reference.trace"

printf 'alpha\nbeta\n\ngamma' |
        "$work/s.reference" 2> "$work/p.reference.err" 3> "$work/p.reference.trace" |
        cat > "$work/p.reference.out"

#
#       What is on disk while the program is still holding it. script's own
#       typescript is buffered unless it is told to flush, which is why -f is
#       not optional here.
#
terminal_ready=no

if command -v script > /dev/null 2>&1; then
        terminal_ready=yes
fi

held_on_file() {
        rm -f "$work/held.out"
        "$@" > "$work/held.out" 2>/dev/null &
        held=$!
        sleep 0.35
        wc -c < "$work/held.out" | tr -d ' '
        wait $held 2>/dev/null
}

held_on_terminal() {
        rm -f "$work/held.tty"
        script -q -f -c "$*" "$work/held.tty" > /dev/null 2>&1 &
        held=$!
        sleep 0.35
        # The typescript carries a header line of its own; only what follows
        # the program's own first byte is being counted, so look for the text.
        if grep -q onetwo "$work/held.tty" 2>/dev/null; then
                echo yes
        else
                echo no
        fi
        wait $held 2>/dev/null
}

#       won always succeeds, so each "&& won ||" below loses only on the test.
reference_on_file=$(held_on_file "$work/b.reference")
[ "$reference_on_file" = 0 ] && won ||
        lost 'reference blocks on a file' "held $reference_on_file bytes, wanted 0"

if [ "$terminal_ready" = yes ]; then
        reference_on_terminal=$(held_on_terminal "$work/b.reference")
        [ "$reference_on_terminal" = yes ] && won ||
                lost 'reference lines on a terminal' 'nothing had been written'
fi

#
#       Each target: build, run, diff.
#
stream_one()
{
        runner=$target_runner
        mkdir -p "$work/$target"

        if ! target_build freestanding_check stream "$work/t.$target" "$target" \
                "-DWORK=\"$work/$target\""; then
                lost "$target build" "did not build"
                return 0
        fi

        if [ -z "$runner" ]; then
                if timeout 10 "$work/t.$target" --allocation; then
                        won
                else
                        lost "$target allocation failure" 'fdopen lost descriptor or ENOMEM'
                fi
                if command -v strace > /dev/null 2>&1; then
                        for stop in retval=0:0 error=ENOSPC:28 error=EINTR:4; do
                                if timeout 10 strace -qq -o "$work/write-stop.trace" \
                                        -e "inject=write:${stop%:*}:when=1+" \
                                        "$work/t.$target" --write-stop "${stop#*:}"; then
                                        won
                                else
                                        lost "$target write stop $stop" 'checked result, errno or spool descriptor leak'
                                fi
                        done
                else
                        printf '  %-10s %s\n' stream 'no strace, write-stop injections skipped'
                fi
        fi

        if ! target_build freestanding_check stream_standard "$work/s.$target" "$target"; then
                lost "$target standard build" "did not build"
                return 0
        fi

        if ! target_build freestanding_check stream_buffering "$work/b.$target" "$target"; then
                lost "$target buffering build" "did not build"
                return 0
        fi

        if timeout 30 $runner "$work/t.$target" > "$work/t.$target.out" 2>&1; then
                won
        else
                lost "$target internal invariants" "test returned failure"
        fi

        if diff -q "$work/t.reference.out" "$work/t.$target.out" > /dev/null; then
                won
        else
                lost "$target file trace" \
                        "$(diff "$work/t.reference.out" "$work/t.$target.out" | head -6 | tr '\n' '|')"
        fi

        if diff -r "$work/reference" "$work/$target" > /dev/null 2>&1; then
                won
        else
                lost "$target files produced" \
                        "$(diff -r "$work/reference" "$work/$target" 2>&1 | head -4 | tr '\n' '|')"
        fi

        $runner "$work/s.$target" < "$work/input.txt" \
                > "$work/s.$target.out" 2> "$work/s.$target.err" 3> "$work/s.$target.trace"

        printf 'alpha\nbeta\n\ngamma' |
                $runner "$work/s.$target" \
                        2> "$work/p.$target.err" 3> "$work/p.$target.trace" |
                cat > "$work/p.$target.out"

        for shape in s:files p:pipes; do
                for part in out err trace; do
                        got=$work/${shape%:*}.$target.$part
                        want=$work/${shape%:*}.reference.$part
                        if diff -q "$want" "$got" > /dev/null; then
                                won
                        else
                                lost "$target standard on ${shape#*:} ($part)" \
                                        "$(diff "$want" "$got" | head -4 | tr '\n' '|')"
                        fi
                done
        done

        held=$(held_on_file $runner "$work/b.$target")
        [ "$held" = 0 ] && won ||
                lost "$target blocks on a file" "held $held bytes, wanted 0"

        if [ "$terminal_ready" = yes ]; then
                held=$(held_on_terminal "$runner $work/b.$target")
                [ "$held" = yes ] && won ||
                        lost "$target lines on a terminal" 'nothing had been written'
        fi
}

target_lane stream_one
stream_outcome=$?

if [ "$terminal_ready" != yes ]; then
        printf '  %-10s %s\n' stream 'no script(1), the terminal half did not run'
fi

counted "$stream_outcome"
)

#
#       The allocator, on three machines and against the one on this one.
#
#           sh test/run allocator
#
#       The allocator section of test/checks.c runs on each architecture
#       against the allocator in src/lib.util.c with no C library under it,
#       and is built once more against glibc. Everything the test prints
#       before its "shared-end" line is a statement about behaviour rather
#       than about addresses, so those bytes have to be identical in all
#       four, and that is what is diffed. What each build prints after that
#       line is about its own internals and is shown rather than compared.
#
#       The three freestanding runs are the section lane's own: this reads
#       what they printed, and a target that did not build or did not run
#       has already been named there.
#
allocator_against_glibc()
(
[ "$host_system" = Linux ] || {
        note "allocator: the glibc reference needs Linux -- not run"
        exit 2
}

failed=0

note()
{
        printf '%s\n' "$*"
}

#       The reference first, because everything else is compared against it.
if ! gcc -O2 -std=gnu17 -w -DCHECK_allocator -DALLOCATOR_REFERENCE \
        -o "$work/allocator.reference" test/checks.c \
        2> "$work/allocator.reference.log"
then
        note "allocator: the glibc reference did not build"
        cat "$work/allocator.reference.log"
        exit 1
fi

if ! "$work/allocator.reference" > "$work/allocator.reference.out"
then
        note "allocator: glibc itself failed the test, which is a bug here"
        failed=1
fi

sed -n '1,/^shared-end$/p' "$work/allocator.reference.out" \
        > "$work/allocator.reference.shared"

for name in x86_64 arm64 riscv64; do
        out=$work/allocator.$name.out
        [ -f "$out" ] || continue

        sed -n '1,/^shared-end$/p' "$out" > "$out.shared"

        if ! diff -u "$work/allocator.reference.shared" "$out.shared" \
                > "$out.diff"
        then
                note "allocator $name: differs from glibc"
                cat "$out.diff"
                failed=1
                continue
        fi

        note "allocator $name: agrees with glibc"
        sed -n '/^shared-end$/,$p' "$out" | sed '1d;s/^/    /'
done

tally allocator-glibc "$((1 - failed))" 1
exit $failed
)

#       Failed before not run before passed, across both halves.
lane_allocator()
{
        freestanding_checks_lane allocator allocator
        allocator_outcome=$?
        allocator_against_glibc
        case $allocator_outcome$? in
        *1*) return 1 ;;
        *2*) return 2 ;;
        esac
}


#       A check is a section of test/checks.c by name, or a path when it is a
#       fixture a generator wrote into the work directory for this run.
freestanding_checks_one()
{
        suite=$1
        source=$2
        name=$target
        runner=$target_runner

        case $source in
        *.c) target_build freestanding "$source" "$work/$suite.$name" "$name" ;;
        *)   target_build freestanding_check "$source" "$work/$suite.$name" "$name" ;;
        esac || return 1

        #       Soft RLIMIT_AS is ignored under qemu-user; native host arch
        #       proves it. Pass --emulated so CHECK_reserve / CHECK_lock /
        #       CHECK_net log honest NOT RUN for AS rather than a false pass.
        if { [ "$suite" = reserve ] || [ "$suite" = lock ] ||
             [ "$suite" = net ]; } && [ -n "$runner" ]; then
                $runner "$work/$suite.$name" --emulated > "$work/$suite.$name.out" 2>&1
                status=$?
        elif [ -n "${check_input-}" ]; then
                $runner "$work/$suite.$name" < "$check_input" \
                        > "$work/$suite.$name.out" 2>&1
                status=$?
        else
                $runner "$work/$suite.$name" > "$work/$suite.$name.out" 2>&1
                status=$?
        fi

        if [ "$suite" = verify ]; then
                sed -n '/FAIL/p;/ABSENT/p;/under neither name here/p' \
                        "$work/$suite.$name.out"
        else
                sed -n '/FAIL/p;/NOT RUN/p' "$work/$suite.$name.out"
        fi

        line=$(sed -n 's/^\([0-9]*\) checks, \([0-9]*\) failures$/\1 \2/p' \
                "$work/$suite.$name.out")

        [ -n "$line" ] || { note "$name printed no verdict"; return 1; }

        checks=${line% *}
        bad=${line#* }

        tally "$suite-${target_label:-$name}" "$((checks - bad))" "$checks"

        [ "$status" = 0 ] && [ "$bad" = 0 ]
}

freestanding_checks_lane()
{
        suite=$1
        source=$2
        target_lane freestanding_checks_one "$suite" "$source"
}

target_lane()
{
        check=$1
        shift
        failed=0
        missing=0

        #       The check reads target, target_compiler and target_runner.
        #       The status is target_tools' when the tools are missing and
        #       the check's when it ran.
        for target in x86_64 arm64 riscv64; do
                outcome=0
                target_tools "$target" && "$check" "$@" || outcome=$?

                case $outcome in
                0) ;;
                2) missing=1 ;;
                *) failed=1 ;;
                esac
        done

        [ "$failed" = 0 ] || return 1
        [ "$missing" = 0 ] || return 2
        return 0
}

#
#       The byte order half is arithmetic and proves itself anywhere. The
#       socket half needs a loopback interface to bind to, which qemu-user
#       hands straight to the host kernel, so all three targets open real
#       sockets rather than only compiling the calls.
#
lane_socket() { freestanding_checks_lane socket socket; }

#
#       The message building half is arithmetic and proves itself anywhere.
#       The talking half reads the running kernel's link table, which any user
#       may do. Changing an interface needs privilege this may not have, so
#       the test attempts it and accepts the refusal -- run the lane under
#       `unshare -rn` and the same binary configures a real interface instead,
#       which is how the mutation path is actually covered.
#
#       tls_chains puts wget's certificate verdicts against openssl verify's
#       over a grammar of generated chains, served from loopback.
#       tls_hostnames puts the certificate name check against OpenSSL's over a
#       grammar of subjectAltNames and hosts. public_suffixes holds the
#       wildcard check's lookup to suffixes.inc and
#       anchors holds anchors.inc to the sizes and hashes net.c relies on. tls_peer
#       serves a grammar of TLS 1.3 flights and record streams from a
#       scripted server to wget and to OpenSSL's client, with real crypto.
#       http_response_framing holds the response parser to a written
#       accept/refuse matrix (and names deliberate disagreements with
#       Python's http.client).
#       The network libFuzzer targets are bounded ASan/UBSan runs
#       over seeds differential.py writes into each run's temporary
#       directory. NOT RUN (2) when clang/libFuzzer is absent.
#       Longer fuzzing is lane_fuzz and MSan is lane_msan, both run only when
#       named; neither is part of lane_net or a CI push job.
#       Fuzz exit 2 is soft: missing clang must not turn a green freestanding+
#       oracle lane into "did not run". Exit 1 from fuzz stays a hard fail.
#       Oracle harnesses (tls_chains / https_downgrade / http_response_framing)
#       still propagate exit 2 into net_outcome when the lane was otherwise 0.
#       security_hygiene holds the guards no one harness sees: registration
#       and soft-skip wiring, the seed tables, the verify lift's proves.
#       CHECK_net again with the tight tier (MOONWATER_STRICT 2, what
#       kernel/profile/sec_hardened builds), on the host architecture only: the RFC 9110 204/205
#       framing refusals live there, and no other build of the checks says
#       whether the tier still refuses what the default accepts.
net_tight_one()
{
        #       Native only: the check runs the host's own build, no runner.
        [ "$target" = "$host_arch" ] && [ -z "$target_runner" ] || return 0
        target_build freestanding_check net "$work/net.tight" "$target" \
                -DMOONWATER_STRICT=2 || return 1
        "$work/net.tight" > "$work/net.tight.out" 2>&1
        net_tight_status=$?
        sed -n '/FAIL/p;/NOT RUN/p' "$work/net.tight.out"
        net_tight_line=$(sed -n \
                's/^\([0-9]*\) checks, \([0-9]*\) failures$/\1 \2/p' \
                "$work/net.tight.out")
        [ -n "$net_tight_line" ] || { note "net tight printed no verdict"; return 1; }
        tally "net-tight-$target" "$(( ${net_tight_line% *} - ${net_tight_line#* } ))" \
                "${net_tight_line% *}"
        [ "$net_tight_status" = 0 ] && [ "${net_tight_line#* }" = 0 ]
}

lane_net()
{
        python3 test/differential.py --harness net_clock_fault || return 1
        python3 test/differential.py --harness net_math_proof || return 1
        python3 test/differential.py --harness wire_constants || return 1
        python3 test/differential.py --harness net_dependency_closure || return 1
        python3 test/differential.py --harness security_hygiene || return 1
        freestanding_checks_lane net net
        net_outcome=$?
        target_lane net_tight_one
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        #       The crypto against OpenSSL on all three machines: the vectors
        #       come from Python's cryptography, the answers from
        #       CHECK_crypto_vectors reading them on its standard input.
        python3 test/differential.py --harness crypto_vectors \
                > "$work/crypto_vectors.in"
        case $? in
        0)
                check_input=$work/crypto_vectors.in
                freestanding_checks_lane crypto_vectors crypto_vectors
                case $? in
                0) ;;
                2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
                *) net_outcome=1 ;;
                esac
                check_input=
                ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness tls_chains
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness tls_hostnames
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness tls_dates || net_outcome=1
        python3 test/differential.py --harness public_suffixes || net_outcome=1
        python3 test/differential.py --harness anchors || net_outcome=1
        python3 test/differential.py --harness g_tables || net_outcome=1
        need_shell || return 1
        python3 test/differential.py --harness tls_peer --shell "$shell_binary"
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness tls_peer --shell "$shell_binary" \
                --mutate 100
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        #       Delivery schedules and FIN/RST cuts under the record layer;
        #       MOONWATER_TLS_SCHEDULES lengthens it.
        python3 test/differential.py --harness tls_peer --shell "$shell_binary" \
                --schedule "${MOONWATER_TLS_SCHEDULES:-40}"
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness https_downgrade
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness http_response_framing
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness tls_der_fuzz
        case $? in
        0) ;;
        2) note "tls_der_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness tls_hs_fuzz
        case $? in
        0) ;;
        2) note "tls_hs_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness dhcp_fuzz; case $? in 0) ;; 2) note "dhcp_fuzz: skipped (soft) -- does not downgrade net" ;; *) net_outcome=1 ;; esac
        python3 test/differential.py --harness sntp_fuzz
        case $? in
        0) ;;
        2) note "sntp_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness wifi_eapol_fuzz
        case $? in
        0) ;;
        2) note "wifi_eapol_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness wifi_scan_fuzz
        case $? in
        0) ;;
        2) note "wifi_scan_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness bowl_sig_fuzz
        case $? in
        0) ;;
        2) note "bowl_sig_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness dns_fuzz
        case $? in
        0) ;;
        2) note "dns_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness netlink_fuzz
        case $? in
        0) ;;
        2) note "netlink_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness crypto_fuzz
        case $? in
        0) ;;
        2) note "crypto_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness http_urls
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness wget_mutation --shell "$shell_binary"
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness wget_hostile --shell "$shell_binary"
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness hostile_strings --shell "$shell_binary"
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness http_fuzz
        case $? in
        0) ;;
        2) note "http_fuzz: skipped (soft) -- does not downgrade net" ;;
        *) net_outcome=1 ;;
        esac
        python3 test/differential.py --harness sntp_era
        case $? in
        0) ;;
        2) [ "$net_outcome" != 0 ] || net_outcome=2 ;;
        *) net_outcome=1 ;;
        esac
        return "$net_outcome"
}
#       Every network fuzz target for longer than lane_net's smoke, an hour
#       each with no run cap unless MOONWATER_FUZZ_SECONDS /
#       MOONWATER_FUZZ_RUNS say otherwise.
#       MOONWATER_FUZZ_REPORT=artifacts/fuzz-report.txt makes it the release
#       attach instead: lane_net's budget unless the knobs are set, and a JSON
#       report of toolchain, seeds, budget and exits written there.
lane_fuzz() { python3 test/differential.py --harness tls_fuzz; }
#       MemorySanitizer over hosted lifts of the net wire parsers, pad and
#       uninit proves, and short tls_der_fuzz / tls_hs_fuzz / dns_fuzz /
#       netlink_fuzz runs. Needs Linux clang's -fsanitize=memory; NOT RUN
#       without it.
lane_msan() { MOONWATER_MSAN=1 python3 test/differential.py --harness msan_net; }
lane_bowl() { freestanding_checks_lane bowl bowl; }
#       Freestanding CHECK_tar (paths, pax, magics), then a continuous
#       file↔directory↔symlink-to-dir pathname race against tar extract
#       (shallow + deep trees, private-edit / noclobber / install probes).
#       The race harness needs the shell applet farm; exit 2 (threads/rename
#       missing) is soft and does not downgrade a green freestanding lane.
#       Longer local stress: MOONWATER_PATHNAME_RACE_ROUNDS /
#       MOONWATER_PATHNAME_RACE_SECONDS (lane leaves both unset).
lane_tar()
{
        python3 test/differential.py --harness security_hygiene || return 1
        freestanding_checks_lane tar tar
        tar_outcome=$?
        if ! need_shell; then
                note "pathname_race: NOT RUN -- shell farm unavailable"
                [ "$tar_outcome" != 0 ] || tar_outcome=2
                return "$tar_outcome"
        fi
        python3 test/differential.py --harness pathname_race \
                --binary "ours=$shell_binary"
        case $? in
        0) ;;
        2) note "pathname_race: skipped (soft) -- threads/rename unavailable" ;;
        *) tar_outcome=1 ;;
        esac
        python3 test/differential.py --harness protected_links \
                --binary "ours=$shell_binary"
        case $? in
        0) ;;
        2) note "protected_links: NOT RUN -- no second uid for the namespace" ;;
        *) tar_outcome=1 ;;
        esac
        return "$tar_outcome"
}
lane_zstd() { freestanding_checks_lane zstd zstd; }
lane_gzip() { freestanding_checks_lane gzip gzip; }
lane_xz() { freestanding_checks_lane xz xz; }
lane_compression_floor() { freestanding_checks_lane compression_floor compression_floor; }
lane_compression()
{
        need_shell || return 1
        # Ubuntu's default umask 002 makes 0775 directories. The codec
        # staging path already accepts user-private group-writable parents;
        # pin 022 anyway so this lane does not depend on the caller's mask.
        umask 022
        python3 test/differential.py --harness compression --binary "ours=$shell_binary"
}

lane_reuse_shell() { freestanding_checks_lane reuse_shell reuse_shell; }

secure_creation_regressions()
(
        need_shell || exit 1
        place="$work/secure-creation"
        mkdir -m 0700 "$place" || exit 1
        trap 'chmod -R u+rwx "$place" 2> /dev/null || true' EXIT HUP INT TERM
        printf source > "$place/source" || exit 1
        chmod 0600 "$place/source" || exit 1
        mkdir -m 0777 "$place/unsafe" || exit 1
        mkdir -m 1777 "$place/sticky" || exit 1
        mkdir -m 0700 "$place/target" || exit 1
        ln -s target "$place/link" || exit 1

        cd "$place" || exit 1

        # An explicit empty suffix falls back to '~'.  Existing mode still
        # switches to numbered backups when a numbered series is present.
        printf newer > backup-source || exit 1
        printf older > backup-destination || exit 1
        "$farm/cp" -b -S '' backup-source backup-destination || exit 1
        [ "$(cat backup-destination)" = newer ] || exit 1
        [ "$(cat 'backup-destination~')" = older ] || exit 1

        printf newest > numbered-source || exit 1
        printf current > numbered-destination || exit 1
        printf prior > 'numbered-destination.~1~' || exit 1
        "$farm/cp" --backup=existing -S '' \
                numbered-source numbered-destination || exit 1
        [ "$(cat numbered-destination)" = newest ] || exit 1
        [ "$(cat 'numbered-destination.~2~')" = current ] || exit 1

        umask 0777

        "$farm/mkdir" -p a/b || exit 1
        "$farm/mkdir" -p -m 0640 c/d || exit 1
        "$farm/mkdir" -m 0640 e || exit 1
        "$farm/mkfifo" -m 0640 pipe || exit 1
        "$farm/mknod" -m 0640 node p || exit 1
        "$farm/install" -D source f/g/out || exit 1
        "$farm/install" -d -m 000 locked || exit 1
        "$farm/install" -d -m 2750 locked || exit 1
        "$farm/install" -d -m 0640 h/i || exit 1
        "$farm/mkdir" -m 4750 setuid || exit 1
        "$farm/mkdir" -m 4000 setuidzero || exit 1
        "$farm/mkdir" -p -m 2750 setgid/tree || exit 1
        "$farm/mkdir" -m 2755 inherited || exit 1
        "$farm/mkdir" -m 0755 inherited/leaf || exit 1

        modes=$(stat -c '%a' a a/b c c/d e pipe node f f/g f/g/out \
                locked h h/i setuid setuidzero setgid/tree inherited inherited/leaf |
                paste -sd:)
        [ "$modes" = 300:0:300:640:640:640:640:755:755:755:2750:755:640:4750:4000:2750:2755:2755 ] ||
                exit 1

        # A world-writable directory without the sticky bit is somewhere GNU
        # makes entries, and so does the default; the tight tier's refusal is
        # floodlight_hardened's (unsafe-* rows).
        "$farm/mkdir" -p unsafe/x || exit 1
        "$farm/mkfifo" -m 0600 unsafe/f || exit 1
        "$farm/mknod" -m 0600 unsafe/n p || exit 1
        "$farm/install" -D source unsafe/a/out || exit 1
        "$farm/install" -d unsafe/d/e || exit 1
        for entry in unsafe/x unsafe/f unsafe/n unsafe/a/out unsafe/d/e; do
                [ -e "$entry" ] || exit 1
        done
        [ -z "$(ls -A unsafe | grep moonwater-stage)" ] || exit 1

        "$farm/mkdir" -p -m 0700 sticky/x || exit 1
        "$farm/mkfifo" -m 0600 sticky/f || exit 1
        "$farm/mknod" -m 0600 sticky/n p || exit 1
        "$farm/install" -D source sticky/a/out || exit 1
        "$farm/install" -d -m 0700 sticky/d/e || exit 1

        "$farm/mkdir" -p link/x || exit 1
        "$farm/install" -D source link/out || exit 1
        "$farm/install" -d link/d || exit 1
        for entry in target/x target/out target/d; do
                [ -e "$entry" ] || exit 1
        done
)

#       Pure-state regressions for the verified builtin repairs, followed by
#       the descriptor-pinned creation paths whose contract needs real Linux
#       namespace and umask behavior.
lane_audit()
{
        failed=0
        freestanding_checks_lane audit-builtin audit_builtin_regressions ||
                failed=1
        freestanding_checks_lane path-stage path_stage || failed=1
        secure_creation_regressions
        verdict secure-creation failed 'secure creation mode, parent or symlink regression'
        return "$failed"
}

lane_regex() { freestanding_checks_lane regex regex; }


lane_slurp()
{
        freestanding_checks_lane slurp slurp
}

lane_wait()
{
        freestanding_checks_lane wait wait_retry
}

lane_writer()
{
        freestanding_checks_lane writer writer_buffer
}


#
#       The arm64 cases, run on this machine.
#
#           sh test/run native
#
#       Lifts each routine's arm64 body out of the library and links it into
#       the case beside it, so what runs is what is in the file.
#
#       Why arm64 and only arm64: there is no qemu-user on a Mac, so
#       CHECK_verify's differential cases cannot be run for a foreign
#       architecture from here. arm64 is not foreign. This is an arm64
#       machine, and AAPCS64 passes arguments in x0-x7 and returns in x0 on
#       Darwin exactly as it does on Linux; none of the string or memory
#       routines make a system call, so a body copied out of lib.c
#       between its label and its ret runs here unchanged. Darwin needs a
#       leading underscore on the symbol and has no .type or .size, so only
#       the three prologue lines differ from ASM_FUNC.
#
#       This is one architecture of three. x86_64 and riscv64 go through
#       CHECK_verify under the repo's own qemu.
#
native_lifted()
(
lib=${1:-src/lib.c}
# The assembly the text tools keep in their own source lifts the same way.
text=${2:-src/sh/text.c}

[ -f "$lib" ] || { echo "run: no such library: $lib" >&2; exit 1; }

#       The byte-commonness object is generated from one marked assembly
#       payload.  Before compiling it, mutate every part of that extraction
#       contract so missing/duplicate/mismatched wrappers, wrong size and
#       reordered content are all known to fail closed.
python3 test/differential.py --harness native_extract_test "$lib" || exit 1

work=$(mktemp -d "${TMPDIR:-/tmp}/native.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

#       Each header and what is lifted into it, one to a line. A header
#       carries what its case links and nothing more: string_find reaches
#       string_length, memory_search (and byte_commonness through it) and
#       memory_compare by name; the bulk bodies branch to memory_copy_apart,
#       so a case without the plain symbol stays out of that header; the wide
#       hunts are kept from string_find's followers; and where a case supplies
#       a reference itself -- the decimal tail of positive_into_base, human.c's
#       buffer adapters, fields.c's positive_into, reserve.c's allocator calls
#       -- it is left out. text_blank_field comes from the tool's own source,
#       floodlight_status_clear, env_find_hashed_span_probe, parse_keyword_of,
#       exec_function_slot and shell_assignment_kind from the shell's.
while read -r lifted_header lifted_source lifted_routines; do
        case $lifted_source in
        text) lifted_source=$text ;;
        builtin) lifted_source=src/sh/builtin.c ;;
        parse) lifted_source=src/sh/parse.c ;;
        exec) lifted_source=src/sh/exec.c ;;
        shell) lifted_source=src/sh/shell.c ;;
        util) lifted_source=src/lib.util.c ;;
        *) lifted_source=$lib ;;
        esac
        # shellcheck disable=SC2086 # the routines are separate arguments
        python3 test/differential.py --harness native_extract "$lifted_source" \
                $lifted_routines > "$work/$lifted_header.h" || exit 1
done <<'LIFTED'
lifted lib string_first_of string_first_of_or_end string_first_of_max string_find string_last_of_or_end string_compare_max string_length_max memory_first_of string_length memory_search memory_search_prepare memory_search_prepared_core memory_compare
bulk lib memory_fill memory_exchange_apart memory_frob memory_copy_apart memory_copy string_copy string_copy_max string_cut string_replace_all
reverse lib memory_reverse
series lib memory_decimal_series
squeeze lib memory_squeeze_bytes
offsets lib memory_offsets_of_either memory_offsets_between memory_offsets_outside memory_offsets_in_set
hash lib string_hash_33_length
join text text_blank_field
floodlight builtin floodlight_status_clear
keyword parse parse_keyword_of
envprobe builtin env_find_hashed_span_probe
funcslot exec exec_function_slot
assignment shell shell_assignment_kind
assignment_lib lib string_span string_span_max
wordkind parse parse_word_kind
arguments util argument_option_take
arguments_lib lib string_first_of string_compare_max memory_compare
floodlight_lib lib memory_first_of memory_compare
wide lib string_length string_length_max string_first_of string_first_of_or_end string_first_of_max string_last_of string_last_of_or_end memory_first_of
bases lib positive_into_base
base_field lib positive_into_base writer_fill positive_to_base_field
human lib positive_into_human_1024_string positive_to_human_1024
human_nearest lib positive_into_human_nearest_string wait_status_code_base wait_status_code
fields lib positive_into_padded positive_into_pair
input_bases lib string_digits_max string_digits_octal_escape_max string_digits_octal_max string_digits_hexadecimal_escape_max string_digits_hexadecimal_max string_digits_base_max
network lib network_load_16 network_load_32 network_store_16 network_store_32
reserve lib memory_growth memory_reserve memory_release
LIFTED

status=0
for case in byte_hunts bounded riscv_bits bulk reverse squeeze offsets hash join floodlight keyword envprobe funcslot assignment arguments series wide bases base_field human human_nearest fields input_bases network reserve; do
        cc -O2 -w -I"$work" "-DCHECK_native_$case" test/checks.c -o "$work/$case" || { status=1; continue; }
        "$work/$case" || status=1
done

exit $status
)

#       arm64 assembly on an arm64 machine.
#
#       The verify lane runs the foreign two under qemu, and a Mac has no
#       qemu-user -- but a Mac is one of the three machines. AAPCS64 passes
#       arguments in x0-x7 on Darwin exactly as it does on Linux and none of
#       these routines makes a system call, so a body lifted out of the
#       library runs here unchanged.
#
#       native_lifted above does the lifting directly out of the library that
#       ships; this reads its verdicts into the tally.
lane_native()
(
        if [ "$host_system" != Darwin ] || [ "$host_arch" != arm64 ]; then
                note "native: NOT RUN -- the lifting needs Darwin's Mach-O assembler on arm64"
                exit 2
        fi

        note "lifted out of src/lib.c"

        native_lifted src/lib.c > "$work/native.out" 2>&1
        answered=$?

        sed 's/^/  /' "$work/native.out"

        #       Every verdict is "<label>: <checks> checks" with nothing but
        #       failure counts after it, however a section spells them, so a
        #       section's failures are every number that follows its count.
        awk -F': ' '$2 ~ /^[0-9]+ checks/ {
                label = $1
                gsub(/ /, "-", label)
                count = split($2, number, /[^0-9]+/)
                failures = 0
                for (at = 2; at <= count; at++) failures += number[at]
                print label, number[1] - failures, number[1]
        }' "$work/native.out" >> "$TEST_TALLY"

        # A run that printed no verdict at all is a run that proved nothing,
        # which has to weigh something or it reads as a pass.
        [ "$answered" = 0 ] && grep -q ' checks' "$work/native.out"
)

#       spark.ld used to hide an RV64 process-entry ABI bug.  Its complete
#       layout did not relax small globals through gp, while the ordinary GNU
#       ELF script did; _start left the register at the kernel's unspecified
#       value and the first relaxed store went below address zero.  Build one
#       probe through that ordinary layout on purpose, then execute enough of
#       C startup to publish the environment and return through exit.
riscv_default_startup()
{
        startup_cross=riscv64-linux-gnu-gcc
        startup_runner=qemu-riscv64
        startup_image="$work/probe.riscv64-default"

        command -v "$startup_cross" > /dev/null 2>&1 || {
                note "RISC-V default-link startup: NOT RUN -- no $startup_cross"
                return 2
        }
        command -v "$startup_runner" > /dev/null 2>&1 || {
                note "RISC-V default-link startup: NOT RUN -- no $startup_runner"
                return 2
        }

        if ! "$startup_cross" -O2 -static -nostdlib -nostartfiles \
                -fno-stack-protector -fno-builtin \
                -march=rv64imafd_zicsr_zicntr -mabi=lp64d -w \
                -Wl,-e,_start -Wl,--build-id=none \
                -Wl,--no-warn-rwx-segments \
                -o "$startup_image" -DCHECK_probe test/checks.c \
                2> "$work/probe.riscv64-default.err"
        then
                note "the ordinary RISC-V ELF startup probe did not build:"
                sed 's/^/    /' "$work/probe.riscv64-default.err" | head -10
                return 1
        fi

        if ! "$startup_runner" "$startup_image" status 0 \
                > "$work/probe.riscv64-default.out" 2>&1
        then
                note "the ordinary RISC-V ELF startup probe did not exit cleanly:"
                sed 's/^/    /' "$work/probe.riscv64-default.out" | head -10
                return 1
        fi

        [ ! -s "$work/probe.riscv64-default.out" ] || {
                note "the ordinary RISC-V ELF startup probe wrote unexpected output:"
                sed 's/^/    /' "$work/probe.riscv64-default.out" | head -10
                return 1
        }
}

#
#       Running the probes and reading what came back.
#
#           sh test/run probe
#
#       The probe section of test/checks.c is the program; this is what asks it questions. The
#       probes existed for a long time and nothing ran them, so a stack of
#       arguments that arrived wrong, a .bss that arrived dirty or an exit
#       status that never came back would all have been silent.
#       What a function puts on the stack, and what a deep walk costs.
#
#       Two questions in one lane because they are one failure seen from two
#       sides. A frame is a number in the disassembly and costs nothing to
#       look at; a recursive walk turns that number into megabytes of
#       committed memory, and the first machine with a smaller stack turns it
#       into a crash. Neither `size`, nor RSS at startup, nor the section
#       table shows any of it, which is why it went unnoticed for so long:
#       ls_below held each level's subdirectory names in an array sized
#       LS_ARENA / 8 -- 128 kB of stack per level of nesting, to
#       FILE_MAX_DEPTH -- and file_ls_as put another 320 kB under it, so
#       `ls -R` over a tree anybody can make with mkdir -p walked five
#       megabytes down the stack. Both are arenas now and the walk needs 320
#       kB, which is why this lane exists rather than a note somewhere: the
#       number is only true until somebody puts an array back on the stack.
#
#       The ceilings below are pins in the same sense the differential engine
#       uses the word: they record what a function costs today so that growth
#       fails here rather than on the machine with the smaller stack. They are
#       not endorsements. ls_below's is a bug with a ceiling drawn around it,
#       and the ceiling is what keeps it from getting worse while it waits to
#       be fixed. A function that shrinks passes; lower its pin when it does,
#       and delete it when the frame drops under the notice threshold.
#
#       Reading frames out of the disassembly is written for x86_64 only. On
#       arm64 a large frame is built with a scratch register rather than an
#       immediate, so the same scan would quietly report nothing rather than
#       fail, and a check that cannot see what it is looking for is worse than
#       one that says so. The recursion measurement below is arithmetic the
#       kernel does and runs everywhere.
STACK_FRAME_NOTICE=32768

#       name ceiling -- the most this function may move %rsp in one go.
#
#       The pins from http_run down were drawn on 2026-09-24 over frames
#       that had landed unpinned and left this lane red. None of them
#       recurses: http_run, locale_auto_get, tls_handshake and the bowl and
#       host settings writers run once per command, and the *_tree_enter
#       functions are parallel_tree callbacks, called once per directory on
#       a pool thread's 8 MB stack. They are the size of their buffers, not
#       of a walk, so a ceiling at today's size is the whole of the risk.
stack_frame_pins()
{
        cat <<'PINS'
text_join 8192
text_comm 8192
tools_factor 67000
tools_dmesg_follow 4096
text_tail_start 4096
awk_option_seen 4096
http_run 312640
locale_auto_get 283648
bowl_write_pacman 266280
bowl_write_mirror 266248
host_settings_save 70648
tls_handshake 43368
find_tree_enter 37256
du_tree_enter 37256
host_update 33464
grep_tree_enter 33384
rm_tree_enter 33336
chown_tree_enter 33112
chmod_tree_enter 33112
cp_tree_enter 33080
host_settings_image 32776
PINS
}

#       The largest single stack allocation in each function, base names only:
#       gcc's .part/.isra/.constprop/.cold clones are the same source function
#       and would otherwise need a pin each, renamed by every compiler bump.
stack_frames_of()
{
        objdump -d --no-show-raw-insn "$1" 2>/dev/null | awk -v notice="$STACK_FRAME_NOTICE" '
                /^[0-9a-f]+ <.*>:/ {
                        name = $2
                        gsub(/[<>:]/, "", name)
                        sub(/\.(part|isra|constprop|cold)\.[0-9]+$/, "", name)
                        sub(/\.cold$/, "", name)
                }
                /^ +[0-9a-f]+:\tsub +\$0x[0-9a-f]+,%rsp$/ {
                        match($0, /0x[0-9a-f]+/)
                        v = strtonum(substr($0, RSTART, RLENGTH))
                        #       A borrow written as a subtraction of a huge
                        #       unsigned constant is not a frame.
                        if (v < 1073741824 && v > m[name]) m[name] = v
                }
                END { for (k in m) if (m[k] >= notice) printf "%d %s\n", m[k], k }
        ' | sort -rn
}

stack_frame_check()
{
        if [ "$host_arch" != x86_64 ]; then
                note "stack frames: read from x86_64 disassembly only, and this is $host_arch"
                return 2
        fi

        command -v objdump > /dev/null 2>&1 || {
                note "stack frames: no objdump here"
                return 2
        }

        stack_frames_of "$shell_binary" > "$work/frames" || return 1
        stack_frame_pins > "$work/frame-pins"

        frame_failed=0

        while read -r size name; do
                [ -n "$name" ] || continue
                ceiling=$(awk -v n="$name" '$1 == n { print $2 }' "$work/frame-pins")

                if [ -z "$ceiling" ]; then
                        note "$name puts $size bytes on the stack and has no pin"
                        note "  a new frame this large is the ls_below shape again; pin it or shrink it"
                        frame_failed=$((frame_failed + 1))
                        continue
                fi

                if [ "$size" -gt "$ceiling" ]; then
                        note "$name grew to $size bytes of stack, over its $ceiling pin"
                        frame_failed=$((frame_failed + 1))
                fi
        done < "$work/frames"

        [ "$frame_failed" -eq 0 ]
}

#       What `ls -R` costs, measured the way the failure is met: by giving it
#       a stack and seeing whether it lives. The ladder is reported rather
#       than asserted, so the number moves visibly as the frame is fixed; the
#       assertion is only that the common default still works, because that
#       is the one whose failure would be a crash on an ordinary machine.
#
#       As it stands that assertion has no headroom at all -- the walk needs
#       the whole 8 MB default -- so this passing is the narrowest possible
#       pass, and any growth in ls_below's frame turns it into a failure.
#       That is the intended behaviour of the pin and not a flaky test: the
#       margin really is zero, and the lane should say so the moment it goes.
LS_RECURSION_DEPTH=40
LS_RECURSION_STACK_KB=8192

stack_recursion_check()
{
        tree=$work/deep-tree
        rm -rf "$tree" || return 1

        deep=$tree
        at=0
        while [ "$at" -lt "$LS_RECURSION_DEPTH" ]; do
                deep=$deep/a
                at=$((at + 1))
        done

        mkdir -p "$deep" || return 1
        : > "$deep/leaf" || return 1

        #       A subshell so the limit dies with it, and a limit this shell
        #       is allowed to set: a hard limit below the ask would otherwise
        #       report the ulimit's failure as the tool's.
        #       A frame this size dies on a signal, and the shell announces
        #       that on its own stderr along with a core file. Both are the
        #       expected result of the measurement rather than news, so the
        #       subshell drops its cores and the announcement with them.
        lowest=none
        for limit in 16 32 64 128 256 384 512 1024 2048 4096 8192; do
                # dash and bash support these resource limits.
                # shellcheck disable=SC3045
                ( ulimit -c 0 2>/dev/null
                  ulimit -s "$limit" 2>/dev/null || exit 111
                  "$farm/ls" -R "$tree" > /dev/null 2>&1 ) 2>/dev/null
                case $? in
                0|1) [ "$lowest" = none ] && lowest=$limit ;;
                111) ;;
                esac
        done

        if [ "$lowest" = none ]; then
                note "ls -R survived no stack limit up to ${LS_RECURSION_STACK_KB} kB"
        else
                note "ls -R over $LS_RECURSION_DEPTH levels needs ${lowest} kB of stack (GNU ls: 16)"
        fi

        # shellcheck disable=SC3045
        ( ulimit -c 0 2>/dev/null
          ulimit -s "$LS_RECURSION_STACK_KB" 2>/dev/null || exit 111
          "$farm/ls" -R "$tree" > /dev/null 2>&1 ) 2>/dev/null
        outcome=$?

        case $outcome in
        111)
                note "ls -R: cannot set a ${LS_RECURSION_STACK_KB} kB stack limit here"
                return 2 ;;
        0|1)
                return 0 ;;
        *)
                note "ls -R died with status $outcome under a ${LS_RECURSION_STACK_KB} kB stack"
                note "  a recursive walk outgrowing the ordinary default is a crash, not a slowdown"
                return 1 ;;
        esac
}

lane_stack()
(
failed=0

need_shell || exit 1

frame_outcome=0
stack_frame_check || frame_outcome=$?
case $frame_outcome in
0) tally stack-frames 1 1 ;;
2) ;;
*)
        tally stack-frames 0 1
        failed=$((failed + 1))
        ;;
esac

recursion_outcome=0
stack_recursion_check || recursion_outcome=$?
case $recursion_outcome in
0) tally stack-recursion 1 1 ;;
2) ;;
*)
        tally stack-recursion 0 1
        failed=$((failed + 1))
        ;;
esac

[ "$failed" -eq 0 ]
)

#
lane_probe()
(
failed=0

freestanding_check probe "$work/probe" || exit 1
probe=$work/probe

[ -x "$probe" ] || { echo "no probe at $probe" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

counting probe

# Output and exit status both, because half of what these prove is the status.
expect()
{
        name=$1
        want=$2
        want_status=$3
        shift 3

        if "$@" > "$work/got" 2>&1; then
                got_status=0
        else
                got_status=$?
        fi

        printf '%s' "$want" > "$work/want"

        if cmp -s "$work/want" "$work/got" && [ "$want_status" = "$got_status" ]; then
                won
                return 0
        fi

        lost "$name" "want [$(tr '\n' '|' < "$work/want")]($want_status) got [$(tr '\n' '|' < "$work/got")]($got_status)"
}

# Keep the two descriptors apart when their destination, rather than their
# relative write order, is the fact under test.
expect_streams()
{
        name=$1
        want_stdout=$2
        want_stderr=$3
        want_status=$4
        shift 4

        if "$@" > "$work/got.stdout" 2> "$work/got.stderr"; then
                got_status=0
        else
                got_status=$?
        fi

        printf '%s' "$want_stdout" > "$work/want.stdout"
        printf '%s' "$want_stderr" > "$work/want.stderr"

        if cmp -s "$work/want.stdout" "$work/got.stdout" &&
           cmp -s "$work/want.stderr" "$work/got.stderr" &&
           [ "$want_status" = "$got_status" ]; then
                won
                return 0
        fi

        lost "$name" "stdout [$(tr '\n' '|' < "$work/got.stdout")] stderr [$(tr '\n' '|' < "$work/got.stderr")] status $got_status"
}

# The same, when only one line of the answer is the point.
expect_line()
{
        name=$1
        want=$2
        line=$3
        shift 3

        "$@" > "$work/got" 2>&1
        sed -n "${line}p" "$work/got" > "$work/line"
        printf '%s\n' "$want" > "$work/want"

        if cmp -s "$work/want" "$work/line"; then
                won
                return 0
        fi

        lost "$name" "line $line want [$want] got [$(cat "$work/line")]"
}

#
#       A stack of arguments.
#

expect_line 'counted'        '5 argument(s)'   1 "$probe" arguments a b c
expect_line 'called as'      "  0: $probe"     2 "$probe" arguments a b c
expect_line 'first is mode'  '  1: arguments'  3 "$probe" arguments a b c
expect_line 'third'          '  2: a'          4 "$probe" arguments a b c
expect_line 'last'           '  4: c'          6 "$probe" arguments a b c
expect_line 'no mode at all' 'probe: arguments regions environment logging diagnostic terminal spawn quack status' 1 "$probe"
expect_line 'mode only'      '2 argument(s)'   1 "$probe" arguments
expect_line 'an empty one'   '  2: '           4 "$probe" arguments '' x
expect_line 'one with space' '  2: a b'        4 "$probe" arguments 'a b'
expect_line 'one with a tab' '  2: a	b'        4 "$probe" arguments 'a	b'
expect_line 'a long one'     "  2: $(printf 'x%.0s' $(seq 200))" 4 \
        "$probe" arguments "$(printf 'x%.0s' $(seq 200))"

many=$(seq 100 | tr '\n' ' ')
# shellcheck disable=SC2086 # a hundred separate arguments is the point
expect_line 'a hundred'      '102 argument(s)' 1 "$probe" arguments $many

#
#       An exit status, which a spawner has to be able to read back.
#

for code in 0 1 7 42 255; do
        expect "status $code" '' "$code" "$probe" status "$code"
done

expect 'unknown mode' 'probe: arguments regions environment logging diagnostic terminal spawn quack status
' 2 "$probe" nosuchmode

#
#       The three regions the loader maps.
#

expect 'regions' 'bss zeroed:   yes
data initial: yes
data written: yes
bss written:  yes
' 0 "$probe" regions

expect 'quack' 'quack
' 0 "$probe" quack

#
#       The logging boundary and terminal fallback in the runtime assembly.
#

logging_x=$(printf 'x%.0s' $(seq 4096))
logging_want=A$(printf '%.*s' 4095 "$logging_x")B${logging_x}CDE
expect 'logging boundaries' "$logging_want" 0 "$probe" logging
expect 'diagnostic ordering' 'stdout-before
stderr-zero
stdout-middle
stderr-explicit
stdout-after
' 0 "$probe" diagnostic
expect_streams 'diagnostic descriptors' 'stdout-before
stdout-middle
stdout-after
' 'stderr-zero
stderr-explicit
' 0 "$probe" diagnostic
expect 'terminal fallback' '80 24
' 0 "$probe" terminal

#
#       The environment a spawner handed over.
#

if command -v env > /dev/null 2>&1; then
        expect 'environment' '  env: PROBE_SAYS=hello
' 0 env -i PROBE_SAYS=hello "$probe" environment

        expect 'no environment' 'environment is empty
' 1 env -i "$probe" environment
fi

#
#       /dev/spark, which only exists inside the image.
#

if [ -c /dev/spark ]; then
        expect_line 'spark device' 'device: 3' 1 "$probe" spawn
else
        printf '  %-24s %s\n' 'spark device' 'not here, skipped'
fi

counted || failed=1

startup_outcome=0
riscv_default_startup || startup_outcome=$?
case $startup_outcome in
0) tally probe-riscv64-default-startup 1 1 ;;
1)
        tally probe-riscv64-default-startup 0 1
        failed=1
        ;;
2) ;;
esac

[ "$failed" = 0 ]
)

lane_checksum() { freestanding_checks_lane checksum_crc checksum_crc; }

#
#       The differential engine, one domain at a time.
#
#       test/differential.py walks the grammar each domain declares -- every
#       option alone, every pair together, every operand and input shape, and
#       a seeded random tier -- through the farm and through the tools on this
#       machine, and compares status, output, effect and diagnostic. It writes
#       its own tally rows, one per program. Without python3, GNU coreutils,
#       dash and bash there is nothing to compare against, and the lane says
#       so rather than passing on nothing.
#
differential_ready()
{
        if ! command -v python3 > /dev/null 2>&1; then
                note "differential: NOT RUN -- no python3"
                return 2
        fi

        case $(ls --version 2> /dev/null) in
        *"GNU coreutils"*) ;;
        *)
                note "differential: NOT RUN -- the ls here is not GNU coreutils, the reference"
                return 2
                ;;
        esac

        if ! command -v dash > /dev/null 2>&1 || ! command -v bash > /dev/null 2>&1; then
                note "differential: NOT RUN -- dash and bash are the shell references"
                return 2
        fi
}

differential_domain()
{
        differential_ready || return 2
        need_shell || return 1

        differential_farm=${2:-$farm}

        differential_jobs=$(nproc 2> /dev/null || echo 4)

        #       The shell domain's cases spend their time waiting -- on a
        #       terminal to answer, a job to stop, a timeout to pass -- and
        #       leave the processor idle while they do: a run of one worker a
        #       processor held the load under one. Three a processor keep it
        #       busy, 886 seconds to 396 on the 32-thread box. The other
        #       domains compute and keep one a processor.
        case $1 in
        shell) differential_jobs=$((differential_jobs * 3)) ;;
        esac

        python3 test/differential.py "$differential_farm" --domain "$1" \
                --jobs "${MW_JOBS:-$differential_jobs}"
}

#       The shell as kernel/profile/sec_hardened configures it, built through
#       the configuration header an image build writes (switch_header, below
#       in kit), so its Floodlight policy string and dangerous-flag switches
#       reach the compile the way they reach the image's shell; a switch the
#       profile does not turn off keeps its Kconfig default, y. Another
#       whole-shell build, so run -j makes it beside the others.
need_hardened_shell()
{
        [ -x "$work/hardened-shell" ] && return 0
        build_tool config-header kernel/profile/sec_hardened \
                "$work/hardened.h" > "$work/hardened.h.log" 2>&1 ||
                { sed 's/^/    /' "$work/hardened.h.log"; return 1; }
        freestanding programs/shell.c "$work/hardened-shell.building" \
                "$host_arch" "-DMOONWATER_CONFIG=\"$work/hardened.h\"" ||
                return 1
        mkdir -p "$work/hardened-bin" || return 1
        for hardened_name in $utilities bash sh; do
                ln -sf "$work/hardened-shell" "$work/hardened-bin/$hardened_name" ||
                        return 1
        done
        mv "$work/hardened-shell.building" "$work/hardened-shell"
}

#       What sec_hardened refuses, refused, by the shell's own copy of it on a
#       machine with no register; and what it does not name, still allowed.
#       Flag and run rows need nothing of /proc, so they hold with it masked;
#       awk's spawn denial needs confinement, which cannot be proved there,
#       so awk is refused outright -- the policy failing closed. Each row is
#       name, status, a word the output must hold, and the command.
floodlight_hardened()
{
        need_hardened_shell || return 1
        hardened_failed=0
        hardened_masked=0
        /usr/bin/unshare -rm true 2> /dev/null && hardened_masked=1
        while IFS='|' read -r hardened_case hardened_want hardened_needle \
                hardened_command; do
                [ -n "$hardened_case" ] || continue
                case $hardened_case in
                masked-*) [ "$hardened_masked" = 1 ] || continue ;;
                esac
                PATH="$work/hardened-bin:/usr/bin:/bin" HB="$work/hardened-bin" \
                        /bin/sh -c "$hardened_command" > "$work/hardened.out" 2>&1
                hardened_got=$?
                [ "$hardened_got" = "$hardened_want" ] &&
                        { [ -z "$hardened_needle" ] ||
                          grep -q -- "$hardened_needle" "$work/hardened.out"; }
                verdict "floodlight-hardened-$hardened_case" hardened_failed 'floodlight hardened $hardened_case: status $hardened_got, want $hardened_want: $(head -c 200 "$work/hardened.out")'
        done <<'HARDENED'
find-exec|126|flag refused|find /dev/null -exec true {} ';'
find-execdir|126|flag refused|find /dev/null -execdir true {} ';'
find-delete|126|flag refused|find /dev/null -delete
find-fprint|126|flag refused|find /dev/null -fprint /dev/null
find-print|0||find /dev/null -print
env-split|126|flag refused|env -S true
env-split-cluster|126|flag refused|env -iS true
env-split-long|126|flag refused|env --split-string=true
env-named|0||env true
xargs|126|run refused|xargs < /dev/null
split-filter|126|flag refused|split --filter=cat /dev/null
split-filter-abbreviated|126|flag refused|split --fil=cat /dev/null
sort-compress|126|flag refused|sort --compress-program=gzip /dev/null
timeout|126|run refused|timeout 5 true
nice|126|run refused|nice true
unshare|126|run refused|unshare true
chroot|126|run refused|chroot / true
wget|126|run refused|wget
shell-find-delete|126|flag refused|"$HB/sh" -c 'find /dev/null -delete'
shell-xargs|126|run refused|"$HB/sh" -c 'xargs < /dev/null'
cat|0||cat /dev/null
unsafe-mkdir|1|Permission denied|d=$(mktemp -d) && chmod 0777 "$d" && "$HB/mkdir" -p "$d/x"; s=$?; rm -rf "$d"; exit $s
unsafe-mkfifo|1|Permission denied|d=$(mktemp -d) && chmod 0777 "$d" && "$HB/mkfifo" "$d/f"; s=$?; rm -rf "$d"; exit $s
unsafe-mknod|1|Permission denied|d=$(mktemp -d) && chmod 0777 "$d" && "$HB/mknod" "$d/n" p; s=$?; rm -rf "$d"; exit $s
unsafe-install|1|Permission denied|d=$(mktemp -d) && chmod 0777 "$d" && echo x > "$d.src" && "$HB/install" -D "$d.src" "$d/a/out"; s=$?; rm -rf "$d" "$d.src"; exit $s
unsafe-cp|1|Permission denied|d=$(mktemp -d) && chmod 0777 "$d" && echo x > "$d.src" && "$HB/cp" "$d.src" "$d/c"; s=$?; rm -rf "$d" "$d.src"; exit $s
cp-link-replaced|0||d=$(mktemp -d) && cd "$d" && echo a > f && ln -s f l && echo b > g && "$HB/cp" g l && [ "$(cat f)" = a ] && [ ! -L l ] && [ "$(cat l)" = b ]; s=$?; cd /; rm -rf "$d"; exit $s
cp-dangling-refused|1|not writing through dangling|d=$(mktemp -d) && cd "$d" && echo b > g && ln -s gone l && POSIXLY_CORRECT=1 "$HB/cp" g l; s=$?; cd /; rm -rf "$d"; exit $s
split-link-replaced|0||d=$(mktemp -d) && cd "$d" && echo a > t && ln -s t xaa && seq 2 | "$HB/split" -b 1 - && [ "$(cat t)" = a ] && [ ! -L xaa ]; s=$?; cd /; rm -rf "$d"; exit $s
csplit-link-replaced|0||d=$(mktemp -d) && cd "$d" && echo a > t && ln -s t xx01 && seq 2 | "$HB/csplit" -k - 2 > /dev/null && [ "$(cat t)" = a ] && [ ! -L xx01 ]; s=$?; cd /; rm -rf "$d"; exit $s
chown-L-not-followed|0||d=$(mktemp -d) && cd "$d" && mkdir t && ln -s /etc t/e && n=$("$HB/chown" -RL "$(id -u)" t 2>&1 | wc -l); cd /; rm -rf "$d"; [ "$n" -le 1 ]
cp-tree-staged|0||d=$(mktemp -d) && cd "$d" && mkdir s && mkfifo s/f && { timeout 5 "$HB/cp" -R --copy-contents s t & p=$!; sleep 1; [ ! -e t ]; r=$?; kill $p 2>/dev/null; wait $p 2>/dev/null; cd /; rm -rf "$d"; exit $r; }
install-owner-discarded|1|cannot publish|[ "$(id -u)" = 0 ] && { echo cannot publish; exit 1; }; d=$(mktemp -d) && echo x > "$d.src" && "$HB/install" -o 0 "$d.src" "$d/out"; s=$?; [ -e "$d/out" ] && s=9; rm -rf "$d" "$d.src"; exit $s
sticky-mkdir|0||d=$(mktemp -d) && chmod 1777 "$d" && "$HB/mkdir" -p "$d/x"; s=$?; rm -rf "$d"; exit $s
masked-find-exec|126|flag refused|/usr/bin/unshare -rm /bin/sh -c 'mount -t tmpfs tmpfs /proc && "$HB/find" /dev/null -exec true {} ";"'
masked-awk|126||/usr/bin/unshare -rm /bin/sh -c 'mount -t tmpfs tmpfs /proc && echo x | "$HB/awk" 1'
masked-cat|0||/usr/bin/unshare -rm /bin/sh -c 'mount -t tmpfs tmpfs /proc && "$HB/cat" /dev/null'
HARDENED
        return "$hardened_failed"
}

#       The self-test drives the engine end to end on a farm of its own, and
#       those inner runs write tally rows like any run does. Only the oracle's
#       own verdict belongs in this tally, so it gets a file of its own and
#       that one row is carried over.
lane_differential_oracle()
{
        if ! command -v python3 > /dev/null 2>&1; then
                note "differential oracle: NOT RUN -- no python3"
                return 2
        fi

        : > "$work/oracle.tally"
        TEST_TALLY="$work/oracle.tally" python3 test/differential.py --self-test
        oracle_status=$?
        grep '^differential-oracle ' "$work/oracle.tally" >> "$TEST_TALLY"
        return "$oracle_status"
}

#       sort cuts its work into fixed blocks and hands them to the pool, so
#       its bytes must not move with the width it runs at. An input well past
#       a block is sorted at one CPU, at every CPU the affinity allows, with
#       --parallel=1, and by the reference, under keys that take each path:
#       radix windows, numbers, comparator keys, -u and -s ties, a spill.
text_sort_widths()
{
        need_shell || return 1

        if ! command -v taskset > /dev/null 2>&1; then
                note "sort widths: NOT RUN -- no taskset"
                return 0
        fi

        widths="$work/sort-widths"
        mkdir -p "$widths" || return 1
        awk 'BEGIN {
                srand(11)
                for (i = 0; i < 300000; i++)
                        printf "%08x %d %s%d tail\n", int(rand() * 4294967295),
                               int(rand() * 2000000) - 1000000,
                               i % 7 ? "word" : "Word", int(rand() * 1000)
        }' > "$widths/input" || return 1

        width_pass=0
        width_total=0
        # The CPU this lane already runs on, so one-CPU cases stay inside it.
        width_cpu=$(taskset -pc $$ | sed 's/.*: *//; s/[-,].*//')

        sort_width_case()
        {
                width_input=$1
                shift
                want=$(LC_ALL=C sort "$@" "$width_input" | cksum)
                one=$(LC_ALL=C taskset -c "$width_cpu" "$farm/sort" "$@" "$width_input" | cksum)
                every=$(LC_ALL=C "$farm/sort" "$@" "$width_input" | cksum)
                alone=$(LC_ALL=C "$farm/sort" --parallel=1 "$@" "$width_input" | cksum)
                width_total=$((width_total + 1))

                if [ "$want" = "$one" ] && [ "$want" = "$every" ] &&
                        [ "$want" = "$alone" ]; then
                        width_pass=$((width_pass + 1))
                else
                        note "sort widths [$*]: reference $want, one CPU $one, every CPU $every, --parallel=1 $alone"
                fi
        }

        # -R hashes each key once, in its window, and the hash is the same at
        # every width and GNU's for the same random source.
        for options in "" "-r" "-n -k2,2" "-k3" "-u -k3,3" "-s -k3,3" "-f" \
                "-V -k3" "-h -k2" "-S 1M -k2,2n" "-rs -t x -k2" \
                "-R --random-source=$widths/input" "-Ru -k3,3 --random-source=$widths/input" \
                "-rR -k2 --random-source=$widths/input"; do
                sort_width_case "$widths/input" $options
        done

        #       Past 64 MiB of spilled runs the merge itself is cut into
        #       pieces for the pool, and an 8 MiB buffer spills a dozen runs.
        awk 'BEGIN {
                srand(13)
                for (i = 0; i < 800000; i++)
                        printf "%08x %d word%d %s\n", int(rand() * 4294967295),
                               int(rand() * 100000), int(rand() * 1000),
                               "and a tail that makes the input large enough to merge on the pool"
        }' > "$widths/large" || return 1

        for options in "-S 8M" "-S 8M -u -k3,3" "-S 8M -s -k2,2n"; do
                sort_width_case "$widths/large" $options
        done
        rm -f "$widths/large"

        tally sort-widths "$width_pass" "$width_total"
        printf '  %-12s %s of %s\n' sort-widths "$width_pass" "$width_total"
        [ "$width_pass" = "$width_total" ]
}

#       Whatever a tool hands to the pool exists only past its crossover,
#       which no grammar input comes near: a few generated files of 10 to 35
#       MiB, every tool that cuts a file into pieces and each shape it takes
#       through them, on one processor, on two, on three and on every
#       processor the lane was given -- the bytes, the diagnostics and the
#       status must not move with the number of threads or with where a piece
#       happens to end, and tr is held to GNU's as well. The inputs are the ones that
#       make an edge fall somewhere awkward: lines of every length, tabs and
#       blanks and multibyte text and NULs, a line past a piece's bound and
#       one that is the whole file, and no last newline. And the descriptor
#       must end where reading through leaves it, for the command after tr in
#       a group.
parallel_cpus()
{
        # The first $1 processors of this lane's affinity, as taskset writes them.
        taskset -cp $$ | sed 's/.*: *//' | awk -v want="$1" '{
                n = split($0, part, ",")
                for (i = 1; i <= n; i++) {
                        m = split(part[i], span, "-")
                        for (c = span[1]; c <= (m > 1 ? span[2] : span[1]); c++) {
                                if (++have > want) exit
                                printf "%s%s", (have > 1 ? "," : ""), c
                        }
                }
        }'
}

parallel_inputs()
{
        LC_ALL=C awk 'BEGIN {
                srand(7)
                for (i = 0; i < 700000; i++) {
                        line = ""
                        n = int(rand() * 90)
                        for (j = 0; j < n; j++)
                                line = line sprintf("%c", 32 + int(rand() * 95))
                        print line
                }
        }' > "$parallel_dir/plain" || return 1

        # Tabs, runs of blanks, form feeds, returns, NULs, 0xa0 and UTF-8 of
        # every width, empty lines, and lines long enough to cross a piece.
        LC_ALL=C awk 'BEGIN {
                srand(11)
                split("a b ab word words the_quick x9 \t \t\t \f \r    \302\240 \303\251 \344\270\255 \360\237\230\200 \200 \377 , : ; = _", frag, " ")
                for (i = 0; i < 500000; i++) {
                        line = ""
                        n = rand() < 0.3 ? 0 : int(rand() * 40)
                        if (rand() < 0.001)
                                n = 4000 + int(rand() * 30000)
                        for (j = 0; j < n; j++)
                                line = line frag[1 + int(rand() * 23)] (rand() < 0.5 ? " " : "")
                        print line
                }
        }' > "$parallel_dir/mixed" || return 1

        # The same, with NULs among the bytes.
        tr 'x9' '\000\000' < "$parallel_dir/mixed" > "$parallel_dir/nul" || return 1

        # A line past a piece's bound, then a run of short ones, then one of
        # several megabytes, then the rest of the plain lines.
        { head -c 9000000 "$parallel_dir/plain"
          head -c 1200000 /dev/zero | tr '\000' 'a'; echo
          head -c 100000 "$parallel_dir/plain"
          head -c 4000000 /dev/zero | tr '\000' 'b'; echo
          head -c 6000000 "$parallel_dir/plain"; } > "$parallel_dir/long" || return 1

        # No last newline, and no newline at all.
        head -c 12000001 "$parallel_dir/plain" > "$parallel_dir/noeol" || return 1
        head -c 10000000 /dev/zero | tr '\000' 'c' > "$parallel_dir/oneline" || return 1
}

#       What a program says of a file with these arguments -- output, diagnostics
#       and status -- as a checksum, under a locale, on every processor or on
#       the set named.
parallel_answer()
{
        parallel_lc=$1
        parallel_set=$2
        parallel_program=$3
        parallel_operand=$4
        shift 4

        if [ -n "$parallel_set" ]; then
                taskset -c "$parallel_set" sh -c 'lc=$1; program=$2; operand=$3; shift 3
                        { env LC_ALL="$lc" "$program" "$@" "$operand" 2>&1; echo "status $?"; } | cksum' \
                        sh "$parallel_lc" "$parallel_program" "$parallel_operand" "$@"
        else
                { env LC_ALL="$parallel_lc" "$parallel_program" "$@" "$parallel_operand" 2>&1
                        echo "status $?"; } | cksum
        fi
}

text_parallel_checks()
{
        need_shell || return 1

        case $(tr --version 2> /dev/null) in
        *"GNU coreutils"*) ;;
        *)
                note "text-parallel: NOT RUN -- the tr here is not GNU coreutils"
                return 0
                ;;
        esac

        if ! command -v taskset > /dev/null 2>&1; then
                note "text-parallel: NOT RUN -- no taskset"
                return 0
        fi

        parallel_dir="$work/text-parallel"
        mkdir -p "$parallel_dir" || return 1
        parallel_inputs || return 1
        parallel_input="$parallel_dir/plain"

        parallel_first=$(parallel_cpus 1)
        parallel_two=$(parallel_cpus 2)
        parallel_three=$(parallel_cpus 3)
        parallel_pass=0
        parallel_total=0

        parallel_tr()
        {
                parallel_total=$((parallel_total + 1))
                parallel_want=$(LC_ALL=C tr "$@" < "$parallel_input" | cksum)
                parallel_one=$(LC_ALL=C taskset -c "$parallel_first" "$farm/tr" "$@" \
                        < "$parallel_input" | cksum)
                parallel_all=$(LC_ALL=C "$farm/tr" "$@" < "$parallel_input" | cksum)

                if [ "$parallel_want" = "$parallel_one" ] &&
                        [ "$parallel_one" = "$parallel_all" ]; then
                        parallel_pass=$((parallel_pass + 1))
                else
                        note "text-parallel: tr $* -- GNU $parallel_want, one processor $parallel_one, all $parallel_all"
                fi
        }

        parallel_tr a-z A-Z
        parallel_tr '\000-\177' '\200-\377'
        parallel_tr -d ,
        parallel_tr -d a-z
        parallel_tr -cd 'a-z\n'
        parallel_tr -d '\000-\177'

        parallel_total=$((parallel_total + 1))
        parallel_want=$({ LC_ALL=C tr a b > /dev/null; cat; } < "$parallel_input" | wc -c)
        parallel_got=$({ LC_ALL=C "$farm/tr" a b > /dev/null; cat; } < "$parallel_input" | wc -c)

        if [ "$parallel_want" = "$parallel_got" ]; then
                parallel_pass=$((parallel_pass + 1))
        else
                note "text-parallel: after tr the descriptor left $parallel_got bytes to read, GNU $parallel_want"
        fi

        # A tool over a file: one processor, which runs the serial loop and
        # is GNU's answer wherever the differential lanes find ours equal to
        # it, then two, three and all. The arguments are
        # one word, parted at @, so a script with a blank or a star in it
        # reaches the tool as it is written.
        parallel_file_case()
        {
                parallel_lc=$1
                parallel_name=$2
                parallel_path=$3
                parallel_row=$4
                parallel_total=$((parallel_total + 1))
                parallel_saved=$IFS
                IFS=@
                set -f
                # shellcheck disable=SC2086
                set -- $parallel_row
                set +f
                IFS=$parallel_saved
                # One processor is the serial loop, the answer the others must give.
                parallel_want=$(parallel_answer "$parallel_lc" "$parallel_first" \
                        "$farm/$parallel_name" "$parallel_path" "$@")
                parallel_bad=
                for parallel_set in "$parallel_two" "$parallel_three" ""; do
                        parallel_got=$(parallel_answer "$parallel_lc" "$parallel_set" \
                                "$farm/$parallel_name" "$parallel_path" "$@")
                        [ "$parallel_want" = "$parallel_got" ] ||
                                parallel_bad="$parallel_bad [${parallel_set:-all}]"
                done

                if [ -z "$parallel_bad" ]; then
                        parallel_pass=$((parallel_pass + 1))
                else
                        note "text-parallel: $parallel_lc $parallel_name $parallel_row ${parallel_path##*/} differs from one processor at$parallel_bad"
                fi
        }

        # Every row of a tool against every input: rows are read a line at a time.
        parallel_rows()
        {
                parallel_rows_lc=$1
                parallel_rows_name=$2
                parallel_rows_inputs=$3
                parallel_rows_list=$4

                printf '%s\n' "$parallel_rows_list" > "$parallel_dir/rows"

                for parallel_rows_input in $parallel_rows_inputs; do
                        while IFS= read -r parallel_rows_row; do
                                parallel_file_case "$parallel_rows_lc" "$parallel_rows_name" \
                                        "$parallel_dir/$parallel_rows_input" "$parallel_rows_row"
                        done < "$parallel_dir/rows"
                done
        }

        # The same tools reading standard input from where another command left
        # it: the file offset is the first byte a piece cuts, and the descriptor
        # must be left where the pieces stopped for the command after.
        parallel_offset_case()
        {
                parallel_path=$1
                parallel_name=$2
                parallel_total=$((parallel_total + 1))
                parallel_saved=$IFS
                IFS=@
                set -f
                # shellcheck disable=SC2086
                set -- $3
                set +f
                IFS=$parallel_saved
                parallel_want=
                parallel_bad=
                for parallel_set in "$parallel_first" "$parallel_two" "$parallel_three" ""; do
                        parallel_got=$(
                                if [ -n "$parallel_set" ]; then
                                        taskset -c "$parallel_set" sh -c 'dd bs=4097 count=1 of=/dev/null 2>/dev/null
                                                { "$0" "$@"; echo "status $?"; } 2>&1' "$farm/$parallel_name" "$@" < "$parallel_path"
                                else
                                        sh -c 'dd bs=4097 count=1 of=/dev/null 2>/dev/null
                                                { "$0" "$@"; echo "status $?"; } 2>&1' "$farm/$parallel_name" "$@" < "$parallel_path"
                                fi | cksum)
                        [ -n "$parallel_want" ] || parallel_want=$parallel_got
                        [ "$parallel_want" = "$parallel_got" ] ||
                                parallel_bad="$parallel_bad [${parallel_set:-all}]"
                done

                if [ -z "$parallel_bad" ]; then
                        parallel_pass=$((parallel_pass + 1))
                else
                        note "text-parallel: $parallel_name $* from an offset in ${parallel_path##*/} differs from one processor at$parallel_bad"
                fi
        }

        # sed -i edits a copy: the staged output is what the pieces write to.
        parallel_inplace_case()
        {
                parallel_path=$1
                parallel_row=$2
                parallel_total=$((parallel_total + 1))
                parallel_saved=$IFS
                IFS=@
                set -f
                # shellcheck disable=SC2086
                set -- $parallel_row
                set +f
                IFS=$parallel_saved
                parallel_want=
                parallel_bad=
                for parallel_set in "$parallel_first" "$parallel_two" "$parallel_three" ""; do
                        cp "$parallel_path" "$parallel_dir/edit" || return 1
                        rm -f "$parallel_dir/edit.bak"
                        parallel_got=$(
                                if [ -n "$parallel_set" ]; then
                                        taskset -c "$parallel_set" sh -c '"$0" "$@" 2>&1; echo "status $?"' "$farm/sed" "$@" "$parallel_dir/edit"
                                else
                                        sh -c '"$0" "$@" 2>&1; echo "status $?"' "$farm/sed" "$@" "$parallel_dir/edit"
                                fi
                                cat "$parallel_dir/edit"
                                cat "$parallel_dir/edit.bak" 2> /dev/null) 
                        parallel_got=$(printf '%s' "$parallel_got" | cksum)
                        [ -n "$parallel_want" ] || parallel_want=$parallel_got
                        [ "$parallel_want" = "$parallel_got" ] ||
                                parallel_bad="$parallel_bad [${parallel_set:-all}]"
                done

                if [ -z "$parallel_bad" ]; then
                        parallel_pass=$((parallel_pass + 1))
                else
                        note "text-parallel: sed $parallel_row in place in ${parallel_path##*/} differs from one processor at$parallel_bad"
                fi
        }

        #       Not parallel_name: the two functions below set that one to the
        #       tool they run, and a function's variables are the caller's, so a
        #       loop on it lost its file after the first case.
        for parallel_shape in plain noeol long; do
                parallel_inplace_case "$parallel_dir/$parallel_shape" '-i@s/ab/AB/g'
                parallel_inplace_case "$parallel_dir/$parallel_shape" '-i.bak@/^a/d'
                parallel_inplace_case "$parallel_dir/$parallel_shape" '-i@-n@/a/p'
                parallel_inplace_case "$parallel_dir/$parallel_shape" '-i@y/abc/xyz/'
        done

        for parallel_shape in plain noeol long; do
                parallel_offset_case "$parallel_dir/$parallel_shape" wc '-l@-w@-c'
                parallel_offset_case "$parallel_dir/$parallel_shape" grep '-n@ab'
                parallel_offset_case "$parallel_dir/$parallel_shape" cut '-d,@-f2'
                parallel_offset_case "$parallel_dir/$parallel_shape" sed 's/ab/AB/g'
        done

        parallel_all='plain mixed nul long noeol oneline'

        parallel_rows C wc "$parallel_all" '-l
-w
-c
-m
-L
-l@-w@-c
-l@-w
-w@-L'

        # wc -m, -w and -L follow the locale; the multibyte lines are where
        # a piece's edge must not cut a character.
        parallel_rows C.UTF-8 wc 'mixed nul long' '-m
-w
-L
-l@-m@-w'

        # grep over a file: the count, the lines, their numbers and offsets,
        # the questions, and what -v and the boundaries make of an edge.
        parallel_rows C grep "$parallel_all" '-c@ab
-n@ab
ab
-v@-c@ab
-v@-n@ab
-c@-E@a.b|xyz
-c@-i@AB
-c@-w@a
-c@-x@ab
-n@-b@ab
-H@-n@ab
-l@ab
-L@ab
-q@ab
-q@zzzz
-c@-F@-e@ab@-e@zz@-e@qq
-c@^
-c@$
-c@^$
-T@-n@ab
-c@a'

        # rev, by bytes and by characters, and with NUL for the line's end.
        parallel_rows C rev "$parallel_all" '
-0'
        parallel_rows C.UTF-8 rev 'mixed nul long' '
-0'

        # cut over a file: fields by one delimiter, bytes and characters as one
        # range or several, kept or left out, in both locales.
        parallel_rows C cut "$parallel_all" '-d,@-f2
-d,@-f1,3,5
-d,@-f2-
-d,@-s@-f2
-d,@--complement@-f2
-f2
-f1-2,4
-d @-f3-
-d,@-f100
-c1-20
-c5
-c5-
-c-10
-b3-8
-c1-5,10-15
-c1-3,5-7,9-
--complement@-c3-5
--complement@-b1-2,6-'

        # A dot is a character where the locale says so, and a job's machine
        # has to know it as the serial one does.
        parallel_rows C.UTF-8 grep 'mixed long' '-c@ab
-n@e
-c@-i@AB
-c@-w@a
-v@-c@ab
-c@^.\{3\}$
-c@-E@(.)\1'

        parallel_rows C.UTF-8 sed 'mixed long' 's/./X/g
s/.$//
/^.\{3\}/d
-n@/^..*$/p
s/\(.\)\(.\)/\2\1/g
y/abc/xyz/'

        parallel_rows C.UTF-8 cut 'mixed nul long' '-c1-20
-c5-9
-c1-3,7-9
--complement@-c2-4'

        # sed over a file: the scripts whose every line is answered by that
        # line alone, which are the ones cut into pieces, and a few that are
        # not and must come out the same all the same.
        parallel_rows C sed "$parallel_all" 's/ab/AB/g
-n@/ab/p
/^a/d
/^$/!d
y/abc/xyz/
s/a/b/;s/b/c/
-n@s/x/Y/p
s/e/E/3
s/e/&&/2g
/a/s/a/A/
/a/!s/e/E/
s/a*/X/g
s/[0-9]/<&>/g
s/\(a\)\(b\)/\2\1/g
-E@s/(a)(b)?/\2\1/g
s/b/\n/g
-n@/a/{/b/p}
p;p
:a;s/aa/a/;ta
/a/{s/a/b/;t;s/b/c/}
$!d
5q
s/^/> /
s/$/ </'

        rm -rf "$parallel_dir"
        printf '  %-12s %s of %s\n' text-parallel "$parallel_pass" "$parallel_total"
        tally text-parallel "$parallel_pass" "$parallel_total"
        [ "$parallel_pass" = "$parallel_total" ]
}

lane_text()
{
        differential_domain text
        text_lane_status=$?
        text_sort_widths || [ "$text_lane_status" != 0 ] || text_lane_status=1
        text_parallel_checks || [ "$text_lane_status" != 0 ] || text_lane_status=1
        [ "$text_lane_status" = 0 ] || return "$text_lane_status"

        #       wc's characters, words and widths follow LC_CTYPE. Its pinned
        #       rows are answers in the C locale, so the UTF-8 walk pins none,
        #       and it stays at singles -- every input, every option alone and
        #       the multibyte files -- where GNU's --debug line, which names the
        #       machine's vector extension, never meets a pure line count.
        python3 test/differential.py "$farm" --domain text --utility wc \
                --locale C.UTF-8 --no-pinned --budget singles \
                --jobs "${MW_JOBS:-$(nproc 2> /dev/null || echo 4)}"
        text_lane_status=$?

        #       expand and unexpand advance a column by a character's width
        #       where LC_CTYPE says so, and are in this walk for it.
        #
        #       cut -c and fold -w are widths in characters where LC_CTYPE
        #       says a character is more than a byte, and the walk above is
        #       the C locale, where a byte is a character and every answer
        #       agrees. The multibyte inputs are already in both sets; only
        #       the locale to read them under was missing, which is why a
        #       green suite said nothing about either one. Pins and budget
        #       as wc's, and for the same reasons.
        python3 test/differential.py "$farm" --domain text \
                --utility cut --utility fold --utility expand --utility unexpand \
                --locale C.UTF-8 --no-pinned --budget singles \
                --jobs "${MW_JOBS:-$(nproc 2> /dev/null || echo 4)}" ||
                [ "$text_lane_status" != 0 ] || text_lane_status=1

        #       grep and sed ask the same of a pattern: a dot stands for one
        #       character, and so does a bracket naming what it will not
        #       match. One engine answers for both, and for awk.
        #
        #       Their pins are kept here where cut's and fold's are dropped.
        #       A pinned row of theirs is a difference that has nothing to
        #       do with the locale -- grep -P, a backreference diagnostic,
        #       sed's e command -- and dropping the ledger would read every
        #       one of them as a failure of this pass rather than of the
        #       thing it is looking at.
        python3 test/differential.py "$farm" --domain text \
                --utility grep --utility sed \
                --locale C.UTF-8 --budget singles \
                --jobs "${MW_JOBS:-$(nproc 2> /dev/null || echo 4)}" ||
                [ "$text_lane_status" != 0 ] || text_lane_status=1

        return "$text_lane_status"
}
lane_files()
{
        differential_ready || return $?
        need_shell || return 1
        files_failed=0

        mkdir -p "$work/cp-mode-regression"
        cp_mode_check()
        {
                cp_mode_label=$1
                cp_mode_want=$2
                cp_mode_source=$3
                cp_mode_target=$4
                shift 4
                rm -rf "$cp_mode_target"
                (
                        umask 022
                        "$farm/cp" "$@" "$cp_mode_source" "$cp_mode_target"
                )
                cp_mode_status=$?
                cp_mode_got=$(stat -c %a "$cp_mode_target" 2>/dev/null ||
                        printf missing)
                [ "$cp_mode_status:$cp_mode_got" = "0:$cp_mode_want" ]
                verdict "$cp_mode_label" files_failed '$cp_mode_label returned $cp_mode_status with mode $cp_mode_got'
        }

        printf 'set-id source\n' > "$work/cp-mode-regression/source"
        if [ "$(id -u)" = 0 ]; then
                chown 65534:65534 "$work/cp-mode-regression/source"
        fi
        chmod 6755 "$work/cp-mode-regression/source"
        cp_mode_check cp-new-file-clears-set-id 755 \
                "$work/cp-mode-regression/source" \
                "$work/cp-mode-regression/plain"
        cp_mode_check cp-attributes-only-clears-set-id 755 \
                "$work/cp-mode-regression/source" \
                "$work/cp-mode-regression/attributes" --attributes-only
        cp_mode_check cp-preserve-retains-set-id 6755 \
                "$work/cp-mode-regression/source" \
                "$work/cp-mode-regression/preserved" -p

        mkdir "$work/cp-mode-regression/source-directory"
        chmod 6755 "$work/cp-mode-regression/source-directory"
        cp_mode_check cp-new-directory-clears-set-id 755 \
                "$work/cp-mode-regression/source-directory" \
                "$work/cp-mode-regression/directory" -R

        mkfifo "$work/cp-mode-regression/source-fifo"
        chmod 6755 "$work/cp-mode-regression/source-fifo"
        cp_mode_check cp-new-special-clears-set-id 755 \
                "$work/cp-mode-regression/source-fifo" \
                "$work/cp-mode-regression/fifo" -R

        printf 'old executable\n' > "$work/cp-mode-regression/staged-output"
        chmod 4755 "$work/cp-mode-regression/staged-output"
        printf 'replacement\n' | "$farm/shuf" -o \
                "$work/cp-mode-regression/staged-output"
        staged_output_status=$?
        staged_output_mode=$(stat -c %a \
                "$work/cp-mode-regression/staged-output" 2>/dev/null ||
                printf missing)
        [ "$staged_output_status:$staged_output_mode" = '0:755' ]
        verdict staged-output-clears-set-id files_failed 'generic staged output returned $staged_output_status with mode $staged_output_mode'

        printf 'symlink victim\n' > "$work/cp-mode-regression/victim"
        printf 'copy source\n' > "$work/cp-mode-regression/link-source"
        ln -sf victim "$work/cp-mode-regression/link-target"
        "$farm/cp" "$work/cp-mode-regression/link-source" \
                "$work/cp-mode-regression/link-target" \
                > /dev/null 2> "$work/cp-mode-regression/link.err"
        cp_link_status=$?
        [ "$cp_link_status:$(test -L "$work/cp-mode-regression/link-target"; echo $?):$(cat "$work/cp-mode-regression/link-target" 2>/dev/null):$(cat "$work/cp-mode-regression/victim")" = \
                '0:1:copy source:symlink victim' ]
        verdict cp-final-symlink-replaced files_failed 'cp live dest symlink returned $cp_link_status with victim [$(cat "$work/cp-mode-regression/victim" 2>/dev/null)]'

        ln -sf missing "$work/cp-mode-regression/dangling"
        "$farm/cp" "$work/cp-mode-regression/link-source" \
                "$work/cp-mode-regression/dangling" \
                > /dev/null 2> "$work/cp-mode-regression/dangling.err"
        cp_dangling_status=$?
        [ "$cp_dangling_status:$(readlink "$work/cp-mode-regression/dangling" 2>/dev/null)" = \
                '1:missing' ] &&
                grep -q 'dangling symlink' "$work/cp-mode-regression/dangling.err"
        verdict cp-dangling-symlink-refused files_failed 'cp dangling dest symlink returned $cp_dangling_status'

        mkdir -p "$work/cp-mode-regression/src/sub" \
                "$work/cp-mode-regression/hollow"
        printf 'parents body\n' > "$work/cp-mode-regression/src/sub/deep"
        (
                cd "$work/cp-mode-regression" || exit 1
                "$farm/cp" --parents src/sub/deep hollow
        )
        cp_parents_status=$?
        [ "$cp_parents_status:$(cat "$work/cp-mode-regression/hollow/src/sub/deep" 2>/dev/null)" = \
                '0:parents body' ]
        verdict cp-parents-keeps-source-path files_failed 'cp --parents returned $cp_parents_status or dest layout'

        printf 'symlink victim\n' > "$work/cp-mode-regression/victim"
        ln -sf victim "$work/cp-mode-regression/link-target"

        "$farm/cp" -f "$work/cp-mode-regression/link-source" \
                "$work/cp-mode-regression/link-target"
        cp_force_link_status=$?
        [ "$cp_force_link_status:$(test -L "$work/cp-mode-regression/link-target"; echo $?):$(cat "$work/cp-mode-regression/link-target")" = \
                '0:1:copy source' ] &&
                [ "$(cat "$work/cp-mode-regression/victim")" = 'symlink victim' ]
        verdict cp-final-symlink-explicit-replacement files_failed 'cp -f final symlink returned $cp_force_link_status or changed its victim'

        ln -sf victim "$work/cp-mode-regression/stream-link"
        printf 'stream replacement\n' | "$farm/shuf" -o \
                "$work/cp-mode-regression/stream-link" \
                > /dev/null 2> "$work/cp-mode-regression/stream-link.err"
        stream_link_status=$?
        [ "$stream_link_status:$(test -L "$work/cp-mode-regression/stream-link"; echo $?):$(cat "$work/cp-mode-regression/stream-link"):$(cat "$work/cp-mode-regression/victim")" = \
                '0:1:stream replacement:symlink victim' ]
        verdict staged-stream-final-symlink-replaced files_failed 'staged stream symlink returned $stream_link_status or followed its victim'

        printf 'codec input\n' > "$work/cp-mode-regression/codec"
        printf 'old executable\n' > "$work/cp-mode-regression/codec.gz"
        chmod 4755 "$work/cp-mode-regression/codec.gz"
        "$farm/gzip" -f "$work/cp-mode-regression/codec"
        codec_status=$?
        codec_mode=$(stat -c %a "$work/cp-mode-regression/codec.gz" \
                2>/dev/null || printf missing)
        [ "$codec_status:$codec_mode" = '0:755' ]
        verdict codec-replacement-clears-set-id files_failed 'codec replacement returned $codec_status with mode $codec_mode'

        printf 'archive member\n' > "$work/cp-mode-regression/member"
        printf 'old executable\n' > "$work/cp-mode-regression/archive.tar"
        chmod 4755 "$work/cp-mode-regression/archive.tar"
        (
                cd "$work/cp-mode-regression" || exit 1
                "$farm/tar" -cf archive.tar member
        )
        archive_status=$?
        archive_mode=$(stat -c %a "$work/cp-mode-regression/archive.tar" \
                2>/dev/null || printf missing)
        [ "$archive_status:$archive_mode" = '0:755' ]
        verdict tar-replacement-clears-set-id files_failed 'tar replacement returned $archive_status with mode $archive_mode'

        #       A member that cannot be written says why -- a full bowl root
        #       said "Input/output error" and then "invalid header checksum" --
        #       and the member after it still lands. The write limit stands in
        #       for a full filesystem: the same short write, answered EFBIG.
        write_place="$work/cp-mode-regression/tar-write"
        mkdir -p "$write_place/in" "$write_place/out"
        head -c 1048576 /dev/zero > "$write_place/in/big"
        printf 'small member\n' > "$write_place/in/small"
        (cd "$write_place/in" && "$farm/tar" -cf ../members.tar big small) &&
                "$farm/gzip" -c "$write_place/members.tar" > "$write_place/members.tar.gz"
        (
                ulimit -f 256
                trap '' 25
                "$farm/tar" -xf "$write_place/members.tar.gz" -C "$write_place/out"
        ) 2> "$write_place/error"
        write_status=$?
        write_said=$(cat "$write_place/error")
        write_small=$(cat "$write_place/out/small" 2>/dev/null || printf missing)
        [ "$write_status" != 0 ] && [ "$write_said" = 'tar: big: File too large' ] &&
                [ "$write_small" = 'small member' ] && [ ! -e "$write_place/out/big" ]
        verdict tar-write-failure-says-why files_failed 'tar under a write limit returned $write_status, said [$write_said], small [$write_small]'

        #       seq to a last number nobody could read, into a device that
        #       refuses every write and to a closed descriptor: GNU's stops at
        #       the first refusal with status 1, and ours counted on for ever.
        timeout 10 "$farm/seq" 1 1000000000000000000 > /dev/full 2> /dev/null
        seq_full=$?
        timeout 10 "$farm/seq" 1 1000000000000000000 2> /dev/null >&-
        seq_closed=$?
        [ "$seq_full:$seq_closed" = 1:1 ]
        verdict seq-stops-at-refused-write files_failed 'seq into /dev/full returned $seq_full, to a closed descriptor $seq_closed'

        printf 'old text\n' > "$work/cp-mode-regression/sed"
        chmod 4755 "$work/cp-mode-regression/sed"
        "$farm/sed" -i s/old/new/ "$work/cp-mode-regression/sed"
        sed_status=$?
        sed_mode=$(stat -c %a "$work/cp-mode-regression/sed" \
                2>/dev/null || printf missing)
        [ "$sed_status:$sed_mode" = '0:755' ]
        verdict sed-replacement-clears-set-id files_failed 'sed replacement returned $sed_status with mode $sed_mode'

        differential_domain files || files_failed=1
        return "$files_failed"
}
lane_misc()
{
        need_shell || return 1
        need_hardened_shell || return 1
        misc_failed=0

        #       script started straight from a foreign parent: by default as
        #       util-linux's is, and under a policy refusing its spawn, refused,
        #       because its external parent cannot be proved to be a protected
        #       shell. Under our own shell that policy still lets it run the
        #       modes that start nothing.
        "$farm/script" --version > /dev/null 2>&1
        verdict script-direct-default misc_failed 'direct script --version failed with nothing configured'

        "$work/hardened-bin/script" --version > /dev/null \
                2> "$work/script-direct-policy.err"
        script_direct=$?
        [ "$script_direct" = 126 ] &&
                grep -q 'parent protection unavailable; refusing launch' \
                        "$work/script-direct-policy.err"
        verdict script-direct-policy-refusal misc_failed 'direct hardened script did not preserve its parent-contract refusal'

        if "$work/hardened-bin/bash" -c 'script --version >/dev/null' \
                > /dev/null 2>&1; then
                tally script-integrated-policy-path 1 1
        else
                tally script-integrated-policy-path 0 1
                note "script's non-spawning mode failed under a protected shell parent"
                misc_failed=1
        fi

        #       stdbuf, read from inside the program it starts. The misc
        #       grammar compares the variables stdbuf publishes; this reads
        #       glibc's own stream state once libstdbuf has run, which is the
        #       change those variables only promise. A static target its
        #       preload cannot reach is run all the same, as GNU runs it, with
        #       the variables and no preload (this shell's own programs, all
        #       static, read _STDBUF_O themselves), so the static probe
        #       reports what GNU's run of it reports.
        if $compiler -O2 -o "$work/stdio-buffer" -DCHECK_stdio_buffer \
                test/checks.c > "$work/stdio-buffer.err" 2>&1 &&
                $compiler -O2 -static -o "$work/stdio-buffer-static" \
                        -DCHECK_stdio_buffer test/checks.c \
                        >> "$work/stdio-buffer.err" 2>&1
        then
                stdbuf -i0 -oL -e4K "$work/stdio-buffer" > "$work/stdbuf.want" 2>&1
                "$farm/stdbuf" -i0 -oL -e4K "$work/stdio-buffer" \
                        > "$work/stdbuf.got" 2>&1
                cmp -s "$work/stdbuf.want" "$work/stdbuf.got"
                verdict stdbuf-changes-streams misc_failed 'stdbuf left the streams at $(cat "$work/stdbuf.got"), GNU at $(cat "$work/stdbuf.want")'

                stdbuf -o0 "$work/stdio-buffer-static" \
                        > "$work/stdbuf.static.want" 2>&1
                "$farm/stdbuf" -o0 "$work/stdio-buffer-static" \
                        > "$work/stdbuf.static" 2>&1
                static_status=$?
                [ "$static_status" = 0 ] &&
                        cmp -s "$work/stdbuf.static.want" "$work/stdbuf.static"
                verdict stdbuf-static-runs misc_failed 'stdbuf on a static target: status $static_status, $(cat "$work/stdbuf.static"), GNU $(cat "$work/stdbuf.static.want")'

                #       upstream misc/responsive: under stdbuf -oL a line
                #       into a pipe comes out while the writer still holds
                #       the pipe open (it used to wait for the end, or for
                #       stdbuf to refuse the static program outright).
                for prompt_reader in "cut -b1" "date -u -f - +%H"; do
                        rm -f "$work/prompt.in" "$work/prompt.out"
                        mkfifo "$work/prompt.in"
                        # shellcheck disable=SC2086
                        "$farm/stdbuf" -oL $farm/$prompt_reader < "$work/prompt.in" \
                                > "$work/prompt.out" 2>&1 &
                        prompt_pid=$!
                        { printf '1\n'; sleep 3; } > "$work/prompt.in" &
                        prompt_writer=$!
                        sleep 1
                        case $(cat "$work/prompt.out") in
                        1|01)   tally stdbuf-line-prompt 1 1 ;;
                        *)      tally stdbuf-line-prompt 0 1
                                note "stdbuf -oL $prompt_reader wrote nothing while its pipe stayed open"
                                misc_failed=1 ;;
                        esac
                        wait "$prompt_writer" "$prompt_pid"
                done

                #       upstream timeout/timeout-group: a timeout killed
                #       outright still has its signal sent to the command,
                #       by the kernel (PR_SET_PDEATHSIG).
                rm -f "$work/pdeath.got"
                "$farm/timeout" -sUSR1 30 sh -c 'trap "echo got > \"\$0\"; exit" USR1
                        i=0; while [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done' \
                        "$work/pdeath.got" &
                pdeath_timeout=$!
                sleep 1
                kill -KILL "$pdeath_timeout"
                wait "$pdeath_timeout" 2>/dev/null
                sleep 1
                [ "$(cat "$work/pdeath.got" 2>/dev/null)" = got ]
                verdict timeout-death-signal misc_failed 'a timeout killed by SIGKILL left its command without the USR1 it was to send'
        else
                note "stdbuf: the glibc stream probe did not build"
                sed 's/^/    /' "$work/stdio-buffer.err" | head -10
                misc_failed=1
        fi

        #       hexdump from /dev/zero into /dev/full, which never ends by
        #       itself, so the misc grammar cannot hold it. Ours stops at the
        #       first refusal and says what util-linux 2.42.4's says there:
        #       write error and the reason, status 1. (2.42.2 read on for ever
        #       and said no reason.)
        timeout 10 "$farm/hexdump" -v /dev/zero > /dev/full \
                2> "$work/hexdump-full.err"
        hexdump_status=$?
        [ "$hexdump_status" = 1 ] &&
                [ "$(cat "$work/hexdump-full.err")" = "hexdump: write error: No space left on device" ]
        verdict hexdump-stops-at-refused-write misc_failed 'hexdump -v /dev/zero > /dev/full: status $hexdump_status, $(head -c 200 "$work/hexdump-full.err")'

        floodlight_masked_proc || misc_failed=1
        floodlight_hardened || misc_failed=1

        differential_domain misc "$farm" || misc_failed=1
        return "$misc_failed"
}

#       Floodlight asks /proc nothing for a launch no row restricts, so a
#       machine nobody configured runs the same with /proc masked as with it:
#       a tmpfs over /proc in a private mount namespace, the way a sandbox or
#       a half-built chroot leaves it. Each case runs twice, under our shell
#       and tools and under the host's bash and GNU, and the two must agree.
#       The dash rows are a foreign shell starting our tools directly, which
#       is where every tool used to answer 126. awk is here from stdin, a
#       file, a substitution and a pipeline, with system() and both kinds of
#       pipe, and the last line is an in-place exec after a structural fork
#       with a child still alive: nothing about any of it is restricted, so
#       none of it may ask /proc a question.
floodlight_masked_proc_script='mount -t tmpfs tmpfs /proc || exit 99
printf "%s|" "$(printf x | cat)" "$(printf "a\nb\n" | wc -l)" "$(ls /dev/null)"
cat /dev/null; printf "%s|" "$?"
(cat /dev/null); printf "%s|" "$?"
printf "%s|" "$(env ls /dev/null)"
sort /dev/null | cat; printf "%s|" "$?"
printf "a b\n" | awk "{ print \$2 }"
printf "%s|" "$(awk "BEGIN { print 1 + 1 }")"
printf "{ print NR }\n" > "${TMPDIR:-/tmp}/masked.awk.$$"
printf "x\ny\n" | awk -f "${TMPDIR:-/tmp}/masked.awk.$$"; rm -f "${TMPDIR:-/tmp}/masked.awk.$$"
awk "BEGIN { system(\"echo s\"); \"echo p\" | getline v; print v }"
printf "q\n" | awk "{ print | \"cat\" }"
(sleep 1 &); exec cat /dev/null'
floodlight_masked_proc()
{
        if ! unshare -rm true 2> /dev/null; then
                note "floodlight masked /proc: no unprivileged mount namespace here"
                return 0
        fi

        masked_failed=0
        for masked_shell in bash dash; do
                masked_want=$(PATH=/usr/bin:/bin unshare -rm "/bin/$masked_shell" \
                        -c "$floodlight_masked_proc_script" 2>&1; echo "status $?")
                masked_got=$(PATH="$farm:/usr/bin:/bin" unshare -rm \
                        "$([ "$masked_shell" = bash ] && echo "$farm/bash" || echo /bin/dash)" \
                        -c "$floodlight_masked_proc_script" 2>&1; echo "status $?")
                [ "$masked_got" = "$masked_want" ]
                verdict "floodlight-masked-proc-$masked_shell" masked_failed 'floodlight masked /proc under $masked_shell: got [$masked_got] want [$masked_want]'
        done
        return "$masked_failed"
}
lane_util_linux()
{
        need_shell || return 1
        need_hardened_shell || return 1
        util_linux_failed=0

        "$farm/setarch" --show > /dev/null 2>&1
        verdict setarch-direct-default util_linux_failed 'direct setarch --show failed with nothing configured'

        "$work/hardened-bin/setarch" --show > /dev/null \
                2> "$work/setarch-direct-policy.err"
        setarch_direct=$?
        [ "$setarch_direct" = 126 ] &&
                grep -q 'parent protection unavailable; refusing launch' \
                        "$work/setarch-direct-policy.err"
        verdict setarch-direct-policy-refusal util_linux_failed 'direct hardened setarch did not preserve its parent-contract refusal'

        if "$work/hardened-bin/bash" -c 'setarch --show >/dev/null' \
                > /dev/null 2>&1; then
                tally setarch-integrated-policy-path 1 1
        else
                tally setarch-integrated-policy-path 0 1
                note "setarch's non-spawning mode failed under a protected shell parent"
                util_linux_failed=1
        fi

        differential_domain util_linux "$farm" || util_linux_failed=1

        #       Mount names a user chose, planted in a namespace and listed.
        python3 test/differential.py --harness mount_names "$farm"
        case $? in 0|2) ;; *) util_linux_failed=1 ;; esac
        return "$util_linux_failed"
}
lane_shell()
{
        need_shell || return 1
        shell_failed=0
        freestanding_checks_lane lexer_spans lexer_spans || shell_failed=1
        python3 test/differential.py --harness shell_functions --shell "$shell_binary" || shell_failed=1
        [ "$(env PS4='+ ' SHELLOPTS=xtrace "$farm/bash" -c : 2>&1)" = '+ :' ]
        verdict shell-literal-inherited-options shell_failed 'bash literal fast path ignored inherited SHELLOPTS'
        process_limited=$(
                ulimit -n 32 || exit 1
                "$farm/bash" -c 'cat <(printf inherited)'
        ) && [ "$process_limited" = inherited ]
        verdict shell-process-substitution-low-fd shell_failed 'process substitution lost its descriptor below fd 60'

        # ppoll reports POLLNVAL as a ready row. A zero-timeout read probe
        # must distinguish that condition from readable input instead of
        # claiming success for a closed descriptor.
        read_invalid_status=$(
                "$farm/bash" -c 'read -t 0 -u 99 value; printf "%s" "$?"'
        )
        [ "$read_invalid_status" = 1 ]
        verdict shell-read-timeout-invalid-fd shell_failed 'zero-timeout read accepted invalid fd 99 with status [$read_invalid_status]'

        # POSIX disconnects an asynchronous command from the shell's input
        # only while job control is off.  Make fd 0 itself available before
        # opening /dev/null: opening first under a full descriptor table used
        # to fail silently and let the child consume the parent's input.
        async_null_result=$(
                printf X | "$farm/bash" -c '
                        ulimit -n 10
                        exec 3</dev/null; exec 4</dev/null
                        exec 5</dev/null; exec 6</dev/null
                        exec 7</dev/null; exec 8</dev/null; exec 9</dev/null
                        { IFS= read -r -N1 x; printf "%s:%s\n" "$?" "$x"; } &
                        wait'
        )
        # The other four need job control, which set -m only turns on for a
        # shell with a controlling terminal. Without one -- a lane under
        # nohup or ssh -n -- they answered 0 of 5 and read as a regression,
        # so they get a terminal of their own from script(1), and say NOT
        # RUN when there is none to be had.
        cat > "$work/monitor-probes.sh" <<'PROBES'
farm=$1
printf X | "$farm/bash" -c '
        set -m
        { IFS= read -r -N1 x; printf "%s:%s\n" "$?" "$x"; } &
        wait' 2>/dev/null
"$farm/bash" -c '
        set -m
        sleep 5 & p=$!
        /bin/sleep 0.1
        kill -INT "$p"
        wait "$p"
        printf "%s\n" "$?"' 2>/dev/null
"$farm/bash" -c '
        set -m
        coproc C { sleep 5; }
        p=$C_PID
        /bin/sleep 0.1
        kill -INT "$p"
        wait "$p"
        printf "%s\n" "$?"' 2>/dev/null
"$farm/bash" -c '
        set -m
        coproc C { sleep 5; }
        p=$C_PID
        listed=$(jobs -p)
        set -- $(/bin/ps -o pgid= -p "$p")
        pg=$1
        ok=1
        [ "$listed" = "$p" ] && [ "$pg" = "$p" ] && ok=0
        kill -TERM "$p"
        wait "$p"
        printf "%s\n" "$ok"' 2>/dev/null
PROBES
        # A subshell: a redirection that fails on the special builtin :
        # ends a POSIX shell, and this one is the whole of test/run.
        if ( : < /dev/tty ) 2>/dev/null; then
                monitor_results=$(sh "$work/monitor-probes.sh" "$farm")
        elif command -v script > /dev/null 2>&1; then
                monitor_results=$(script -qfec \
                        "sh '$work/monitor-probes.sh' '$farm'" /dev/null |
                        tr -d '\r')
        else
                monitor_results=
        fi
        monitor_input_result=$(echo "$monitor_results" | sed -n 1p)
        monitor_signal_result=$(echo "$monitor_results" | sed -n 2p)
        coproc_signal_result=$(echo "$monitor_results" | sed -n 3p)
        coproc_job_result=$(echo "$monitor_results" | sed -n 4p)
        if [ -z "$monitor_results" ]; then
                note "background input policy under job control: NOT RUN -- needs a tty and there is no script(1)"
                [ "$async_null_result" = 1: ]
                verdict shell-background-input-policy shell_failed
        elif [ "$async_null_result" = 1: ] &&
                [ "$monitor_input_result" = 0:X ] &&
                [ "$monitor_signal_result" = 130 ] &&
                [ "$coproc_signal_result" = 130 ] &&
                [ "$coproc_job_result" = 0 ]; then
                tally shell-background-input-policy 5 5
        else
                tally shell-background-input-policy 0 5
                note "background input policy answered [$async_null_result][$monitor_input_result][$monitor_signal_result][$coproc_signal_result][$coproc_job_result]"
                shell_failed=1
        fi

        # Everything from here to the here-document checks is what a policy
        # refusing awk's spawn must still guarantee, so it runs under the
        # shell sec_hardened configures: with nothing configured awk is not
        # confined and none of these boundaries is asked for.
        need_hardened_shell || return 1
        parser_shell="$work/hardened-bin/bash"

        # A named script remains open while its commands run. Before the
        # parser-source gate, confined awk could append a command that this
        # unrestricted shell then read and executed. Keep an unrestricted
        # command in the same streaming file as the compatibility control.
        parser_source_dir="$work/parser-source"
        mkdir -p "$parser_source_dir"
        parser_regular_script="$parser_source_dir/regular-script"
        parser_regular_target="$parser_source_dir/regular-injected"
        parser_regular_compatible="$parser_source_dir/regular-compatible"
        parser_regular_ran="$parser_source_dir/regular-restricted-ran"
        cat > "$parser_regular_script" <<REGULAR_SCRIPT
printf ready > "$parser_regular_compatible"
awk 'BEGIN { print "ready" > "$parser_regular_ran"; print "touch -- $parser_regular_target" >> "$parser_regular_script" }' 2>/dev/null
REGULAR_SCRIPT
        # Keep the original EOF beyond the first parser read. Without the
        # sealed-tail replacement, awk's appended command is then reached by a
        # later read and executed; a tiny two-line file would already be fully
        # buffered and would not exercise the vulnerable transition.
        parser_padding=0
        while [ "$parser_padding" -lt 512 ]; do
                printf '# parser snapshot padding %04d 0123456789abcdef0123456789abcdef\n' \
                        "$parser_padding" >> "$parser_regular_script"
                parser_padding=$((parser_padding + 1))
        done
        "$parser_shell" "$parser_regular_script" >/dev/null 2>&1 || :

        [ "$(cat "$parser_regular_compatible" 2>/dev/null)" = ready ]
        verdict shell-parser-regular-compatible shell_failed 'an unrestricted command stopped working in a streamed regular script'
        [ "$(cat "$parser_regular_ran" 2>/dev/null)" = ready ] &&
                [ ! -e "$parser_regular_target" ]
        verdict shell-parser-regular-mutation shell_failed 'a restricted applet did not run safely against a sealed regular-script tail'

        # -c and dot/source both execute a complete memory snapshot. They have
        # no live source descriptor for a child to feed and remain compatible
        # with restricted applets that can otherwise be confined.
        parser_command_marker="$parser_source_dir/command-memory"
        "$parser_shell" -c \
                "awk 'BEGIN { print \"ready\" > \"$parser_command_marker\" }'" \
                >/dev/null 2>&1 || :
        [ "$(cat "$parser_command_marker" 2>/dev/null)" = ready ]
        verdict shell-parser-command-memory shell_failed 'a memory-backed -c command was treated as a live mutable source'

        # Noninteractive Bash reads BASH_ENV before its main stdin program.
        # Publish stdin's pipe identity first, or restricted startup awk can
        # consume the future command while the parser is mislabeled memory.
        parser_startup_env="$parser_source_dir/startup-env"
        parser_startup_main="$parser_source_dir/startup-main"
        parser_startup_stolen="$parser_source_dir/startup-stolen"
        cat > "$parser_startup_env" <<STARTUP_ENV
awk 'BEGIN { if ((getline line < "/dev/stdin") > 0) print line > "$parser_startup_stolen" }' 2>/dev/null
STARTUP_ENV
        printf 'printf ready > "%s"\n' "$parser_startup_main" |
                BASH_ENV="$parser_startup_env" "$parser_shell" >/dev/null 2>&1 || :
        [ "$(cat "$parser_startup_main" 2>/dev/null)" = ready ] &&
                [ ! -e "$parser_startup_stolen" ]
        verdict shell-parser-startup-stdin shell_failed 'BASH_ENV consumed or suppressed the main stdin program'

        # A restricted startup applet can remain alive after BASH_ENV and
        # change any pathname it was given. The shell must refuse both a main
        # named script and a later dot/source open in that state; copying the
        # already changed bytes after open would only preserve the attack.
        parser_late_result=$(python3 - "$parser_shell" \
                "$parser_source_dir" <<'PY'
import os, pathlib, shlex, signal, subprocess, sys

shell, root = sys.argv[1:]

def run_case(label, dot):
    base = pathlib.Path(root)
    source = base / (label + "-source")
    marker = base / (label + "-injected")
    ready = base / (label + "-ready")
    startup = base / (label + "-env")
    quote = shlex.quote
    program = (r'BEGIN { print "printf compromised > \047" marker "\047" > script; '
               r'close(script); print "ready" > ready; close(ready); while (1) {} }')

    source.write_text("printf original >/dev/null\n")
    startup.write_text(
        "awk -v script=%s -v marker=%s -v ready=%s %s "
        "</dev/null >/dev/null 2>&1 &\n"
        "while [ ! -e %s ]; do :; done\n" %
        (quote(str(source)), quote(str(marker)), quote(str(ready)),
         quote(program), quote(str(ready))))

    environment = dict(os.environ, BASH_ENV=str(startup), ENV="/dev/null")
    arguments = ([shell, "-c", ". " + quote(str(source))]
                 if dot else [shell, str(source)])
    status = None
    process = None
    try:
        process = subprocess.Popen(
            arguments, env=environment, stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
        status = process.wait(timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass
    finally:
        if process:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass

    expected = 1 if dot else 126
    return status == expected and ready.exists() and not marker.exists()

print("%d:%d" % (run_case("late-main", False),
                  run_case("late-dot", True)))
PY
        )
        if [ "$parser_late_result" = 1:1 ]; then
                tally shell-parser-startup-descendant-source 2 2
        else
                tally shell-parser-startup-descendant-source 0 2
                note "live startup descendant source guards answered [$parser_late_result]"
                shell_failed=1
        fi

        # A forked parser may protect its own copied address space, but that
        # says nothing about the outer shell which still owns future syntax.
        # Close the inherited marker descriptor, derive the outer PID through
        # procfs, and make the applet try to reopen it. Opaque command names
        # must likewise never mint a launcher role in-child: a shell whose
        # policy confines anything protects itself before the fork, so the
        # child inherits the role rather than inventing it, and the dynamic
        # awk runs confined, its system() refused.
        parser_ancestor_marker="$parser_source_dir/ancestor-escaped"
        parser_ancestor_result=$(python3 - "$parser_shell" \
                "$parser_ancestor_marker" <<'PY'
import pathlib, subprocess, sys

shell, marker_name = sys.argv[1:]
marker = pathlib.Path(marker_name)
ancestor = r'''exec 9>"$1"
value=$(exec 9>&-; :; awk 'BEGIN {
    getline < "/proc/self/stat"; parent = $4; close("/proc/self/stat")
    path = "/proc/" parent "/stat"
    getline < path; outer = $4; close(path)
    path = "/proc/" outer "/fd/9"
    print "escaped" > path; close(path)
}')
printf '%s:%s\n' "$?" "$value"
'''
dynamic = r'''value=$(tool=awk; "$tool" 'BEGIN { system("printf spawned > " ENVIRON["SPAWNED"]); print "ran" }')
printf '%s:%s\n' "$?" "$value"
'''
literal = r'''value=$(awk 'BEGIN { print 3 }')
printf '%s:%s\n' "$?" "$value"
'''

try:
    first = subprocess.run(
        [shell, "-c", ancestor, "guard", marker_name],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        text=True, timeout=10)
    spawned = pathlib.Path(marker_name + ".spawned")
    second = subprocess.run(
        [shell, "-c", dynamic], stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, text=True, timeout=10,
        env=dict(__import__("os").environ, SPAWNED=str(spawned)))
    third = subprocess.run(
        [shell, "-c", literal], stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, text=True, timeout=10)
    # The shell protects itself before the substitution's fork, so awk may
    # run there confined (a failed write, 2) or be refused outright (126);
    # either way the outer shell's descriptor is never reached, and a
    # dynamically named awk never starts a program.
    ancestor_ok = (first.returncode == 0 and
                   first.stdout in ("126:\n", "2:\n") and
                   marker.exists() and marker.read_bytes() == b"")
    dynamic_ok = (second.returncode == 0 and
                  second.stdout in ("126:\n", "0:ran\n") and
                  not spawned.exists())
    literal_ok = third.returncode == 0 and third.stdout == "0:3\n"
except (OSError, subprocess.TimeoutExpired):
    ancestor_ok = dynamic_ok = literal_ok = False

print("%d:%d:%d" % (ancestor_ok, dynamic_ok, literal_ok))
PY
        )
        if [ "$parser_ancestor_result" = 1:1:1 ]; then
                tally shell-parser-ancestor-contract 3 3
        else
                tally shell-parser-ancestor-contract 0 3
                note "forked/dynamic launcher contract answered [$parser_ancestor_result]"
                shell_failed=1
        fi

        # Job control must fork every pipeline stage so parent and child can
        # race setpgid, and a stage redirection also declines direct spawn. A
        # fixed resident applet still has to prepare the real parser parent
        # before either fallback fork; otherwise the child correctly refuses
        # its inherited launcher contract and the pipeline is empty.
        parser_redirect_pipeline=$(
                "$parser_shell" -c \
                        "awk 'BEGIN { print \"ok\" }' 2>/dev/null | wc -c" \
                        2>/dev/null
        )
        parser_redirect_status=$?
        parser_monitor_pipeline=$(
                "$parser_shell" -c \
                        "set -m; awk 'BEGIN { print \"ok\" }' | wc -c" \
                        2>/dev/null
        )
        parser_monitor_status=$?
        if [ "$parser_redirect_status" = 0 ] &&
                [ "$parser_redirect_pipeline" = 3 ] &&
                [ "$parser_monitor_status" = 0 ] &&
                [ "$parser_monitor_pipeline" = 3 ]; then
                tally shell-parser-pipeline-parent-contract 2 2
        else
                tally shell-parser-pipeline-parent-contract 0 2
                note "redirected/monitored resident pipelines answered [$parser_redirect_status:$parser_redirect_pipeline][$parser_monitor_status:$parser_monitor_pipeline]"
                shell_failed=1
        fi

        parser_dot_file="$parser_source_dir/dot-source"
        parser_dot_marker="$parser_source_dir/dot-memory"
        cat > "$parser_dot_file" <<DOT_SOURCE
awk 'BEGIN { print "ready" > "$parser_dot_marker" }'
DOT_SOURCE
        "$parser_shell" -c ". '$parser_dot_file'" >/dev/null 2>&1 || :
        [ "$(cat "$parser_dot_marker" 2>/dev/null)" = ready ]
        verdict shell-parser-dot-memory shell_failed 'a fully loaded dot/source file was treated as a live mutable source'

        # A full-duplex socket lets a cooperating peer reflect a child write
        # into the parent's next parser read. Spawn-only confinement therefore
        # has to refuse the restricted child while ordinary socket-fed shell
        # input still runs. Python owns the peer endpoint and performs exactly
        # that reflection if the payload escapes.
        parser_socket_compatible="$parser_source_dir/socket-compatible"
        parser_socket_target="$parser_source_dir/socket-injected"
        parser_socket_result=$(python3 - "$parser_shell" \
                "$parser_socket_compatible" "$parser_socket_target" <<'PY'
import os, socket, subprocess, sys, time

shell, compatible_path, target_path = sys.argv[1:]
left, right = socket.socketpair()
process = subprocess.Popen(
    [shell], stdin=left, stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL, close_fds=True)
left.close()

def quoted(path):
    return "'" + path.replace("'", "'\\''") + "'"

right.sendall(("printf ready > " + quoted(compatible_path) + "\n").encode())
deadline = time.monotonic() + 5
while time.monotonic() < deadline and not os.path.exists(compatible_path):
    time.sleep(0.01)
compatible = os.path.exists(compatible_path)

payload = "touch -- " + quoted(target_path)
awk_payload = payload.replace("\\", "\\\\").replace('"', '\\"')
right.sendall(("awk 'BEGIN { print \"" + awk_payload + "\" }' >&0\n").encode())
right.settimeout(1.5)
answer = b""
try:
    while b"\n" not in answer:
        part = right.recv(4096)
        if not part:
            break
        answer += part
except TimeoutError:
    pass

escaped = payload.encode() in answer
if escaped:
    right.sendall((payload + "\n").encode())
right.sendall(b"exit 0\n")
try:
    process.wait(timeout=5)
except subprocess.TimeoutExpired:
    process.kill()
    process.wait()
right.close()

safe = not escaped and not os.path.exists(target_path) and process.returncode == 0
print("%d:%d" % (compatible, safe))
PY
        )
        [ "$parser_socket_result" = 1:1 ]
        verdict shell-parser-socket-injection shell_failed 'socket parser compatibility/security answered [$parser_socket_result]'

        # A terminal source is controlled by a paired PTY master with a
        # different inode, and that master may live in an outside same-UID
        # process which the child's descriptor inventory cannot revoke. A
        # restricted applet is therefore refused while an unrestricted command
        # from the same terminal remains ordinary shell input.
        parser_pty_compatible="$parser_source_dir/pty-compatible"
        parser_pty_restricted="$parser_source_dir/pty-restricted-ran"
        parser_pty_result=$(python3 - "$parser_shell" \
                "$parser_pty_compatible" "$parser_pty_restricted" <<'PY'
import os, pty, subprocess, sys, time

shell, compatible_path, restricted_path = sys.argv[1:]
master, slave = pty.openpty()
process = subprocess.Popen(
    [shell, "+i", "-s"], stdin=slave, stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL, close_fds=True)
os.close(slave)

def quoted(path):
    return "'" + path.replace("'", "'\\''") + "'"

os.write(master, ("printf ready > " + quoted(compatible_path) + "\n").encode())
deadline = time.monotonic() + 5
while time.monotonic() < deadline and not os.path.exists(compatible_path):
    time.sleep(0.01)
compatible = os.path.exists(compatible_path)

program = "awk 'BEGIN { print \"ready\" > \"%s\" }'\n" % (
    restricted_path.replace("\\", "\\\\").replace('"', '\\"'))
os.write(master, program.encode())
time.sleep(0.3)
os.write(master, b"exit 0\n")
try:
    process.wait(timeout=5)
except subprocess.TimeoutExpired:
    process.kill()
    process.wait()
os.close(master)

safe = (not os.path.exists(restricted_path) and process.returncode == 0)
print("%d:%d" % (compatible, safe))
PY
        )
        [ "$parser_pty_result" = 1:1 ]
        verdict shell-parser-pty-source shell_failed 'PTY parser compatibility/security answered [$parser_pty_result]'

        # An exec target cannot reap a here-document writer inherited from the
        # shell. Small input is synchronously placed in a pipe and input over
        # actual pipe capacity is sealed in a memfd; neither path leaves a
        # live/zombie child. Descriptor 3 also exercises the opened==target
        # CLOEXEC case.
        exec_here_result=$(python3 - "$farm/bash" "$farm/wc" <<'PY'
import os, shlex, subprocess, sys, tempfile

shell, wc = sys.argv[1:]
quote = shlex.quote

def run(script):
    path = None
    try:
        with tempfile.NamedTemporaryFile("w", delete=False) as source:
            path = source.name
            source.write(script)
        result = subprocess.run([shell, path], text=True,
                                stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, timeout=30)
        return result.returncode, result.stdout
    finally:
        if path:
            os.unlink(path)

inspect = '''children=
IFS= read -r children < "/proc/$$/task/$$/children"
count=$(%s -c)
printf 'children:%%s count:%%s\\n' "$children" "$count"
''' % quote(wc)
target = "%s -c %s" % (quote(shell), quote(inspect))
commands = {
    "literal": "exec " + target,
    "builtin": "builtin exec " + target,
    "command": "command exec " + target,
    "function": "f() { exec " + target + "; }\nf",
    "compound": "{ exec " + target + "; }",
}
answers = []
for name, command in commands.items():
    for body in ("small\n", "x" * (1 << 20) + "\n"):
        status, out = run(command + " <<'EOF'\n" + body + "EOF\n")
        expected = "children: count:%d\n" % len(body)
        answers.append((name, len(body), status, out, expected))

inspect_fd = r'''children=
IFS= read -r children < "/proc/$$/task/$$/children"
IFS= read -r body <&3
printf 'children:%s fd:%s\n' "$children" "$body"
'''
fd_script = "exec %s -c %s 3<<'EOF'\nfdthree\nEOF\n" % (
    quote(shell), quote(inspect_fd))
fd_status, fd_out = run(fd_script)

ok = (all(status == 0 and out == expected
          for _, _, status, out, expected in answers) and
      fd_status == 0 and fd_out == "children: fd:fdthree\n")
print("1" if ok else "0:%r:%d:%r" % (answers, fd_status, fd_out))
PY
        )
        [ "$exec_here_result" = 1 ]
        verdict shell-exec-heredoc-childless shell_failed 'explicit exec heredoc lifecycle answered [$exec_here_result]'

        # A completed background job may remain as a JOB_FINISHED row for a
        # later jobs notification. It is no longer a descendant and must not
        # disable the final-command in-place exec optimization. A stock shell
        # which has never activated Floodlight supervision retains ordinary
        # exec semantics even with a disowned child; restricted replacement
        # paths exercise the authenticated child gate in the Floodlight suite.
        # The optimization is implicit, so an EXIT trap still needs the
        # original shell to wait and run its post-command action.
        descendant_result=$(python3 - "$farm/bash" "$farm/sleep" <<'PY'
import os, re, shlex, signal, subprocess, sys

shell, sleep = sys.argv[1:]

completed_script = ": &\n%s 1\n%s -c 'printf \"tail:%%s\\n\" \"$$\"'\n" % (
    shlex.quote(sleep), shlex.quote(shell))
completed = subprocess.Popen(
    [shell, "-c", completed_script], stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL, text=True)
completed_output, _ = completed.communicate(timeout=10)
match = re.search(r"^tail:(\d+)$", completed_output, re.MULTILINE)
finished_ok = bool(
    completed.returncode == 0 and match and int(match.group(1)) == completed.pid)

disowned_script = "%s 5 &\nprintf 'child:%%s\\n' \"$!\"\ndisown\n%s -c 'printf \"tail:%%s\\n\" \"$$\"'\n" % (
    shlex.quote(sleep), shlex.quote(shell))
disowned = subprocess.Popen(
    [shell, "-c", disowned_script], stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL, text=True)
disowned_output, _ = disowned.communicate(timeout=10)
child_match = re.search(r"^child:(\d+)$", disowned_output, re.MULTILINE)
tail_match = re.search(r"^tail:(\d+)$", disowned_output, re.MULTILINE)
disowned_ok = bool(
    disowned.returncode == 0 and child_match and tail_match and
    int(tail_match.group(1)) == disowned.pid)
if child_match:
    try:
        os.kill(int(child_match.group(1)), signal.SIGTERM)
    except ProcessLookupError:
        pass

trapped_script = "trap 'echo exit:$?' EXIT\n%s -c 'exit 7'\n" % (
    shlex.quote(shell),)
trapped = subprocess.run(
    [shell, "-c", trapped_script], stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL, text=True, timeout=10)
trapped_ok = bool(trapped.returncode == 7 and trapped.stdout == "exit:7\n")

print("%d:%d:%d" % (finished_ok, disowned_ok, trapped_ok))
PY
        )
        [ "$descendant_result" = 1:1:1 ]
        verdict shell-exec-descendant-liveness shell_failed 'completed/disowned descendant exec checks answered [$descendant_result]'

        # Lazy confinement must not make a stock shell a child subreaper.
        # An ordinary double-fork daemon should be reparented past the shell,
        # while a later restricted launch can establish supervision anew.
        stock_daemon_result=$(python3 - "$farm/bash" "$farm/sleep" <<'PY'
import os, shlex, signal, subprocess, sys, tempfile, time

shell, sleep = sys.argv[1:]
with tempfile.TemporaryDirectory() as directory:
    helper = os.path.join(directory, "daemon.py")
    result = os.path.join(directory, "parent")
    with open(helper, "w") as output:
        output.write(r'''import os, sys, time
if os.fork():
    os._exit(0)
os.setsid()
if os.fork():
    os._exit(0)
time.sleep(.1)
with open(sys.argv[1], "w") as out:
    out.write("%d:%d" % (os.getppid(), os.getpid()))
time.sleep(5)
''')
    command = "%s %s %s\n%s 1\n" % (
        shlex.quote(sys.executable), shlex.quote(helper), shlex.quote(result),
        shlex.quote(sleep))
    process = subprocess.Popen([shell, "-c", command],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
    process.wait(timeout=10)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline and not os.path.exists(result):
        time.sleep(.01)
    answer = open(result).read() if os.path.exists(result) else ""
    try:
        parent, daemon = map(int, answer.split(":"))
    except ValueError:
        parent = daemon = -1
    if daemon > 0:
        try:
            os.kill(daemon, signal.SIGTERM)
        except ProcessLookupError:
            pass
    print("1" if process.returncode == 0 and parent != process.pid else
          "0:%d:%d:%s" % (process.returncode, process.pid, answer))
PY
        )
        [ "$stock_daemon_result" = 1 ]
        verdict shell-stock-daemon-parent shell_failed 'stock double-fork parent answered [$stock_daemon_result]'

        differential_domain shell || shell_failed=1
        return "$shell_failed"
}
lane_builtins()
{
        differential_ready || return $?
        need_shell || return 1
        builtins_failed=0

        mkdir -p "$work/history-regression/bin"
        chmod 700 "$work/history-regression"
        ln -sf "$shell_binary" "$work/history-regression/bin/bash"
        history_shell="$work/history-regression/bin/bash"

        mkdir -p "$work/fc-umask"
        if fc_masked=$(
                cd "$work/fc-umask" || exit 1
                "$history_shell" -c '
history -c 2>/dev/null
printf "echo one\n" > history
history -r history 2>/dev/null
fc_editor() { printf "echo edited\n" > "$1"; }
umask 0777
fc -e fc_editor 1
' 2>/dev/null
        ); then
                fc_masked_status=0
        else
                fc_masked_status=$?
        fi

        [ "$fc_masked_status:$fc_masked" = '0:edited' ]
        verdict fc-private-umask builtins_failed 'fc under umask 0777 returned $fc_masked_status [$fc_masked]'

        history_command='history -c; history -s replacement; history -w "$1"'
        history_append_command='history -c; history -s appended; history -a "$1"'

        printf 'old history\n' > "$work/history-regression/history"
        chmod 6751 "$work/history-regression/history"
        history_owner=$(stat -c %u:%g "$work/history-regression/history")
        "$history_shell" -c "$history_command" history \
                "$work/history-regression/history" \
                > "$work/history-regression/write.out" \
                2> "$work/history-regression/write.err"
        history_status=$?
        history_mode=$(stat -c %a "$work/history-regression/history" 2>/dev/null ||
                printf unknown)
        history_owner_after=$(stat -c %u:%g \
                "$work/history-regression/history" 2>/dev/null || printf unknown)
        [ "$history_status:$(cat "$work/history-regression/history"):$history_mode:$history_owner_after" = \
                "0:replacement:751:$history_owner" ]
        verdict history-transaction-success builtins_failed 'history rewrite returned $history_status, mode $history_mode, owner $history_owner_after, content [$(cat "$work/history-regression/history")]'

        printf 'old history\n' > "$work/history-regression/preserved"
