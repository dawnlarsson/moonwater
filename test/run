)

#
#       Moonwater put on a disk, and found there again.
#
#           sh test/run install       (MOONWATER_IMAGE names the image)
#
#       Four boots share one NVMe disk. The first is a live session beside a
#       USB stick carrying the image, and installs to the disk. The second
#       starts with the disk alone and must find its data waiting. The third
#       starts beside the stick after the disk's image has been made another
#       build, and must ask, and update when told to. The fourth asks again,
#       is told to leave the disk alone, and then uses the disk's data without
#       updating it. Between boots the host reads the disk with its own tools:
#       sfdisk the table, e2fsck the data partition, which is the only judge
#       here that is not this project's code. Where OVMF is installed, UEFI
#       firmware starts the disk last with no -kernel at all.
#
#       The stick is QEMU's vvfat view of a directory, attached as USB mass
#       storage so it arrives late the way a real one does; the disk is NVMe,
#       because the image has no virtio-blk. Answers are reversed or made
#       arithmetic, as in the boot lane, so the command echo cannot pass.
#
lane_install()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}

#
#       The machine the image is for, which is the one it installs on: its
#       emulator and console, the removable-media name its firmware starts
#       (and the short name FAT gives it), its firmware, and how much longer
#       than a KVM x86 boot an emulated one takes. The board is named apart
#       from the processor because x86 starts the kernel on QEMU's default
#       board and the firmware on q35.
#
case "$image" in
*aa64.efi)
        install_emulator=qemu-system-aarch64
        install_console=ttyAMA0
        install_loader=BOOTAA64.EFI
        install_short='BOOTAA64EFI'
        install_board="-machine virt,gic-version=3"
        install_firmware_board=$install_board
        install_machine="-cpu max,pauth-impdef=on"
        install_slow=3
        case "$(uname -s):$(uname -m)" in
        Darwin:arm64) install_machine="-accel hvf -cpu host"; install_slow=1 ;;
        Linux:aarch64) [ -w /dev/kvm ] && install_machine="-enable-kvm -cpu host" && install_slow=1 ;;
        esac
        install_firmwares="/usr/share/edk2/aarch64/QEMU_EFI.fd:/usr/share/edk2/aarch64/QEMU_VARS.fd"
        install_started='BdsDxe: starting Boot'
        install_from='NVMe Ctrl moonwater'
        ;;
*riscv64.efi)
        install_emulator=qemu-system-riscv64
        install_console=ttyS0
        install_loader=BOOTRISCV64.EFI
        install_short='BOOTRI~1EFI'
        install_board="-machine virt"
        install_firmware_board=$install_board
        install_machine="-cpu rv64"
        install_slow=2
        install_firmwares="/usr/share/edk2/riscv64/RISCV_VIRT_CODE.fd:/usr/share/edk2/riscv64/RISCV_VIRT_VARS.fd"
        #       Its edk2 says nothing of what it boots, and the kernel it
        #       started says both: an EFI start, of an image with Moonwater's
        #       table, with nothing attached but the disk.
        install_started='efi: EFI v'
        install_from=' Moonwater=0x'
        ;;
*)
        install_emulator=qemu-system-x86_64
        install_console=ttyS0
        install_loader=BOOTX64.EFI
        install_short='BOOTX64 EFI'
        install_board=""
        install_firmware_board="-machine q35"
        install_machine="-cpu Nehalem -vga none"
        [ -r /dev/kvm ] && [ -w /dev/kvm ] &&
                install_machine="-enable-kvm -cpu host -vga none"
        install_slow=1
        install_started='BdsDxe: starting Boot'
        install_from='NVMe Ctrl moonwater'
        install_firmwares=""
        for candidate in /usr/share/edk2/x64/OVMF_CODE.4m.fd \
                /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd \
                /usr/share/edk2-ovmf/x64/OVMF_CODE.fd; do
                install_firmwares="$install_firmwares $candidate:${candidate%CODE*}VARS${candidate##*CODE}"
        done
        ;;
esac

for tool in "$install_emulator" timeout truncate; do
        if ! command -v "$tool" > /dev/null 2>&1; then
                echo "  install      NOT RUN -- no $tool"
                exit 2
        fi
done

if [ ! -f "$image" ]; then
        echo "  install      NOT RUN -- no image at $image"
        exit 2
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

counting install 12 30

#
#       moonwater link across the install: this machine stands in for a second
#       one, with its own /root and /run by a mount namespace and the shell
#       binary as its moonwater. The live session pairs it, allows it run and
#       switches the link on; the disk boot must have the listener up again
#       from what the install carried, and this side reaches it through a
#       forwarded UDP port and runs a command there.
#
link_host=""
link_port=$((20000 + $$ % 20000))
if command -v unshare > /dev/null 2>&1 && unshare -Urm true 2> /dev/null &&
        need_shell > /dev/null 2>&1; then
        link_host=$work/link-host
        mkdir -p "$link_host/root" "$link_host/run" "$link_host/bin"
        ln -sf "$shell_binary" "$link_host/bin/moonwater"
        ln -sf "$shell_binary" "$link_host/bin/sh"
fi
link_on_host()
{
        unshare -Urm sh -c "mount --bind $link_host/root /root &&
                mount --bind $link_host/run /run && mkdir -p /run/moonwater &&
                cd /root && $*"
}
link_host_key=none
[ -z "$link_host" ] || link_host_key=$(link_on_host "$link_host/bin/moonwater link key")

#
#       The image as firmware reads it: a PE whose sections run in order,
#       aligned, inside the file and the image and overlapping nothing, and
#       whose settings section is where the moonwater command looks for it --
#       a whole number of pages at the raw offset that is also its address,
#       two 16 KiB slots, both carrying the magic.
#
if command -v python3 > /dev/null 2>&1; then
        python3 - "$image" > "$work/layout" 2>&1 <<'PY'
import struct, sys
d = open(sys.argv[1], 'rb').read()
pe = struct.unpack_from('<I', d, 0x3c)[0]
optional = pe + 24
count = struct.unpack_from('<H', d, pe + 6)[0]
table = optional + struct.unpack_from('<H', d, pe + 20)[0]
section_align, file_align = struct.unpack_from('<II', d, optional + 32)
image_size, headers = struct.unpack_from('<II', d, optional + 56)
rows = []
for at in range(count):
    s = d[table + 40 * at:table + 40 * at + 40]
    rows.append((s[:8].rstrip(b'\0'),) + struct.unpack_from('<IIII', s, 8))
def said(word, holds):
    print('layout-%s-%s' % (word, 'yes' if holds else 'no'))
said('pe', d[:2] == b'MZ' and d[pe:pe + 4] == b'PE\0\0' and table + 40 * count <= headers)
said('ordered', rows[0][2] >= headers and
     all(a[2] + a[1] <= b[2] and a[4] + a[3] <= b[4] for a, b in zip(rows, rows[1:])))
said('aligned', all(va % section_align == 0 and raw % file_align == 0
                    for _, vs, va, rs, raw in rows))
said('inside', image_size % section_align == 0 and
     all(raw + rs <= len(d) and va + vs <= image_size for _, vs, va, rs, raw in rows))
#       Two slots, or on arm64 the 64 KiB its sections are aligned to.
found = [r for r in rows if r[0] == b'.mwset']
said('settings', len(found) == 1 and found[0][2] == found[0][4] and
     found[0][4] % 4096 == 0 and found[0][1] == found[0][3] and
     found[0][1] in (32768, section_align) and
     all(struct.unpack_from('<Q', d, found[0][4] + k)[0] == 0x474e54544553574d
         for k in (0, 16384)))
PY
        says layout 'the image is a PE firmware reads' 'layout-pe-yes'
        says layout 'its sections run in order'   'layout-ordered-yes'
        says layout 'every section is aligned'     'layout-aligned-yes'
        says layout 'every section is inside it'   'layout-inside-yes'
        says layout 'settings are where moonwater looks' 'layout-settings-yes'
fi

mkdir -p "$work/stick/EFI/BOOT" &&
        cp "$image" "$work/stick/EFI/BOOT/$install_loader" &&
        truncate -s 4G "$work/disk.img" || exit 1

#       Another build is this one with a byte of its version changed: in the
#       x86 setup header, which the disk commands find themselves, or in the
#       release that begins the numbered banner an arm64 or riscv64 image
#       carries, which is found here.
install_patch=""
if [ "$install_loader" != BOOTX64.EFI ]; then
        install_banner=$(python3 - "$image" <<'PY'
import re, sys
d = open(sys.argv[1], 'rb').read()
m = re.search(rb'Linux version [^\n]*\) #[0-9][^\n]*\n', d)
print(m.start() + len(b'Linux version ') if m else '')
PY
) && [ -n "$install_banner" ] || { lost 'install image' 'no numbered banner in the image'; exit 1; }
        install_patch="s|^at=\$(od -An -tu2 -j526 -N2 .*)\$|at=$((install_banner - 512))|"
fi

stick="-drive if=none,id=stick,format=raw,file=fat:ro:$work/stick,readonly=on"
stick="$stick -device usb-storage,bus=xhci.0,drive=stick,removable=on"

#
#       The commands wait for the console shell's prompt.
#
#       Piped in at power on, they arrive while the kernel is still writing its
#       log to the same UART, and the receive FIFO overruns: one boot here lost
#       the closing quote of its second line and spent the rest of the run
#       inside a string. The boot lane only loses the start of its first line,
#       because its shell starts at once. This one starts after moonwater boot
#       has settled the disks, a USB stick included, so the commands go through
#       a FIFO and are written once the prompt is on the line.
#
#       And no display. With one the compositor starts its terminal, which
#       takes boot's question and waits for an answer at a window nothing
#       here can type into, and the serial shell's moonwater ask then has
#       nothing to ask.
#
install_boot()
{
        name=$1
        shift
        rm -f "$work/serial.in"
        mkfifo "$work/serial.in" || exit 1
        coverage_guest "$image" "$work/coverage-$name"
        # shellcheck disable=SC2086
        timeout $((240 * install_slow)) "$install_emulator" -m "${install_memory:-2G}" -smp 2 $install_board $install_machine \
                -kernel "$image" -no-reboot -display none -serial stdio $coverage_serial \
                -append "console=$install_console drm_client_lib.active=" \
                -device qemu-xhci,id=xhci \
                -drive if=none,id=disk,format=raw,file="${install_disk:-$work/disk.img}" \
                -device nvme,serial=moonwater,drive=disk \
                "$@" < "$work/serial.in" > "$work/$name" 2>&1 &
        booting=$!
        exec 9> "$work/serial.in"

        waited=0
        until grep -q -F ' $ ' "$work/$name" 2>/dev/null; do
                kill -0 "$booting" 2>/dev/null || break
                [ "$waited" -lt $((180 * install_slow)) ] || break
                sleep 1
                waited=$((waited + 1))
        done

        #       The image's own name on its machine, and where a byte of its
        #       version is to make it another build.
        #       And after boot's verdict: emulated, the prompt can come while
        #       moonwater boot is still settling the disks.
        {
                sed -n 1p "$work/$name.commands"
                echo 'until [ -e /run/moonwater/verdict ]; do sleep 1; done'
                coverage_guest_commands "$work/$name.commands" | sed 1d
        } | sed -e "s|/EFI/BOOT/BOOTX64.EFI|/EFI/BOOT/$install_loader|g" \
                -e "$install_patch" >&9
        exec 9>&-
        wait "$booting" 2>/dev/null || true
        coverage_guest_collect "install-$name"

        says "$name" "$name powered down" 'reboot: Power down'
        never "$name" "$name without a panic" 'Kernel panic'
        never "$name" "$name without an oops" 'Oops:'
        never "$name" "$name without ext4 errors" 'EXT4-fs error'
}

#       What the host's own tools make of the disk after a boot.
disk_checks()
{
        if ! command -v sfdisk > /dev/null 2>&1 ||
                ! command -v e2fsck > /dev/null 2>&1; then
                printf '  %-30s no sfdisk or e2fsck here to read it\n' "$1 disk"
                return
        fi

        if sfdisk --verify "${install_disk:-$work/disk.img}" > "$work/sfdisk" 2>&1; then
                won
        else
                lost "$1 disk" 'sfdisk --verify refused the table'
                sed 's/^/    /' "$work/sfdisk" | head -8
        fi

        offset=$(sfdisk -d "${install_disk:-$work/disk.img}" 2>/dev/null |
                awk -F '[=,]' '/name="moonwater-data"/ { print $2 * 512; exit }')

        if [ -n "$offset" ] &&
                e2fsck -fn "${install_disk:-$work/disk.img}?offset=$offset" > "$work/fsck" 2>&1; then
                won
        else
                lost "$1 disk" 'e2fsck -fn is not clean'
                sed 's/^/    /' "$work/fsck" | head -12
        fi
}

#
#       Power lost while an image is being written, and an image that cannot
#       be written whole.
#
#       A guest on pipes is started beside the stick, asked to update (or
#       install), and killed outright a few milliseconds after it says it is
#       writing the build, with QEMU gone mid-write. What is left on the disk
#       is read from here, with a FAT reader that is not Moonwater's: the
#       loader is the image the disk had or the one it was given, never
#       between, no cluster chain of a file that is kept runs out, and a
#       staging file the cut left is the one thing allowed to be there. Then
#       the same disk is asked again and must come out as this build, with
#       nothing left beside it. A stick whose image has no settings section
#       says so, and one that stops short of its own sections is refused with
#       the disk as it was.
#
#       The grid of cut times is where the write is, which is a few hundred
#       milliseconds on a disk that answers at once; rows say that some cut
#       landed with the copy begun and the old loader still the loader, and
#       some after the new one was in place, so a grid that missed the write
#       does not pass for one that held.
#
cat > "$work/fatjudge.py" <<'PY'
import hashlib, re, struct, sys

def masked(data):
    # An image with the bytes of its settings section, where an install or an
    # update stamps what the disk keeps, set aside.
    d = bytearray(data)
    if d[:2] == b'MZ':
        pe = struct.unpack_from('<I', d, 0x3c)[0]
        if bytes(d[pe:pe + 4]) == b'PE\0\0':
            table = pe + 24 + struct.unpack_from('<H', d, pe + 20)[0]
            for i in range(struct.unpack_from('<H', d, pe + 6)[0]):
                s = bytes(d[table + 40 * i:table + 40 * i + 40])
                if s[:8].rstrip(b'\0') == b'.mwset':
                    size, raw = struct.unpack_from('<II', s, 16)
                    d[raw:raw + size] = b'\0' * len(d[raw:raw + size])
    return hashlib.sha256(bytes(d)).hexdigest()

class Disk:
    def __init__(self, path):
        self.f = open(path, 'rb')
        head = self.read(512, 92)
        entries, count, size = struct.unpack_from('<QII', head, 72)
        self.start = None
        for i in range(count):
            e = self.read(entries * 512 + i * size, size)
            if e[56:128].decode('utf-16-le', 'replace').rstrip('\0') == 'moonwater-boot':
                self.start = struct.unpack_from('<Q', e, 32)[0] * 512
        if self.start is None:
            raise SystemExit('none')
        boot = self.read(self.start, 512)
        self.sector, per, reserved, fats = struct.unpack_from('<HBHB', boot, 11)
        self.fat_sectors = struct.unpack_from('<I', boot, 36)[0]
        self.root = struct.unpack_from('<I', boot, 44)[0]
        self.cluster = self.sector * per
        self.fat = self.start + reserved * self.sector
        self.data = self.fat + fats * self.fat_sectors * self.sector
        self.clusters = (self.fat_sectors * self.sector) // 4
        self.table = self.read(self.fat, self.fat_sectors * self.sector)
        self.errors = []
        self.claimed = {}
    def read(self, offset, size):
        self.f.seek(offset)
        return self.f.read(size)
    def next(self, c):
        return struct.unpack_from('<I', self.table, c * 4)[0] & 0x0fffffff
    def chain(self, first, what, size=None):
        out, c = [], first
        if first == 0:
            if size:
                self.errors.append('%s has no clusters for %d bytes' % (what, size))
            return out
        while True:
            if c < 2 or c >= self.clusters or c == 0x0ffffff7:
                self.errors.append('%s runs to cluster %#x' % (what, c))
                return out
            if self.next(c) == 0:
                self.errors.append('%s has a free cluster %d in its chain' % (what, c))
                return out
            if c in out:
                self.errors.append('%s loops' % what)
                return out
            if self.claimed.get(c, what) != what:
                self.errors.append('%s and %s share cluster %d' % (what, self.claimed[c], c))
            self.claimed[c] = what
            out.append(c)
            c = self.next(c)
            if c >= 0x0ffffff8:
                break
        if size is not None and len(out) * self.cluster < size:
            self.errors.append('%s is %d bytes in %d clusters' % (what, size, len(out)))
        return out
    def entries(self, first, what):
        found = []
        for c in self.chain(first, what):
            blob = self.read(self.data + (c - 2) * self.cluster, self.cluster)
            for o in range(0, self.cluster, 32):
                e = blob[o:o + 32]
                if e[0] == 0:
                    return found
                if e[0] == 0xe5 or e[11] == 0x0f or e[11] & 0x08:
                    continue
                found.append((e[:11].decode('latin-1'), e[11],
                              struct.unpack_from('<H', e, 20)[0] << 16 |
                              struct.unpack_from('<H', e, 26)[0],
                              struct.unpack_from('<I', e, 28)[0]))
        return found
    def content(self, first, size, what):
        data = b''
        for c in self.chain(first, what, size):
            data += self.read(self.data + (c - 2) * self.cluster, self.cluster)
        return data[:size]

def survey(path):
    d = Disk(path)
    files = {}
    d.dirs = {}
    stack = [('', d.root)]
    while stack:
        where, first = stack.pop()
        for name, attr, cl, size in d.entries(first, where or '/'):
            if name.startswith('.'):
                continue
            full = where + '/' + name.rstrip()
            if attr & 0x10:
                d.dirs[full] = cl
                stack.append((full, cl))
            else:
                files[full] = (size, cl)
                d.chain(cl, full, size)
    return d, files

def find(d, files, tail):
    found = [k for k in files if k.endswith('/' + tail)]
    if not found:
        return None
    size, cl = files[found[0]]
    return masked(d.content(cl, size, found[0]))

def stale(path):
    # What a cut leaves when the directory block reached the disk and the FAT
    # did not: a staging file beside each image, of 14 MB, whose first cluster
    # the FAT says is free.
    d, files = survey(path)
    w = open(path, 'r+b')
    free = [c for c in range(2, d.clusters) if d.next(c) == 0][-2:]
    for where, name, cluster in (('/EFI/BOOT', b'BOOTX64 NEW', free[0]),
                                 ('/EFI/MOONWA~1', b'PREVIOUSNEW', free[1])):
        for c in d.chain(d.dirs[where], where):
            at = d.data + (c - 2) * d.cluster
            blob = d.read(at, d.cluster)
            slot = [o for o in range(0, d.cluster, 32) if blob[o] in (0, 0xe5)]
            if slot:
                entry = bytearray(32)
                entry[:11] = name
                entry[11] = 0x20
                struct.pack_into('<H', entry, 20, cluster >> 16)
                struct.pack_into('<H', entry, 26, cluster & 0xffff)
                struct.pack_into('<I', entry, 28, 14 * 1024 * 1024)
                w.seek(at + slot[0])
                w.write(entry)
                break
    w.close()

mode = sys.argv[1]
if mode == 'stale':
    stale(sys.argv[2])
elif mode == 'sha':
    print(masked(open(sys.argv[2], 'rb').read()))
elif mode == 'diskimage':
    d, files = survey(sys.argv[2])
    print(find(d, files, sys.argv[3]))
elif mode == 'judge':
    # judge DISK LOADER OLD NEW: what is on the disk, as words.
    path, loader, old, new = sys.argv[2:6]
    try:
        d, files = survey(path)
    except BaseException as e:
        # No Moonwater partition, or a FAT that was still being made: no
        # loader, which is whole when there was none to lose.
        print('no-partitions' if isinstance(e, SystemExit) else 'fat-unreadable %s' % e)
        print('image-absent')
        print('image-whole' if old == 'none' else 'image-not-whole')
        sys.exit(0)
    sha = find(d, files, loader)
    state = 'absent' if sha is None else 'old' if sha == old else 'new' if sha == new else 'torn'
    print('image-%s' % state)
    print('image-whole' if state in ('old', 'new') or (state == 'absent' and old == 'none')
          else 'image-not-whole')
    left = sorted(k.replace(' ', '') for k in files if k.endswith('NEW'))
    print('leftover-%s' % (','.join(left) if left else 'none'))
    sha = find(d, files, 'PREVIOUSEFI')
    print('previous-absent' if sha is None else
          'previous-%s' % ('old' if sha == old else 'new' if sha == new else 'torn'))
    # A staging file the cut left half made is the one thing allowed to be
    # wrong: the next write removes it.
    errors = [e for e in d.errors if not re.search(r'NEW\b', e)]
    print('fat-ok' if not errors else 'fat-bad %s' % '; '.join(errors[:4]))
PY
cat > "$work/cutboot.py" <<'PY'
import os, re, subprocess, sys, threading, time

# cutboot.py LOG TRIGGER K_MS COMMANDS LIMIT -- QEMU...
# A guest started with its console on pipes, given COMMANDS at its first
# prompt, and killed outright K_MS after TRIGGER first shows on the console
# (never, when K_MS is negative). Says what became of it, and the time of
# every line the moonwater command said, from the trigger, in LOG.times.
log, trigger, k, commands, limit = sys.argv[1:6]
k, limit = int(k), float(limit)
argv = sys.argv[sys.argv.index('--') + 1:]
trigger = trigger.encode()
p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                     stderr=subprocess.STDOUT)
out = open(log, 'wb')
times = open(log + '.times', 'w')
seen = bytearray()
state = {'sent': False, 'fired': None}
begun = time.monotonic()

def reader():
    taken = 0
    while True:
        chunk = os.read(p.stdout.fileno(), 65536)
        if not chunk:
            return
        out.write(chunk)
        out.flush()
        seen.extend(chunk)
        if not state['sent'] and b' $ ' in seen:
            state['sent'] = True
            p.stdin.write(open(commands, 'rb').read())
            p.stdin.close()
        #       The kernel's own lines cut the console's in two (see says_whole).
        if state['fired'] is None and \
                trigger in re.sub(rb'\[ *[0-9]+\.[0-9]+\][^\n]*\n', b'', bytes(seen)):
            state['fired'] = time.monotonic()
        while b'\n' in seen[taken:]:
            end = seen.index(b'\n', taken)
            line = bytes(seen[taken:end])
            taken = end + 1
            if state['fired'] is not None and b'[Moonwater]' in line:
                times.write('%d %s\n' % ((time.monotonic() - state['fired']) * 1000,
                                         line.decode('latin-1', 'replace').strip()))
                times.flush()

thread = threading.Thread(target=reader, daemon=True)
thread.start()
cut = False
while p.poll() is None and time.monotonic() - begun < limit:
    if k >= 0 and state['fired'] is not None:
        time.sleep(k / 1000.0)
        p.kill()
        cut = True
        break
    time.sleep(0.002)
if p.poll() is None:
    p.kill()
p.wait()
thread.join(5)
print('fired-%s' % ('yes' if state['fired'] else 'no'))
print('killed-%s' % ('yes' if cut else 'no'))
print('ms-%d' % ((time.monotonic() - state['fired']) * 1000 if state['fired'] else -1))
PY

