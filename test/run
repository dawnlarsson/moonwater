        #       The data an install keeps, read by e2fsck and debugfs: the
        #       ext4 is clean and /root/big is all of its 300 MB.
        cut_data()
        {
                offset=$(sfdisk -d "$2" 2> /dev/null |
                        awk -F '[=,]' '/name="moonwater-data"/ { print $2 * 512; exit }')
                size=$(debugfs -R 'stat /root/big' "$2?offset=$offset" 2> /dev/null |
                        sed -n 's/^.*Size: \([0-9]*\).*$/\1/p' | head -n 1)
                if [ -n "$offset" ] && e2fsck -fn "$2?offset=$offset" > /dev/null 2>&1 &&
                        [ "$size" = 314572800 ]; then
                        echo data-whole >> "$work/$1"
                else
                        echo "data-partial-${size:-none}" >> "$work/$1"
                fi
        }

        old_sha=none
        landed_copy=0
        landed_image=0
        cut_trigger='partitioning and formatting'
