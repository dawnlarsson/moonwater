printf 'gone-said-%s\n' $(( $(grep -c 'is left without a partition table' /tmp/gone) * 7 ))
printf 'gone-parts-%s\n' $(( $(ls /sys/class/block | grep -c '^nvme1n1p') + 30 ))
poweroff
