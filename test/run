for i in $(seq 1 60); do [ "$(cat /proc/sys/net/ipv4/tcp_syncookies)" = 1 ] && break; sleep 0.2; done
printf 'nk-%s-%s-%s-%s-%s\n' "$(cat /proc/sys/net/ipv4/conf/default/accept_redirects)" "$(cat /proc/sys/net/ipv6/conf/eth0/accept_ra)" "$(cat /proc/sys/net/ipv6/conf/default/autoconf)" "$(cat /proc/sys/net/ipv4/tcp_rfc1337)" "$(cat /proc/sys/net/ipv4/tcp_syncookies)" | rev
#
#       The address space of a program the Spark loader started is randomized,
#       as an ELF's is: the loader never set PF_RANDOMIZE, which begin_new_exec
#       clears, so every program's stack sat at the top of the address space
#       and its mmap area at a fixed distance below it, and the shell and
#       every tool that reads a file, a peer or an archive somebody else
#       wrote ran that way. Eight programs, each asked where its own stack is;
#       fewer than five different answers is a layout that does not move.
#
aslr=$(for i in 1 2 3 4 5 6 7 8; do /shell -c 'grep "\[stack\]" /proc/self/maps'; done | sort -u | wc -l)
[ "$aslr" -ge 5 ] && printf 'stack-aslr\n' | rev
#
#       A 32-bit process that starts a Spark image. The compatibility layers
#       are on in this build, and a process carries its 32-bit mode in its
#       thread flags across exec: the ELF loader sets them for what it loads
#       and this loader did not, so the shell started that way was a 64-bit
#       program in a 4 GiB address space with the 32-bit mmap layout and died
#       at its first look at its own arguments. The program here is 163 bytes
#       of i386: execve("/shell", {"sh", "-c", "echo mode-ok | rev"}, 0).
#
printf '\177ELF\001\001\001\000\000\000\000\000\000\000\000\000\002\000\003\000\001\000\000\000T\200\004\0104\000\000\000\000\000\000\000\000\000\000\0004\000 \000\001\000\000\000\000\000\000\000\001\000\000\000\000\000\000\000\000\200\004\010\000\200\004\010\243\000\000\000\243\000\000\000\007\000\000\000\000\020\000\000\270\013\000\000\000\273s\200\004\010\271\223\200\004\0101\322\315\200\270\001\000\000\000\273c\000\000\000\315\200/shell\000sh\000-c\000echo mode-ok | rev\000z\200\004\010}\200\004\010\200\200\004\010\000\000\000\000' > /tmp/e32
chmod +x /tmp/e32
/tmp/e32
#
#       Floodlight, on a running machine.
#
#       Everything else about the register is checked in a harness. This is the
#       only place it is asked on a kernel that booted: the device is there, it
#       says what this kernel was built saying, and an applet that turns data
#       into a command cannot start one. rev keeps the answers out of the
#       command echo, the way every other check here does.
