        cat > "$work/wget-write-server.py" <<'PY'
import socket
import sys

body = bytes(range(256)) * 4096
server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(("127.0.0.1", 0))
server.listen(8)
with open(sys.argv[1], "w", encoding="ascii") as port:
    port.write(str(server.getsockname()[1]))
while True:
    connection, _ = server.accept()
    with connection:
        request = b""
        while b"\r\n\r\n" not in request:
            part = connection.recv(4096)
            if not part:
                break
            request += part
        try:
            connection.sendall(b"HTTP/1.0 200 OK\r\nContent-Length: %d\r\n"
                               b"Connection: close\r\n\r\n" % len(body) + body)
        except OSError:
            pass
PY
        wget_place="$work/wget-write"
        mkdir -p "$wget_place/ours" "$wget_place/gnu"
        rm -f "$wget_place/port"
        python3 "$work/wget-write-server.py" "$wget_place/port" &
        wget_server=$!
        wget_wait=0
        while [ ! -s "$wget_place/port" ] && [ "$wget_wait" -lt 200 ]; do
                sleep 0.01
                wget_wait=$((wget_wait + 1))
        done
        wget_url="http://127.0.0.1:$(cat "$wget_place/port" 2>/dev/null)/payload"
        #       wget_run WGET DIR NAME [OPTION...]: -O - onto /dev/full, then
        #       -O out in DIR under a 256-block write limit; both statuses,
        #       then each last line.
        wget_run()
        {
                wget_program=$1
                wget_dir=$2
                wget_name=$3
                shift 3
                timeout 10 "$wget_program" "$@" -O - "$wget_url" \
                        > /dev/full 2> "$wget_place/$wget_name-stdout.err"
                printf '%s ' "$?"
                (
                        cd "$wget_dir" || exit 125
                        ulimit -f 256
                        trap '' 25
                        exec timeout 10 "$wget_program" "$@" -O out "$wget_url"
                ) 2> "$wget_place/$wget_name-file.err"
                printf '%s\n' "$?"
                tail -n 1 "$wget_place/$wget_name-stdout.err"
                tail -n 1 "$wget_place/$wget_name-file.err"
        }
        if [ -s "$wget_place/port" ]; then
                wget_ours=$(wget_run "$farm/wget" "$wget_place/ours" ours)
        else
                wget_ours=server-failed
        fi
        wget_expected="3 3
Cannot write to '-' (No space left on device).
Cannot write to 'out' (File too large)."
        [ "$wget_ours" = "$wget_expected" ] &&
                [ -z "$(ls -A "$wget_place/ours")" ]
        verdict wget-write-failure-says-why builtins_failed 'wget onto a full disk said [$wget_ours], left [$(ls -A "$wget_place/ours")]'
        wget_gnu=$(PATH=/usr/local/bin:/usr/bin:/bin command -v wget)
        if [ -n "$wget_gnu" ] && [ -s "$wget_place/port" ] &&
                "$wget_gnu" --version 2>/dev/null | head -n 1 | grep -q '^GNU Wget'; then
                wget_gnu_said=$(wget_run "$wget_gnu" "$wget_place/gnu" gnu \
                        --no-config --no-proxy --no-hsts)
                [ "$wget_gnu_said" = "$wget_ours" ]
                verdict wget-write-failure-matches-gnu builtins_failed 'GNU wget said [$wget_gnu_said] where ours said [$wget_ours]'
        else
                note "wget write failure against GNU wget: NOT RUN -- no GNU wget"
        fi
        #       -O onto a device or a FIFO writes into the node, as GNU wget
        #       and every other staged output here do. The node was replaced
        #       by a regular file instead -- /dev/null itself, run as root --
        #       or refused outright when its directory was not writable.
        #       wget_stream_run WGET DIR [OPTION...]: the /dev/null status,
        #       the FIFO status, the bytes a reader drew through the FIFO,
        #       and whether the FIFO is still one.
        wget_stream_run()
        {
                wget_program=$1
                wget_dir=$2
                shift 2
                mkdir -p "$wget_dir"
                timeout 10 "$wget_program" -q "$@" -O /dev/null "$wget_url"
                printf '%s ' "$?"
                rm -f "$wget_dir/fifo"
                mkfifo "$wget_dir/fifo" || { echo no-fifo; return; }
                timeout 10 sh -c 'exec wc -c < "$1"' sh "$wget_dir/fifo" \
                        > "$wget_dir/count" 2>/dev/null &
                wget_reader=$!
                timeout 10 "$wget_program" -q "$@" -O "$wget_dir/fifo" "$wget_url"
                printf '%s ' "$?"
                wait "$wget_reader"
                printf '%s ' "$(tr -d ' ' < "$wget_dir/count")"
                if [ -p "$wget_dir/fifo" ]; then echo fifo; else echo replaced; fi
        }
        if [ -s "$wget_place/port" ]; then
                wget_stream_ours=$(wget_stream_run "$farm/wget" "$wget_place/stream-ours")
        else
                wget_stream_ours=server-failed
        fi
        [ "$wget_stream_ours" = "0 0 1048576 fifo" ]
        verdict wget-into-device-and-fifo builtins_failed 'wget -O /dev/null, -O fifo said [$wget_stream_ours], want [0 0 1048576 fifo]'
        #       A symlink planted at the -O name is replaced, never written
        #       through (where GNU wget follows it): the download lands in a
        #       regular file of that name and the link's target keeps its
        #       bytes.
        printf keep > "$wget_place/victim"
        ln -sf "$wget_place/victim" "$wget_place/stream-ours/link"
        timeout 10 "$farm/wget" -q -O "$wget_place/stream-ours/link" "$wget_url"
        wget_link_status=$?
        [ "$wget_link_status" = 0 ] && [ ! -L "$wget_place/stream-ours/link" ] &&
                [ "$(cat "$wget_place/victim")" = keep ] &&
                [ "$(wc -c < "$wget_place/stream-ours/link")" -eq 1048576 ]
        verdict wget-output-link-replaced builtins_failed 'wget -O onto a symlink: status $wget_link_status, victim [$(cat "$wget_place/victim")]'
        #       A link to a FIFO -- /dev/stdout onto a pipe is one -- is
        #       followed into the FIFO, as GNU wget follows it, and stays.
        wget_fifo_dir=$wget_place/stream-ours
        rm -f "$wget_fifo_dir/linked-fifo" "$wget_fifo_dir/fifo-link"
        mkfifo "$wget_fifo_dir/linked-fifo"
        ln -s linked-fifo "$wget_fifo_dir/fifo-link"
        timeout 10 sh -c 'exec wc -c < "$1"' sh "$wget_fifo_dir/linked-fifo" \
                > "$wget_fifo_dir/linked-count" 2>/dev/null &
        wget_reader=$!
        timeout 10 "$farm/wget" -q -O "$wget_fifo_dir/fifo-link" "$wget_url"
        wget_link_status=$?
        wait "$wget_reader"
        [ "$wget_link_status" = 0 ] && [ -L "$wget_fifo_dir/fifo-link" ] &&
                [ "$(tr -d ' ' < "$wget_fifo_dir/linked-count")" = 1048576 ]
        verdict wget-output-link-to-fifo builtins_failed 'wget -O onto a link to a FIFO: status $wget_link_status, read [$(cat "$wget_fifo_dir/linked-count")]'
        if [ -n "$wget_gnu" ] && [ -s "$wget_place/port" ] &&
                "$wget_gnu" --version 2>/dev/null | head -n 1 | grep -q '^GNU Wget'; then
                wget_stream_gnu=$(wget_stream_run "$wget_gnu" "$wget_place/stream-gnu" \
                        --no-config --no-proxy --no-hsts)
                [ "$wget_stream_gnu" = "$wget_stream_ours" ]
                verdict wget-into-device-and-fifo-matches-gnu builtins_failed 'GNU wget said [$wget_stream_gnu] where ours said [$wget_stream_ours]'
        fi
        kill "$wget_server" 2>/dev/null || :
        wait "$wget_server" 2>/dev/null || :

        #       wget against GNU wget, row by row: exit status, the last
        #       thing said, and every file left behind with its mode and its
        #       bytes, which are the path the server was asked for -- so a
        #       dot segment shows as the request it became. A row's pinned
        #       answer holds ours; GNU wget, where installed, must give the
        #       same unless the row is ours alone (a name ending =), where
        #       this client is stricter on purpose.
        cat > "$work/wget-rows-server.py" <<'PY'
import socket
import sys
import threading

def reply(path):
    if path.startswith("/to/"):
        return (302, "Location: " + path[4:].replace("~", "/"), b"")
    fixed = {
        "/404": (404, "", b"no\n"), "/500": (500, "", b"no\n"),
        "/401": (401, 'WWW-Authenticate: Basic realm="x"', b"no\n"),
        "/407": (407, "", b"no\n"), "/304": (304, "", b""),
        "/dots": (302, "Location: ../../a/./b/../file", b""),
        "/dots-absolute": (302, "Location: /x/../y/./%2e%2E/z", b""),
        "/loop": (302, "Location: /loop", b""),
    }
    return fixed.get(path, (200, "", path.encode() + b"\n"))

def serve(connection):
    with connection:
        request = b""
        while b"\r\n\r\n" not in request:
            part = connection.recv(4096)
            if not part:
                return
            request += part
        target = request.split(b" ")[1].decode()
        if target == "/malformed":
            connection.sendall(b"HTTP/1.1 2x0 Odd\r\n\r\n")
            return
        if target == "/empty":
            return
        code, extra, body = reply(target)
        head = "HTTP/1.1 %d X\r\nContent-Length: %d\r\nConnection: close\r\n" % (
            code, len(body))
        head += (extra + "\r\n" if extra else "") + "\r\n"
        try:
            connection.sendall(head.encode() + body)
        except OSError:
            pass

server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(("127.0.0.1", 0))
server.listen(16)
with open(sys.argv[1], "w", encoding="ascii") as port:
    port.write(str(server.getsockname()[1]))
while True:
    connection, _ = server.accept()
    threading.Thread(target=serve, args=(connection,), daemon=True).start()
PY
        rows_place="$work/wget-rows"
        mkdir -p "$rows_place"
        rm -f "$rows_place/port"
        python3 "$work/wget-rows-server.py" "$rows_place/port" &
        rows_server=$!
        rows_wait=0
        while [ ! -s "$rows_place/port" ] && [ "$rows_wait" -lt 200 ]; do
                sleep 0.01
                rows_wait=$((rows_wait + 1))
        done
        rows_url="http://127.0.0.1:$(cat "$rows_place/port" 2>/dev/null)"
        #       wget_row_run WGET DIR SETUP ARGUMENT...: run in a fresh DIR
        #       after the SETUP shell text, standard output to a file; print
        #       "status|last line|files", that file last as (stdout).
        wget_row_run()
        {
                rows_program=$1
                rows_dir=$2
                rows_setup=$3
                shift 3
                rm -rf "$rows_dir"
                mkdir -p "$rows_dir/in"
                (
                        cd "$rows_dir/in" || exit 125
                        eval "$rows_setup"
                        LC_ALL=C exec timeout 20 "$rows_program" "$@" \
                                > "$rows_dir/stdout" 2> "$rows_dir/stderr"
                )
                rows_status=$?
                rows_line=$(sed '/^[[:space:]]*$/d' "$rows_dir/stderr" |
                        tail -n 1 | sed "s|$rows_url|URL|g")
                rows_files=$(cd "$rows_dir/in" && for rows_file in *; do
                        [ -f "$rows_file" ] || continue
                        printf '%s:%s:%s ' "$rows_file" \
                                "$(stat -c %a "$rows_file")" \
                                "$(tr -d '\n' < "$rows_file")"
                done
                [ -s "$rows_dir/stdout" ] &&
                        printf '(stdout):%s ' "$(tr -d '\n' < "$rows_dir/stdout")")
                printf '%s|%s|%s\n' "$rows_status" "$rows_line" "${rows_files% }"
        }
        #       NAME|STATUS|LINE ("*" for any)|FILES|SETUP|ARGUMENT|...,
        #       URL standing for the server. location-ftp is ours alone:
        #       GNU wget follows it into FTP, which this client lacks.
        wget_rows="404|8|*|||-q|URL/404
500|8|*|||-q|URL/500
401|6|Username/Password Authentication Failed.|||URL/401
407|8|*|||-q|URL/407
304|8|*|||-q|URL/304
unsupported-scheme|1|gopher://127.0.0.1/x: Unsupported scheme.|||gopher://127.0.0.1/x
location-ftp=|1|ftp://127.0.0.1/x: Unsupported scheme.|||URL/to/ftp:~~127.0.0.1~x
location-mailto|1|mailto:x: Unsupported scheme.|||URL/to/mailto:x
location-no-slashes|1|http:path: Unsupported scheme.|||URL/to/http:path
dots-relative|0|*|dots:644:/a/file|umask 022|-q|URL/dots
dots-absolute|0|*|dots-absolute:644:/z|umask 022|-q|URL/dots-absolute
dots-start|0|*|d:644:/a/d|umask 022|-q|URL/a/./b/../c%2e/%2e%2e/d
dots-root|0|*|index.html:644:/|umask 022|-q|URL/a/..
twenty-redirects|8|20 redirections exceeded.|||URL/loop
unresolved-after-redirect|4|wget: unable to resolve host address 'no-such-host.invalid'|||URL/to/http:~~no-such-host.invalid~x
refused|4|*|||-q|http://127.0.0.1:1/x
malformed|4|*|||-q|URL/malformed
empty|4|*|||-q|URL/empty
numbered|0|*|f:644:keep f.1:644:keep f.2:644:/f|umask 022; printf keep > f; printf keep > f.1|-q|URL/f
directory|3|Cannot write to 'd' (Is a directory).||mkdir d|URL/d
umask-002|0|*|g:664:/g|umask 002|-q|URL/g
umask-077|0|*|g:600:/g|umask 077|-q|URL/g
replace-keeps-mode|0|*|h:640:/h|printf old > h; chmod 640 h|-q|-O|h|URL/h
missing-directory|1|/nonexistent-wget-row/x: No such file or directory|||-q|-O|/nonexistent-wget-row/x|URL/x
bad-option|2|*|||--wget-row-no-such-option|URL/x
stdout-file|0|*|(stdout):/s||-q|-O|/dev/stdout|URL/s
link-to-device|0|*||ln -s /dev/null l|-q|-O|l|URL/x
link-to-file=|0|*|l:644:/x v:644:keep|umask 022; printf keep > v; ln -s v l|-q|-O|l|URL/x"
        rows_failed=0
        rows_gnu_failed=0
        rows_count=0
        rows_gnu=$(PATH=/usr/local/bin:/usr/bin:/bin command -v wget)
        if [ -n "$rows_gnu" ] &&
                ! "$rows_gnu" --version 2>/dev/null | head -n 1 | grep -q '^GNU Wget'; then
                rows_gnu=
        fi
        printf '%s\n' "$wget_rows" > "$rows_place/rows"
        while IFS='|' read -r rows_name rows_status rows_line rows_files \
                rows_setup rows_args; do
                [ -n "$rows_name" ] || continue
                rows_count=$((rows_count + 1))
                #       The arguments, split at | with URL put in.
                set --
                rows_rest=$rows_args
                while [ -n "$rows_rest" ]; do
                        rows_word=${rows_rest%%|*}
                        case $rows_rest in
                        *'|'*) rows_rest=${rows_rest#*|} ;;
                        *) rows_rest= ;;
                        esac
                        case $rows_word in URL*) rows_word=$rows_url${rows_word#URL} ;; esac
                        set -- "$@" "$rows_word"
                done
                rows_want="$rows_status|$rows_line|$rows_files"
                rows_ours=$(wget_row_run "$farm/wget" "$rows_place/ours" \
                        "$rows_setup" "$@")
                [ "$rows_line" = '*' ] &&
                        rows_ours="${rows_ours%%|*}|*|${rows_ours#*|*|}"
                if [ "$rows_ours" != "$rows_want" ]; then
                        rows_failed=$((rows_failed + 1))
                        note "wget row $rows_name: ours [$rows_ours], want [$rows_want]"
                fi
                case $rows_name in *=) continue ;; esac
                [ -n "$rows_gnu" ] || continue
                rows_theirs=$(wget_row_run "$rows_gnu" "$rows_place/gnu" \
                        "$rows_setup" --no-config --no-proxy --no-hsts -t 1 "$@")
                [ "$rows_line" = '*' ] &&
                        rows_theirs="${rows_theirs%%|*}|*|${rows_theirs#*|*|}"
                if [ "$rows_theirs" != "$rows_want" ]; then
                        rows_gnu_failed=$((rows_gnu_failed + 1))
                        note "wget row $rows_name: GNU wget [$rows_theirs], want [$rows_want]"
                fi
        done < "$rows_place/rows"
        kill "$rows_server" 2>/dev/null || :
        wait "$rows_server" 2>/dev/null || :
        tally wget-rows $((rows_count - rows_failed)) "$rows_count"
        [ "$rows_failed" = 0 ] || builtins_failed=1
        if [ -n "$rows_gnu" ]; then
                tally wget-rows-match-gnu $((rows_count - rows_gnu_failed)) "$rows_count"
                [ "$rows_gnu_failed" = 0 ] || builtins_failed=1
        else
                note "wget rows against GNU wget: NOT RUN -- no GNU wget"
        fi

        differential_domain builtins || builtins_failed=1
        return "$builtins_failed"
}
lane_awk()
{
        need_shell || return 1
        need_hardened_shell || return 1
        awk_failed=0
        awk_policy_dir="$work/awk-parent-policy"
        mkdir -p "$awk_policy_dir"

        #       A foreign bash reading its script from a pipe starts awk, and
        #       awk reads the pipe too: by default it takes the next line of
        #       that script exactly as gawk does, so bash never runs it. Under
        #       a policy refusing awk's spawn it is refused instead, because a
        #       confined child of a parser it cannot protect could feed that
        #       parser, and the next line runs.
        for awk_mode in default hardened; do
                awk_bin=$farm
                [ "$awk_mode" = hardened ] && awk_bin=$work/hardened-bin
                awk_main="$awk_policy_dir/$awk_mode-main"
                awk_stolen="$awk_policy_dir/$awk_mode-stolen"
                awk_direct_status="$awk_policy_dir/$awk_mode-status"
                awk_direct_error="$awk_policy_dir/$awk_mode-error"
                printf '%s\n' \
                        "\"$awk_bin/awk\" 'BEGIN { if ((getline line < \"/dev/stdin\") > 0) print line > \"$awk_stolen\" }' 2>\"$awk_direct_error\"; printf '%s' \"\$?\" > \"$awk_direct_status\"" \
                        "printf ready > \"$awk_main\"" | /bin/bash \
                        > /dev/null 2>&1 || :
                if [ "$awk_mode" = default ]; then
                        [ "$(cat "$awk_direct_status" 2>/dev/null)" = 0 ] &&
                                [ ! -e "$awk_main" ] &&
                                grep -q 'printf ready' "$awk_stolen" 2>/dev/null
                else
                        [ "$(cat "$awk_direct_status" 2>/dev/null)" = 126 ] &&
                                [ "$(cat "$awk_main" 2>/dev/null)" = ready ] &&
                                [ ! -e "$awk_stolen" ] &&
                                grep -q 'parent protection unavailable; refusing launch' \
                                        "$awk_direct_error"
                fi
                [ "$?" = 0 ]
                verdict "awk-direct-parser-$awk_mode" awk_failed 'direct $awk_mode awk under a foreign bash reading a pipe: status $(cat "$awk_direct_status" 2>/dev/null)'

                [ "$(printf 'alpha beta\n' |
                        "$awk_bin/bash" -c 'awk '\''{ print }'\'' 2>/dev/null')" = \
                        'alpha beta' ]
                verdict "awk-integrated-$awk_mode" awk_failed '$awk_mode awk failed under our shell with a memory parser'

                #       system() and "cmd" | getline: by default they run, as
                #       gawk's do; under the policy the filter refuses them and
                #       awk carries on.
                awk_system_marker="$awk_policy_dir/$awk_mode-system-ran"
                awk_pipe_marker="$awk_policy_dir/$awk_mode-pipe-ran"
                awk_system_output=$(AWK_POLICY_MARKER="$awk_system_marker" \
                        "$awk_bin/bash" -c \
                        'awk '\''BEGIN { print "ran"; system("printf ready > " ENVIRON["AWK_POLICY_MARKER"]) }'\'' 2>/dev/null')
                awk_pipe_output=$(AWK_POLICY_MARKER="$awk_pipe_marker" \
                        "$awk_bin/bash" -c \
                        'awk '\''BEGIN { cmd = "printf ready > " ENVIRON["AWK_POLICY_MARKER"]; cmd | getline; close(cmd); print "ran" }'\'' 2>/dev/null')
                if [ "$awk_system_output:$awk_pipe_output" = 'ran:ran' ] &&
                        if [ "$awk_mode" = default ]; then
                                [ -e "$awk_system_marker" ] && [ -e "$awk_pipe_marker" ]
                        else
                                [ ! -e "$awk_system_marker" ] && [ ! -e "$awk_pipe_marker" ]
                        fi
                then
                        tally "awk-spawn-$awk_mode" 1 1
                else
                        tally "awk-spawn-$awk_mode" 0 1
                        note "$awk_mode awk's system and pipe answered $awk_system_output:$awk_pipe_output"
                        awk_failed=1
                fi
        done

        differential_domain awk "$farm" || awk_failed=1
        return "$awk_failed"
}

#
#       The terminal: the sequences it is sent, the cells they become, and
#       the line being typed before it is a line.
#
#           sh test/run term          (it does not use the farm)
#
#       src/canvas/term.c makes no system call, which is what makes it testable
#       without a kernel, a compositor or a pty. The harness below is the
#       emulator with a page of memory standing in for the window Canvas
#       would have mapped: bytes go in, the grid of cells comes out, and a
#       case is a byte stream and the rows it should have written.
#
#       There is no reference terminal here to agree with. The other lanes
#       compare against dash or coreutils; nothing on a machine that boots
#       this renders a grid to compare a grid against, so every case below
#       instead names the sequence and asserts what the standard that defines
#       it says happens -- ECMA-48 for the CSI sequences, the VT100 and VT510
#       manuals for the DEC private ones, and Unicode 3.9 for what a
#       malformed UTF-8 sequence becomes. Where ours knowingly does something
#       else, that is a differs case and says so.
#
#       The harness is driven by verbs:
#
#           in TEXT       bytes for the emulator, with \e \n \r \t \b \xHH
#           keys TEXT     keystrokes: <left> <up> <del> and their like,
#                         ^A for a control character, anything else itself
#           edit on|off   whether the line editor is running
#           row N         one row, as [what has been written to it]
#           dump          every row of the screen
#           back N        the N lines above the screen, out of the ring
#           cursor        where the cursor is, as row,column
#           attr R,C      the colours of one cell, as ink,paper
#           flags R,C     the style and shape bits of one cell
#           sent          what would have gone up the pty, and forgets it
#           wrote RESULT  apply a write result (count, again, intr, fatal)
#           mode          the modes that are set
#           resize CxR    the window is now this, through the resize path
#           pty           what the seam in screen.c makes of a real one
#
lane_term()
(
compiler=${CC:-gcc}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

test_group_width=12
test_case_width=24
pass=0
fail=0
current=""
section_name=""
section_pass=0
section_total=0

: "${test_group_width:=14}"
: "${test_case_width:=26}"

#       The emulator, with a page of memory where the window would be.
cat > "$work/harness.c" <<'HARNESS'
#include "src/lib.util.c"
#include "src/moonwater/spark.c"
#include "src/canvas/window.c"
#include "src/canvas/term.c"
#include "src/sh/pty.c"
// The terminal fixture does not execute the desktop launcher.
#define BOWL_DEFAULT_PATH "/fixture/bin"
#include "src/canvas/terminfo.c"
static fn host_terminal_opening() {}
static bipolar shell_exec_file(string_address path,
                               string_address address_to arguments,
                               positive count,
                               string_address address_to environment)
{
        (void)path;
        (void)arguments;
        (void)count;
        (void)environment;
        return -1;
}
// The shell's signal names live in file.c, which the fixture leaves out; only
// screen_term, which never runs here, asks it. The killed verb names its own.
static fn kill_name(positive number, p8 address_to into)
{
        positive_into_string(into, number);
}
// The launcher's session setup lives in bowl/runtime.c, which the fixture
// leaves out for the same reason it stubs shell_exec_file: screen_term's
// child never runs here, and pulling bowl in would drag the whole runtime
// into a terminal fixture.
static fn bowl_session_prepare(string_address home, string_address runtime)
{
        (void)home;
        (void)runtime;
}
static string_address address_to bowl_environment(
    string_address address_to inherited)
{
        return inherited;
}
#include "src/canvas/screen.c"

#define TERMINAL_FIXTURE_OUTPUT 16384
#define TERMINAL_FIXTURE_BELL
#define SHARED_terminal_fixture
#include "test/checks.c"
#undef SHARED_terminal_fixture
#define SHARED_unicode_width_reference
#include "test/checks.c"
#undef SHARED_unicode_width_reference

// Whether in hands its bytes over one at a time or as one read.
static b32 feed_reads;

// Where the next in is cut into two reads, when it is.
static bipolar feed_cut = -1;

static const struct
{
        const char *name;
        unsigned int code;
} named_keys[] = {
    {"left", KEY_LEFT}, {"right", KEY_RIGHT}, {"up", KEY_UP}, {"down", KEY_DOWN},
    {"home", KEY_HOME}, {"end", KEY_END}, {"del", KEY_DELETE},
    {"pgup", 104}, {"f1", 59}, {"enter", 28}, {"kpenter", 96},
};

static fn feed_keys(string_address text)
{
        positive at = 0;

        while (text[at])
        {
                if (text[at] == '<')
                {
                        positive stop = at + 1;
                        positive begin = at + 1;
                        unsigned int modifiers = WINDOW_KEY_DOWN;

                        while (text[stop] && text[stop] != '>')
                                stop++;

                        while (begin + 1 < stop && text[begin + 1] == '-')
                        {
                                if (text[begin] == 's')
                                        modifiers |= WINDOW_KEY_SHIFT;
                                else if (text[begin] == 'a')
                                        modifiers |= WINDOW_KEY_ALT;
                                else if (text[begin] == 'c')
                                        modifiers |= WINDOW_KEY_CONTROL;

                                begin += 2;
                        }

                        if (begin + 1 == stop)
                        {
                                term_key_modified(text[begin], 0, modifiers);
                                at = text[stop] ? stop + 1 : stop;
                                continue;
                        }

                        for (positive i = 0; i < sizeof(named_keys) / sizeof(named_keys[0]); i++)
                        {
                                const char *name = named_keys[i].name;
                                positive c = begin;

                                while (*name && text[c] == (p8)*name)
                                {
                                        name++;
                                        c++;
                                }

                                if (!*name && c == stop)
                                {
                                        term_key_modified(0, named_keys[i].code,
                                                          modifiers);
                                        break;
                                }
                        }

                        at = text[stop] ? stop + 1 : stop;
                        continue;
                }

                if (text[at] == '^' && text[at + 1])
                {
                        unsigned int c = text[at + 1];

                        term_key((c >= 'a' && c <= 'z' ? c - 'a' : c - 'A') + 1, 0);
                        at += 2;
                        continue;
                }

                bipolar c = next_byte(text, &at);

                if (c < 0)
                        break;

                term_key((unsigned int)c, 0);
        }
}

b32 main()
{
        b32 count = program_argument_count();
        unsigned int columns, rows;

        if (count < 3)
        {
                log_direct(str("usage: harness columns rows verb [argument] ...\n"));
                return 2;
        }

        columns = number(program_argument(1));
        rows = number(program_argument(2));

        terminal_fixture_start(columns, rows);

        for (b32 i = 3; i < count; i++)
        {
                string_address verb = program_argument(i);
                string_address argument = i + 1 < count ? program_argument(i + 1) : (string_address) "";

                if (string_compare(verb, (string_address) "in") == 0)
                {
                        static p8 feed[4096];
                        positive at = 0;
                        positive n = 0;
                        bipolar c;

                        // A byte at a time, or the whole of it in one call as
                        // a read from the pty is handed over.
                        for (;;)
                        {
                                c = next_byte(argument, &at);

                                if (c >= 0 && n < sizeof(feed))
                                {
                                        feed[n++] = (p8)c;
                                        continue;
                                }

                                if (feed_reads && feed_cut >= 0 &&
                                    (positive)feed_cut <= n)
                                {
                                        term_bytes(feed, (positive)feed_cut);
                                        term_bytes(feed + feed_cut,
                                                   n - (positive)feed_cut);
                                        feed_cut = -1;
                                }
                                else if (feed_reads)
                                        term_bytes(feed, n);
                                else
                                        for (positive k = 0; k < n; k++)
                                                consume(feed[k]);

                                n = 0;

                                if (c < 0)
                                        break;

                                feed[n++] = (p8)c;
                        }

                        i++;
                }
                else if (string_compare(verb, (string_address) "reads") == 0)
                        feed_reads = true;
                else if (string_compare(verb, (string_address) "cut") == 0)
                {
                        feed_cut = (bipolar)number(argument);
                        i++;
                }
                else if (string_compare(verb, (string_address) "length") == 0)
                {
                        positive at = 0;
                        unsigned int n = 0;

                        while (next_byte(argument, &at) >= 0)
                                n++;

                        say_number(n);
                        say_byte('\n');
                        i++;
                }
                else if (string_compare(verb, (string_address) "click") == 0 ||
                         string_compare(verb, (string_address) "release") == 0)
                {
                        unsigned int col = number(argument);
                        unsigned int row_at = 1;
                        unsigned int button = 0;
                        unsigned int flags =
                            verb[0] == 'c' ? WINDOW_KEY_DOWN : 0;
                        positive at = 0;

                        while (argument[at] && argument[at] != ',')
                                at++;
                        if (argument[at] == ',')
                        {
                                row_at = number(argument + at + 1);
                                at++;
                                while (argument[at] && argument[at] != ',')
                                        at++;
                                if (argument[at] == ',')
                                        button = number(argument + at + 1);
                        }

                        term_pointer(col, row_at, button, flags);
                        i++;
                }
                else if (string_compare(verb, (string_address) "keys") == 0)
                {
                        feed_keys(argument);
                        i++;
                }
                else if (string_compare(verb, (string_address) "edit") == 0)
                {
                        term_line_editing(argument[0] == 'o' && argument[1] == 'n');
                        i++;
                }
                else if (string_compare(verb, (string_address) "row") == 0)
                {
                        say_row(number(argument));
                        i++;
                }
                else if (string_compare(verb, (string_address) "dump") == 0)
                {
                        for (unsigned int r = 0; r < ROWS; r++)
                                say_row(r);
                }
                else if (string_compare(verb, (string_address) "back") == 0)
                {
                        unsigned int how_many = number(argument);

                        for (unsigned int n = how_many; n; n--)
                        {
                                struct window_cell *cells =
                                    window_line(window, window->head - ROWS - n);
                                unsigned int length =
                                    *window_length(window, window->head - ROWS - n);

                                say_byte('[');

                                for (unsigned int c = 0; c < length; c++)
                                        say_byte(cells[c].character >= ' ' &&
                                                         cells[c].character < 127
                                                     ? cells[c].character
                                                     : '?');

                                tell("]\n");
                        }

                        i++;
                }
                else if (string_compare(verb, (string_address) "cursor") == 0)
                {
                        say_number(row);
                        say_byte(',');
                        say_number(column);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "show") == 0)
                        cursor_show();
                else if (string_compare(verb, (string_address) "attr") == 0)
                {
                        say_attribute(argument);
                        i++;
                }
                else if (string_compare(verb, (string_address) "flags") == 0)
                {
                        say_flags(argument);
                        i++;
                }
                else if (string_compare(verb, (string_address) "sent") == 0)
                {
                        say_byte('[');

                        for (unsigned int at = 0; at < to_shell_length; at++)
                        {
                                unsigned int c = to_shell[at];

                                if (c == 27)
                                        tell("\\e");
                                else if (c >= ' ' && c < 127)
                                        say_byte(c);
                                else
                                {
                                        tell("\\x");
                                        say_hex(c, 2);
                                }
                        }

                        tell("]\n");
                        to_shell_length = 0;
                }
                /*
                        ask N TEXT: TEXT handed over N times, as reads from a
                        far end that never reads what is sent back; queued
                        says how many bytes are then waiting, and the last
                        one of them.
                */
                else if (string_compare(verb, (string_address) "ask") == 0 &&
                         i + 2 < count)
                {
                        static p8 feed[4096];
                        positive n = 0;
                        positive at = 0;
                        unsigned int times = number(argument);
                        bipolar c;

                        while ((c = next_byte(program_argument(i + 2), &at)) >= 0 &&
                               n < sizeof(feed))
                                feed[n++] = (p8)c;
                        while (times--)
                                term_bytes(feed, n);
                        i += 2;
                }
                else if (string_compare(verb, (string_address) "queued") == 0)
                {
                        say_number((unsigned int)to_shell_length);
                        say_byte(',');
                        say_number(to_shell_length ? to_shell[to_shell_length - 1] : 0);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "wrote") == 0)
                {
                        bipolar wrote;

                        if (string_compare(argument, (string_address) "again") == 0)
                                wrote = -EAGAIN;
                        else if (string_compare(argument, (string_address) "intr") == 0)
                                wrote = -EINTR;
                        else if (string_compare(argument, (string_address) "fatal") == 0)
                                wrote = -4095;
                        else
                                wrote = (bipolar)number(argument);

                        tell(term_sent(wrote) ? "alive\n" : "dead\n");
                        i++;
                }
                /*
                        What a window says when its shell dies of a signal it
                        did not send: killed NUMBER,NAME or NUMBER,NAME,oom.
                */
                else if (string_compare(verb, (string_address) "killed") == 0)
                {
                        static p8 name[16];
                        positive at = 0;
                        positive length = 0;

                        while (argument[at] && argument[at] != ',')
                                at++;
                        if (argument[at])
                                at++;
                        while (argument[at + length] && argument[at + length] != ',' &&
                               length + 1 < sizeof(name))
                        {
                                name[length] = argument[at + length];
                                length++;
                        }
                        name[length] = 0;

                        term_child_killed(number(argument), name,
                                          argument[at + length] == ',');
                        i++;
                }
                /*
                        The seam the shipped program actually turns the editor
                        on at, run against a real pty.

                        Every other case says edit on and asks what the editor
                        does. This one asks what says so: a slave in the state
                        the kernel gives it should read as canonical, and the
                        echo should come off it, and the struct that is asked
                        those questions has to be the one the kernel fills in
                        rather than the larger one a C library hands out.
                */
                else if (string_compare(verb, (string_address) "pty") == 0)
                {
                        terminal_modes modes;
                        b32 master, slave;

                        if (process_pty_open(address_of master,
                                             address_of slave, true) < 0)
                        {
                                tell("no pty\n");
                                continue;
                        }

                        term_follow_modes(master);
                        system_call_3(syscall(ioctl), master, PTY_TCGETS,
                                      (positive)address_of modes);

                        tell("editing=");
                        say_number(line_editing != 0);
                        tell(" canonical=");
                        say_number((modes.behaviour & TERMINAL_CANONICAL) != 0);
                        tell(" echo=");
                        say_number((modes.behaviour & TERMINAL_ECHO) != 0);
                        say_byte('\n');

                        // And the far end going raw takes the editor with it.
                        modes.behaviour &= ~TERMINAL_CANONICAL;
                        system_call_3(syscall(ioctl), slave, PTY_TCSETS,
                                      (positive)address_of modes);
                        term_follow_modes(master);

                        tell("raw editing=");
                        say_number(line_editing != 0);
                        say_byte('\n');

                        system_call_1(syscall(close), slave);
                        system_call_1(syscall(close), master);
                }
                else if (string_compare(verb,
                                        (string_address) "pty-low") == 0)
                {
                        b32 pair[2];
                        if (system_pipe(pair, O_CLOEXEC) < 0)
                        {
                                tell("lowfds unavailable\n");
                                continue;
                        }

                        bipolar child = system_fork();
                        if (!child)
                        {
                                system_close((positive)pair[0]);
                                system_close(0);
                                system_close(1);
                                system_close(2);

                                b32 master = -1;
                                b32 slave = -1;
                                bipolar opened = process_pty_open(
                                    address_of master, address_of slave, true);
                                /* Keep a master reference across setup just
                                   as the recorder parent does; otherwise the
                                   last master close correctly hangs up this
                                   child before it can report the result. */
                                bipolar held = opened < 0 ? opened
                                    : system_duplicate(master, pair[0],
                                                       O_CLOEXEC);
                                bipolar auxiliary = held < 0 ? held
                                    : system_open_at(AT_FDCWD, "/dev/null",
                                                     FILE_READ | O_CLOEXEC);
                                bipolar prepared = auxiliary < 0 ? auxiliary
                                    : process_pty_child_setup(master, slave,
                                                              auxiliary, -1);
                                p8 result = prepared >= 0 ? 1 : 10;

                                for (b32 descriptor = 0;
                                     result == 1 && descriptor < 3;
                                     descriptor++)
                                        if (system_call_3(syscall(fcntl),
                                                          (positive)descriptor,
                                                          1 /* F_GETFD */, 0) != 0)
                                                result = (p8)(20 + descriptor);

                                system_write_all((positive)pair[1],
                                                 address_of result, 1);
                                system_call_1(syscall(exit),
                                              result == 1 ? 0 : 1);
                        }

                        system_close((positive)pair[1]);
                        p8 result = 0;
                        bipolar got = child > 0
                            ? system_read_retry((positive)pair[0],
                                                address_of result, 1)
                            : child;
                        system_close((positive)pair[0]);
                        if (child > 0)
                                system_call_4(syscall(wait4),
                                              (positive)child, 0, 0, 0);
                        tell(got == 1 && result == 1 ? "lowfds ok\n"
                                                     : "lowfds failed\n");
                }
                else if (string_compare(verb, (string_address) "widths") == 0)
                {
                        unsigned int wrong = 0;

                        // Every character, as unicode_width answers it for
                        // the terminal and as the reference's two range tables
                        // alone say, so no shortcut in front of the table
                        // lookup can disagree with them.
                        for (unsigned int c = 0; c <= 0x10ffff; c++)
                                wrong += unicode_width(c, UNICODE_WIDTH_TERMINAL) !=
                                         unicode_width_reference_tables(c);

                        say_number(wrong);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "mode") == 0)
                {
                        tell("wrap=");
                        say_number(autowrap != 0);
                        tell(" insert=");
                        say_number(insert_mode != 0);
                        tell(" alternate=");
                        say_number(alternate != 0);
                        tell(" cursor=");
                        say_number(cursor_visible != 0);
                        tell(" region=");
                        say_number(region_top);
                        say_byte(',');
                        say_number(region_bottom);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "title") == 0)
                {
                        say_byte('[');
                        tell(window->title);
                        tell("]\n");
                }
                else if (string_compare(verb, (string_address) "sync") == 0)
                {
                        say_number(synchronized_output != 0);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "mouse") == 0)
                {
                        say_number(mouse_mode);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "tab_reset") == 0)
                {
                        positive wrong = 0;
                        memory_fill(tab_stop, 0xa5, sizeof(tab_stop));
                        tabs_reset();
                        for (positive at = 0; at < sizeof(tab_stop); at++)
                                wrong += tab_stop[at] != (at % 8 == 0);
                        say_number(wrong);
                        say_byte('\n');
                }
                else if (string_compare(verb, (string_address) "resize") == 0)
                {
                        positive at = 0;

                        while (argument[at] && argument[at] != 'x')
                                at++;

                        window->columns = number(argument);
                        window->rows = number(argument + at + 1);
                        regrid(-1);
                        i++;
                }
                else
                {
                        tell("no verb called ");
                        tell((const char *)verb);
                        say_byte('\n');
                }
        }

        log_direct(out, out_length);
        return 0;
}
HARNESS

coverage_build "$host_arch" "$work/term" || exit 1
# shellcheck disable=SC2086
if ! $compiler -O2 -static -nostdlib -nostartfiles -fno-stack-protector \
        -fno-builtin -Wall -Wextra -Werror=unused-variable \
        -Werror=unused-but-set-variable -I "$root" -T src/build/spark.ld -Wl,-e,_start \
        -Wl,--build-id=none -Wl,--no-warn-rwx-segments $coverage_args \
        -o "$work/term" "$work/harness.c" 2> "$work/err"
then
        echo "  term         harness build failed"
        sed 's/^/    /' "$work/err"
        exit 1
fi
coverage_keep "$work/term"

#       Rows arrive one to a line and are joined by a bar, so a case that
#       asks for several of them is still one string to compare.
term() { ${TEST_RUNNER:-} "$work/term" "$@" 2>&1 | tr '\n' '|' | sed 's/|$//'; }

same()
{
        name=$1
        want=$2
        shift 2

        got=$(term "$@")

        #       And again with each in handed over whole, as a read from the
        #       pty is: runs of text take a path of their own, and it has to
        #       leave exactly what a byte at a time leaves.
        columns=$1
        rows=$2
        shift 2
        whole=$(term "$columns" "$rows" reads "$@")

        if [ "$want" = "$got" ] && [ "$want" = "$whole" ]; then
                won
                return 0
        fi

        if [ "$want" != "$got" ]; then
                lost "$name" "want [$want] got [$got]"
        else
                lost "$name" "read whole: want [$want] got [$whole]"
        fi
}

#       Ours and the standard disagree, and this is exactly what ours says
#       today. Written down rather than left out, so that closing the gap
#       fails here and says so.
differs() { same "$@"; }

#       Every place a read can end inside the input. A byte at a time, and two
#       reads cut after any of its bytes, have to leave the same cells, the
#       same cursor and the same answers.
cuts()
{
        name=$1
        want=$2
        columns=$3
        rows=$4
        input=$5
        shift 5

        got=$(term "$columns" "$rows" in "$input" "$@")

        if [ "$want" != "$got" ]; then
                lost "$name" "want [$want] got [$got]"
                return 1
        fi

        length=$(term 1 1 length "$input")
        at=0

        while [ "$at" -le "$length" ]; do
                got=$(term "$columns" "$rows" reads cut "$at" in "$input" "$@")

                if [ "$want" != "$got" ]; then
                        lost "$name" "cut after $at bytes: want [$want] got [$got]"
                        return 1
                fi

                at=$((at + 1))
        done

        won
}

#
#       Characters into cells.
#

section printing

group text
same 'plain'          '[hello]'                  20 3 in 'hello' row 0
same 'carriage'       '[world]'                  20 3 in 'hello\rworld' row 0
same 'linefeed'       '[one]|[two]|[]'           20 3 in 'one\r\ntwo' dump
same 'backspace'      '[hi ]'                    20 3 in 'hix\b \b' row 0
same 'bell is silent' '[ab]'                     20 3 in 'a\ab' row 0

#       ECMA-48 8.3.74: a line feed moves down a line and does not return to
#       the start of it. A vertical tab and a form feed do the same, and both
#       used to be dropped on the floor.
same 'no implicit return' '[abc]|[   de]|[]'     20 3 in 'abc\nde' dump
same 'vertical tab'       '[a]|[ b]|[]'          20 3 in 'a\x0bb' dump
same 'form feed'          '[a]|[ b]|[]'          20 3 in 'a\x0cb' dump

group wrap
#       The last cell of a row is filled and the wrap happens on the next
#       character, not on the one that filled it. A terminal that wraps early
#       puts the cursor on the row below with nothing written on it.
same 'fills the row'    '[abcde]|[]|[]'          5 3 in 'abcde' dump
same 'cursor waits'     '0,5'                    5 3 in 'abcde' cursor
same 'then wraps'       '[abcde]|[f]|[]'         5 3 in 'abcdef' dump
same 'off the bottom'   '[def]|[gh]'             3 2 in 'abcdefgh' dump
same 'kept in the ring' '[abc]'                  3 2 in 'abcdefgh' back 1

group tab
same 'all reset stops'       '0'                    20 3 tab_reset
#       Every eighth column to begin with. HTS puts a stop where the cursor
#       is and TBC with a parameter of 3 takes them all away.
same 'to the eighth'     '[a       b]'           20 3 in 'a\tb' row 0
same 'stops at the edge' '0,5'                   6 3 in 'a\t' cursor
same 'set and cleared'   '[Y    XZ b]'           20 3 in 'a\tb\e[3g\e[1G\e[5CX\eH\e[1GY\tZ' row 0

#
#       Where the cursor is put.
#

section cursor

group move
#       ECMA-48 numbers rows and columns from one, and the default for a
#       missing or zero parameter is one.
same 'cup'          '2,4'                        20 5 in '\e[3;5H' cursor
same 'cup defaults' '0,0'                        20 5 in '\e[9;9H\e[H' cursor
same 'cup empty first' '0,4'                     20 5 in '\e[;5H' cursor
same 'up down'      '2,0'                        20 5 in '\e[5;1H\e[3A\e[1B' cursor
same 'right left'   '0,3'                        20 5 in '\e[9C\e[6D' cursor
same 'clamped'      '4,19'                       20 5 in '\e[99;99H' cursor
#       Parameters are unsigned implementation storage, but the terminal
#       language is decimal without that ceiling.  More digits must keep
#       meaning "past the edge", rather than wrapping around to a small
#       position that overwrites existing text.
same 'huge column clamps' '[abc    Z]'             8 2 in 'abc\e[4294967297GZ' row 0
same 'huge move clamps'   '[a      Z]'             8 2 in 'a\e[4294967297CZ' row 0
#       CHA and VPA, which move on one axis and leave the other alone.
same 'cha'          '2,6'                        20 5 in '\e[3;3H\e[7G' cursor
same 'vpa'          '3,2'                        20 5 in '\e[3;3H\e[4d' cursor
same 'cnl cpl'      '2,0'                        20 5 in '\e[1;5H\e[3E\e[1F' cursor
#       Up and down stop at the margin of a region the cursor is in or past,
#       and a pending wrap is gone once the cursor has moved.
same 'up stops at the margin' '1,0'              10 5 in '\e[2;4r\e[3;1H\e[5A' cursor
same 'up from below the region' '1,0'            10 6 in '\e[2;4r\e[6;1H\e[9A' cursor
same 'down stops at the margin' '3,0'            10 5 in '\e[2;4r\e[2;1H\e[9B' cursor
same 'down from below the region' '5,0'          10 6 in '\e[2;4r\e[5;1H\e[9B' cursor
same 'up takes the pending wrap away' '[         Y]|[xxxxxxxxxx]' 10 3 in '\e[2;1Hxxxxxxxxxx\e[AY' row 0 row 1

group save
#       DECSC and DECRC keep the colours with the position, which is what
#       makes them usable around a status line.
same 'dec save'     '[abcX]|[def]|[]'            20 3 in 'abc\e7\r\ndef\e8X' dump
same 'dec colours'  '1,0'                        20 3 in '\e[31m\e7\e[32m\e8x' attr 0,0
same 'ansi save'    '[abcX]|[def]|[]'            20 3 in 'abc\e[s\r\ndef\e[uX' dump
#       DECSC keeps the character sets and origin mode along with the cursor.
same 'save keeps the character set' '[<2500>]'   8 2 in '\e(0\e7\e(B\e8q' row 0
same 'save keeps origin mode' '1,1'              20 5 in '\e[2;4r\e[?6h\e7\e[?6l\e8\e[Hx' cursor

group report
#       DSR with a parameter of 6 is answered with CPR, one based, which is
#       the counting CUP takes back.
same 'cursor position' '[\e[3;4R]'               20 5 in '\e[3;4H\e[6n' sent
same 'cursor position three digits' '[\e[3;160R]' 200 5 in '\e[3;160H\e[6n' sent
same 'device status'   '[\e[0n]'                 20 5 in '\e[5n' sent
same 'device attributes' '[\e[?1;2c]'            20 5 in '\e[c' sent
same 'secondary attributes' '[\e[>0;115;0c]'     20 5 in '\e[>c' sent
same 'tertiary attributes' '[\eP!|00000000\e\]'  20 5 in '\e[=c' sent
same 'cursor position asked privately' '[\e[?3;4R]' 20 5 in '\e[3;4H\e[?6n' sent
#       XTWINOPS reports the text area in cells and pixels, a cell and the
#       screen; the operations that move or stack things are not answered.
same 'text area in cells' '[\e[8;5;20t]'         20 5 in '\e[18t' sent
same 'text area in pixels' '[\e[4;80;160t]'      20 5 in '\e[14t' sent
same 'a cell'        '[\e[6;16;8t]'              20 5 in '\e[16t' sent
same 'the screen'    '[\e[9;5;20t]'              20 5 in '\e[19t' sent
same 'title stack'   '[]'                        20 5 in '\e[22;0;0t\e[23;0;0t' sent
#       DECRQM answers from the same list SM and RM change.
same 'mode set'      '[\e[?7;1$y]'               20 5 in '\e[?7$p' sent
same 'mode reset'    '[\e[?1049;2$y]'            20 5 in '\e[?1049$p' sent
same 'mode once set' '[\e[?2026;1$y]'            20 5 in '\e[?2026h\e[?2026$p' sent
same 'ansi mode'     '[\e[4;2$y]'                20 5 in '\e[4$p' sent
same 'unknown mode'  '[\e[?9999;0$y]'            20 5 in '\e[?9999$p' sent
#       OSC colour queries, answered in the terminator they came with.
same 'paper asked'   '[\e]11;rgb:0000/0000/0000\x07]' 20 5 in '\e]11;?\x07' sent
same 'ink asked with st' '[\e]10;rgb:e5e5/e5e5/e5e5\e\]' 20 5 in '\e]10;?\e\\' sent
same 'ink then paper' '[\e]10;rgb:e5e5/e5e5/e5e5\x07\e]11;rgb:0000/0000/0000\x07]' 20 5 in '\e]10;?;?\x07' sent
same 'palette asked' '[\e]4;196;rgb:ffff/0000/0000\x07\e]4;244;rgb:8080/8080/8080\x07]' 20 5 in '\e]4;196;?;244;?\x07' sent
same 'setting a colour' '[]'                     20 5 in '\e]11;#ffffff\x07\e]4;300;?\x07' sent
#       Every question the emulator answers, asked 200,000 times by a far end
#       that reads none of the answers (a file of them on the screen while
#       the program in front reads no input): what waits stays under the
#       ceiling plus one answer, a key typed then still goes up whole, and a
#       question asked once the far end has read is answered again.
for question in '\e[6n' '\e[?6n' '\e[5n' '\e[c' '\e[>c' '\e[=c' '\e[?7$p' \
                '\e[4$p' '\e[18t' '\e[14t' '\e[16t' '\e[19t' '\e]11;?\x07' \
                '\e]10;?;?\e\\' '\e]4;1;?;2;?\x07' '\e[6n\e[c\e[18t'; do
        once=$(term 20 5 in "$question" sent)
        got=$(term 20 5 ask 200000 "$question" keys x queued wrote 99999999 \
                   in "$question" sent)
        held=${got%%,*}
        rest=${got#*,}
        if [ "$held" -le 4160 ] && [ "$rest" = "120|alive|$once" ] && [ "$once" != "[]" ]; then
                won
        else
                lost "answers held for $question" "want at most 4160 then 120|alive|$once, got $got"
        fi
done

#
#       Erasing.
#

section erasing

group ed
same 'to the end'   '[ab]|[]|[]'                 20 3 in 'abc\r\ndef\e[1;3H\e[J' dump
#       ED and EL take the cursor's own cell with them: erasing to the start
#       of the page reaches the active position inclusive.
same 'to the start' '[]|[   gh]|[]'              20 3 in 'abc\r\ndefgh\e[2;3H\e[1J' dump
same 'all of it'    '[]|[]|[]'                   20 3 in 'abc\r\ndef\e[2J' dump
#       ED 3 forgets the lines scrolled off the top and leaves the screen, and
#       a number nobody has defined erases nothing.
same 'history only'  '[abc]|[def]|[]'            20 3 in 'abc\r\ndef\e[3J' dump
same 'past three'    '[abc]'                     20 3 in 'abc\e[4J' row 0

group el
same 'line to end'   '[ab]'                      20 3 in 'abcdef\e[1;3H\e[K' row 0
same 'line to start' '[    ef]'                  20 3 in 'abcdef\e[1;4H\e[1K' row 0
same 'whole line'    '[]'                        20 3 in 'abcdef\e[2K' row 0
same 'past two'      '[abc]'                     20 3 in 'abc\e[1G\e[3K' row 0

group ech
#       ECH blanks in place and does not move the cursor or shorten the line.
same 'erases in place' '[   def]'                20 3 in 'abcdef\e[1G\e[3X' row 0
same 'cursor stays'    '0,0'                     20 3 in 'abcdef\e[1G\e[3X' cursor
same 'in colour past the end' '[ab     ]|7,4'    20 3 in 'ab\e[44m\e[5X' row 0 attr 0,6

group background
#       Erasing takes the background in force. Without it a program that
#       paints a coloured panel by clearing to the end of a line gets a black
#       hole instead. Moving over cells that were never written is not an
#       erase: xterm and tmux leave them in the default colours, and painting
#       them put stray colour behind every gap a program stepped across.
same 'erase in colour' '7,1'                     8 2 in '\e[41m\e[2Jx' attr 0,1
same 'stepped over'    '7,0'                     8 2 in '\e[42m\e[5Cx' attr 0,0
#       An erase takes the background and nothing else: under reverse video it
#       took the ink as well and painted the line white.
same 'reverse erase'   '[]|[]'                   8 2 in '\e[7mab\e[2J' dump
same 'reverse erase in colour' '7,4'             8 2 in '\e[44;7m\e[2J' attr 1,0

#
#       Lines and characters put in and taken out.
#

section shifting

group characters
#       ICH pushes what is to the right of the cursor further right and
#       DCH pulls it back. What is pushed past the last column is gone.
same 'insert'        '[  abcdef]'                20 3 in 'abcdef\e[1G\e[2@' row 0
same 'delete'        '[def]'                     20 3 in 'abcdef\e[1G\e[3P' row 0
same 'insert at edge' '[  ab]'                   4 3 in 'abcd\e[1G\e[2@' row 0
same 'delete past end' '[abc]'                   20 3 in 'abc\e[1;9H\e[5P' row 0
same 'insert mode'   '[XYabc]'                   20 3 in 'abc\e[1G\e[4hXY' row 0
same 'insert mode off' '[XYc]'                   20 3 in 'abc\e[1G\e[4h\e[4lXY' row 0
#       In colour what DCH pulls in at the right margin is that colour.
same 'delete in colour' '[def     ]|7,0|7,4'     8 3 in 'abcdef\e[1G\e[44m\e[3P' row 0 attr 0,3 attr 0,5

group lines
#       IL and DL move the rest of the region and never the rows above the
#       cursor.
same 'insert line'   '[]|[a]|[b]|[c]'            20 4 in 'a\r\nb\r\nc\e[1;1H\e[L' dump
same 'delete line'   '[b]|[c]|[]|[]'             20 4 in 'a\r\nb\r\nc\e[1;1H\e[M' dump
same 'insert below'  '[a]|[]|[b]|[c]'            20 4 in 'a\r\nb\r\nc\e[2;1H\e[L' dump
same 'line attributes move' '1,4'                 20 4 in 'a\r\nb\r\n\e[31;44mX\e[0m\e[2;1H\e[M' attr 1,0
same 'scroll up'     '[b]|[c]|[]|[]'             20 4 in 'a\r\nb\r\nc\e[S' dump
same 'scroll down'   '[]|[a]|[b]|[c]'            20 4 in 'a\r\nb\r\nc\e[T' dump
#       Lines scrolled or put in take the background in force.
same 'scrolled in colour' '7,4'                  8 3 in 'a\r\nb\r\nc\e[44m\n' attr 2,0
same 'inserted in colour' '7,4'                  8 3 in 'a\r\nb\e[44m\e[1;1H\e[L' attr 0,0
same 'region scrolled in colour' '7,4'           8 4 in '\e[2;3r\e[3;1H\e[44m\n' attr 2,0

group region
#       DECSTBM names the rows a scroll happens between. The VT100 manual
#       puts the cursor at the home position of the page, origin mode being
#       what would make that the region instead.
same 'set'           'wrap=1 insert=0 alternate=0 cursor=1 region=1,4' \
                                                 20 6 in '\e[2;4r' mode
same 'homes'         '0,0'                       20 6 in '\e[3;3H\e[2;4r' cursor
same 'one row is none' 'wrap=1 insert=0 alternate=0 cursor=1 region=0,6' \
                                                 20 6 in '\e[3;3r' mode
#       A line feed at the bottom of the region scrolls the region and leaves
#       everything outside it alone.
same 'scrolls inside' '[a]|[c]|[d]|[]|[e]'       20 5 in 'a\r\nb\r\nc\r\nd\e[5;1He\e[2;4r\e[4;1H\n' dump
same 'reset by resize' 'wrap=1 insert=0 alternate=0 cursor=1 region=0,5' \
                                                 20 5 in '\e[2;4r' resize '20x5' mode
#       A region whose top margin is the top of the page keeps what scrolls
#       off it, as xterm and tmux keep it: apt reserves the last row for its
#       progress bar, and everything it printed above went nowhere, missing
#       from the wheel and from a window made taller. The rows under the
#       region stay where they are. A deleted line is gone rather than kept,
#       and the alternate screen keeps nothing. Every answer here is tmux
#       3.7c's, rows, the lines above them and the cursor.
same 'a top region keeps what leaves it' '[d]|[e]|[f]|[g]|[S]|[a]|[b]|[c]|3,1' \
                                                 20 5 in '\e[5;1HS\e[1;4r\e[4;1Ha\r\nb\r\nc\r\nd\r\ne\r\nf\r\ng' dump back 3 cursor
same 'and a taller window takes it back' '[a]|[b]|[c]|[d]|[e]|[f]|[g]|[S]|6,1' \
                                                 20 5 in '\e[5;1HS\e[1;4r\e[4;1Ha\r\nb\r\nc\r\nd\r\ne\r\nf\r\ng' resize '20x8' dump cursor
same 'scroll up keeps them too' '[c]|[d]|[]|[]|[S]|[a]|[b]|0,0' \
                                                 20 5 in 'a\r\nb\r\nc\r\nd\r\nS\e[1;4r\e[2S' dump back 2 cursor
same 'a deleted line is not kept' '[c]|[d]|[]|[]|[]|[]|[]|0,0' \
                                                 20 5 in 'a\r\nb\r\nc\r\nd\e[1;4r\e[2M' dump back 2 cursor
same 'nor at the top of the page' '[b]|[c]|[]|[]|[]|0,0' \
                                                 20 4 in 'a\r\nb\r\nc\e[1;1H\e[M' dump back 1 cursor
