#       moonwater sleep, from a terminal, woken by a key.
#
#       The display is bochs, not virtio-gpu: bochs suspends through the same
#       drm_mode_config_helper_suspend the atomic drivers use (amdgpu's
#       dm_suspend saves the same drm_atomic_helper_suspend state), so the
#       pipe really is turned off and restored, where virtio-gpu has no power
#       management at all. Three guests: the plain one, one told by
#       moonwater.pm_dark=1 to wake as a card that lost its pipe does (the
#       screens turned off and a hotplug sent while asleep, and the card
#       treated as a real one, which is what runs the hotplug rebind and the
#       off and on cycle), and one with pm_dark=3, where the wake's own
#       redraws are left undone so only what the hotplug finds can put the
#       picture back. Each runs the verb from the Canvas terminal (its tty
#       frozen with it) and is woken by a key: "awake again" must be said,
#       the screen must have the desktop on it, a letter typed after the
#       wake must reach the terminal, the log must name the steps, a lease
#       must be back, and the kernel must have warned of nothing.
lane_sleep()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}

counting sleep

if ! command -v qemu-system-x86_64 > /dev/null 2>&1 || ! command -v python3 > /dev/null 2>&1; then
        echo "  sleep        no qemu-system-x86_64 or python3, skipped"
        exit 2
fi

if [ ! -f "$image" ]; then
        echo "  sleep        no image at $image, skipped"
        exit 2
fi

if [ ! -w /dev/kvm ]; then
        echo "  sleep        no /dev/kvm: a guest that sleeps needs it, skipped"
        exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-sleep.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

MOONWATER_SLEEP_WORK=$work
export MOONWATER_SLEEP_WORK
qmp_guest_module "$work"

PYTHONPATH=$work python3 - "$image" > "$work/answers" 2>"$work/why" <<'PY'
import os, socket, sys, time
from qmp_guest import *

image = sys.argv[1]
base = os.environ["MOONWATER_SLEEP_WORK"]
out = []

def lit(name):
    """How many colours a screendump holds and what share is not the commonest: a blank screen is one colour."""
    w, h, px = load(name)
    seen = {}
    for i in range(0, len(px) - 2, 21):
        seen[px[i:i + 3]] = seen.get(px[i:i + 3], 0) + 1
    return len(seen), 1 - max(seen.values()) / sum(seen.values())

def drawn(name):
    colours, share = lit(name)
    return colours >= 5 and share > 0.05

for label, extra in (("plain", ""), ("dark", "moonwater.pm_dark=5"), ("undone", "moonwater.pm_dark=3")):
    work = base + "/" + label
    os.makedirs(work, exist_ok=True)
    console = work + "/console"
    guest = Guest(["qemu-system-x86_64", "-m", "2G", "-smp", "2", "-cpu", "host", "-enable-kvm",
        "-kernel", image, "-vga", "std", "-no-reboot", "-display", "none", "-nic", "user,model=e1000",
        "-chardev", "socket,id=console,path=" + console + ",server=on,wait=off", "-serial", "chardev:console",
        "-append", "console=ttyS0 drm_client_lib.active= " + extra],
        work + "/qmp", work + "/mon", work, (console,), 0.1)
    serial = socket.socket(socket.AF_UNIX)
    serial.connect(console)
    serial.settimeout(0.2)
    transcript = bytearray()

    def pump(seconds):
        stop = time.time() + seconds
        while time.time() < stop:
            try:
                chunk = serial.recv(65536)
            except socket.timeout:
                continue
            except OSError:
                return
            if not chunk:
                return
            transcript.extend(chunk)

    def wait_for(marker, seconds):
        stop = time.time() + seconds
        while marker.encode() not in transcript and time.time() < stop:
            pump(0.3)
        return marker.encode() in transcript

    def say(line):
        serial.sendall(line.encode() + b"\n")

    #       The desktop first, read off the screen rather than waited for.
    stop = time.time() + 60
    up = False
    while time.time() < stop and not up:
        time.sleep(2)
        shot("up", 1)
        up = drawn("up")
    #       And the terminal it opens, which is what the keys go to.
    wait_for("canvas] terminal: 0", 60)
    time.sleep(4)
    say("echo READY-$((20+1))")
    out.append((label + ": the serial shell answers", "yes" if wait_for("READY-21", 20) else "no", "yes"))

    #       What the terminal will run: the verb with its words on the serial
    #       line, then a read that only a delivered key can satisfy.
    say("echo 'moonwater sleep > /dev/ttyS0 2>&1' > /tmp/w")
    say("echo 'read k' >> /tmp/w")
    say("echo 'echo KEY=$k > /dev/ttyS0' >> /tmp/w")
    time.sleep(1)
    shot("before", 1)
    out.append((label + ": the desktop is up before the sleep", "yes" if drawn("before") else "no", "yes"))
    mark = len(transcript)
    type_text("sh /tmp/w\n")
    out.append((label + ": the verb is sleeping", "yes" if wait_for("mem_sleep", 20) else "no", "yes"))
    time.sleep(4)
    shot("during", 1)
    out.append((label + ": the screen is off while it sleeps", "yes" if not drawn("during") else "no", "yes"))
    #       A modifier wakes it: a PS/2 controller's own resume flushes the
    #       key that woke the machine, so a letter would be lost to the
    #       hardware and prove nothing about Canvas.
    key("shift")
    out.append((label + ": a key wakes it", "yes" if wait_for("awake again", 40) else "no", "yes"))
    time.sleep(5)
    shot("after", 1)
    out.append((label + ": the desktop is on the screen again", "yes" if drawn("after") else "no", "yes"))
    key("a")
    key("ret")
    out.append((label + ": a key typed after the wake reaches the terminal", "yes" if wait_for("KEY=a", 10) else "no", "yes"))

    say("cat /root/sleep.log; echo LOG-END")
    wait_for("LOG-END\r\n", 10)
    for line in (("woken by:", "kernel log lines:") if label == "undone" else
                 ("woken by:", "kernel log lines:", "wake: ", "primary shows ours")):
        out.append((label + ": the log says " + line.strip(), "yes" if line.encode() in transcript[mark:] else "no", "yes"))
    if label != "plain":
        out.append((label + ": the screens were turned off", "yes" if b"screens off: 0" in transcript[mark:] else "no", "yes"))
    say("ip addr; echo IP-END")
    wait_for("IP-END\r\n", 10)
    out.append((label + ": the lease is back", "yes" if b"inet 10.0.2." in transcript[mark:] else "no", "yes"))
    pump(1)
    after = bytes(transcript[mark:])
    bad = [word for word in ("WARNING:", "BUG:", "Oops", "Call Trace") if word.encode() in after]
    out.append((label + ": the kernel says nothing is wrong", ",".join(bad) or "yes", "yes"))
    if os.environ.get("SLEEP_KEEP"):
        open(work + "/transcript", "wb").write(transcript)

    guest.quit()
    time.sleep(1)
    guest.terminate()
    try:
        guest.wait(10)
    except Exception:
        guest.kill()

for name, got, want in out:
    print("%s|%s|%s" % (name, got, want))
PY

if [ ! -s "$work/answers" ]; then
        same "the sleep guests answered" "yes" "no"
        sed 's/^/    /' "$work/why" | tail -5
else
        while IFS='|' read -r name got want; do
                same "$name" "$want" "$got"
        done < "$work/answers"
fi

counted
)

#
#       Every tool against the host's own, at every size.
#
#           taskset -c 8-15 sh test/run scale
#
#       A series is one tool along one dimension -- bytes, lines, a line's
#       length, patterns, keys, fields, files, entries in a directory,
#       arguments, commands, depth, entropy, processors -- run turn about
#       with the host's tool on the same job, and judged for a loss (ours
#       slower than GNU's), a cliff (the cost of a unit more than doubling
#       where GNU's does not), super-linear growth, a refusal GNU does not
#       have, and a ratio worse than the one test/differential.py's
#       SCALE_BASELINE recorded. It is a lane of timings, so it wants a quiet
#       machine: the taskset names the cores the multi-threaded tools may use
#       (eight of one die of the box this was recorded on), and a lock the
#       other benchmarks share can be held series by series. About ten
#       minutes; MOONWATER_SCALE_FULL=1 runs every decade (an hour or more).
#
#           MOONWATER_SCALE_SERIES=grep,sort    only the series with these words
#           MOONWATER_SCALE_DATA=DIR            keep the inputs between runs
#           MOONWATER_SCALE_FARMS="parent=DIR"  more farms, to time beside ours
#                                               (a parent built apart is how a
#                                               new row is shown red there)
#           MOONWATER_SCALE_LOCK=FILE           hold FILE (flock) around each series, so
#                                               that benchmarks of other people's take turns
#           MOONWATER_SCALE_UPDATE=1            write the ratios into the baseline
#
lane_scale()
(
if [ "$host_arch" != x86_64 ] || [ "$(uname -s)" != Linux ]; then
        echo "  scale        NOT RUN -- it times Linux programs against GNU's, on the box that recorded the baseline"
        exit 2
fi
command -v python3 > /dev/null 2>&1 || { echo "  scale        NOT RUN -- no python3"; exit 2; }
need_shell || exit 1
set -- --farm "ours=$farm"
for scale_farm in ${MOONWATER_SCALE_FARMS:-}; do
        set -- "$@" --farm "$scale_farm"
done
[ -z "${MOONWATER_SCALE_FULL:-}" ] || set -- "$@" --full
[ -z "${MOONWATER_SCALE_SERIES:-}" ] || set -- "$@" --series "$MOONWATER_SCALE_SERIES"
[ -z "${MOONWATER_SCALE_DATA:-}" ] || set -- "$@" --data "$MOONWATER_SCALE_DATA"
[ -z "${MOONWATER_SCALE_LOCK:-}" ] || set -- "$@" --lock "$MOONWATER_SCALE_LOCK"
[ -z "${MOONWATER_SCALE_UPDATE:-}" ] || set -- "$@" --update
python3 test/differential.py --harness scale "$@"
)

#
#       The benchmarks.
#
#           sh test/run bench                every benchmark
#           sh test/run bench floor hex      only the ones named
#           sh test/run bench --list         what the benchmarks are
#           sh test/run bench reserve -- 128 sparse   arguments for the ones named
#
#       This is the other half of the one command: `sh test/run` runs the
#       tests and `sh test/run bench` runs the benchmarks, and neither runs
#       the other. It was kit/bench and the four drivers beside it. A
#       benchmark is not a test -- nothing below asserts anything, nothing
#       below writes to the tally, and no lane above builds any of it.
#
#       The C benchmarks are sections of test/checks.c named BENCH_<name>,
#       built by the same freestanding link the C checks get and for the same
#       reason: the thing being measured is lib.c's own assembly, and a
#       libc in the link would supply the very functions in question. That
#       link is spelled out again below rather than reused from freestanding()
#       above, because it is the contract the published numbers were taken
#       under, down to the absence of -w.
#
#       Foreign targets run under qemu. A qemu tick is the emulator's work and
#       not the machine's, so what comes out is a ratio worth reading and an
#       absolute number that is not. A Linux host target runs directly.
#

benchmarks="floor baseline numbers bases hex escape spelled codec fixed table padded input-bases fields human human-nearest hash-33 span-byte utf8-valid net-parsers cells-ascii fill-u32 fill-u64 paths reverse writer-field writer-text text-hot prefix-known translate delete squeeze offsets record-scans ascii-case ascii-case-fold line-break bounded-fold ascii-convert ascii-search grep-search grep-count last-of words clock scan-literal random allocator lock pool ordered tree reserve storage-read compare-max string-copy stream-get stream-write format-bounds startup montgomery limbs shell tools grep-sets awk find boot-time engines compression compression-floor cksum-crc cksum-digests unicode-width link"

#       One benchmark's section and one line about it. A name with no section
#       is one of the drivers below, which time a whole binary against the
#       host's own programs rather than one routine against a floor.
bench_about()
{
        bench_section=
        case $1 in
        floor)   bench_section=BENCH_floor
                 bench_line="every routine in lib.c, against the speed of the machine" ;;
        baseline) bench_section=BENCH_baseline
                 bench_line="the assembly against the C byte loop it replaced" ;;
        numbers) bench_section=BENCH_numbers
                 bench_line="decimal conversion at the call shapes the library exposes" ;;
        bases)   bench_section=BENCH_bases
                 bench_line="buffer conversion in the non-decimal bases" ;;
        hex)     bench_section=BENCH_hex
                 bench_line="bulk hex output against the former checksum loop" ;;
        escape)  bench_section=BENCH_escape
                 bench_line="shared escaping against the former writer loops" ;;
        spelled) bench_section=BENCH_spelled
                 bench_line="table-driven spelling against cat -v's former byte loop" ;;
        codec)   bench_section=BENCH_codec
                 bench_line="the radix codec bodies, apart from the shell's streaming" ;;
        fixed)   bench_section=BENCH_fixed
                 bench_line="exact decimal records against an independent C carry loop" ;;
        table)   bench_section=BENCH_table
                 bench_line="the production table renderer, after its own byte checks" ;;
        padded)  bench_section=BENCH_padded
                 bench_line="the padded-decimal writer against the C call shape it replaced" ;;
        input-bases) bench_section=BENCH_input_bases
                 bench_line="bounded base-input parsing at the folded call shapes" ;;
        fields)  bench_section=BENCH_fields
                 bench_line="contiguous fixed-width decimal fields against the C bodies they fold" ;;
        human)   bench_section=BENCH_human
                 bench_line="compact binary-size formatting at both public call shapes" ;;
        human-nearest) bench_section=BENCH_human_nearest
                 bench_line="dd's nearest human formatter against the former C body" ;;
        hash-33) bench_section=BENCH_hash_33
                 bench_line="the DJB2 byte hash: dependent scalar loop against four-byte assembly" ;;
        span-byte) bench_section=BENCH_span_byte
                 bench_line="bounded equal-byte prefix and suffix: scalar caller loops against the assembly" ;;
        net-parsers) bench_section=BENCH_net_parsers
                 bench_line="network parser byte loops against the lib.c routines, at their callers" ;;
        utf8-valid) bench_section=BENCH_utf8_valid
                 bench_line="well-formed UTF-8 prefix: grep's former C check against the assembly" ;;
        cells-ascii) bench_section=BENCH_cells_ascii
                 bench_line="terminal cells from a printable run: term.c's C loop against the assembly" ;;
        fill-u32) bench_section=BENCH_fill_u32
                 bench_line="the shared canvas 32-bit span fill against its two floors" ;;
        fill-u64) bench_section=BENCH_fill_u64
                 bench_line="aligned 64-bit pattern fill against scalar and bulk-store floors" ;;
        paths)   bench_section=BENCH_paths
                 bench_line="the former path C bodies against the shared assembly" ;;
        reverse) bench_section=BENCH_reverse
                 bench_line="memory_reverse and the rev fold against the C shapes they replace" ;;
        writer-field) bench_section=BENCH_writer_field
                 bench_line="the counted and string field primitives against their C helper" ;;
        writer-text) bench_section=BENCH_writer_text
                 bench_line="buffered output policy: the former C against the assembly core" ;;
        text-hot) bench_section=BENCH_text_hot
                 bench_line="the hot text-loop folds against the scalar loops they replace" ;;
        prefix-known) bench_section=BENCH_prefix_known
                 bench_line="literal-size equal-span walk against the out-of-line routine" ;;
        translate) bench_section=BENCH_translate
                 bench_line="in-place byte-table translation against the former scalar C" ;;
        delete)  bench_section=BENCH_delete
                 bench_line="in-place byte deletion by table against the former scalar C" ;;
        squeeze) bench_section=BENCH_squeeze
                 bench_line="in-place squeezing of repeats by table against the former scalar C" ;;
        offsets) bench_section=BENCH_offsets
                 bench_line="every delimiter and line end of a read as offsets against a byte loop" ;;
        record-scans) bench_section=BENCH_record_scans
                 bench_line="field edges, n-th separators and the last of two at their callers' shapes against the calls they replace" ;;
        ascii-case) bench_section=BENCH_ascii_case
                 bench_line="ASCII-folded bounded comparison against a scalar reference" ;;
        ascii-case-fold) bench_section=BENCH_ascii_case_fold
                 bench_line="literal-size ASCII-folded compare against the floor routine" ;;
        line-break) bench_section=BENCH_line_break
                 bench_line="canvas line breaking against the former byte walk" ;;
        bounded-fold) bench_section=BENCH_bounded_fold
                 bench_line="literal-bound string operations at the production shapes" ;;
        ascii-convert) bench_section=BENCH_ascii_convert
                 bench_line="ASCII case conversion: inlined former loops against reusable assembly" ;;
        ascii-search) bench_section=BENCH_ascii_search
