    guest.wait(10)

open(work + "/power-transcript", "wb").write(bytes(transcript))
for name, got, want in out:
    print("%s|%s|%s" % (name, got, want))
PY
        coverage_guest_collect power
        if [ ! -s "$work/power-answers" ]; then
                lost 'power button guest' "answered nothing: $(tail -3 "$work/power-why")"
        fi
        while IFS='|' read -r name got want; do
                same "$name" "$want" "$got"
