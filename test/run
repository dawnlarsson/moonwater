printf 'fl-masked-%s\n' "$?" | rev
#
#       A live pipe has a writer in an outside feeder which a same-UID child
#       can reacquire through that feeder's proc descriptor table. Restricted
#       applets therefore refuse while such a parser source remains active,
#       including below nested descriptor saves and substitutions.
#
rm -f /tmp/fl-parser-nested /tmp/fl-parser-nested-ran
printf '%s\n' \
'f() { awk '\''BEGIN { print "ready" > "/tmp/fl-parser-nested-ran"; print "touch /tmp/fl-parser-nested" > "/proc/self/fd/9" }'\'' 2>/dev/null; }' \
'f 9<&0 </dev/null' | /bin/bash
[ ! -e /tmp/fl-parser-nested-ran ] &&
        [ ! -e /tmp/fl-parser-nested ] &&
        printf 'fl-parser-nested-clean\n' | rev
# A command substitution has a private descriptor table. Its committed exec
# cannot replace the parent shell's reader identity, even though there is no
# enclosing redirect save in that forked process.
