#       The cursor on its plane.
#
#       The boot above passes moonwater.cursor_plane=0, because QEMU's
#       screendump holds the primary surface only: a cursor on virtio-gpu's
#       cursor plane is composited by QEMU's display and appears in no
#       screendump, so every pixel check above would count an empty desktop.
#       Those checks are the software cursor's. This boot leaves the plane on
#       and asks the kernel instead, through the pointer applet: that each
#       output's plane is claimed and shown, that every move re-arms it, that
#       none of those updates fails, and that after a titlebar drag -- the
#       path that arms planes ahead of the window's repaint -- the last move
#       is armed exactly where the tablet put the pointer.
PYTHONPATH=$work python3 - "$image" > "$work/plane-answers" 2>"$work/plane-why" <<'PY'
import os, re, sys, time
from qmp_guest import *

image = sys.argv[1]
work = os.environ["MOONWATER_CANVAS_WORK"] + "/plane"
os.makedirs(work, exist_ok=True)

guest = Guest(desktop(image) + [
    "-device", "usb-mouse,id=xhcimouse",
    "-no-reboot", "-display", "none", "-serial", "file:" + work + "/serial",
    "-append", "console=ttyS0 drm_client_lib.active= " + os.environ.get("CANVAS_APPEND", "")],
    work + "/qmp", work + "/mon", work)

# What the tablet reports for a point, and where pointer.c puts the pointer
# for that report: offset * size / span, span 32767 on QEMU's tablet.
def report(v, size):
    return int(v * 32767 / size)

def placed(v, size):
    return report(v, size) * size // 32767

def button(down):
    send([{"type": "btn", "data": {"down": down, "button": "left"}}])
    time.sleep(0.08)

def sample():
    type_text("pointer ")
    chord("shift", "dot")
    type_text(" /dev/tty")
    chord("shift", "s")
    type_text("0\n")
    time.sleep(1.0)

time.sleep(25)
out = []

sample()
spots = [(700, 400), (1500, 700), (900, 300)]
for x, y in spots:
    moveto(x, y)
    time.sleep(0.3)
mice = [line.split("#")[1].split(":")[0] for line in monitor("info mice").splitlines()
        if "HID Mouse" in line]
for index in mice:
    monitor("mouse_set " + index)
    for step in range(20):
        send([{"type": "rel", "data": {"axis": "x", "value": 4}},
              {"type": "rel", "data": {"axis": "y", "value": 3}}])
        time.sleep(0.01)
    time.sleep(0.3)
sample()

# The terminal, found as the lane above finds it, and dragged by its titlebar.
shot("drag")
w, h, px = load("drag")

def at(x, y):
    o = (y * w + x) * 3
    return px[o:o + 3]

bg = at(4, 4)
runs, start = [], None
for x in range(w):
    lit = at(x, h // 2) != bg
    if lit and start is None:
        start = x
    elif not lit and start is not None:
        if x - start > 40:
            runs.append((start, x - 1))
        start = None

end = None
if runs:
    left, right = runs[-1]
    cx = (left + right) // 2
    top = next((y for y in range(h) if at(cx, y) != bg), 0)
    gx, gy = cx, top + 6
    moveto(gx, gy)
    button(True)
    for k in range(1, 7):
        moveto(gx - 20 * k, gy + 10 * k)
    end = (gx - 120, gy + 60)
    button(False)
    time.sleep(0.3)
sample()

serial = open(work + "/serial", "rb").read().decode("utf-8", "replace").lower()
planes = re.findall(r"cursor planes +(\d+) active, (\d+) shown", serial)
io = re.findall(r"cursor plane io +(\d+) updates, (\d+) failures", serial)
sync = re.findall(r"cursor sync +(\d+) requested, (\d+) armed", serial)
where = re.findall(r"cursor requested (-?\d+),(-?\d+) armed (-?\d+),(-?\d+)", serial)

out.append(("the cursor rides a plane",
            "%s active, %s shown" % planes[1] if len(planes) > 1 else "no pointer sample",
            "1 active, 1 shown"))
moves = len(spots) + len(mice)
rearmed = int(io[1][0]) - int(io[0][0]) if len(io) > 1 else -1
out.append(("every move re-arms the plane",
            "yes" if rearmed >= moves else "%d updates for %d moves" % (rearmed, moves),
            "yes"))
out.append(("no plane update fails", io[-1][1] if io else "no pointer sample", "0"))
if end is None or len(sync) < 3 or len(where) < 3:
    drag = "not run: no window or no pointer sample"
else:
    wanted = (placed(end[0], W), placed(end[1], H))
    armed = (int(where[-1][2]), int(where[-1][3]))
    drag = ("yes" if sync[-1][0] == sync[-1][1] and int(sync[-1][0]) > 0 and armed == wanted
            else "sync %s/%s armed %s wanted %s" % (sync[-1][0], sync[-1][1], armed, wanted))
out.append(("a drag leaves the plane armed under the pointer", drag, "yes"))

guest.quit()
time.sleep(1)
guest.terminate()
try:
    guest.wait(10)
except Exception:
    guest.kill()

for name, got, want in out:
    print("%s|%s|%s" % (name, got, want))
