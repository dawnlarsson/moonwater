                cut_data "cuti$k" "$work/cut.img"
                says "cuti$k" "install cut at $k ms: the guest was installing" 'fired-yes'
                says "cuti$k" "install cut at $k ms: no loader, or a whole one" 'image-whole'
                never "cuti$k" "install cut at $k ms: the FAT's chains hold" 'fat-bad'
                if grep -q 'image-new' "$work/cuti$k"; then
                        says "cuti$k" "install cut at $k ms: a disk with its loader has all its data" 'data-whole'
                        landed_image=$((landed_image + 1))
                elif grep -q 'image-absent' "$work/cuti$k" && grep -q 'copying /root' "$work/cuti$k.console"; then
                        landed_copy=$((landed_copy + 1))
                fi
                cp "$work/cutredo.commands" "$work/redo$k.commands"
                install_disk=$work/cut.img
                # shellcheck disable=SC2086
                install_boot "redo$k" $stick
                cut_show "redo$k"
                python3 "$work/fatjudge.py" judge "$work/cut.img" "$install_short" none \
                        "$loader_sha" >> "$work/redo$k" 2>&1
                disk_checks "redo$k"
                install_disk=""
                if grep -q 'image-absent' "$work/cuti$k"; then
                        says "redo$k" "a disk cut before its loader is not attached" 'redone-40'
                fi
                if grep -q 'image-absent' "$work/cuti$k" && ! grep -q 'no-partitions' "$work/cuti$k"; then
                        says "redo$k" "and is asked about, not trusted" 'verdict- ksa'
