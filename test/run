def serial_wait(marker, seconds):
    stop = time.time() + seconds
    while time.time() < stop:
        if marker in open(work + "/leak-serial", "rb").read():
            return True
        time.sleep(0.2)
    return False

def typed_to_serial(word):
    type_text("echo " + word + "-")
    chord("shift", "4")
    chord("shift", "4")
    type_text(" ")
    chord("shift", "dot")
    type_text(" /dev/tty")
    chord("shift", "s")
    type_text("0\n")

def run_holder(arguments, program="/mnt/drmhold"):
    type_text(program + " " + arguments + " ")
    chord("shift", "dot")
    type_text(" /dev/tty")
    chord("shift", "s")
    type_text("0 2")
    chord("shift", "dot")
    chord("shift", "7")
    type_text("1 ")
    chord("shift", "7")
    type_text("\n")

#       Keys typed at a program that holds the display are that program's.
#       Canvas and the program both hear every key, and this one used to go
#       into the focused terminal as well and run there when it could.
if switcher and holder:
    shot("foreign-before")
    before_w, before_h, before_px = load("foreign-before")
    run_holder("8 0 0")
    held = serial_wait(b"DRMHOLD master", 15)
    if held:
        typed_to_serial("weston")
    finished = serial_wait(b"DRMHOLD done", 20)
    time.sleep(2)
    serial_now = open(work + "/leak-serial", "rb").read()
    out.append(("a program takes the display", "yes" if held and finished else "no", "yes"))
    out.append(("keys typed at it never reach a Canvas window",
                str(len(re.findall(rb"weston-(\d+)", serial_now))), "0"))
    typed_to_serial("after")
    time.sleep(3)
    serial_now = open(work + "/leak-serial", "rb").read()
    out.append(("and typing reaches Canvas once it exits",
                str(len(re.findall(rb"after-(\d+)", serial_now))), "1"))
    shot("foreign-after")
    after_w, after_h, after_px = load("foreign-after")
    out.append(("the desktop comes back the size it was",
                "%dx%d" % (after_w, after_h), "%dx%d" % (before_w, before_h)))

    #   The cursor this guest draws into the framebuffer, where the screendump
    #   can see it: nothing moved the pointer, so it is where it started, in
    #   the middle of the desktop, and pure white is no ink but the cursor's.
    def cursor_white(data, width, height):
        x, y = width // 2, height // 2
        return sum(1 for py in range(max(y - 4, 0), min(y + 28, height))
                   for px in range(max(x - 4, 0), min(x + 24, width))
                   if data[(py * width + px) * 3:(py * width + px) * 3 + 3] == b"\xff\xff\xff")
    cursor_before = cursor_white(before_px, before_w, before_h)
    cursor_after = cursor_white(after_px, after_w, after_h)
    out.append(("the cursor is drawn again where it was",
                "yes" if cursor_before and cursor_after == cursor_before
                else "%d before, %d after" % (cursor_before, cursor_after), "yes"))
    type_text("pointer ")
    chord("shift", "dot")
    type_text(" /dev/tty")
    chord("shift", "s")
    type_text("0\n")
    time.sleep(2)
    synced = re.findall(rb"cursor sync +(\d+) requested, (\d+) armed",
                        open(work + "/leak-serial", "rb").read())
    out.append(("the cursor is back at a new generation",
                "yes" if synced and synced[-1][0] == synced[-1][1] and int(synced[-1][0]) > 0
                else repr(synced[-1:]), "yes"))

    #   A program that gives master back without exiting. Nothing closes
    #   the card, so nothing tells Canvas; it has to notice on its own.
    run_holder("3 1 8")
    dropped = serial_wait(b"DRMHOLD dropped", 20)
    quiet = "no drop"
    if dropped:
        #   Nothing is typed or moved in this second and the holder writes
        #   only to the serial port, so no key, pointer or terminal output
        #   wakes Canvas: its desktop replaces the holder's white fill only
        #   if the suspended loop looks at the card again by itself.
        time.sleep(1)
        shot("dropped-quiet", 0.5)
        quiet_w, quiet_h, quiet_px = load("dropped-quiet")
        grid = [(y * quiet_w + x) * 3 for y in range(0, quiet_h, 8) for x in range(0, quiet_w, 8)]
        white = sum(1 for at in grid if quiet_px[at:at + 3] == b"\xff\xff\xff")
        quiet = "yes" if white * 2 < len(grid) else "%d of %d sampled pixels still white" % (white, len(grid))
        typed_to_serial("dropped")
        time.sleep(2)
    serial_now = open(work + "/leak-serial", "rb").read()
    out.append(("a program that gives master back and stays is noticed",
                "yes" if dropped and serial_now.count(b"DRMHOLD done") == 1 else "no", "yes"))
    out.append(("and the desktop is back within a second with nothing typed or moved", quiet, "yes"))
    out.append(("and typing reaches Canvas while it still runs",
                str(len(re.findall(rb"dropped-(\d+)", serial_now))), "1"))
    serial_wait(b"DRMHOLD done\r\nDRMHOLD", 0)
    time.sleep(8)

    #   How often a suspended Canvas wakes with a pointer moving over it. The
    #   look it takes at the card is four a second and a frame timer left
    #   running while the card is taken is one a frame, but the thing that
    #   used to wake it was the pointer itself: every report of a tablet or a
    #   mouse that the program holding the card reads too went through the
    #   acceleration curve and woke a thread that runs ahead of every ordinary
    #   task, which looked at the card and threw it away.
    def pointer_storm(seconds):
        stop = time.time() + seconds
        swing = 0
        while time.time() < stop:
            swing += 1
            send([{"type": "abs", "data": {"axis": "x", "value": 1000 + (swing % 40) * 700}},
                  {"type": "abs", "data": {"axis": "y", "value": 2000 + (swing % 25) * 900}}])
            time.sleep(0.002)

    #   What a program that reads the pointer is given, and how soon: the
    #   median wait of a report between the kernel stamping it and the read
    #   having it, with Canvas moving the cursor on the same reports first,
    #   and then with it keeping out of the way of a program that has the
    #   card. Asked of the same tablet in the same guest in the same second
    #   of a storm, so what differs is who has the display.
    delivered = [0]

    def delivery(label, rows):
        delivered[0] += 1
        for _ in range(60):
            if open(work + "/leak-serial", "rb").read().count(b"evlat-") >= delivered[0]:
                break
            time.sleep(0.2)
        said = re.findall(rb"evlat-(\d+)-(\d+)-(\d+)-(\d+)", open(work + "/leak-serial", "rb").read())
        got = said[delivered[0] - 1] if len(said) >= delivered[0] else None
        rows.append((label, "yes" if got and int(got[0]) > 100 and int(got[1]) < 250
                     else ("%s reports, median %s us, p99 %s us" % (got[0].decode(), got[1].decode(), got[2].decode())
                           if got else "no count"), "yes"))
        return got

    if reader:
        run_holder("4", "/mnt/evlat")
        time.sleep(0.5)
        pointer_storm(2.5)
        delivery("a report reaches a program reading it within 250 us at the median, Canvas moving the cursor", out)

    run_holder("7 0 0", "/shell /mnt/holdwake")
    time.sleep(2.2)
    pointer_storm(3.4)
    serial_wait(b"-per-second", 15)
    rate = re.findall(rb"wakes-(\d+)-per-second", open(work + "/leak-serial", "rb").read())
    out.append(("a suspended Canvas wakes fewer than 20 times a second, a pointer moving over it",
                "yes" if rate and int(rate[-1]) < 20
                else ("%s a second" % rate[-1].decode() if rate else "no count"), "yes"))
    if reader:
        delivery("and a report reaches a program reading it within 250 us at the median, another program holding the card", out)
    for _ in range(60):
        if open(work + "/leak-serial", "rb").read().count(b"DRMHOLD done") >= 3:
            break
        time.sleep(0.2)
    time.sleep(2)
else:
    for name, want in (("a program takes the display", "yes"),
                       ("keys typed at it never reach a Canvas window", "0"),
                       ("and typing reaches Canvas once it exits", "1"),
                       ("the desktop comes back the size it was", "same"),
                       ("the cursor is drawn again where it was", "yes"),
                       ("the cursor is back at a new generation", "yes"),
                       ("a program that gives master back and stays is noticed", "yes"),
                       ("and the desktop is back within a second with nothing typed or moved", "yes"),
                       ("and typing reaches Canvas while it still runs", "1"),
                       ("a suspended Canvas wakes fewer than 20 times a second, a pointer moving over it", "yes"),
                       ("a report reaches a program reading it within 250 us at the median, Canvas moving the cursor", "yes"),
                       ("and a report reaches a program reading it within 250 us at the median, another program holding the card", "yes")):
        out.append((name, "not run: no static cc for the helpers", want))

#       Canvas off from its own terminal, then the kernel's console: a shell
#       answers on it, a program takes the display from it and gives it back,
#       Canvas comes back on with a terminal, and goes off and on twice more
#       from the console with a terminal still answering afterwards.
def vga_share(name):
    width, height, data = load(name)
    grid = [(y * width + x) * 3 for y in range(0, height, 8) for x in range(0, width, 8)]
    levels = (0, 0x55, 0xaa, 0xff)
    vga = sum(1 for at in grid if data[at] in levels and data[at + 1] in levels and data[at + 2] in levels)
    white = sum(1 for at in grid if data[at:at + 3] == b"\xff\xff\xff")
    return vga * 100 // len(grid), white * 100 // len(grid)

def serial_count(pattern):
    return len(re.findall(pattern, open(work + "/leak-serial", "rb").read()))

def type_line_with_semicolons(line):
    for piece_at, piece in enumerate(line.split(";")):
        if piece_at:
            key("semicolon")
        type_text(piece)
    type_text("\n")

