#       What a compositor hears, in a booted guest, from the real packages.
#
#       The KDE desktop of a bowl profile came up drawn and deaf: libinput does
#       not read /dev/input to learn which device is a keyboard, it asks udev,
#       and nothing here ran one, so every node was "not tagged as a supported
#       input device" and a compositor from any bowl had no keys and no
#       pointer. libinput's own tool is the smallest thing that asks as a
#       compositor does, and Alpine is where the desktop profile's packages
#       come from, so this lands an Alpine bowl on a blank disk (the network
#       of QEMU's user stack, a few tens of megabytes), adds eudev and
#       libinput-tools, and looks at what libinput finds before and after
#       `bowl udev`, and at what it reports of a key and a pointer sent in
#       through QMP. The guest's own serial shell is the other terminal: it
#       answers while the display is the compositor's, which is the point of
#       having one.
lane_desktop()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}

counting desktop

for need in qemu-system-x86_64 python3 mke2fs; do
        if ! command -v "$need" > /dev/null 2>&1; then
                echo "  desktop      NOT RUN -- no $need"
                exit 2
        fi
done

if [ ! -f "$image" ]; then
        echo "  desktop      NOT RUN -- no image at $image"
        exit 2
fi

if ! python3 -c 'import socket; socket.create_connection(("dl-cdn.alpinelinux.org", 80), 5).close()' 2> /dev/null; then
        echo "  desktop      NOT RUN -- no network to Alpine's mirror"
        exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-desktop.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

truncate -s 3G "$work/bowls.img" && mke2fs -q -t ext4 -F "$work/bowls.img" || exit 1

MOONWATER_DESKTOP_WORK=$work
export MOONWATER_DESKTOP_WORK
qmp_guest_module "$work"

PYTHONPATH=$work python3 - "$image" > "$work/answers" 2>"$work/why" <<'PY'
import os, re, socket, sys, time
from qmp_guest import *

image = sys.argv[1]
work = os.environ["MOONWATER_DESKTOP_WORK"]

guest = Guest(desktop(image) + [
    "-drive", "if=none,id=bw,format=raw,file=" + work + "/bowls.img",
    "-device", "nvme,serial=bowls0,drive=bw",
    "-netdev", "user,id=n0", "-device", "virtio-net-pci,netdev=n0",
    "-chardev", "socket,id=s0,path=" + work + "/ser,server=on,wait=off",
    "-serial", "chardev:s0",
    "-no-reboot", "-display", "none",
    "-append", "console=ttyS0 drm_client_lib.active= moonwater.cursor_plane=0"],
    work + "/qmp", work + "/mon", work, sockets=(work + "/ser",))

shell = socket.socket(socket.AF_UNIX)
shell.connect(work + "/ser")
shell.settimeout(1)
tags = [0]

def run(command, seconds=60):
    """One line on the guest's serial shell: what it printed, and its status."""
    tags[0] += 1
    mark = tags[0]
    shell.sendall(("\necho BEG\"%d\"; %s\necho END\"%d\":$?\n" % (mark, command, mark)).encode())
    seen = b""
    stop = time.time() + seconds
    done = re.compile(rb"BEG%d\r?\n(.*?)END%d:(\d+)" % (mark, mark), re.S)
    while time.time() < stop:
        try:
            seen += shell.recv(65536)
        except socket.timeout:
            pass
        found = done.search(seen)
        if found:
            text = re.sub(rb"\x1b\[[0-9;?]*[a-zA-Z]", b"", found.group(1))
            text = text.decode("utf8", "replace").replace("\r", "").strip()
            #       What the shell wrote last is its prompt, for the line after.
            return re.sub(r"(\s*\$)+$", "", text), int(found.group(2))
    return seen.decode("utf8", "replace").replace("\r", ""), 124

time.sleep(25)
out = []

run("mount /dev/nvme0n1 /bowls", 30)
_, setup = run("bowl setup alpine", 600)
out.append(("an Alpine bowl lands on the disk", "yes" if setup == 0 else "no, status %d" % setup, "yes"))
_, added = run("apk add eudev libinput-tools", 600)
out.append(("with eudev and libinput's tools added", "yes" if added == 0 else "no, status %d" % added, "yes"))

before, _ = run("libinput list-devices 2>&1 | grep -c 'Capabilities:'")
out.append(("libinput lists no device while no udev has named one", before or "no answer", "0"))

said, started = run("bowl udev 2>&1", 120)
out.append(("bowl udev starts the bowl's udev", "yes" if started == 0 and "udev is running" in said else "no: " + said[-200:], "yes"))
again, second = run("bowl udev 2>&1; echo second=$?", 30)
out.append(("and run again does nothing", "yes" if "second=0" in again and "udev is running" not in again else "no: " + again[-200:], "yes"))

listed, _ = run("libinput list-devices 2>&1")
out.append(("libinput lists the keyboard and the tablet after it",
            "yes" if "QEMU QEMU USB Keyboard" in listed and "QEMU QEMU USB Tablet" in listed else "no: " + listed[-300:], "yes"))

run("(libinput debug-events > /tmp/events 2>&1 &) ; sleep 2", 30)
key("a")
key("b")
moveto(300, 300)
moveto(900, 700)
send([{"type": "btn", "data": {"down": True, "button": "left"}}])
time.sleep(0.1)
send([{"type": "btn", "data": {"down": False, "button": "left"}}])
time.sleep(2)
events, _ = run("cat /tmp/events")
out.append(("a key reaches it", "yes" if "KEYBOARD_KEY" in events else "no: " + events[-300:], "yes"))
out.append(("a pointer movement reaches it", "yes" if "POINTER_MOTION_ABSOLUTE" in events or "POINTER_MOTION" in events else "no: " + events[-300:], "yes"))
out.append(("a button reaches it", "yes" if "POINTER_BUTTON" in events else "no: " + events[-300:], "yes"))

links, _ = run("ls /sys/class/net")
out.append(("the network interface keeps the name the kernel gave it", "yes" if "eth0" in links.split() else "no: " + links[-100:], "yes"))

alive, status = run("echo answers")
out.append(("and the machine answers on its serial shell", "yes" if status == 0 and "answers" in alive else "no", "yes"))

guest.quit()
time.sleep(1)
guest.terminate()
try:
    guest.wait(10)
except Exception:
    guest.kill()

for name, got, want in out:
    print("%s|%s|%s" % (name, " ".join(got.split()).replace("|", "/"), want))
