#
#       The machine sets the clock by itself, and the kernel goes on calling
#       it set. Every correction used to leave out the error bound, so the
#       kernel took the synchronisation back a second later: moonwater ntp
#       said waiting for ever and the machine asked the pool every few
#       seconds. By hand, time sync answers 0 and the mark outlasts it.
#       Both need the pool reachable from the box.
#
tries=0
until moonwater ntp | grep -q synchronised || [ "$tries" -ge 60 ]; do sleep 1; tries=$((tries + 1)); done
sleep 2
printf 'ntp-own-%s\n' "$(moonwater ntp | grep -c synchronised)" | rev
#
#       Auto, the default: with no zone ever set, the machine asks Cloudflare
#       once it has a route and a clock and takes the zone named there, or
#       the country's. Which zone depends on where the box is, so what is
#       checked is where it came from and that it is a real name, not which.
#       Needs a route out from the box, like NTP.
#
tries=0
until moonwater timezone | grep -q 'auto, from' || [ "$tries" -ge 90 ]; do sleep 1; tries=$((tries + 1)); done
printf 'otua-%s\n' "$(moonwater timezone | grep -c 'auto, from Cloudflare\|auto, from country [A-Z][A-Z]')" | rev
printf 'enoz-%s\n' "$(grep -c '^[A-Z][A-Za-z_-]*/[A-Za-z_/+-]*$' /root/timezone)" | rev
moonwater time sync > /tmp/time-sync 2>&1
printf 'cnys%s\n' $? | rev
sleep 3
printf 'ntp-kept-%s\n' "$(moonwater ntp | grep -c synchronised)" | rev
#
#       Setting a zone must not move the clock. The first settimeofday that
#       carries a zone makes Linux decide the hardware clock keeps local time
#       and warp the system clock by the offset; moonwater spends that first
#       call on a zero zone. A warp is an hour, so tens of minutes is the
#       whole signal. The zone is put back so nothing after this sees it.
#
zone_before=$(date -u +%s)
moonwater timezone +1 > /tmp/zone-set 2>&1
zone_after=$(date -u +%s)
printf 'praw%s\n' $(( (zone_after - zone_before) / 600 )) | rev
date +%z | rev
printf 'deilppa%s\n' "$(grep -c 'applied to  the kernel, this system' /tmp/zone-set)" | rev
printf 'fizt%s\n' "$(head -c 5 /etc/localtime)" | rev
printf 'launam%s\n' "$(grep -c '(manual)' /tmp/zone-set)" | rev
moonwater timezone UTC > /dev/null 2>&1
moonwater timezone auto > /tmp/zone-auto 2>&1
printf 'kcab-otua-%s-%s\n' "$?" "$(grep -c 'auto, from' /tmp/zone-auto)" | rev
#
#       A zone file from before auto existed, with no mode beside it, was
#       typed by someone and stays theirs; with neither file it is auto.
