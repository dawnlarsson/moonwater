        history_limit_status=$?
        history_temps=$(find "$work/history-regression" -maxdepth 1 \
                -name '.moonwater-stage-*' -print | wc -l | tr -d '[:space:]')
        [ "$history_limit_status:$(cat "$work/history-regression/preserved"):$history_temps" = \
                '1:old history:0' ]
        verdict history-transaction-write-error builtins_failed 'limited history rewrite returned $history_limit_status, retained [$(cat "$work/history-regression/preserved")], stages $history_temps'

        printf 'link victim\n' > "$work/history-regression/victim"
        ln -sf victim "$work/history-regression/link"
        "$history_shell" -c "$history_command" history \
                "$work/history-regression/link" \
                > "$work/history-regression/link.out" \
                2> "$work/history-regression/link.err"
        history_link_status=$?
        [ "$history_link_status:$(readlink "$work/history-regression/link"):$(cat "$work/history-regression/victim")" = \
                '1:victim:link victim' ] &&
                grep -q 'Too many levels of symbolic links' \
                        "$work/history-regression/link.err"
        verdict history-symlink-fails-closed builtins_failed 'history symlink rewrite returned $history_link_status with link [$(readlink "$work/history-regression/link" 2>/dev/null)] and victim [$(cat "$work/history-regression/victim" 2>/dev/null)]'

        printf 'append victim\n' > "$work/history-regression/append-victim"
        ln -sf append-victim "$work/history-regression/append-link"
        "$history_shell" -c "$history_append_command" history \
                "$work/history-regression/append-link" \
                > "$work/history-regression/append-link.out" \
                2> "$work/history-regression/append-link.err"
        history_append_link_status=$?
        [ "$history_append_link_status:$(readlink "$work/history-regression/append-link"):$(cat "$work/history-regression/append-victim")" = \
                '1:append-victim:append victim' ] &&
                grep -q 'Too many levels of symbolic links' \
                        "$work/history-regression/append-link.err"
        verdict history-append-symlink-fails-closed builtins_failed 'history append symlink returned $history_append_link_status with victim [$(cat "$work/history-regression/append-victim" 2>/dev/null)]'

        if [ -c /dev/full ]; then
                "$history_shell" -c "$history_command" history /dev/full \
                        > /dev/null 2> "$work/history-regression/full.err"
                history_full_status=$?
                [ "$history_full_status" = 1 ] && [ -c /dev/full ] &&
                        grep -q 'No space left on device' \
                                "$work/history-regression/full.err"
                verdict history-special-write-error builtins_failed 'history /dev/full returned $history_full_status or changed the device'
        else
                note "history special-file regression: NOT RUN -- no /dev/full"
        fi

        if command -v strace > /dev/null 2>&1; then
                printf 'metadata preserved\n' > "$work/history-regression/metadata-error"
                chmod 6751 "$work/history-regression/metadata-error"
