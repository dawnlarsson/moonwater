#
#       A fresh shell waits until the live register changes, then asks for the
#       same denied image directly and through a #! line.  Starting it before
#       the write keeps this test independent of the parent's cached report;
#       using printf pieces keeps the successful marker out of console echo.
#       "Before" is a handshake, not an ampersand: the child's exec is its own,
#       and when it lands after the write the child is refused, nobody ever
#       opens the gate, and the parent hangs there until the boot times out.
#
#scenarios
printf '%s\n' '#!/bin/dirname' > /tmp/floodlight-entry
chmod +x /tmp/floodlight-entry
mkfifo /tmp/floodlight-gate /tmp/floodlight-started
/bin/bash -c ': > /tmp/floodlight-started; read gate < /tmp/floodlight-gate; /bin/dirname /tmp/direct >/dev/null 2>&1; direct=$?; /tmp/floodlight-entry >/dev/null 2>&1; script=$?; printf "fl-policy-%s-%s\n" "$direct" "$script"' &
floodlight_child=$!
read started < /tmp/floodlight-started
printf '%s\n' '/shell run deny' > /dev/floodlight
printf '%s\n' go > /tmp/floodlight-gate
wait "$floodlight_child"
poweroff
COMMANDS

#
#       Generated scenarios, where the #scenarios line is: settings lists,
#       the wifi and bluetooth files, keyboard layouts, the monitor on the
#       console and in its failures, and init under signals and orphans
#       with its two services killed until it gives them up --
#       what only runs on a booted image, each family held to a model in
#       differential.py --harness guest_scenarios. Before the last block,
#       which leaves floodlight refusing scripts, and last otherwise, since
#       init stops restarting the machine script and ip watch in it.
#       MOONWATER_GUEST_SEED picks another draw.
#
if python3 test/differential.py --harness guest_scenarios \
        --seed "${MOONWATER_GUEST_SEED:-1}" > "$work/scenarios" 2> "$work/scenarios.err"; then
        awk -v with="$work/scenarios" '
                $0 == "#scenarios" {
                        print "cat > /tmp/scenarios.sh <<'"'"'SCENARIOS'"'"'"
                        while ((getline line < with) > 0)
                                if (line !~ /^#expect /)
                                        print line
                        print "SCENARIOS"
                        print "sh /tmp/scenarios.sh < /dev/null"
                        next
                }
                { print }' "$work/commands" > "$work/commands.run" &&
                mv "$work/commands.run" "$work/commands"
else
        : > "$work/scenarios"
        lost 'guest scenarios' "the generator failed: $(tail -1 "$work/scenarios.err")"
fi

coverage_guest "$image" "$work/coverage"
coverage_guest_commands "$work/commands" > "$work/commands.run"
mv "$work/commands.run" "$work/commands"

#       A display the terminal fits on. A guest takes seventy percent of the
#       mode its EDID prefers, and QEMU's default EDID leaves it 640x480,
#       which holds 78 columns: the terminal opens, as 78x24, and the check
#       below cannot see it. 1600x1200 gives 1024x768.
#
#       The PL011 is fed only once the shell is up. Everything piped into it
#       while the kernel is still booting is gone by the time the shell reads
#       -- not the first line, as on the 8250, but the whole file -- so the
#       arm64 machine waits, and gets longer for it, since emulated it is
#       several times slower than the x86 one under kvm.
#
if [ "$boot_emulator" = qemu-system-x86_64 ]; then
        # shellcheck disable=SC2086
        timeout 240 "$boot_emulator" -m 2G -smp 2 "$@" \
                -kernel "$image" -no-reboot -display none -serial stdio \
                $coverage_serial \
                -append "console=$boot_console drm_client_lib.active=" \
                < "$work/commands" > "$work/transcript" 2>&1 || true
        coverage_guest_collect boot
else
        { sleep 15; cat "$work/commands"; } |
                timeout 480 "$boot_emulator" -m 2G -smp 2 "$@" \
                -kernel "$image" -no-reboot -display none -serial stdio \
                -append "console=$boot_console drm_client_lib.active=" \
                > "$work/transcript" 2>&1 || true
fi

#
