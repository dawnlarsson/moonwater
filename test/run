#       The far side asks the disk's listener until it answers, while the
#       disk boot waits for the file it writes.
link_asker=""
if [ -n "$link_host" ]; then
        link_guest_key=$(grep -o 'link-key-[A-Za-z0-9+/]\{43\}=' "$work/live" |
                head -1 | sed 's/^link-key-//')
        link_on_host "$link_host/bin/moonwater link add guest $link_guest_key 127.0.0.1:$link_port" \
                > /dev/null 2>&1
        (
                tries=0
                while [ "$tries" -lt 40 ]; do
                        [ -s "$work/link-log" ] ||
                                link_on_host "timeout 6 $link_host/bin/moonwater link log guest" \
                                2> /dev/null | head -5 > "$work/link-log"
                        answer=$(link_on_host "timeout 20 $link_host/bin/moonwater link run guest 'echo asked > /root/link-asked; echo from-the-disk'" 2> /dev/null)
                        if [ "$answer" = from-the-disk ]; then
                                echo "$answer" > "$work/link-run"
                                break
                        fi
                        tries=$((tries + 1))
                        sleep 1
                done
        ) &
        link_asker=$!
fi

#       The headless box's neighbour: a second machine, live from the same
#       image, on the same virtual LAN -- QEMU's multicast socket segment,
#       which carries mDNS between the two and has no DHCP server, so each
#       is given its LAN address by one typed line. It joins the group with
#       the secret the live session used, waits for the two to pair by
#       themselves, and runs a command on the disk boot, which touches
#       nothing but that one line.
lan_port=$((30000 + $$ % 20000))
lan="-netdev socket,id=lan,mcast=230.0.0.1:$lan_port"
cat > "$work/neighbour.commands" <<COMMANDS
