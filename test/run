#
#       What the disk's own image carries, read from here: the GPT, the FAT32
#       the install wrote, BOOTX64.EFI's clusters and the newest of its two
#       settings slots whose sum holds.
#
disk_settings()
{
        python3 - "$work/disk.img" "$install_short" > "$work/$1" 2>&1 <<'PY'
import struct, sys, zlib
f = open(sys.argv[1], 'rb')
def at(offset, size):
    f.seek(offset)
    return f.read(size)
head = at(512, 92)
entries, count, size = struct.unpack_from('<QII', head, 72)
start = [struct.unpack_from('<Q', e, 32)[0] * 512
         for e in (at(entries * 512 + i * size, size) for i in range(count))
         if e[56:128].decode('utf-16-le').rstrip('\0') == 'moonwater-boot'][0]
boot = at(start, 512)
sector, per, reserved, fats = struct.unpack_from('<HBHB', boot, 11)
fat_sectors, root = struct.unpack_from('<I', boot, 36)[0], struct.unpack_from('<I', boot, 44)[0]
cluster = sector * per
fat = start + reserved * sector
data = fat + fats * fat_sectors * sector
def chain(c):
    out = []
    while 2 <= c < 0x0ffffff8:
        out.append(c)
        c = struct.unpack('<I', at(fat + c * 4, 4))[0] & 0x0fffffff
    return out
def find(directory, name):
    for c in chain(directory):
        blob = at(data + (c - 2) * cluster, cluster)
        for o in range(0, cluster, 32):
            if blob[o:o + 11] == name:
                return struct.unpack_from('<H', blob, o + 20)[0] << 16 | struct.unpack_from('<H', blob, o + 26)[0]
runs = [data + (c - 2) * cluster
        for c in chain(find(find(find(root, b'EFI        '), b'BOOT       '), sys.argv[2].encode()))]
def read(offset, size):
    out = b''
    while size:
        i, o = divmod(offset, cluster)
        k = min(size, cluster - o)
        out += at(runs[i] + o, k)
        offset, size = offset + k, size - k
    return out
image = read(0, 4096)
pe = struct.unpack_from('<I', image, 0x3c)[0]
table = pe + 24 + struct.unpack_from('<H', image, pe + 20)[0]
raw = [struct.unpack_from('<I', image, table + 40 * i + 20)[0]
       for i in range(struct.unpack_from('<H', image, pe + 6)[0])
       if image[table + 40 * i:table + 40 * i + 8] == b'.mwset\0\0'][0]
best = None
for k in range(2):
    s = read(raw + k * 16384, 16384)
    generation = struct.unpack_from('<Q', s, 16)[0]
    length, total = struct.unpack_from('<II', s, 40)
    if length <= 16320 and zlib.crc32(s[:44] + b'\0\0\0\0' + s[48:64 + length]) == total and \
            (best is None or generation > best[0]):
        best = (generation, s, length)
print('settings-generation-%d' % best[0])
names = {1: 'init', 2: 'startup', 3: 'exit', 4: 'bind'}
kinds = {2: 'shell', 3: 'kernel_shell'}
o = 0
while o < best[2]:
    l, kind, ident, n = struct.unpack_from('<BBHH', best[1], 64 + o)
    print('settings-%s-%d-%s' % (names[l], ident,
                                 kinds.get(kind) or best[1][72 + o:72 + o + n].decode()))
    o += 8 + ((n + 3) & ~3)
PY
}

if command -v python3 > /dev/null 2>&1; then
        disk_settings update-settings
        says update-settings 'the update kept what the stick set' 'settings-init-1-echo carried > /root/carried'
        says update-settings 'and what the disk wrote in place' 'settings-init-3-echo disk >> /root/disk'
        says update-settings 'and its exit list'          'settings-exit-1-echo stop >> /root/stops'
fi

cat > "$work/use.commands" <<'COMMANDS'
this line is eaten by the console
printf '3\n' | moonwater ask > /tmp/ask 2>&1
printf 'left-%s\n' "$(rev < /run/moonwater/verdict)"
moonwater ask > /dev/null 2>&1
printf 'asked-once-%s\n' $(( $? + 60 ))
moonwater setup use > /tmp/use 2>&1
printf 'used-%s\n' $(( $? + 70 ))
printf 'used-root-%s\n' "$(rev < /root/second)"
moonwater status > /tmp/status 2>&1
printf 'status-kept-other-%s\n' $(( $(grep -c 'installed on nvme0n1, another build' /tmp/status) * 3 ))
