#       The way out of a display that nothing is working at, and the profiles
#       that start one. Canvas drops every key while another program holds the
#       card, so what is typed is of no use until it lets go: a compositor with
#       no input, or no picture, would have left the machine with a keyboard
#       and nothing to do with it.
def wait_count(pattern, count, seconds):
    stop = time.time() + seconds
    while time.time() < stop:
        if serial_count(pattern) >= count:
            return True
        time.sleep(0.2)
    return False

def type_symbols(line):
    symbols = {">": "dot", "&": "7", "$": "4"}
    for character in line:
        if character in symbols:
            chord("shift", symbols[character])
        elif character.isupper():
            chord("shift", character.lower())
        else:
            type_text(character)

def windows_now():
    type_text("/shell /mnt/windows\n")
    time.sleep(3)
    found = re.findall(rb"windows-(\d+)", open(work + "/leak-serial", "rb").read())
    return found[-1].decode() if found else "no answer"

