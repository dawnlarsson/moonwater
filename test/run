same 'only newline'    '|'               40 6 text '\n' bytes
same 'edited empty has newline' '|'      40 6 keys 'x<bs>' bytes
same 'empty file'      ''               40 6 bytes
same 'undo restores empty bytes' ''      40 6 keys 'x^z' bytes
same 'redo undo restores empty bytes' '' 40 6 keys 'x^z^y^z' bytes

section

printf '  %-12s %s passed, %s failed\n' 'edit' "$pass" "$fail"

[ "$fail" -eq 0 ] || exit 1

if command -v python3 >/dev/null 2>&1 && [ "$(uname -s)" = Linux ]; then
        python3 test/differential.py --harness edit_driver "$shell_binary"
fi
)

#
#       Build and development tooling.
#
#           sh test/run kit
#
#       Build, source-inventory, remote-host and firmware tooling checks.
#
#       Every harness runs even when one before it fails: core_state first
#       with `|| exit 1` once kept twelve of them dark, the seal among them.
#       objtool_shape stands in for the objtool pass of the kernel build,
#       which no lane runs.
#       The build's configuration reaching the programs. An image build
#       writes artifacts/moonwater_config.h from the kernel's .config and the
#       programs include it; `build config-header` writes the same header
#       from any fragment, over the Kconfig defaults, so a shell is built
#       here exactly as the image would build it. Every other lane builds
#       with no header, which is the default configuration -- that is how
#       the component switches went unread for as long as they did.
switch_header()
{
        build_tool config-header "$1" "$2" > "$2.log" 2>&1 ||
                { sed 's/^/    /' "$2.log"; return 1; }
}

switch_shell()
{
        freestanding programs/shell.c "$2" "$host_arch" \
                "-DMOONWATER_CONFIG=\"$1\""
}

#       What a command answers with no PATH to fall back on: its status.
#       A name the shell does not know is also looked for in the bowls, so
#       where this machine has a /bowls it is hidden under an empty tmpfs in
#       a mount namespace of the run's own, or an Arch bowl's lsblk would
#       answer for the one switched off.
switch_status()
{
        if [ -d /bowls ]; then
                unshare -rm sh -c 'mount -t tmpfs none /bowls &&
                        PATH="$1" exec "$2" -c "$3"' sh \
                        "$switch_empty" "$1" "$2" < /dev/null > /dev/null 2>&1
        else
                PATH="$switch_empty" "$1" -c "$2" < /dev/null > /dev/null 2>&1
        fi
        echo $?
}

#       Whether the shell itself answers to a name: command -v prints a
#       builtin or tool as the bare name, and anything else as a path or
#       not at all.
switch_own()
{
        if [ "$(PATH="$switch_empty" "$1" -c "command -v $2" < /dev/null \
                2> /dev/null)" = "$2" ]; then
                echo yes
        else
                echo no
        fi
}

lane_switches()
(
counting switches 12 28
switch_empty=$work/switch-empty
mkdir -p "$switch_empty" || exit 1

group handoff
printf '%s\n' 'CONFIG_MOONWATER_CORE=y' \
        '# CONFIG_MOONWATER_UTIL_LINUX is not set' \
        'CONFIG_MOONWATER_SHELL_MONITOR=n' \
        'CONFIG_MOONWATER_STRICT=2' > "$work/switch-components.config"
if switch_header "$work/switch-components.config" "$work/switch-components.h" &&
        switch_shell "$work/switch-components.h" "$work/switch-components"; then
        won
        switch_bin=$work/switch-components
        switch_record=$(sed -n 's/^#define MOONWATER_CONFIG_RECORD "\(.*\)"$/\1/p' \
                "$work/switch-components.h")
        if [ -n "$switch_record" ] &&
                grep -q -a -F "$switch_record" "$switch_bin"; then
                won
        else
                lost 'record in the image' "no [$switch_record] in the shell"
        fi
        same 'strict level' 'MOONWATER_STRICT 2' \
                "$(grep -o 'MOONWATER_STRICT [0-9]*' "$work/switch-components.h")"
        same 'util-linux off' 127 "$(switch_status "$switch_bin" lsblk)"
        same 'util-linux not its own' no "$(switch_own "$switch_bin" lsblk)"
        same 'monitor not its own' no "$(switch_own "$switch_bin" monitor)"
        same 'utilities still on' 0 "$(switch_status "$switch_bin" 'cat /dev/null')"
else
        lost 'components build' 'the header or the shell did not build'
fi

#       One tool off, and its neighbours in tools.inc still there: gone from
#       the table, from every name the image links, and from the shell.
group tool
printf '%s\n' 'CONFIG_MOONWATER_CORE=y' \
        '# CONFIG_MOONWATER_TOOL_TAC is not set' \
        '# CONFIG_MOONWATER_BUILTIN_ULIMIT is not set' \
        '# CONFIG_MOONWATER_TOOL_MOUNTPOINT is not set' \
        '# CONFIG_MOONWATER_BUILTIN_MOUNTPOINT is not set' \
        '# CONFIG_MOONWATER_BUILTIN_KILL is not set' \
        '# CONFIG_MOONWATER_BUILTIN_EXIT is not set' > "$work/switch-single.config"
if switch_header "$work/switch-single.config" "$work/switch-single.h" &&
        switch_shell "$work/switch-single.h" "$work/switch-single"; then
        won
        switch_bin=$work/switch-single
        same 'tac not found' 127 "$(switch_status "$switch_bin" 'tac /dev/null')"
        same 'tac not its own' no "$(switch_own "$switch_bin" tac)"
        same 'tail its own' yes "$(switch_own "$switch_bin" tail)"
        same 'sum still on' 0 "$(switch_status "$switch_bin" 'sum /dev/null')"
        same 'tail still on' 0 "$(switch_status "$switch_bin" 'tail /dev/null')"
        same 'ulimit not found' 127 "$(switch_status "$switch_bin" 'ulimit -n')"
        same 'ulimit not its own' no "$(switch_own "$switch_bin" ulimit)"
        same 'umask still its own' yes "$(switch_own "$switch_bin" umask)"
        same 'mountpoint gone from both' no \
                "$(switch_own "$switch_bin" mountpoint)"
        same 'mountpoint not found' 127 \
                "$(switch_status "$switch_bin" 'mountpoint /')"
        same 'kill kept by its tool' yes "$(switch_own "$switch_bin" kill)"
        same 'exit has no switch' 3 "$(switch_status "$switch_bin" 'exit 3')"
        same 'enable lists no ulimit' '' \
                "$(PATH="$switch_empty" "$switch_bin" -c 'enable' < /dev/null |
                        grep -x 'enable ulimit')"
        if build_tool surface "$work/switch-single.config" \
                > "$work/switch-single.surface" 2>&1; then
                same 'tac not linked' '' \
                        "$(grep -x -e tac -e bin/tac "$work/switch-single.surface")"
                same 'tail linked' 'tail bin/tail' \
                        "$(grep -x -e tail -e bin/tail "$work/switch-single.surface" |
                                tr '\n' ' ' | sed 's/ $//')"
                same 'init always linked' init \
                        "$(grep -x init "$work/switch-single.surface")"
        else
                lost 'surface' "$(head -3 "$work/switch-single.surface")"
        fi
else
        lost 'single build' 'the header or the shell did not build'
fi

#       sec_reference is the only tier that compiles the STRICT_REFERENCE
#       branches, and a utility-only image is the only build of
#       programs/utilities.c against a header: each is built once here so
#       neither can rot unseen. The utility program drops the monitor and
#       every SYSTEM name, and has no shell to fall back to.
group reference
{ echo CONFIG_MOONWATER_CORE=y; cat kernel/profile/sec_reference; } \
        > "$work/switch-reference.config"
if switch_header "$work/switch-reference.config" "$work/switch-reference.h" &&
        switch_shell "$work/switch-reference.h" "$work/switch-reference"; then
        won
        same 'strict level' 'MOONWATER_STRICT 0' \
                "$(grep -o 'MOONWATER_STRICT [0-9]*' "$work/switch-reference.h")"
        same 'cat runs' 0 "$(switch_status "$work/switch-reference" 'cat /dev/null')"
else
        lost 'reference build' 'the header or the shell did not build'
fi

group utility
printf '%s\n' 'CONFIG_MOONWATER_CORE=y' '# CONFIG_MOONWATER_SHELL is not set' \
        '# CONFIG_MOONWATER_TOOL_TAC is not set' > "$work/switch-utility.config"
if build_tool config-header "$work/switch-utility.config" \
                "$work/switch-utility.h" utility > "$work/switch-utility.log" 2>&1 &&
        freestanding programs/utilities.c "$work/switch-utility" "$host_arch" \
                "-DMOONWATER_CONFIG=\"$work/switch-utility.h\""; then
        won
        mkdir -p "$work/switch-utility-bin"
        for switch_name in tac tail monitor init; do
                ln -sf "$work/switch-utility" "$work/switch-utility-bin/$switch_name"
        done
        for switch_name in tac monitor init; do
                "$work/switch-utility-bin/$switch_name" < /dev/null > /dev/null 2>&1
                same "$switch_name not a utility" 127 "$?"
        done
        "$work/switch-utility-bin/tail" < /dev/null > /dev/null 2>&1
        same 'tail a utility' 0 "$?"
        same 'utility surface' tail \
                "$(build_tool surface "$work/switch-utility.config" |
                        grep -x -e tac -e tail -e monitor -e init)"
else
        lost 'utility build' "$(head -3 "$work/switch-utility.log")"
fi

#       A policy string the shell and floodlight.c cannot read refuses every
#       program at boot, /init among them, so the header is not written for
#       one: each row below is read as given, then misspelled one field at
#       a time, and only the row as given builds. A value that is not one C
#       string is refused too; the header carries it as written.
group floodlight-policy
for switch_row in 'wget spawn deny' 'curl network allow' '/usr/bin/nc run deny' \
        'find flag -exec deny' 'tar flag --to-command allow'; do
        # shellcheck disable=SC2086
        set -- $switch_row
        switch_last=$(($# == 4 ? 4 : 3))
        eval "switch_state=\${$switch_last}"
        for switch_shape in given setting state extra short seal option split; do
                case $switch_shape in
                given) switch_policy="$switch_row; $switch_row" ;;
                split) switch_policy="$switch_row\"; \"" ;;
                setting) switch_policy="$1 ${2}s ${switch_row#"$1 $2 "}" ;;
                state) switch_policy="${switch_row% *} ${switch_state}d" ;;
                extra) switch_policy="$switch_row now" ;;
                short) switch_policy="${switch_row% *}" ;;
                seal) switch_policy="seal ${switch_row#* }" ;;
                option)
                        [ "$2" = flag ] || continue
                        switch_policy="$1 flag ${3#"${3%%[!-]*}"} $4" ;;
                esac
                printf 'CONFIG_MOONWATER_FLOODLIGHT_POLICY="%s"\n' \
                        "$switch_policy" > "$work/switch-policy.config"
                build_tool config-header "$work/switch-policy.config" \
                        "$work/switch-policy.h" > "$work/switch-policy.log" 2>&1
                switch_built=$?
                if [ "$switch_shape" = given ]; then
                        same "$switch_policy" 0 "$switch_built"
                elif [ "$switch_built" -ne 0 ] &&
                        grep -q FLOODLIGHT_POLICY "$work/switch-policy.log"; then
                        won
                else
                        lost "$switch_policy" "built ($switch_built)"
                fi
        done
done

#       kernel/profile/sec_locked as the build composes it over the
#       defaults, after profile/any turns the core on: its allow list in,
#       everything else out, the core kept.
group locked
{ echo CONFIG_MOONWATER_CORE=y; cat kernel/profile/sec_locked; } \
        > "$work/switch-locked.config"
if switch_header "$work/switch-locked.config" "$work/switch-locked.h" &&
        switch_shell "$work/switch-locked.h" "$work/switch-locked"; then
        won
        switch_bin=$work/switch-locked
        same 'strict level' 'MOONWATER_STRICT 2' \
                "$(grep -o 'MOONWATER_STRICT [0-9]*' "$work/switch-locked.h")"
        for switch_name in cat ls sed grep ip mount blkid echo printf test \
                read poweroff cd exit trap eval; do
                same "$switch_name kept" yes "$(switch_own "$switch_bin" "$switch_name")"
        done
        for switch_name in awk wget host tar gzip chroot nsenter unshare dd \
                monitor edit bowl history alias source declare enable \
                pushd jobs; do
                same "$switch_name gone" no "$(switch_own "$switch_bin" "$switch_name")"
        done
        same 'wget not found' 127 \
                "$(switch_status "$switch_bin" 'wget http://localhost/')"
        same 'history not found' 127 "$(switch_status "$switch_bin" 'history')"
        same 'a script still runs' 7 \
                "$(switch_status "$switch_bin" 'f() { return 7; }; trap : EXIT; f; exit $?')"
        if build_tool surface "$work/switch-locked.config" \
                > "$work/switch-locked.surface" 2>&1; then
                same 'linked in locked' 'bin/cat bin/ls cat init ls moonwater term' \
                        "$(grep -x -e cat -e bin/cat -e ls -e bin/ls -e init \
                                -e term -e moonwater "$work/switch-locked.surface" |
                                sort | tr '\n' ' ' | sed 's/ $//')"
                same 'not linked in locked' '' \
                        "$(grep -x -e awk -e bin/awk -e wget -e bin/wget \
                                -e edit -e bowl -e monitor -e sbin/wipefs \
                                "$work/switch-locked.surface")"
                same 'links in locked' "$(grep -c '^CONFIG_MOONWATER_TOOL_.*=y$' \
                                kernel/profile/sec_locked)" \
                        "$(grep -c -v / "$work/switch-locked.surface" |
                                awk '{ print $1 - 3 }')"
        else
                lost 'locked surface' "$(head -3 "$work/switch-locked.surface")"
        fi
else
        lost 'locked build' 'the header or the shell did not build'
fi

counted
)

lane_kit()
(
kit_failed=0
python3 test/differential.py --harness core_state || kit_failed=1
python3 test/differential.py --harness canvas_lifetime || kit_failed=1
python3 test/differential.py --harness canvas_hold || kit_failed=1
python3 test/differential.py --harness canvas_view || kit_failed=1
python3 test/differential.py --harness audit_shell_functions || kit_failed=1
python3 test/differential.py --harness spark_entry || kit_failed=1
python3 test/differential.py --harness objtool_shape || kit_failed=1
python3 test/differential.py --harness terminfo_install || kit_failed=1
python3 test/differential.py --harness host_writes || kit_failed=1
python3 test/differential.py --harness net_sysctl || kit_failed=1
python3 test/differential.py --harness console_queue || kit_failed=1
python3 test/differential.py --harness pane_restride || kit_failed=1
python3 test/differential.py --harness pane_pages || kit_failed=1
python3 test/differential.py --harness shared_page || kit_failed=1
python3 test/differential.py --harness kernel_dirhash || kit_failed=1
python3 test/differential.py --harness kernel_ports || kit_failed=1
python3 test/differential.py --harness sort_spill_names || kit_failed=1
python3 test/differential.py --harness dhcp_packets || kit_failed=1
python3 test/differential.py --harness inventory_mutations || kit_failed=1
python3 test/differential.py --harness machine_reap || kit_failed=1
python3 test/differential.py --harness machine_scan || kit_failed=1
if [ "$(uname -s)" = Darwin ]; then
        python3 test/differential.py --harness macos_read_retry || kit_failed=1
fi
python3 test/function_audit.py --check || kit_failed=1
build_tool switches check || kit_failed=1
python3 test/differential.py --harness floodlight || kit_failed=1
python3 test/differential.py --harness surface_coreutils_gap || kit_failed=1
python3 test/differential.py --harness image_nodes || kit_failed=1
python3 test/differential.py --harness canvas_seam || kit_failed=1
python3 test/differential.py --harness canvas_scale || kit_failed=1
python3 test/differential.py --harness bowl_session || kit_failed=1
python3 test/differential.py --harness bowl_roots || kit_failed=1
python3 test/differential.py --harness riscv_builtins || kit_failed=1
[ "$kit_failed" = 0 ] || exit 1

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

counting kit 10 24

# The remote copy must not recursively ship agent worktrees. Stub the two
# remote tools and fail the copy deliberately, before any build can start.
group build
mkdir -p "$work/build-bin"
cat > "$work/build-bin/ssh" <<'SCRIPT'
#!/bin/sh
exit 0
SCRIPT
cat > "$work/build-bin/rsync" <<'SCRIPT'
#!/bin/sh
printf '%s\n' "$@" > "$MOONWATER_TEST_COPY"
for argument do
        case $argument in
        --rsync-path=*) printf '%s' "${argument#--rsync-path=}" > "$MOONWATER_TEST_COPY.stage" ;;
        esac
done
exit 23
SCRIPT
chmod +x "$work/build-bin/ssh" "$work/build-bin/rsync"
hostile_remote="$work/remote path; printf injected >$work/rsync-injected; : #"
PATH="$work/build-bin:$PATH" MOONWATER_TEST_COPY="$work/copy-arguments" \
        MOONWATER_BUILD_DIR="$hostile_remote" \
        sh build.sh --host build-fixture > "$work/build-log" 2>&1
copy_status=$?
copy_target=$(tail -1 "$work/copy-arguments")
python3 - "$work/copy-arguments" "$copy_target" "$hostile_remote" <<'PY'
import pathlib
import platform
import shlex
import sys

record, target, remote = sys.argv[1:]
if platform.system() == 'Darwin':
    assert target.startswith('build-fixture:')
    assert shlex.split(target[len('build-fixture:'):]) == [remote + '/']
else:
    assert target == 'build-fixture:./'
    command = shlex.split(pathlib.Path(record + '.stage').read_text())
    assert len(command) == 6
    assert command[:2] == ['sh', '-c']
    assert command[3:] == ['sh', remote, 'rsync']
PY
copy_decode_status=$?
if [ "$copy_status" -ne 0 ] &&
        grep -q -x -F '.claude' "$work/copy-arguments" &&
        [ "$copy_decode_status" -eq 0 ] &&
        [ ! -e "$work/rsync-injected" ]; then
        won
else
        lost 'quoted remote copy' \
                "copy $copy_status decode $copy_decode_status target [$copy_target]"
fi

if [ "$(uname -s)" = Darwin ]; then
# Exercise the Mac-side remote path without a remote machine. The local rsync
# stub runs stage preparation as the remote shell would. Native Linux
# exercises the C remote entry in the build_tools harness below.
mkdir -p "$work/secure-bin" "$work/remote-parent" \
        "$work/remote-fixture/src" "$work/remote-fixture/kernel" \
        "$work/remote-fixture/dist"
chmod 700 "$work/remote-parent"
: > "$work/remote-fixture/build.sh"
cat > "$work/secure-bin/stat" <<'SCRIPT'
#!/bin/sh
format=$2
shift 2
[ "$1" != -- ] || shift
if [ "$(/usr/bin/uname -s)" = Darwin ]; then
        case $format in
        %u) exec /usr/bin/stat -f %u "$1" ;;
        %a|%Lp) exec /usr/bin/stat -f %Lp "$1" ;;
        %s|%z) exec /usr/bin/stat -f %z "$1" ;;
        esac
fi
case $format in %z) format=%s ;; %Lp) format=%a ;; esac
exec /usr/bin/stat -c "$format" -- "$1"
SCRIPT
cat > "$work/secure-bin/rsync" <<'SCRIPT'
#!/bin/sh
exit 0
SCRIPT
cat > "$work/secure-bin/ssh" <<'SCRIPT'
#!/bin/sh
command=
for command do :; done
case "$command" in
*"'./build' 'key-one' 'kernel_export'"*)
        printf '%s\n' "${MOONWATER_TEST_IMAGE:-dist/image.efi}" ;;
*"'cat' '--'"*)
        if [ -n "${MOONWATER_TEST_REPLACE_STAGE:-}" ]; then
                staged=$(find "$MOONWATER_TEST_REPLACE_STAGE" \
                        -path '*/.moonwater-fetch.*/image' -type f -print |
                        head -1)
                [ -n "$staged" ] || exit 91
                rm -f -- "$staged" || exit 92
                ln -s "$MOONWATER_TEST_SWAP_OUTPUT" "$staged" || exit 93
        fi
        printf '%s' 'new image bytes'
        exit "${MOONWATER_TEST_FETCH_STATUS:-0}" ;;
*"'sudo' 'env'"*) exit 0 ;;
true) exit 0 ;;
*) sh -c "$command" ;;
esac
SCRIPT
cat > "$work/secure-bin/mktemp" <<'SCRIPT'
#!/bin/sh
if [ "$1" = -d ]; then
        [ -z "${MOONWATER_TEST_MKTEMP_LOG:-}" ] ||
                printf '%s\n' directory >> "$MOONWATER_TEST_MKTEMP_LOG"
        exec /usr/bin/mktemp "$@"
fi
temporary=$(/usr/bin/mktemp "$@") || exit 1
[ -z "${MOONWATER_TEST_MKTEMP_LOG:-}" ] ||
        printf '%s\n' named-file >> "$MOONWATER_TEST_MKTEMP_LOG"
if [ -n "${MOONWATER_TEST_SWAP_OUTPUT:-}" ]; then
        rm -f -- "$temporary" || exit 1
        ln -s "$MOONWATER_TEST_SWAP_OUTPUT" "$temporary" || exit 1
fi
printf '%s\n' "$temporary"
SCRIPT
chmod +x "$work/secure-bin/stat" "$work/secure-bin/rsync" \
        "$work/secure-bin/ssh" "$work/secure-bin/mktemp"

printf '%s' 'outside stays' > "$work/outside-image"
ln -s "$work/outside-image" "$work/remote-fixture/dist/image.efi"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_TEST_MKTEMP_LOG="$work/build-mktemp-log" \
                MOONWATER_TEST_SWAP_OUTPUT="$work/outside-image" \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture > "$work/secure-log" 2>&1
)
secure_status=$?
secure_type=regular
[ ! -L "$work/remote-fixture/dist/image.efi" ] || secure_type='link'
same 'private atomic remote build' \
        '0:regular:new image bytes:outside stays:directory:700:600' \
        "$secure_status:$secure_type:$(cat "$work/remote-fixture/dist/image.efi"):$(cat "$work/outside-image"):$(cat "$work/build-mktemp-log"):$($work/secure-bin/stat -c %a -- "$work/remote-parent/stage"):$($work/secure-bin/stat -c %a -- "$work/remote-parent/stage/.moonwater-stage-v1")"

rm -f -- "$work/remote-fixture/dist/image.efi"
mkdir -p "$work/fetch-directory-target"
ln -s "$work/fetch-directory-target" \
        "$work/remote-fixture/dist/image.efi"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture \
                > "$work/fetch-link-directory-log" 2>&1
)
fetch_link_directory_status=$?
fetch_link_directory_type=regular
[ ! -L "$work/remote-fixture/dist/image.efi" ] ||
        fetch_link_directory_type='link'
fetch_link_directory_escape=no
[ ! -e "$work/fetch-directory-target/image" ] ||
        fetch_link_directory_escape=yes
same 'fetch replaces directory symlink safely' \
        '0:regular:new image bytes:no' \
        "$fetch_link_directory_status:$fetch_link_directory_type:$(cat "$work/remote-fixture/dist/image.efi"):$fetch_link_directory_escape"

rm -f -- "$work/remote-fixture/dist/image.efi"
mkdir "$work/remote-fixture/dist/image.efi"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture \
                > "$work/fetch-directory-log" 2>&1
)
fetch_directory_status=$?
same 'fetch refuses directory destination' '1:directory' \
        "$fetch_directory_status:$([ -d "$work/remote-fixture/dist/image.efi" ] && printf directory || printf changed)"
rmdir "$work/remote-fixture/dist/image.efi"

artifact_cr=$(printf '\r')
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_TEST_IMAGE="dist/image${artifact_cr}.efi" \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture \
                > "$work/fetch-cr-log" 2>&1
)
same 'remote carriage return refused' 1 "$?"

printf '%s' 'old image bytes' > "$work/remote-fixture/dist/image.efi"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_TEST_REPLACE_STAGE="$work/remote-fixture/dist" \
                MOONWATER_TEST_SWAP_OUTPUT="$work/outside-image" \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture > "$work/fetch-race-log" 2>&1
)
fetch_race_status=$?
fetch_race_temps=$(find "$work/remote-fixture/dist" -name '.moonwater-fetch.*' |
        wc -l | tr -d ' ')
same 'fetch replacement refused' '1:old image bytes:outside stays:0' \
        "$fetch_race_status:$(cat "$work/remote-fixture/dist/image.efi"):$(cat "$work/outside-image"):$fetch_race_temps"

printf '%s' 'old image bytes' > "$work/remote-fixture/dist/image.efi"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_TEST_FETCH_STATUS=9 \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture > "$work/fetch-fail-log" 2>&1
)
fetch_status=$?
fetch_temps=$(find "$work/remote-fixture/dist" -name '.moonwater-fetch.*' |
        wc -l | tr -d ' ')
same 'failed fetch preserves image' '1:old image bytes:0' \
        "$fetch_status:$(cat "$work/remote-fixture/dist/image.efi"):$fetch_temps"

chmod 0777 "$work/remote-fixture/dist"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture > "$work/local-mode-log" 2>&1
)
local_mode_status=$?
chmod 0755 "$work/remote-fixture/dist"
same 'writable local output refused' 1 "$local_mode_status"

(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_TEST_IMAGE='dist/../../escaped' \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture > "$work/traversal-log" 2>&1
)
traversal_status=$?
escaped=no
[ ! -e "$work/escaped" ] || escaped=yes
same 'remote traversal refused' '1:no' "$traversal_status:$escaped"

mkdir -p "$work/link-target"
ln -s "$work/link-target" "$work/remote-fixture/dist/nested"
(
        cd "$work/remote-fixture" || exit 1
        PATH="$work/secure-bin:$PATH" \
                MOONWATER_TEST_IMAGE='dist/nested/image.efi' \
                MOONWATER_BUILD_DIR="$work/remote-parent/stage" \
                sh "$root/build.sh" --host build-fixture > "$work/parent-link-log" 2>&1
)
parent_link_status=$?
parent_escape=no
[ ! -e "$work/link-target/image.efi" ] || parent_escape=yes
same 'local parent symlink refused' '1:no' \
        "$parent_link_status:$parent_escape"

mkdir -p "$work/unclaimed-stage" "$work/stage-link-target"
chmod 777 "$work/unclaimed-stage"
chmod 700 "$work/stage-link-target"
ln -s "$work/stage-link-target" "$work/remote-parent/stage-link"
for unsafe_stage in "$work/unclaimed-stage" "$work/remote-parent/stage-link"; do
        (
                cd "$work/remote-fixture" || exit 1
                PATH="$work/secure-bin:$PATH" \
                        MOONWATER_BUILD_DIR="$unsafe_stage" \
                        sh "$root/build.sh" --host build-fixture > \
                        "$work/unsafe-stage-log" 2>&1
        )
        unsafe_status=$?
        same "unsafe stage $(basename "$unsafe_stage")" 1 "$unsafe_status"
done

fi

# The Raspberry Pi hook verifies both cached and newly downloaded bytes, and
# writes private stages through pinned descriptors before publication. Fake
# downloads make those transitions deterministic and keep this lane offline.
mkdir -p "$work/rpi/src/build" "$work/rpi/artifacts/pi" \
        "$work/rpi/dist/boot" "$work/rpi-bin"
cp src/build/host.sh "$work/rpi/src/build/host.sh"
rpi_fixture_uid=$(id -u)
cat > "$work/rpi-bin/id" <<'SCRIPT'
#!/bin/sh
if [ -n "${MOONWATER_TEST_UID:-}" ]; then
        printf '%s\n' "$MOONWATER_TEST_UID"
else
        exec /usr/bin/id "$@"
fi
SCRIPT
cat > "$work/rpi-bin/stat" <<'SCRIPT'
#!/bin/sh
format=$2
shift 2
[ "$1" != -- ] || shift
path=$1
if [ "${MOONWATER_TEST_ROOT_OUTPUTS:-}" = 1 ] && [ "$format" = %u ]; then
        case $path in
        artifacts|artifacts/*|dist|dist/*) printf '0\n'; exit 0 ;;
        esac
fi
if [ "$(uname -s)" = Darwin ]; then
        case $format in
        %u) exec /usr/bin/stat -f %u "$path" ;;
        %a) exec /usr/bin/stat -f %Lp "$path" ;;
        esac
fi
exec /usr/bin/stat -c "$format" -- "$path"
SCRIPT
cat > "$work/rpi-bin/sha256sum" <<'SCRIPT'
#!/bin/sh
read -r digest path || exit 1
case $path in
*bootcode.bin*) expected='firmware:bootcode.bin' ;;
*start.elf*) expected='firmware:start.elf' ;;
*fixup.dat*) expected='firmware:fixup.dat' ;;
*) exit 1 ;;
esac
[ "$(cat "$path")" = "$expected" ]
SCRIPT
cat > "$work/rpi-bin/curl" <<'SCRIPT'
#!/bin/sh
output=
url=
while [ "$#" -gt 0 ]; do
        case $1 in
        --output) output=$2; shift 2 ;;
        --proto|--proto-redir) shift 2 ;;
        --fail|--location|--silent|--show-error|--tlsv1.2) shift ;;
        *) url=$1; shift ;;
        esac
done
[ -n "$output" ] && [ -n "$url" ] || exit 1
name=${url##*/}
[ -z "${MOONWATER_TEST_OUTPUT_LOG:-}" ] ||
        printf '%s\n' "$output" >> "$MOONWATER_TEST_OUTPUT_LOG"
if [ -n "${MOONWATER_TEST_REPLACE_STAGE:-}" ]; then
        staged=$(find "$MOONWATER_TEST_REPLACE_STAGE" -name payload \
                -type f -print | head -1)
        [ -n "$staged" ] || exit 91
        rm -f -- "$staged" || exit 92
        ln -s "$MOONWATER_TEST_SWAP_OUTPUT" "$staged" || exit 93
fi
if [ -n "${MOONWATER_TEST_SWAP_OUTPUT:-}" ] && [ "$output" != - ]; then
        rm -f -- "$output" || exit 1
        ln -s "$MOONWATER_TEST_SWAP_OUTPUT" "$output" || exit 1
fi
if [ "${MOONWATER_TEST_BAD_FIRMWARE:-}" = "$name" ]; then
        bytes=corrupt
else
        bytes=firmware:$name
fi
case $output in
-) printf '%s' "$bytes" ;;
*) printf '%s' "$bytes" > "$output" ;;
esac
SCRIPT
chmod +x "$work/rpi-bin/id" "$work/rpi-bin/stat" \
        "$work/rpi-bin/sha256sum" \
        "$work/rpi-bin/curl"
printf '%s' 'firmware:bootcode.bin' > "$work/rpi/artifacts/pi/bootcode.bin"
printf '%s' 'outside firmware stays' > "$work/rpi-outside"
ln -s "$work/rpi-outside" "$work/rpi/artifacts/pi/start.elf"
printf '%s' stale > "$work/rpi/artifacts/pi/fixup.dat"
ln -s "$work/rpi-outside" "$work/rpi/dist/boot/bootcode.bin"
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" \
                MOONWATER_TEST_OUTPUT_LOG="$work/rpi-output-log" \
                MOONWATER_TEST_SWAP_OUTPUT="$work/rpi-outside" \
                sh "$root/kernel/profile/post/rpi.sh" \
                > "$work/rpi-log" 2>&1
)
rpi_status=$?
rpi_types=regular
for firmware in bootcode.bin start.elf fixup.dat; do
        [ ! -L "$work/rpi/artifacts/pi/$firmware" ] || rpi_types='link'
        [ ! -L "$work/rpi/dist/boot/$firmware" ] || rpi_types='link'
done
same 'verified named firmware' \
        '0:regular:firmware:bootcode.bin:firmware:start.elf:firmware:fixup.dat:outside firmware stays' \
        "$rpi_status:$rpi_types:$(cat "$work/rpi/dist/boot/bootcode.bin"):$(cat "$work/rpi/dist/boot/start.elf"):$(cat "$work/rpi/dist/boot/fixup.dat"):$(cat "$work/rpi-outside")"
same 'firmware writer uses descriptors' '-:-' \
        "$(paste -sd: "$work/rpi-output-log")"

# Model a fresh sudo build: the checkout remains owned by the invoking user,
# while artifacts and dist were created by the root build before this hook.
# The process itself stays unprivileged so the fixture can run everywhere;
# the id/stat wrappers expose the ownership combination the hook decides on.
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" MOONWATER_TEST_UID=0 \
                MOONWATER_TEST_ROOT_OUTPUTS=1 SUDO_UID="$rpi_fixture_uid" \
                sh "$root/kernel/profile/post/rpi.sh" \
                > "$work/rpi-sudo-owner-log" 2>&1
)
rpi_sudo_owner_status=$?
same 'sudo accepts invoking checkout and root output' 0 \
        "$rpi_sudo_owner_status"

# mv follows a destination link when that link names a directory. Publication
# must replace the link itself, and must refuse an actual directory rather than
# nesting the generic staged name inside either target.
mkdir "$work/rpi-outside-directory"
rm -f "$work/rpi/dist/boot/start.elf"
ln -s "$work/rpi-outside-directory" "$work/rpi/dist/boot/start.elf"
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" sh "$root/kernel/profile/post/rpi.sh" \
                > "$work/rpi-directory-link-log" 2>&1
)
rpi_directory_link_status=$?
rpi_directory_link_type=regular
[ ! -L "$work/rpi/dist/boot/start.elf" ] || rpi_directory_link_type='link'
rpi_directory_link_escape=$(find "$work/rpi-outside-directory" -mindepth 1 \
        -print | wc -l | tr -d ' ')
same 'firmware replaces directory symlink safely' \
        '0:regular:firmware:start.elf:0' \
        "$rpi_directory_link_status:$rpi_directory_link_type:$(cat "$work/rpi/dist/boot/start.elf"):$rpi_directory_link_escape"

rm -f "$work/rpi/dist/boot/start.elf"
mkdir "$work/rpi/dist/boot/start.elf"
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" sh "$root/kernel/profile/post/rpi.sh" \
                > "$work/rpi-directory-target-log" 2>&1
)
rpi_directory_target_status=$?
rpi_directory_target_escape=$(find "$work/rpi/dist/boot/start.elf" -mindepth 1 \
        -print | wc -l | tr -d ' ')
same 'firmware refuses directory destination' '1:0' \
        "$rpi_directory_target_status:$rpi_directory_target_escape"
rmdir "$work/rpi/dist/boot/start.elf"
printf '%s' 'firmware:start.elf' > "$work/rpi/dist/boot/start.elf"

printf '%s' 'old invalid firmware' > "$work/rpi/artifacts/pi/fixup.dat"
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" \
                MOONWATER_TEST_REPLACE_STAGE="$work/rpi/artifacts/pi" \
                MOONWATER_TEST_SWAP_OUTPUT="$work/rpi-outside" \
                sh "$root/kernel/profile/post/rpi.sh" > "$work/rpi-race-log" 2>&1
)
rpi_race_status=$?
rpi_race_temps=$(find "$work/rpi" \( -name '*.download.*' -o -name '*.copy.*' \) |
        wc -l | tr -d ' ')
same 'firmware replacement refused' \
        '1:old invalid firmware:outside firmware stays:0' \
        "$rpi_race_status:$(cat "$work/rpi/artifacts/pi/fixup.dat"):$(cat "$work/rpi-outside"):$rpi_race_temps"

printf '%s' 'old invalid firmware' > "$work/rpi/artifacts/pi/fixup.dat"
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" MOONWATER_TEST_BAD_FIRMWARE=fixup.dat \
                sh "$root/kernel/profile/post/rpi.sh" > "$work/rpi-bad-log" 2>&1
)
rpi_bad_status=$?
rpi_temps=$(find "$work/rpi" \( -name '*.download.*' -o -name '*.copy.*' \) |
        wc -l | tr -d ' ')
same 'bad firmware not promoted' '1:old invalid firmware:0' \
        "$rpi_bad_status:$(cat "$work/rpi/artifacts/pi/fixup.dat"):$rpi_temps"

chmod 0777 "$work/rpi/artifacts/pi"
(
        cd "$work/rpi" || exit 1
        PATH="$work/rpi-bin:$PATH" sh "$root/kernel/profile/post/rpi.sh" \
                > "$work/rpi-mode-log" 2>&1
)
rpi_mode_status=$?
chmod 0755 "$work/rpi/artifacts/pi"
same 'writable firmware cache refused' 1 "$rpi_mode_status"

rpi_commit=$(sed -n 's/^firmware_commit=//p' kernel/profile/post/rpi.sh)
rpi_commit_ok=$(printf '%s\n' "$rpi_commit" | grep -E -c '^[0-9a-f]{40}$')
rpi_hashes=$(grep -E -c '[[:xdigit:]]{64}' kernel/profile/post/rpi.sh)
rpi_master=$(grep -c 'raw/master' kernel/profile/post/rpi.sh)
same 'immutable firmware source' '1:3:0' \
        "$rpi_commit_ok:$rpi_hashes:$rpi_master"

#       kernel/firmware/apply, the image's /lib/firmware. A curl that serves
#       "blob:NAME" for every NAME stands in for linux-firmware, with a WHENCE
#       of two sections, and the script is the tree's own with only the
#       WHENCE digest swapped for the fixture's. Every named file must land as
#       NAME.zst unpacking to what was served, a link under its own name, the
#       licence and the one WHENCE section that names them beside it; a
#       digest the bytes do not have stops it with nothing new installed;
#       and a composed config with no firmware line leaves no /lib/firmware.
fw=$work/firmware
mkdir -p "$fw/bin" "$fw/tree/artifacts" "$fw/tree/src/build" \
        "$fw/tree/fs/lib/firmware/stale"
cp src/build/host.sh "$fw/tree/src/build/"
cat > "$fw/bin/curl" <<'SCRIPT'
#!/bin/sh
output=
url=
while [ "$#" -gt 0 ]; do
        case $1 in
        --output) output=$2; shift 2 ;;
        --proto|--proto-redir) shift 2 ;;
        -*) shift ;;
        *) url=$1; shift ;;
        esac
done
name=${url#*/plain/}
name=${name%%\?id=*}
case $name in
WHENCE) printf 'Driver: x\nFile: a/one.bin\nLink: a/two.bin -> b/src.bin\nLicence: see LICENCE.x\n----------\nDriver: y\nFile: other.bin\n----------\n' ;;
*) printf 'blob:%s' "$name" ;;
esac > "$output"
SCRIPT
chmod +x "$fw/bin/curl"
fw_digest() { printf '%s' "$1" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1; }
fw_whence=$(printf 'Driver: x\nFile: a/one.bin\nLink: a/two.bin -> b/src.bin\nLicence: see LICENCE.x\n----------\nDriver: y\nFile: other.bin\n----------\n' |
        { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1)
sed "s/^whence_digest=.*/whence_digest=$fw_whence/" kernel/firmware/apply > "$fw/apply"
{
        printf '#> firmware a/one.bin %s\n' "$(fw_digest blob:a/one.bin)"
        printf '#> firmware a/two.bin %s b/src.bin\n' "$(fw_digest blob:b/src.bin)"
        printf '#> firmware_licence LICENCE.x %s\n' "$(fw_digest blob:LICENSES/LICENCE.x)"
} > "$fw/tree/artifacts/.config"
(cd "$fw/tree" && PATH="$fw/bin:$PATH" sh ../apply > ../log 2>&1)
fw_status=$?
fw_one=$(zstd -dc "$fw/tree/fs/lib/firmware/a/one.bin.zst" 2>/dev/null)
fw_two=$(zstd -dc "$fw/tree/fs/lib/firmware/a/two.bin.zst" 2>/dev/null)
fw_licence=$(cat "$fw/tree/fs/lib/firmware/LICENSES/LICENCE.x" 2>/dev/null)
fw_sections=$(grep -c '^Driver:' "$fw/tree/fs/lib/firmware/WHENCE" 2>/dev/null)
fw_stale=$(ls "$fw/tree/fs/lib/firmware" | grep -c stale)
same 'firmware lands as zstd with its licence and WHENCE' \
        '0:blob:a/one.bin:blob:b/src.bin:blob:LICENSES/LICENCE.x:1:0' \
        "$fw_status:$fw_one:$fw_two:$fw_licence:$fw_sections:$fw_stale"

rm -rf "$fw/tree/artifacts/firmware"
sed 's/^\(#> firmware a\/one.bin \).*/\1'"$(fw_digest other)"'/' \
        "$fw/tree/artifacts/.config" > "$fw/config" &&
        mv "$fw/config" "$fw/tree/artifacts/.config"
(cd "$fw/tree" && PATH="$fw/bin:$PATH" sh ../apply > ../log-bad 2>&1)
fw_bad=$?
fw_bad_cached=$(find "$fw/tree/artifacts/firmware" -name 'one.bin*' | wc -l | tr -d ' ')
fw_bad_said=$(grep -c 'the profile pins' "$fw/log-bad")
same 'a firmware digest that differs stops the build' '1:0:1' \
        "$fw_bad:$fw_bad_cached:$fw_bad_said"

: > "$fw/tree/artifacts/.config"
(cd "$fw/tree" && PATH="$fw/bin:$PATH" sh ../apply > ../log-none 2>&1)
fw_none=$?
[ -e "$fw/tree/fs/lib/firmware" ] && fw_left=left || fw_left=gone
same 'a build with no firmware line clears the last one' '0:gone' \
        "$fw_none:$fw_left"

#       The profiles' own lines: a pinned commit, and each line a plain path
#       with a 64-digit digest, in a profile that also turns on the zstd
#       reader its .zst files need. The Deck LCD's two rtw88 files, without
#       either of which an 8822C will not power on, are named.
fw_commit=$(sed -n 's/^commit=//p' kernel/firmware/apply | grep -E -c '^[0-9a-f]{40}$')
fw_lines=$(grep -h '^#> firmware' kernel/profile/* | wc -l | tr -d ' ')
fw_good=$(grep -h '^#> firmware' kernel/profile/* |
        grep -E -c '^#> firmware(_licence)? [A-Za-z0-9._/+-]+ [0-9a-f]{64}( [A-Za-z0-9._/+-]+)?$')
fw_zstd=0
for profile in $(grep -l '^#> firmware ' kernel/profile/*); do
        grep -q '^CONFIG_FW_LOADER_COMPRESS_ZSTD=y' "$profile" || fw_zstd=$((fw_zstd + 1))
done
fw_deck=$(grep -c '^#> firmware rtw88/rtw8822c_\(wow_\)\{0,1\}fw.bin ' kernel/profile/wifi)
same 'firmware lines are pinned and whole' "1:$fw_lines:0:2" \
        "$fw_commit:$fw_good:$fw_zstd:$fw_deck"

#       The machine process owns its attach from the moment it has it, not
#       from the moment it is told to stop. Its own moonwater_poweroff runs
#       poweroff, a builtin, so the stop happens inside the event and goes
#       through host_machine_stop: claimed any later and that call asks the
#       kernel to end the attach this process is holding and then polls ten
#       seconds for a detach only it could perform, which is a power button
#       that looks dead for ten seconds.
machine_claims=$(grep -c 'host_machine_self = true;' src/moonwater/moonwater.c)
machine_claim_line=$(grep -n 'host_machine_self = true;' src/moonwater/moonwater.c |
        head -1 | cut -d: -f1)
machine_wait_line=$(grep -n 'host_machine_wait_verdict(verdict' src/moonwater/moonwater.c |
        head -1 | cut -d: -f1)
if [ -n "$machine_claim_line" ] && [ -n "$machine_wait_line" ] &&
        [ "$machine_claim_line" -lt "$machine_wait_line" ]; then
        machine_claim_first=yes
else
        machine_claim_first=no
fi
same 'the machine process claims its attach before anything can stop it' \
        '1:yes' "$machine_claims:$machine_claim_first"

#       init retires the machine for the rest of the boot on 0 and on 1,
#       because those are the two ways it is finished on purpose: 0 is the
#       queue told to end, 1 is a stop event already handed to shell_stop.
#       host_fail answers 1, so a failure that returns it directly turns a
#       /dev/spark that is not there yet, or an attach the last machine
#       process has not let go of, into a boot where moonwater_init never
#       runs -- and host_events_boot skips the settings init list whenever
#       the overlay names that hook, so on a machine whose script defines
#       moonwater_init nothing runs at boot at all. Not being root keeps
#       host_refuse's 1, which every other refusal in the command answers.
machine_run_body=$(awk '/^static b32 host_machine_run\(void\)$/,/^}$/' \
        src/moonwater/moonwater.c)
machine_run_fails=$(printf '%s\n' "$machine_run_body" |
        grep -c 'return host_fail(')
machine_run_failed=$(printf '%s\n' "$machine_run_body" |
        grep -c 'return HOST_MACHINE_FAILED;')
same 'a machine that could not start is not a machine init has retired' \
        '0:3' "$machine_run_fails:$machine_run_failed"

#       An edited script has to reach the process that runs it.
#
#       host_machine_refresh re-asked the kernel for the overlay on every
#       event but nothing ever re-sourced, so once anything published an
#       edited /root/main.moonwater.sh -- moonwater status does, on its way
#       to printing the script's own lines -- the kernel routed by the new
#       text while the process still held the old functions. bind_queue does
#       not also run the image line for a row the script owns, so the event
#       ran nowhere at all. The loop has to notice and re-source, and it has
#       to do it before the event is named, because naming it is what decides
#       whether the script owns it.
machine_run_body=$(awk '/^static b32 host_machine_run\(void\)$/,/^}$/' \
        src/moonwater/moonwater.c)
machine_reload_line=$(printf '%s\n' "$machine_run_body" |
        grep -n 'host_machine_reload(slot);' | head -1 | cut -d: -f1)
machine_named_line=$(printf '%s\n' "$machine_run_body" |
        grep -n 'pair = moonwater_paired(control.event);' | head -1 | cut -d: -f1)
machine_stale=$(printf '%s\n' "$machine_run_body" | grep -c 'host_machine_refresh')
if [ -n "$machine_reload_line" ] && [ -n "$machine_named_line" ] &&
        [ "$machine_reload_line" -lt "$machine_named_line" ]; then
        machine_reload_first=yes
else
        machine_reload_first=no
fi
same 'an edited script is taken up before the event it changed is named' \
        'yes:0' "$machine_reload_first:$machine_stale"

#       Re-sourcing has to be allowed to replace the bodies it locked. The
#       lock is what stops anything the script starts from redefining the
#       machine's bindings, and a definition that reaches a locked slot is
#       refused and the source carries on past it -- so a reload that kept
#       the lock would take the new file and keep every old function.
machine_reload_body=$(awk '/^static fn host_machine_reload\(positive address_to slot\)$/,/^}$/' \
        src/moonwater/moonwater.c)
machine_gives=$(printf '%s\n' "$machine_reload_body" |
        grep -n 'host_machine_hold(slot, false);' | head -1 | cut -d: -f1)
machine_sources=$(printf '%s\n' "$machine_reload_body" |
        grep -n 'host_machine_source()' | head -1 | cut -d: -f1)
machine_takes=$(printf '%s\n' "$machine_reload_body" |
        grep -n 'host_machine_hold(slot, true);' | head -1 | cut -d: -f1)
if [ -n "$machine_gives" ] && [ -n "$machine_sources" ] && [ -n "$machine_takes" ] &&
        [ "$machine_gives" -lt "$machine_sources" ] &&
        [ "$machine_sources" -lt "$machine_takes" ]; then
        machine_reload_holds=yes
else
        machine_reload_holds=no
fi
#       And what was sourced is recorded where the sourcing happens, because
#       that is the only thing the next event can compare the kernel against.
machine_sourced=$(grep -c 'host_machine_sourced_overlay = host_machine.overlay;' \
        src/moonwater/moonwater.c)
same 'a reload gives the lock back, re-sources, and takes it again' \
        'yes:1' "$machine_reload_holds:$machine_sourced"

#       An owned event this process cannot run is a key that does nothing:
#       the kernel handed the press to the machine instead of the bound image
#       line precisely because the script owns that row, so there is no
#       second copy behind the call. It should be unreachable now, which is
#       the reason to say it out loud rather than return into silence.
machine_emit_body=$(awk '/^static fn host_machine_emit\(positive event_slot, unsigned int event,$/,/^}$/' \
        src/moonwater/moonwater.c)
#       The recover call below is not one of these: recover is not a bind
#       row, nothing was routed away from an image line for it, and a script
#       with no recover handler is the ordinary case.
machine_missed=$(printf '%s\n' "$machine_emit_body" | grep -c 'host_machine_missed(name);')
machine_plain=$(printf '%s\n' "$machine_emit_body" |
        grep -c 'else if (!host_machine_try(name, name, extra))')
same 'an owned event with no function to run says so' '2:1' \
        "$machine_missed:$machine_plain"

#       A machine that named its own failure has not settled. Running for a
#       while is what tells a transient apart -- a death by signal, a /shell
#       that could not exec -- and the verdict wait alone puts fifteen
#       seconds in front of the two ways a failure happens late, so letting
#       that clear the count is a script nobody can source restarting for the
#       rest of the boot.
init_settle=$(grep -c 'if (code != HOST_MACHINE_FAILED &&' src/sh/system.c)
init_retires=$(grep -c 'if (code == 0 || code == 1)' src/sh/system.c)
same 'a named machine failure never clears the retirement count' '1:1' \
        "$init_settle:$init_retires"

hook_return=$(grep -c 'return build_run("sh", "-c", value, null);' \
        src/build/build.c)
hook_gates=$(grep -E -c '(if \(|return_if\()build_shell_key\("(pre|post)"\)' \
        src/build/build.c)
same 'build hooks gate success' '1:2' "$hook_return:$hook_gates"

#       memory() is the mmap itself and answers a refusal with -errno in the
#       pointer, never with null, so a caller that tests only for null keeps
#       an address just below the top of the space and writes through it.
#       Seven call sites did exactly that. memory_checked in src/lib.util.c
#       is now the one place that spells the pair, and nothing else may call
#       memory directly -- a new call site here is the bug coming back.
#       A cast in front hides the call from '= memory(' alone, and nineteen
#       were written that way; utility_arena_take is the one left, because
#       the lscpu harness lifts it into a prelude without memory_checked.
memory_raw=$(grep -rnE '(= |\))memory\(' --include='*.c' src \
        | grep -v '^src/lib\.util\.c:' \
        | grep -cv '(positive)memory(UTILITY_ARENA_BYTES)' || true)
same 'every mapping is taken through memory_checked' '0' "$memory_raw"

group config
common_path=$(pwd)/src/build/host.sh
mkdir -p "$work/config/artifacts"
for config_shell in bash dash; do
        command -v "$config_shell" >/dev/null 2>&1 || continue
        got=$(cd "$work/config" && "$config_shell" -c '. "$1"; key_one absent' \
                config "$common_path" 2>"$work/config-errors")
        same "missing scalar $config_shell" "" "$got"
        same "missing scalar stderr $config_shell" "" "$(cat "$work/config-errors")"
done
printf '#> arch x86_64\n#> flags -a\n#> flags -b\n' > "$work/config/artifacts/.config"
for config_shell in bash dash; do
        command -v "$config_shell" >/dev/null 2>&1 || continue
        got=$(cd "$work/config" && "$config_shell" -c '. "$1"; key_one absent; key_one arch' \
                config "$common_path" 2>"$work/config-errors")
        same "scalar and absent key $config_shell" "
x86_64" "$got"
        same "absent key stderr $config_shell" "" "$(cat "$work/config-errors")"
        if (cd "$work/config" && "$config_shell" -c '. "$1"; key_one flags' \
                config "$common_path" > /dev/null 2>&1); then
                lost "duplicate scalar $config_shell" "accepted two values"
        else
                won
        fi
done

# Test the benchmark driver's argv contract without a cross compiler or a
# heavyweight benchmark. Native/taskset and emulated paths see the same words.
group benchmark
mkdir -p "$work/bench-bin"
cat > "$work/bench-program" <<'SCRIPT'
#!/bin/sh
printf 'BENCH_ARGS:%s' "$#"
for word in "$@"; do printf '<%s>' "$word"; done
printf '\n'
SCRIPT
cat > "$work/bench-bin/compiler" <<'SCRIPT'
#!/bin/sh
output=
while [ "$#" -gt 0 ]; do
        if [ "$1" = -o ]; then output=$2; shift 2; else shift; fi
done
[ -n "$output" ] || exit 1
cp "$MOONWATER_TEST_BENCH_PROGRAM" "$output" || exit 1
chmod +x "$output"
SCRIPT
cat > "$work/bench-bin/runner" <<'SCRIPT'
#!/bin/sh
case $0 in */taskset) shift 2 ;; esac
exec "$@"
SCRIPT
chmod +x "$work/bench-bin/compiler" "$work/bench-bin/runner"
for name in gcc x86_64-linux-gnu-gcc aarch64-linux-gnu-gcc riscv64-linux-gnu-gcc; do
        ln -s compiler "$work/bench-bin/$name"
done
for name in taskset qemu-x86_64 qemu-aarch64 qemu-riscv64; do
        ln -s runner "$work/bench-bin/$name"
done
PATH="$work/bench-bin:$PATH" CC="$work/bench-bin/gcc" \
        MOONWATER_TEST_BENCH_PROGRAM="$work/bench-program" \
        sh test/run bench reserve -- 128 'two words' > "$work/bench-log" 2>&1
bench_status=$?
bench_arguments=$(grep -c -x -F 'BENCH_ARGS:2<128><two words>' "$work/bench-log")
same 'arguments preserved on all targets' '0:3' "$bench_status:$bench_arguments"

# No lane builds a benchmark, so a section can stop compiling, or stop being
# reachable by name, and nothing says so: compression-floor stopped building
# when memory_copy_apart's source became const, and delete had a section and
# a line and was refused as "no benchmark called delete". Every name's
# section is compiled here as the bench would, and every section in
# checks.c has to be some name's. hardware_floor and libc_audit are hosted
# builds with recipes of their own at the top of their sections, and the six
# the image runs (the note above BENCH_exec) are compiled here as well.
if [ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ]; then
        bench_image="exec network_spawn one shell_document startup_empty tiny"
        bench_sections=" hardware_floor libc_audit $bench_image "
        bench_broken=""
        for name in $benchmarks $bench_image; do
                bench_about "$name"
                case " $bench_image " in *" $name "*) bench_section=BENCH_$name ;; esac
                [ -n "$bench_section" ] || continue
                bench_sections="$bench_sections${bench_section#BENCH_} "
                (${CC:-cc} -march=x86-64 -O2 -fsyntax-only -nostdlib -fno-stack-protector \
                        -fno-builtin "-D$bench_section" test/checks.c \
                        > "$work/bench-compile.$name" 2>&1
                 echo "$?" > "$work/bench-compiled.$name") &
        done
        wait
        for name in $benchmarks $bench_image; do
                [ ! -e "$work/bench-compiled.$name" ] ||
                        [ "$(cat "$work/bench-compiled.$name")" = 0 ] ||
                        bench_broken="$bench_broken $name"
        done
        same 'every benchmark compiles' '' "$bench_broken"
        bench_orphans=""
        for section in $(grep -o 'BENCH_[a-z][a-z0-9_]*' test/checks.c | sort -u); do
                case $bench_sections in
                *" ${section#BENCH_} "*) ;;
                *) bench_orphans="$bench_orphans $section" ;;
                esac
        done
        same 'every benchmark section has a name' '' "$bench_orphans"
fi

group build

if command -v python3 > /dev/null 2>&1; then
        if python3 test/differential.py --harness build_tools > "$work/build-tools.out" 2>&1; then
                won
        else
                lost 'arguments, watch and essential options' "$(tail -12 "$work/build-tools.out" | tr '\n' ' ')"
        fi
fi

group compact

if command -v python3 > /dev/null 2>&1; then
        mkdir -p "$work/inventory-tree/platform"
        cp src/lib.c "$work/inventory-tree/lib.c"
        cp src/platform/*.inc "$work/inventory-tree/platform/"
        python3 test/assembly/inventory.py "$work/inventory-tree/lib.c" \
                > /dev/null 2>&1

        if cmp -s src/lib.c "$work/inventory-tree/lib.c"; then
                won
        else
                lost 'inventory current' 'src/lib.c differs from its generator'
        fi

        if python3 test/assembly/inventory.py --check --target all src/lib.c \
                > /dev/null 2> "$work/inventory-all.err"; then
                won
        else
                lost 'all-platform asm' "$(tail -8 "$work/inventory-all.err" | tr '\n' ' ')"
        fi

        if python3 test/differential.py --harness inventory > "$work/inventory-test.out" 2>&1; then
                won
        else
                lost 'inventory audit' "$(tail -8 "$work/inventory-test.out" | tr '\n' ' ')"
        fi

        if python3 test/performance_coverage.py > "$work/performance.out" 2>&1; then
                won
        else
                lost 'performance map' "$(tail -8 "$work/performance.out" | tr '\n' ' ')"
        fi

        if python3 test/specialization_coverage.py > "$work/specialization.out" 2>&1; then
                won
        else
                lost 'specialization map' "$(tail -8 "$work/specialization.out" | tr '\n' ' ')"
        fi
else
        printf '  %-10s %s\n' compact 'no python3, skipped'
fi

counted
)

#
#       Wifi, where QEMU has no wireless card to give a machine.
#
#           MOONWATER_IMAGE=dist/bootx64.efi sh test/run wifi
#
#       with an image built with kernel/profile/hwsim added to the usual
#       profiles. The machine boots with no radios and no wired network;
#       the script differential.py --harness wifi_air writes makes them
#       with hwsim_radio (test/checks.c, CHECK_hwsim_radio, static) and
#       runs access points on them with this machine's own wpa_supplicant,
#       carried in on a stick with every library it loads and the loader
#       that loads them. moonwater then joins, lists and explains from a
#       radio of its own. Not in a plain run: only named, and only here,
#       with an x86_64 image, a wpa_supplicant and a C compiler.
#
#       A hostapd built with CONFIG_TESTING_OPTIONS (MOONWATER_HOSTAPD, or
#       one on PATH that has them) adds the rekey family: rekeys started
#       from its control socket. Without one that family is not run, and
#       says so -- and the lane is then blind to the rekeys a network makes
#       forty minutes in. Distribution packages leave the option out; one
#       builds in a minute (hostapd_cli beside it is copied too):
#
#           curl -LO https://w1.fi/releases/hostapd-2.11.tar.gz
#           tar xzf hostapd-2.11.tar.gz && cd hostapd-2.11/hostapd
#           cp defconfig .config
#           printf 'CONFIG_LIBNL32=y\nCONFIG_TESTING_OPTIONS=y\nCONFIG_DEBUG_FILE=y\n' >> .config
#           make -j8    # then MOONWATER_HOSTAPD=$PWD/hostapd
#
#       MOONWATER_WIFI_TRANSCRIPT keeps the guest's transcript.
#
lane_wifi()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}
supplicant=$(command -v wpa_supplicant 2>/dev/null)
hostapd=${MOONWATER_HOSTAPD:-$(command -v hostapd 2>/dev/null)}

for need in qemu-system-x86_64 timeout cc ldd; do
        if ! command -v "$need" > /dev/null 2>&1; then
                echo "  wifi         NOT RUN -- no $need"
                exit 2
        fi
done
if [ -z "$supplicant" ]; then
        echo "  wifi         NOT RUN -- no wpa_supplicant to be the access points"
        exit 2
fi
if [ ! -f "$image" ]; then
        echo "  wifi         NOT RUN -- no image at $image"
        exit 2
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
counting wifi 10 24

mkdir -p "$work/stick/lib"
if ! cc -static -O2 -DCHECK_hwsim_radio -o "$work/stick/hwsim_radio" test/checks.c \
        > "$work/cc.log" 2>&1; then
        lost 'hwsim_radio' "$(tail -3 "$work/cc.log" | tr '\n' ' ')"
        counted
        exit 1
fi
cp -L "$supplicant" "$work/stick/wpa_supplicant"
set -- "$supplicant"
if [ -n "$hostapd" ] && [ -x "$hostapd" ] && [ -x "${hostapd%/*}/hostapd_cli" ] &&
        grep -a -q 'REKEY_PTK ' "$hostapd"; then
        cp -L "$hostapd" "$work/stick/hostapd"
        cp -L "${hostapd%/*}/hostapd_cli" "$work/stick/hostapd_cli"
        set -- "$@" "$hostapd" "${hostapd%/*}/hostapd_cli"
else
        echo "  wifi       rekey          NOT RUN -- no hostapd with CONFIG_TESTING_OPTIONS (MOONWATER_HOSTAPD)"
fi
for program in "$@"; do
        ldd "$program" | awk '$2 == "=>" && $3 ~ /^\// { print $3 } $1 ~ /^\/.*ld-linux/ { print $1 }'
done | sort -u | while read -r library; do
        cp -L "$library" "$work/stick/lib/"
done
[ -f "$work/stick/lib/ld-linux-x86-64.so.2" ] ||
        lost 'the loader' "ldd named no ld-linux-x86-64.so.2 for $supplicant"

set --
[ -f "$work/stick/hostapd" ] && set -- --hostapd
if ! python3 test/differential.py --harness wifi_air --seed "${MOONWATER_GUEST_SEED:-1}" "$@" \
        > "$work/script" 2> "$work/script.err"; then
        lost 'wifi scenarios' "the generator failed: $(tail -1 "$work/script.err")"
        counted
        exit 1
fi
{
        echo
        echo 'echo started'
        echo "cat > /tmp/wifi.sh <<'WIFI'"
        grep -v '^#expect ' "$work/script"
        echo 'WIFI'
        echo 'sh /tmp/wifi.sh < /dev/null'
        echo 'poweroff'
} > "$work/commands"

set -- -cpu Nehalem
[ -w /dev/kvm ] && set -- -enable-kvm -cpu host
#       The commands go in once the guest has had time to start its shell:
#       what the console gets before it reads is cut at the terminal's
#       4 KiB, and on a loaded host the script's first lines went with it.
{ sleep 25; cat "$work/commands"; } |
timeout 5400 qemu-system-x86_64 -m 1G -smp 2 "$@" -kernel "$image" \
        -no-reboot -display none -vga none -serial stdio -nic none \
        -device qemu-xhci \
        -drive "if=none,id=stick,format=raw,file=fat:ro:$work/stick,readonly=on" \
        -device usb-storage,drive=stick,removable=on \
        -append "console=ttyS0 drm_client_lib.active= mac80211_hwsim.radios=0" \
        > "$work/transcript" 2>&1 || true
[ -n "${MOONWATER_WIFI_TRANSCRIPT:-}" ] && cp "$work/transcript" "$MOONWATER_WIFI_TRANSCRIPT"

says transcript 'simulated radios (an image with the hwsim profile)' 'no-mswh'
tr -d '\r' < "$work/transcript" | grep -a '^wifi-time ' | sed 's/^/    /'
while read -r mark family total; do
        [ "$mark" = "#expect" ] || continue
        says transcript "wifi: $family" \
                "$(printf 'scen-%s-%s-of-%s' "$family" "$total" "$total" | rev)"
done < "$work/script"
tr -d '\r' < "$work/transcript" | grep -a '^scenario-miss ' | head -20 | sed 's/^/    /'
never transcript 'kernel warned'      'cut here'
never transcript 'no kernel panic'    'Kernel panic'

counted
)

#
#       Ring 0, against a program that means it harm.
#
#           MOONWATER_IMAGE=dist/bootx64.efi sh test/run ring0
#
#       Every path into the kernel module that a local user has is /dev/spark,
#       which is mode 0666, and the shared page of a window, which the
#       program that made it writes as it pleases while the compositor reads
#       it. ring0_hostile (test/checks.c, CHECK_ring0_hostile, static) is that
#       program: it makes windows and writes every field and cell of them from
#       many threads, sends every request number with shaped and random
#       arguments, executes spark images with hostile headers, and, as root,
#       turns the compositor off and on under live windows and writes escape
#       sequences into the kernel log the terminal reads. The machine boots
#       with it on a stick and runs each mode for MOONWATER_RING0_SECONDS
#       (20), one after the other; the lane passes when every mode ended and
#       the kernel said nothing about it.
#
#       What the kernel can say depends on how it was built, and the lane
#       cannot tell you which you had. On a plain image it catches a panic, a
#       BUG, an oops and a warning; on one built with kernel/profile/sec_sanitize
#
#           sh build.sh arch/x64 debug_none limbo desktop wifi sec_default serial sec_sanitize
#
#       it catches what KASAN, UBSAN, lockdep, the atomic-sleep check and the
#       hung-task detector see, which is the point (and 30 times slower).
#       With kernel/profile/sec_kcsan instead, a data race reported in the
#       module's own functions fails it; races in the rest of the kernel,
#       which there are, are not this lane's to judge.
#
#       MOONWATER_RING0_FAIL=N, on an image with either profile, makes N
#       percent of the allocations the program's tasks cause in the kernel
#       fail (failslab and fail_page_alloc, per task), which runs the error
#       paths nothing else does. The program then may take a SIGBUS in its own
#       window the kernel could not back, or be aborted by glibc when a
#       munmap is refused, and is not held to ending clean; the machine is.
#       MOONWATER_GUEST_SEED and MOONWATER_RING0_TRANSCRIPT are as for wifi.
#
lane_ring0()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}
seconds=${MOONWATER_RING0_SECONDS:-20}
seed=${MOONWATER_GUEST_SEED:-1}
injecting=${MOONWATER_RING0_FAIL:-}

for need in qemu-system-x86_64 timeout cc; do
        if ! command -v "$need" > /dev/null 2>&1; then
                echo "  ring0        NOT RUN -- no $need"
                exit 2
        fi
done
if [ ! -f "$image" ]; then
        echo "  ring0        NOT RUN -- no image at $image"
        exit 2
fi
case $seconds$seed$injecting in
*[!0-9]*) echo "  ring0        NOT RUN -- the seconds, seed and failure rate are counts"; exit 2 ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
counting ring0 8 32

mkdir -p "$work/stick"
if ! cc -static -O2 -pthread -DCHECK_ring0_hostile -o "$work/stick/ring0_hostile" test/checks.c \
        > "$work/cc.log" 2>&1; then
        lost 'ring0_hostile' "$(tail -3 "$work/cc.log" | tr '\n' ' ')"
        counted
        exit 1
fi

#       The script rides the stick, so nothing in it is echoed back by the
#       console as if the machine had said it.
{
        echo 'cp /mnt/stick/ring0_hostile /tmp/ring0_hostile'
        echo 'chmod 755 /tmp/ring0_hostile'
        echo 'echo ring0-start'
        if [ -n "$injecting" ] && [ "$injecting" != 0 ]; then
                echo 'mount -t debugfs none /sys/kernel/debug'
                echo 'for f in failslab fail_page_alloc; do'
                echo '  echo N > /sys/kernel/debug/$f/ignore-gfp-wait'
                echo '  echo Y > /sys/kernel/debug/$f/task-filter'
                echo '  echo 0 > /sys/kernel/debug/$f/verbose'
                echo '  echo 1 > /sys/kernel/debug/$f/interval'
                echo '  echo -1 > /sys/kernel/debug/$f/times'
                echo 'done'
                echo "echo $injecting > /sys/kernel/debug/failslab/probability"
                echo "export FAILPCT=$injecting"
                echo 'echo ring0-injecting'
        fi
        for mode in "win 65534" "ioctl 65534" "exec 65534" "admin 0" "kmsg 0"; do
                set -- $mode
                echo "/tmp/ring0_hostile $1 $seed $seconds $2 > /tmp/ring0.$1 2>&1 < /dev/null"
                echo "echo ring0-ended $1 \$?"
        done
        echo 'cat /tmp/ring0.win /tmp/ring0.ioctl /tmp/ring0.exec /tmp/ring0.admin /tmp/ring0.kmsg'
        echo 'dmesg'
        echo 'echo ring0-finished'
        # the console is slow behind the log flood; poweroff must not cut it
        echo 'sleep 5'
} > "$work/stick/ring0.sh"
{
        echo "the console eats the front of the first line"
        echo 'for i in $(seq 80); do [ -b /dev/sda1 ] && break; sleep 0.25; done'
        echo 'mkdir -p /mnt/stick && mount -r -t vfat /dev/sda1 /mnt/stick'
        echo 'sh /mnt/stick/ring0.sh'
        echo 'poweroff'
} > "$work/commands"

set -- -cpu Nehalem
[ -w /dev/kvm ] && set -- -enable-kvm -cpu host
timeout $((seconds * 30 + 900)) qemu-system-x86_64 -m 3G -smp 4 "$@" -kernel "$image" \
        -no-reboot -display none -device VGA,xres=1600,yres=1200 -serial stdio -nic none \
        -device qemu-xhci \
        -drive "if=none,id=stick,format=raw,file=fat:ro:$work/stick,readonly=on" \
        -device usb-storage,drive=stick,removable=on \
        -append "console=ttyS0 drm_client_lib.active= mac80211_hwsim.radios=0 panic=-1" \
        < "$work/commands" > "$work/transcript" 2>&1 || true
[ -n "${MOONWATER_RING0_TRANSCRIPT:-}" ] && cp "$work/transcript" "$MOONWATER_RING0_TRANSCRIPT"

#       Colour codes and carriage returns out, so a line is what was said.
tr -d '\r' < "$work/transcript" | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' > "$work/said"
mv "$work/said" "$work/transcript"

says transcript 'the program started' 'ring0-start'
#       Under injected failures the program may not get to its end and say
#       so: glibc aborts when the kernel refuses a munmap, and a thread that
#       could not be made is not joined. That it was over, and the machine
#       with it, is what is asked then.
for mode in win ioctl exec admin kmsg; do
        if [ -n "$injecting" ] && [ "$injecting" != 0 ]; then
                says transcript "$mode ended" "ring0-ended $mode "
        else
                says transcript "$mode ran to its end" "FUZZ-DONE $mode "
        fi
done
says transcript 'the machine came back' 'ring0-finished'
[ -n "$injecting" ] && [ "$injecting" != 0 ] && says transcript 'allocations were failing' 'ring0-injecting'

#       Said by the kernel, by the sanitizers it may have been built with,
#       and by the program about itself. A program that dies of its own
#       fault outside an operation says FATAL-MAIN; under injected failures a
#       page the kernel could not back is a SIGBUS it may take, and the
#       warnings the display drivers give for a failed allocation of their own
#       are theirs, so those two are not held then.
for said in 'BUG: KASAN' 'UBSAN:' 'kernel BUG at' 'Oops:' 'general protection fault' \
            'blocked for more than' 'Kernel panic' 'SNAPSHOT-BAD' 'sleeping function called'; do
        never transcript "the kernel said nothing: $said" "$said"
done
if [ -z "$injecting" ] || [ "$injecting" = 0 ]; then
        for said in 'cut here' 'WARNING: possible' 'WARNING: suspicious' \
                    'held when returning to user space' 'FATAL-MAIN'; do
                never transcript "the kernel said nothing: $said" "$said"
        done
fi
#       A race the detector reports between two accesses of the module's own
#       is a bug in it; the rest of the kernel has plenty and is not judged.
if grep -a -E 'BUG: KCSAN: .*(canvas_|pane_|spark_|moonwater_|floodlight_|compose_|desktop_|device_ioctl|do_spawn|execute_spark|report_snapshot|report_machine|report_bind|settings_get|settings_set)' \
        "$work/transcript" > "$work/races"; then
        lost 'no data race in the module' "$(head -3 "$work/races" | tr '\n' ' ')"
else
        won
fi

counted
)

#
#       The whole thing, started.
#
#           sh test/run boot          (MOONWATER_IMAGE names the image)
#
#       Everything else here tests a piece on the machine the tests run on.
#       This boots the image under qemu, lets the kernel exec /init -- which
#       is the shell, in the spark format, loaded by the loader in the kernel
#       and by nothing else -- and asks it questions down the serial line.
#
#       The answers are checked as transformed strings rather than as the
#       words that were typed, because the console echoes everything sent to
#       it: grepping the transcript for "hello" after sending "echo hello"
#       finds the echo whether or not a shell ever ran. Sending it through rev
#       or through arithmetic means the answer cannot be in the question.
#
#       The first line is thrown away on purpose. Piping into the serial
#       console loses the first few bytes of the first line, every time.
#
lane_boot()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}

#
#       The image says which machine. bootaa64.efi is arch/arm's, booted on
#       QEMU's virt machine with its console on the PL011, virtio-gpu for the
#       display and a virtio NIC and generator, since virt has no default
#       display and no NIC to fall back on; natively accelerated when this is
#       an arm64 machine, emulated otherwise:
#
#           MOONWATER_IMAGE=dist/bootaa64.efi sh test/run boot
#
#       bootriscv64.efi is arch/riscv's, on the same virt board with its
#       console on the 16550 and the same devices, and emulated everywhere:
#       rv64 is QEMU's model of the rv64gc floor the profile builds for.
#
case "$image" in
*riscv64.efi)
        boot_emulator=qemu-system-riscv64
        boot_console=ttyS0
        set -- -machine virt -cpu rv64 \
                -device virtio-gpu-pci,xres=1600,yres=1200 \
                -netdev user,id=net0 -device virtio-net-pci,netdev=net0 \
                -device virtio-rng-pci
        ;;
*aa64.efi)
        boot_emulator=qemu-system-aarch64
        boot_console=ttyAMA0
        # pauth-impdef: emulating the architected QARMA pointer
        # authentication makes an emulated boot several times slower, and
        # past the timeout below before the checks with waits in them end.
        set -- -machine virt,gic-version=3 -cpu max,pauth-impdef=on \
                -device virtio-gpu-pci,xres=1600,yres=1200 \
                -netdev user,id=net0 -device virtio-net-pci,netdev=net0 \
                -device virtio-rng-pci
        case "$(uname -s):$(uname -m)" in
        Darwin:arm64) set -- "$@" -accel hvf -cpu host ;;
        Linux:aarch64) [ -w /dev/kvm ] && set -- "$@" -accel kvm -cpu host ;;
        esac
        ;;
*)
        boot_emulator=qemu-system-x86_64
        boot_console=ttyS0
        set -- -cpu Nehalem -vga none -device VGA,xres=1600,yres=1200
        ;;
esac

if ! command -v "$boot_emulator" > /dev/null 2>&1; then
        echo "  boot         NOT RUN -- no $boot_emulator"
        exit 2
fi

#
#       Same reason the missing image is loud.
#
#       The boot below is wrapped in timeout, which a Mac does not have. When
#       it is missing the whole pipeline fails before qemu is reached, the
#       transcript is written empty, and every check below says the thing it
#       wanted is not in it -- eleven failures naming eleven features, none of
#       which was ever asked a question. That is worse than not running: it
#       points at the kernel for the absence of a shell utility.
#
if ! command -v timeout > /dev/null 2>&1; then
        echo "  boot         NOT RUN -- no timeout here"
        echo "               the boot is wrapped in it, and without it the"
        echo "               transcript comes out empty and every check below"
        echo "               fails naming a feature it never got to ask about."
        echo "               Run this where there is one: sh test/onbox"
        exit 2
fi

if [ ! -f "$image" ]; then
        #
        #       Loud, and not zero.
        #
        #       This lane is the only one that runs on a processor without
        #       AVX, so it is the only one that can see an instruction the
        #       target cannot execute. It said "skipped" on every run for a
        #       day while exactly that bug went in, and the suite still
        #       printed that everything agreed, because a skip exited zero.
        #
        echo "  boot         NOT RUN -- no image at $image"
        echo "               this is the only lane that runs without AVX, so"
        echo "               nothing else here can see an instruction the"
        echo "               target cannot execute. Build one: sh build.sh"
        exit 2
fi

