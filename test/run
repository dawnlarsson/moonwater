#
#       And the other end of the same argument.
#
#       Everything above runs on a Nehalem, which is the floor: it catches an
#       instruction the target cannot execute. It cannot catch the opposite,
#       an instruction the target executes perfectly well and something
#       underneath it cannot -- and that is a real failure mode, not a
#       hypothetical one.
#
#       A displaced memcpy with an AVX-512 body booted here and died on a host
#       that has AVX-512, in the fbdev path, on
#       vmovdqu64 -256(%r11), %zmm4. Plain memcpy gets called on ioremap'd
#       memory; a device mapping is trapped and emulated; KVM's emulator has
#       no EVEX. Nehalem never reaches that instruction because it never takes
#       that path, so this file said seventeen of seventeen while the kernel
#       did not boot on the machine it was built on.
#
#       So: once more on the widest processor there is, with KVM, which is
#       what puts a real emulator behind the device mapping. Skipped rather
#       than failed where there is no KVM -- a Mac has none -- because the
#       floor pass above is the one that must always run.
#
#       Both this and the power button below are the x86 machine's.
#
#       riscv64's counterpart is QEMU's widest model, -cpu max: V, the vector
#       crypto and Zbc on, which the rv64 boot above never reaches, so every
#       extension path a Spark program or the kernel takes on a feature bit
#       runs here. A program's illegal instruction is init's restart line.
#       arm64's emulated boot above is already -cpu max.
#
if [ "$boot_emulator" = qemu-system-riscv64 ]; then
        { sleep 15; cat "$work/commands"; } |
                timeout 360 qemu-system-riscv64 -m 2G -smp 2 -machine virt -cpu max \
                -kernel "$image" -no-reboot -display none -serial stdio \
                -append "console=ttyS0 drm_client_lib.active=" \
                > "$work/transcript" 2>&1 || true

        says transcript 'init started on the widest'  'Run /init as init process'
        says transcript 'powered down on the widest'  'reboot: Power down'
        never transcript 'no illegal instruction'     'killed by signal 4'
        never transcript 'no oops there'              'Oops:'
        never transcript 'no panic there'             'Kernel panic'
elif [ "$boot_emulator" != qemu-system-x86_64 ]; then
        printf '  %-24s not an x86 image, the x86 host passes did not run\n' 'this host'
elif [ -r /dev/kvm ]; then
        timeout 180 qemu-system-x86_64 -m 2G -smp 2 -cpu host -enable-kvm \
                -kernel "$image" -no-reboot -display none -serial stdio \
                -append "console=ttyS0 drm_client_lib.active=" \
                < "$work/commands" > "$work/transcript" 2>&1 || true

        says transcript 'init started on this host'   'Run /init as init process'
        says transcript 'powered down on this host'   'reboot: Power down'
        never transcript 'nothing went unemulated'    'emulation failure'
        never transcript 'no invalid opcode here'     'invalid opcode'
        never transcript 'no protection fault here'   'general protection fault'
        never transcript 'no oops here'               'Oops:'
        never transcript 'no panic here'              'Kernel panic'
else
        printf '  %-24s no /dev/kvm, the widest pass did not run\n' 'this host'
fi

#
#       The power button, on a machine with no screen at all.
#
#       ACPI's button driver reports the button as KEY_POWER. Bind owns that
#       key, not the compositor, and this is where that is shown: no display
#       device, so Canvas gives up on a card and never takes input, and the
#       button still runs what it was told. QMP presses it. Every answer is
#       reversed or counted so the command echo on this console cannot pass
#       for one.
#
#       Each machine's own button: ACPI's on x86, the PL061 GPIO key QEMU's
#       arm64 virt board presses, and whatever riscv64's virt board has. The
#       helper is built by that machine's compiler, and an emulated machine
#       gets longer to reach a shell.
#
power_machine=""
power_button=yes
case "$boot_emulator" in
qemu-system-x86_64)
        [ -r /dev/kvm ] && power_machine="-cpu host -enable-kvm -vga none"
        power_console=ttyS0 power_cc=cc power_slow=1
        ;;
qemu-system-aarch64)
        power_machine="-machine virt,gic-version=3 -cpu max,pauth-impdef=on"
        case "$(uname -s):$(uname -m)" in
        Darwin:arm64) power_machine="-machine virt,gic-version=3 -accel hvf -cpu host" ;;
        Linux:aarch64) [ -w /dev/kvm ] && power_machine="-machine virt,gic-version=3 -enable-kvm -cpu host" ;;
        esac
        power_console=ttyAMA0 power_cc=aarch64-linux-gnu-gcc power_slow=4
        ;;
qemu-system-riscv64)
        power_machine="-machine virt -cpu rv64"
        power_console=ttyS0 power_cc=riscv64-linux-gnu-gcc power_slow=3
        #       QEMU's riscv64 virt board wires system_powerdown to nothing:
        #       no ACPI button and no GPIO key, so there is no button to
        #       press. The script and bind rules still run; the presses are
        #       said not to have.
        power_button=no
        ;;
esac
[ "$(uname -s):$(uname -m)" = Linux:aarch64 ] && [ "$boot_emulator" = qemu-system-aarch64 ] && power_cc=cc
#       A Mac has no Linux compiler for the helper, and x86 wants KVM.
[ "$(uname -s)" = Darwin ] && power_machine=""

if [ -n "$power_machine" ] && command -v python3 > /dev/null 2>&1; then
        coverage_guest "$image" "$work/coverage-power"
        qmp_guest_module "$work"
        PYTHONPATH=$work MOONWATER_POWER_COVERAGE=${coverage_serial#-serial file:} \
                MOONWATER_POWER_DUMP=$coverage_dump \
                MOONWATER_BOOT_WORK=$work MOONWATER_POWER_EMULATOR=$boot_emulator \
                MOONWATER_POWER_MACHINE=$power_machine MOONWATER_POWER_CONSOLE=$power_console \
                MOONWATER_POWER_CC=$power_cc MOONWATER_POWER_SLOW=$power_slow \
                MOONWATER_POWER_BUTTON=$power_button \
                python3 - "$image" > "$work/power-answers" 2> "$work/power-why" <<'PY'
import os, socket, subprocess, sys, time
from qmp_guest import Guest, qcmd

image = sys.argv[1]
work = os.environ["MOONWATER_BOOT_WORK"]
tty = os.environ["MOONWATER_POWER_CONSOLE"]
slow = int(os.environ["MOONWATER_POWER_SLOW"])
button = os.environ["MOONWATER_POWER_BUTTON"] == "yes"
qmp = work + "/power-qmp"
console = work + "/power-console"
out = []

#       Root holding CAP_SYS_BOOT and nothing else. The image's setpriv refuses
#       every capability change on purpose, so a helper that keeps that one
#       bit and runs the rest of its line rides in on a read-only stick.
stick = work + "/power-stick"
os.makedirs(stick, exist_ok=True)
open(work + "/capboot.c", "w").write(r'''
#include <linux/capability.h>
#include <sys/prctl.h>
#include <sys/syscall.h>
#include <unistd.h>

int main(int argc, char **argv)
{
        struct __user_cap_header_struct header = {_LINUX_CAPABILITY_VERSION_3, 0};
        struct __user_cap_data_struct data[2] = {{0}};

        for (int cap = 0; cap < 64; cap++)
                if (cap != CAP_SYS_BOOT)
                        prctl(PR_CAPBSET_DROP, cap, 0, 0, 0);

        data[0].effective = data[0].permitted = 1u << CAP_SYS_BOOT;
        if (argc < 2 || syscall(SYS_capset, &header, data))
                return 125;

        execvp(argv[1], argv + 1);
        return 127;
}
''')
try:
    capboot = subprocess.run([os.environ["MOONWATER_POWER_CC"], "-O2", "-static", "-o",
                              stick + "/capboot", work + "/capboot.c"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
except OSError:
    capboot = False

guest = Guest([
    os.environ["MOONWATER_POWER_EMULATOR"], "-m", "1G", "-smp", "2"] +
    os.environ["MOONWATER_POWER_MACHINE"].split() + [
    "-kernel", image, "-no-reboot", "-display", "none",
    "-device", "qemu-xhci,id=xhci",
    "-drive", "if=none,id=stick,format=raw,file=fat:ro:" + stick + ",readonly=on",
    "-device", "usb-storage,bus=xhci.0,drive=stick,removable=on",
    "-chardev", "socket,id=console,path=" + console + ",server=on,wait=off",
    "-serial", "chardev:console"] +
    (["-serial", "file:" + os.environ["MOONWATER_POWER_COVERAGE"]]
     if os.environ.get("MOONWATER_POWER_COVERAGE") else []) + [
    "-append", "console=" + tty + " drm_client_lib.active="],
    qmp, None, work, (console,), 0.1)

serial = socket.socket(socket.AF_UNIX)
serial.connect(console)
serial.settimeout(0.2)
transcript = bytearray()

def pump(seconds):
    stop = time.time() + seconds
    while time.time() < stop:
        try:
            chunk = serial.recv(65536)
        except socket.timeout:
            continue
        except OSError:
            return
        if not chunk:
            return
        transcript.extend(chunk)

def wait_for(marker, seconds):
    stop = time.time() + seconds
    while marker not in transcript and time.time() < stop:
        pump(0.3)
    return marker in transcript

def say(line):
    serial.sendall(line.encode() + b"\n")

def press():
    qcmd({"execute": "system_powerdown"})

#       A shell that answers before anything is typed at it for real: the UART
#       drops what arrives while the kernel is still talking.
wait_for(b"Run /init as init process", 60 * slow)
ready = False
for _ in range(30 * slow):
    say("printf 'rewop-ydaer\\n' | rev")
    if wait_for(b"ready-power", 2):
        ready = True
        break

def asked(name, line, marker, seconds=20):
    if not ready:
        out.append((name, "not run: no shell", "yes"))
        return
    say(line)
    out.append((name, "yes" if wait_for(marker, seconds) else "no", "yes"))

asked("the compositor found no card", "true", b"gave up waiting for a card", 30)
asked("a machine script overlays mute at its case arm",
      "printf '%s\\n' 'function moonwater_init {' '  true' '}' 'function moonwater_event {' '  case $1 in' '  mute) : ;;' '  canvas) : ;;' '  *) : ;;' '  esac' '}' 'function moonwater_end {' '  true' '}' > /root/main.moonwater.sh; chmod 600 /root/main.moonwater.sh; moonwater bind mute | grep -c 'mute: /root/main.moonwater.sh:6' | sed 's/^/etum-/' | rev",
      b"1-mute")
asked("canvas on and canvas off share the canvas arm",
      "moonwater bind canvas on | grep -c 'canvas on: /root/main.moonwater.sh:7' | sed 's/^/no-/' | rev",
      b"1-on")
asked("star does not own poweroff",
      "moonwater bind poweroff | grep -c 'poweroff: /root/main.moonwater.sh' | sed 's/^/rats-/' | rev",
      b"0-star")
asked("SET is refused at the script line",
      "moonwater bind mute true 2>&1 | grep -c 'mute is /root/main.moonwater.sh:6; change it there' | sed 's/^/esufer-/' | rev",
      b"1-refuse")
asked("init is the moonwater_init hook, not the stored list",
      "moonwater bind init | grep -c '/root/main.moonwater.sh:1' | sed 's/^/tini-/' | rev",
      b"1-init")
asked("init add is refused the same way",
      "moonwater bind init add true 2>&1 | grep -c 'init is /root/main.moonwater.sh:1; change it there' | sed 's/^/dda-/' | rev",
      b"1-add")
asked("exit is the moonwater_end hook, not the stored list",
      "moonwater bind exit | grep -c '/root/main.moonwater.sh:11' | sed 's/^/dne-/' | rev",
      b"1-end")
asked("removing the script restores the builtin",
      "rm -f /root/main.moonwater.sh; moonwater bind poweroff | grep -c 'poweroff: builtin:' | sed 's/^/tluafed-/' | rev",
      b"1-default")
asked("the power button is the builtin poweroff arm",
      "moonwater bind poweroff | grep -c 'poweroff: builtin:' | sed 's/^/tluafed-/' | rev",
      b"1-default")
asked("a user cannot replace a script arm",
      "setpriv --reuid=65534 --regid=65534 --clear-groups moonwater bind poweroff true 2>&1 | grep -c 'change it there' | sed 's/^/toorn-/' | rev",
      b"1-nroot")
#       Three counts in one answer: the helper left CAP_SYS_BOOT alone in the
#       effective set, the kernel overlay refused the line, and the button
#       still names the builtin afterwards.
if capboot:
    asked("root with only CAP_SYS_BOOT cannot replace a script arm",
          "mkdir -p /mnt; mount -r -t vfat /dev/sda1 /mnt; { /mnt/capboot grep -c 'CapEff:.0000000000400000$' /proc/self/status; /mnt/capboot moonwater bind poweroff true 2>&1 | grep -c 'change it there'; moonwater bind poweroff | grep -c 'poweroff: builtin:'; } | tr -d '\\n' | sed 's/^/toob-/' | rev",
          b"111-boot")
else:
    out.append(("root with only CAP_SYS_BOOT cannot replace a script arm",
                "not run: the helper did not build", "yes"))
asked("a command longer than a bound event holds is refused",
      "moonwater bind mute \"$(printf '%0300d' 0)\" 2>&1 | grep -c 'longer than' | sed 's/^/gnol-/' | rev",
      b"1-long")
asked("a moonwater_mute function owns mute",
      "printf '%s\\n' 'function moonwater_mute {' '  :' '}' > /root/main.moonwater.sh; chmod 600 /root/main.moonwater.sh; moonwater bind mute | grep -c 'mute: /root/main.moonwater.sh:1' | sed 's/^/nf-/' | rev",
      b"1-fn")
#       The file the machine script is read from is held to a policy, and a
#       file that fails it is said to have been refused, by name, wherever the
#       script's lines are shown: the kernel keeps what it had, and that is
#       what `moonwater bind` is describing.
def refused(name, make, marker, want):
    asked(name,
          "rm -f /root/main.moonwater.sh; " + make +
          "; timeout 10 moonwater bind mute 2>&1 | grep -c 'refused' | sed 's/^/" + marker + "-/' | rev",
          want)

script_text = "printf '%s\\n' 'function moonwater_mute {' '  :' '}' > /root/main.moonwater.sh"
refused("a script that others may write is refused, and the status says so",
        script_text + "; chmod 666 /root/main.moonwater.sh", "wo", b"1-ow")
refused("a script only the group may write is refused too",
        script_text + "; chmod 664 /root/main.moonwater.sh", "pg", b"1-gp")
refused("a link in its place is refused",
        "echo ':' > /tmp/linked; chmod 600 /tmp/linked; ln -s /tmp/linked /root/main.moonwater.sh", "ln", b"1-nl")
refused("a fifo in its place is refused and does not hang the command",
        "mkfifo -m 600 /root/main.moonwater.sh", "fi", b"1-if")
refused("a script over 64 KiB is refused",
        "head -c 65537 /dev/zero | tr '\\0' '#' > /root/main.moonwater.sh; chmod 600 /root/main.moonwater.sh", "bg", b"1-gb")
refused("a script of exactly 64 KiB is taken",
        "head -c 65536 /dev/zero | tr '\\0' '#' > /root/main.moonwater.sh; chmod 600 /root/main.moonwater.sh", "ok", b"0-ko")
refused("and an empty one",
        ": > /root/main.moonwater.sh; chmod 600 /root/main.moonwater.sh", "em", b"0-me")
#       A second machine process is refused, and says why; and nobody but
#       root is one.
asked("a second machine process is refused with 2",
      "timeout 20 moonwater machine >/dev/null 2>&1; printf 'second-%s\\n' $? | rev",
      b"2-dnoces")
asked("and so is one that is not root, with 1",
      "setpriv --reuid=65534 --regid=65534 --clear-groups moonwater machine >/dev/null 2>&1; printf 'plain-%s\\n' $? | rev",
      b"1-nialp")
#       Stopping the machine as somebody who may not takes no time at all: the
#       exit list is root's, and asking a machine process to end is too.
asked("poweroff by an ordinary user fails at once",
      "s=$(date +%s%N); setpriv --reuid=65534 --regid=65534 --clear-groups /shell -c poweroff >/dev/null 2>&1; e=$(date +%s%N); "
      "[ $(( (e - s) / 1000000 )) -lt 1500 ] && echo quick-poweroff | rev",
      b"fforewop-kciuq")
#       The machine process killed while a job of its script that is not an
#       exec -- a subshell loop, which keeps a copy of its descriptor -- is
#       alive: the next one attaches. A counter file says how many times
#       moonwater_init ran. The loop has the machine process's command line
#       too, so the one killed is the one init started: the child of 1.
asked("a machine process killed with a background job alive is replaced by one that attaches",
      "mp() { for f in /proc/[0-9]*/cmdline; do case $(tr '\\0' ' ' < $f) in '/shell -c moonwater machine'*) p=${f#/proc/}; p=${p%/cmdline}; set -- $(cat /proc/$p/stat); [ \"$4\" = 1 ] && echo $p;; esac; done; }; "
      "rm -f /root/inits /root/bgpids; "
      "printf '%s\\n' 'function moonwater_init {' '  n=$(cat /root/inits 2>/dev/null || echo 0)' '  echo $((n + 1)) > /root/inits' "
      "'  ( while :; do sleep 1; done ) &' '  echo $! >> /root/bgpids' '}' > /root/main.moonwater.sh; chmod 600 /root/main.moonwater.sh; "
      "kill -9 $(mp); for i in $(seq 60); do [ \"$(cat /root/inits 2>/dev/null)\" = 1 ] && break; sleep 0.5; done; "
      "kill -9 $(mp); for i in $(seq 60); do [ \"$(cat /root/inits 2>/dev/null)\" = 2 ] && break; sleep 0.5; done; "
      "printf 'reattach-%s\\n' \"$(cat /root/inits)\" | rev; kill $(cat /root/bgpids) 2>/dev/null",
      b"2-hcattaer", 90)
#       The boot leaves the settings' init list to a script's moonwater_init only
#       once the machine process says it has the script: its word is a file.
asked("a machine process that took its script up says so, for the boot that waits to hear it",
      "[ -e /run/moonwater/machine.sourced ] && echo sourced-yes | rev",
      b"sey-decruos")
#       A key held down is a flood of presses of a row with no debounce: each
#       is queued or folded into the one waiting, and the machine goes on.
if button:
    asked("a volume key is bound to a command",
