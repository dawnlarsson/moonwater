                        '1:close preserved:0' ]
                verdict history-transaction-close-error builtins_failed 'injected close returned $history_close_status, retained [$(cat "$work/history-regression/close")], stages $history_temps'
        else
                note "history close-error regression: NOT RUN -- no strace"
