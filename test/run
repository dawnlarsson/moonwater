#       A browser that refuses to be root, in a booted guest, from the real
#       package.
#
#       Chrome and everything built on it stop at "Running as root without
#       --no-sandbox is not supported" before a window or a page, and every
#       program a bowl ran was root. Debian is where a Chromium and the glibc
#       it was built for come from with no download outside the mirror, so
#       this lands a Debian bowl on a blank disk, has apt add chromium, and
#       asks who a program of the bowl is (the user, 1000, and root where
#       root is asked for or is the way in), what a package manager from the
#       user is told, and then runs the browser as it is installed -- no flag
#       taking its sandbox off -- on a page of the guest's own: the page's
#       text must come out of --dump-dom and the status must be 0, read
#       before anything is piped. A browser that is root exits 1 with the
#       sentence above, which is the red of the parent.
lane_chrome()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}

counting chrome

for need in qemu-system-x86_64 python3 mke2fs; do
        if ! command -v "$need" > /dev/null 2>&1; then
                echo "  chrome       NOT RUN -- no $need"
                exit 2
        fi
done

if [ ! -f "$image" ]; then
        echo "  chrome       NOT RUN -- no image at $image"
        exit 2
fi

if ! python3 -c 'import socket; socket.create_connection(("deb.debian.org", 80), 5).close()' 2> /dev/null; then
        echo "  chrome       NOT RUN -- no network to Debian's mirror"
        exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-chrome.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

truncate -s 6G "$work/bowls.img" && mke2fs -q -t ext4 -F "$work/bowls.img" || exit 1

MOONWATER_CHROME_WORK=$work
export MOONWATER_CHROME_WORK
qmp_guest_module "$work"

PYTHONPATH=$work python3 - "$image" > "$work/answers" 2>"$work/why" <<'PY'
import os, re, socket, sys, time
from qmp_guest import *

image = sys.argv[1]
work = os.environ["MOONWATER_CHROME_WORK"]

machine = desktop(image)
machine[machine.index("-m") + 1] = "6G"
guest = Guest(machine + [
    "-drive", "if=none,id=bw,format=raw,file=" + work + "/bowls.img",
    "-device", "nvme,serial=bowls0,drive=bw",
    "-netdev", "user,id=n0", "-device", "virtio-net-pci,netdev=n0",
    "-chardev", "socket,id=s0,path=" + work + "/ser,server=on,wait=off",
    "-serial", "chardev:s0",
    "-no-reboot", "-display", "none",
    "-append", "console=ttyS0 drm_client_lib.active= moonwater.cursor_plane=0"],
    work + "/qmp", work + "/mon", work, sockets=(work + "/ser",))

shell = socket.socket(socket.AF_UNIX)
shell.connect(work + "/ser")
shell.settimeout(1)
tags = [0]

def run(command, seconds=60):
    """One line on the guest's serial shell: what it printed, and its status."""
    tags[0] += 1
    mark = tags[0]
    shell.sendall(("\necho BEG\"%d\"; %s\necho END\"%d\":$?\n" % (mark, command, mark)).encode())
    seen = b""
    stop = time.time() + seconds
    done = re.compile(rb"BEG%d\r?\n(.*?)END%d:(\d+)" % (mark, mark), re.S)
    while time.time() < stop:
        try:
            seen += shell.recv(65536)
        except socket.timeout:
            pass
        found = done.search(seen)
        if found:
            text = re.sub(rb"\x1b\[[0-9;?]*[a-zA-Z]", b"", found.group(1))
            text = text.decode("utf8", "replace").replace("\r", "").strip()
            #       What the shell wrote last is its prompt, for the line after.
            return re.sub(r"(\s*\$)+$", "", text), int(found.group(2))
    return seen.decode("utf8", "replace").replace("\r", ""), 124

def last(text):
    """The last line of an answer, which is the one a command printed last."""
    lines = [line for line in text.split("\n") if line.strip()]
    return lines[-1].strip() if lines else ""

time.sleep(25)
out = []

run("mount /dev/nvme0n1 /bowls", 30)
_, setup = run("bowl setup debian", 900)
out.append(("a Debian bowl lands on the disk", "yes" if setup == 0 else "no, status %d" % setup, "yes"))
_, added = run("(apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y "
               "--no-install-recommends -o Dpkg::Options::=--force-unsafe-io chromium) < /dev/null", 1500)
out.append(("with Chromium added by apt", "yes" if added == 0 else "no, status %d" % added, "yes"))

who, _ = run("bowl /bowls/debian /usr/bin/id -u", 60)
out.append(("a program of the bowl is not root", last(who) or "no answer", "1000"))
name, _ = run("bowl /bowls/debian /usr/bin/id -un", 60)
out.append(("it is the user by name", last(name) or "no answer", "user"))
asked, _ = run("bowl --root /bowls/debian /usr/bin/id -u", 60)
out.append(("--root asks for root", last(asked) or "no answer", "0"))
shell_id, _ = run("echo 'id -u' | bowl /bowls/debian", 60)
out.append(("the shell a bare bowl starts is root", last(shell_id) or "no answer", "0"))
refused, _ = run("bowl /bowls/debian /usr/bin/sh -c 'bowl --isolated /bowls/debian /usr/bin/true' 2>&1", 60)
out.append(("a package manager from the user says it needs the machine's root",
            "yes" if "needs the machine's root" in refused else "no: " + refused[-200:], "yes"))

run("printf '<html><body><p id=x>moonwater-chrome-row</p></body></html>' > /tmp/page.html", 30)
status, _ = run("chromium --headless --disable-gpu --dump-dom file:///tmp/page.html > /tmp/dom 2> /tmp/dom.err; echo rc=$?", 240)
dom, _ = run("cat /tmp/dom", 30)
err, _ = run("grep -c 'without --no-sandbox' /tmp/dom.err", 30)
out.append(("Chromium, its sandbox on, exits 0", "yes" if "rc=0" in status else "no: " + status[-100:], "yes"))
out.append(("and prints the page it was given", "yes" if "moonwater-chrome-row" in dom else "no: " + dom[-200:], "yes"))
out.append(("and never says it will not run as root", "yes" if last(err) == "0" else "no", "yes"))

alive, state = run("echo answers")
out.append(("and the machine answers on its serial shell", "yes" if state == 0 and "answers" in alive else "no", "yes"))

guest.quit()
time.sleep(1)
guest.terminate()
try:
    guest.wait(10)
except Exception:
    guest.kill()

for name, got, want in out:
    print("%s|%s|%s" % (name, " ".join(got.split()).replace("|", "/"), want))
