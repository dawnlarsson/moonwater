ip addr add 10.66.0.2/24 dev \$lan
moonwater link group lab $link_lan_secret allow run > /tmp/join 2>&1
i=0; until moonwater link | grep -q 'in group lab' || [ \$i -ge 90 ]; do sleep 1; i=\$((i + 1)); done
name=\$(moonwater link | sed -n 's/^  \([^ ]*\) .*in group lab.*/\1/p' | head -1)
moonwater link run "\$name" 'echo asked > /root/lan-asked; echo from-the-headless-box' < /dev/null > /tmp/lanrun 2>&1
printf 'lan-run-%s\\n' "\$(rev < /tmp/lanrun)"
poweroff
COMMANDS
