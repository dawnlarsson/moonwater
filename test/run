#       The firmware, finally: no -kernel, just the disk.
#
#       A machine started from its own disk has no console on the serial line:
#       nothing puts console= on the command line of an image the firmware
#       loads, so nothing the kernel says reaches this transcript. The firmware
#       can say it loaded the image from the disk, and the disk can say the rest.
#       Moonwater started from it finds its own build there and mounts the
#       data partition, and ext4 counts every mount in its superblock -- so a
#       count that went up while the firmware had the disk is Moonwater, from
#       firmware to init to moonwater boot, and nothing else could have done it.
#
firmware=""
firmware_vars=""
for candidate in $install_firmwares; do
        [ -f "${candidate%%:*}" ] && [ -f "${candidate#*:}" ] &&
                firmware=${candidate%%:*} && firmware_vars=${candidate#*:} && break
done

#       The superblock is 1024 bytes into the partition: s_mnt_count is at
#       52 in it and the ext4 magic, 0xef53, at 56.
mounts_of()
{
        offset=$(sfdisk -d "$work/disk.img" 2>/dev/null |
                awk -F '[=,]' '/name="moonwater-data"/ { print $2 * 512; exit }')
        [ -n "$offset" ] &&
                [ "$(od -An -tx2 -j $((offset + 1080)) -N 2 "$work/disk.img" | tr -d ' ')" = ef53 ] &&
                od -An -tu2 -j $((offset + 1076)) -N 2 "$work/disk.img" | tr -d ' '
}

if [ -z "$firmware" ]; then
        printf '  %-30s no UEFI firmware here, the firmware boot did not run\n' 'firmware'
elif ! command -v sfdisk > /dev/null 2>&1; then
        printf '  %-30s no sfdisk here to find the data partition\n' 'firmware'
else
        cp "$firmware_vars" "$work/vars.fd"

        #
        #       Settings an image carries, read by the kernel it boots.
        #
        #       Only a firmware start runs the EFI stub that hands the section
        #       over -- every -kernel boot above saw the defaults -- so these
        #       go through OVMF, whose loader still passes -append to the stub.
        #       Each copy has its slots written the way the moonwater command
        #       writes them: @SLOT GENERATION FLAGS good|bad, then list/command
        #       pairs; bad is a sum that does not hold.
        #
        settings_write()
        {
                python3 - "$@" <<'PY'
import struct, sys, zlib
path, words = sys.argv[1], sys.argv[2:]
d = bytearray(open(path, 'rb').read())
pe = struct.unpack_from('<I', d, 0x3c)[0]
table = pe + 24 + struct.unpack_from('<H', d, pe + 20)[0]
raw = [struct.unpack_from('<I', d, table + 40 * i + 20)[0]
       for i in range(struct.unpack_from('<H', d, pe + 6)[0])
       if d[table + 40 * i:table + 40 * i + 8] == b'.mwset\0\0'][0]
lists = {'init': 1, 'startup': 2, 'exit': 3, 'bind': 4}
at = 0
while at < len(words):
    slot, generation = int(words[at][1:]), int(words[at + 1])
    flags, state = int(words[at + 2], 0), words[at + 3]
    at += 4
    payload, nexts = b'', [0, 0, 0]
    while at < len(words) and not words[at].startswith('@'):
        l, text = lists[words[at]], words[at + 1].encode()
        at += 2
        ident = 0
        if l != 4:
            nexts[l - 1] += 1
            ident = nexts[l - 1]
        payload += struct.pack('<BBHHH', l, 1, ident, len(text), 0) + text + b'\0' * (-len(text) % 4)
    head = struct.pack('<QHHIQ16sIIIHHH6s', 0x474e54544553574d, 1, 64, 16384, generation,
                       b'\x5a' * 16, len(payload), 0, flags,
                       nexts[0] + 1, nexts[1] + 1, nexts[2] + 1, b'\0' * 6)
    total = zlib.crc32(head + payload) ^ (state == 'bad')
    d[raw + slot * 16384:raw + (slot + 1) * 16384] = \
        (head[:44] + struct.pack('<I', total) + head[48:] + payload).ljust(16384, b'\0')
open(path, 'wb').write(d)
PY
        }

        settings_boot()
        {
                name=$1
                rm -f "$work/serial.in"
                mkfifo "$work/serial.in" || exit 1
                cp "$firmware_vars" "$work/$name.vars"
                coverage_guest "$image" "$work/coverage-$name"
                # shellcheck disable=SC2086
                timeout $((180 * install_slow)) "$install_emulator" -m 2G -smp 2 \
                        $install_firmware_board $install_machine \
                        -drive if=pflash,format=raw,readonly=on,file="$firmware" \
                        -drive if=pflash,format=raw,file="$work/$name.vars" \
                        -kernel "$work/$name.efi" -no-reboot -display none \
                        -serial stdio $coverage_serial \
                        -append "console=$install_console drm_client_lib.active=" \
                        < "$work/serial.in" > "$work/$name" 2>&1 &
                booting=$!
                exec 9> "$work/serial.in"

                waited=0
                until grep -q -F ' $ ' "$work/$name" 2>/dev/null; do
                        kill -0 "$booting" 2>/dev/null || break
                        [ "$waited" -lt $((150 * install_slow)) ] || break
                        sleep 1
                        waited=$((waited + 1))
                done

                coverage_guest_commands "$work/$name.commands" >&9
                exec 9>&-
                wait "$booting" 2>/dev/null || true
                coverage_guest_collect "install-$name"

                says "$name" "$name powered down" 'reboot: Power down'
                never "$name" "$name without a panic" 'Kernel panic'
        }

        cp "$image" "$work/preset.efi" &&
                settings_write "$work/preset.efi" @0 1 0x2 good \
                        init "printf 'init-%s\n' \"\$(printf nar | rev)\" > /dev/$install_console" \
                        exit "true" || exit 1
        cat > "$work/preset.commands" <<'COMMANDS'
this line is eaten by the console
sleep 2
printf 'read-%s\n' $(( $(dmesg | grep -c 'settings: slot 0, generation 1') * 7 ))
printf 'listed-%s\n' $(( $(moonwater bind init | grep -c '^1  printf') * 7 ))
printf 'switch-%s\n' $(( $(moonwater bind init mount | grep -c 'init mount off') * 7 ))
printf 'verdict-%s\n' "$(rev < /run/moonwater/verdict)"
printf 'ended-%s\n' "$(rev < /run/moonwater/init/1.status)"
poweroff
COMMANDS
        settings_boot preset
        says preset 'the kernel read the slot'      'read-7'
        says preset 'init ran what it carries'      'init-ran'
        says preset 'the session lists it'          'listed-7'
        says preset 'a switch arrives with it'      'switch-7'
        says preset 'mount off leaves the disks'    'verdict-evil'
        says preset 'how init ended is kept'        'ended-0 detixe'

        cp "$image" "$work/damaged.efi" &&
                settings_write "$work/damaged.efi" \
                        @0 5 0 bad init "printf 'init-%s\n' \"\$(printf gnorw | rev)\" > /dev/$install_console" \
                        @1 4 0 bad init "printf 'init-%s\n' \"\$(printf gnorw | rev)\" > /dev/$install_console" || exit 1
        cat > "$work/damaged.commands" <<'COMMANDS'
this line is eaten by the console
sleep 2
printf 'damaged-%s\n' $(( $(dmesg | grep -c 'both settings slots in the image are damaged') * 7 ))
printf 'defaults-%s\n' $(( $(moonwater bind init | grep -c 'nothing runs at boot') * 7 ))
poweroff
COMMANDS
        settings_boot damaged
        says damaged 'two bad slots are said once'  'damaged-7'
        says damaged 'and boot on the defaults'     'defaults-7'
        never damaged 'and run nothing they hold'   'init-wrong'

        cp "$image" "$work/torn.efi" &&
                settings_write "$work/torn.efi" \
                        @0 2 0 good init "printf 'init-%s\n' \"\$(printf dlo | rev)\" > /dev/$install_console" \
                        @1 3 0 bad init "printf 'init-%s\n' \"\$(printf wen | rev)\" > /dev/$install_console" || exit 1
        cat > "$work/torn.commands" <<'COMMANDS'
this line is eaten by the console
sleep 2
printf 'torn-read-%s\n' $(( $(dmesg | grep -c 'settings: slot 0, generation 2') * 7 ))
poweroff
COMMANDS
        settings_boot torn
        says torn 'a torn newer slot loses'         'torn-read-7'
        says torn 'the older slot runs'             'init-old'
        never torn 'the torn one does not'          'init-new'

        #       Lines a file on the data partition has, read from here.
        data_lines()
        {
                where=$(sfdisk -d "$work/disk.img" 2>/dev/null |
                        awk -F '[=,]' '/name="moonwater-data"/ { print $2 * 512; exit }')
                debugfs -R "cat $1" "$work/disk.img?offset=$where" 2>/dev/null | grep -c -F "$2"
        }

        boots_before=$(data_lines /root/boots boot)
        stops_before=$(data_lines /root/stops stop)
        before=$(mounts_of)
        # shellcheck disable=SC2086
        timeout $((60 * install_slow)) "$install_emulator" -m 2G -smp 2 \
                $install_firmware_board $install_machine \
                -drive if=pflash,format=raw,readonly=on,file="$firmware" \
                -drive if=pflash,format=raw,file="$work/vars.fd" \
                -drive if=none,id=disk,format=raw,file="$work/disk.img" \
                -device nvme,serial=moonwater,drive=disk \
                -display none -serial stdio -no-reboot \
                < /dev/null > "$work/firmware" 2>&1 || true
        after=$(mounts_of)

        says firmware 'the firmware loads it from the disk' "$install_started"
        says firmware 'from the NVMe disk'               "$install_from"
        #       The firmware's own words: an arm64 kernel started this way
        #       logs to the serial line too, cfg80211's "failed to load
        #       regulatory.db" among it.
        never firmware 'the image loads'                 'BdsDxe: failed to load'
        never firmware 'nothing falls through'           'EFI Internal Shell'

        if [ -n "$before" ] && [ -n "$after" ] && [ "$after" -gt "$before" ]; then
                won
        else
                lost 'Moonwater came up from disk' \
                        "the data was never mounted (mount count ${before:-unread}, then ${after:-unread})"
        fi

        #       The disk's own settings, through the stub this time: init
        #       appended a line and powered the machine off, and exit
        #       appended one on the way down.
        if command -v debugfs > /dev/null 2>&1; then
                same 'init ran from the firmware boot' "$((boots_before + 1))" \
                        "$(data_lines /root/boots boot)"
                same 'exit ran at its power off' "$((stops_before + 1))" \
                        "$(data_lines /root/stops stop)"
        fi
fi

counted
)

#
#       The compositor, looked at.
#
#           sh test/run canvas        (MOONWATER_IMAGE names the image)
#
#       Every other lane reads bytes. This one reads pixels: it boots the
#       image under qemu with no display, asks the monitor for the framebuffer
#       and answers questions about what is on it.
#
#       It exists because the kernel log window shipped broken and nothing
#       here could tell. The boot lane reads the serial transcript, which said
#       everything was fine while the window on the screen was writing every
#       message where the last one ended -- printk says \n and means the start
#       of the next line, and the emulator behind that window is where a pty's
#       line discipline would have put the \r. A picture would have caught it
#       in a second; there was no picture.
#
#       Input goes in through QMP rather than the human monitor, because
#       mouse_move there is relative whatever device is selected and a tablet
#       has no relative axes to move along.
lane_canvas()
(
image=${MOONWATER_IMAGE:-dist/bootx64.efi}

counting canvas

if ! command -v qemu-system-x86_64 > /dev/null 2>&1; then
        echo "  canvas       no qemu-system-x86_64, skipped"
        exit 2
fi

if ! command -v python3 > /dev/null 2>&1; then
        echo "  canvas       no python3, skipped"
        exit 2
fi

if [ ! -f "$image" ]; then
        echo "  canvas       no image at $image, skipped"
        exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/dawning-canvas.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT INT TERM

MOONWATER_CANVAS_WORK=$work
export MOONWATER_CANVAS_WORK
coverage_guest "$image" "$work/coverage-canvas"
MOONWATER_CANVAS_COVERAGE=${coverage_serial#-serial file:}
export MOONWATER_CANVAS_COVERAGE
qmp_guest_module "$work"

PYTHONPATH=$work python3 - "$image" > "$work/answers" 2>"$work/why" <<'PY'
import os, re, subprocess, sys, time
from qmp_guest import *

image = sys.argv[1]
work = os.environ["MOONWATER_CANVAS_WORK"]

guest = Guest(desktop(image) + [
    # A relative mouse on each kind of controller a desktop has. The tablet
    # proves absolute motion; a real mouse is REL_X and REL_Y through usbhid,
    # and on a Haswell desktop the USB 2 ports hang off EHCI, not xHCI.
    "-device", "usb-mouse,id=xhcimouse",
    "-device", "usb-ehci,id=ehci", "-device", "usb-mouse,bus=ehci.0,id=ehcimouse",
    "-no-reboot", "-display", "none", "-serial", "file:" + work + "/serial"] +
    (["-serial", "file:" + os.environ["MOONWATER_CANVAS_COVERAGE"]]
     if os.environ.get("MOONWATER_CANVAS_COVERAGE") else []) + [
    # CANVAS_APPEND adds to the guest's command line: a profiling run wants
    # nokaslr so the samples map onto System.map. The cursor plane is off here
    # because QEMU's screendump has no cursor plane in it, and the pixel checks
    # below count the cursor's pixels; the plane boot after this one covers it.
    "-append", "console=ttyS0 drm_client_lib.active= moonwater.cursor_plane=0 " + os.environ.get("CANVAS_APPEND", "")],
    work + "/qmp", work + "/mon", work)
time.sleep(0.5)

#       Long enough for the desktop, the shell and the boot log replay. The
#       serial transcript is not what is being read, but a machine that never
#       got that far has nothing on its screen either.
time.sleep(25)

out = []

#       The pointer applet, written to the serial line so the kernel's list
#       of attached input devices can be read back. Typed first, into the
#       terminal that has the keyboard at boot, before any window is touched.
#       The arrow and the capital go in as chords: type_text knows only the
#       plain keys, and a qcode a key does not have is an error, not a key.
type_text("pointer ")
chord("shift", "dot")
type_text(" /dev/tty")
chord("shift", "s")
type_text("0\n")
time.sleep(1.0)

shot("first")
w, h, px = load("first")

def at(x, y):
    o = (y * w + x) * 3
    return px[o], px[o + 1], px[o + 2]

bg = at(4, 4)

#       Where the windows are, found rather than assumed: a run of non
#       background across the middle of the screen is a window.
runs, start = [], None
for x in range(w):
    lit = at(x, h // 2) != bg
    if lit and start is None:
        start = x
    elif not lit and start is not None:
        if x - start > 40:
            runs.append((start, x - 1))
        start = None

# A window that reaches the right edge is a run too.
if start is not None and w - start > 40:
    runs.append((start, w - 1))

out.append(("windows", str(len(runs)), "2"))

#       Every check below needs the windows it measures. Without them they
#       used to be skipped without a word, and a display too small for the
#       layout hid twenty seven of them behind one failing count: a check that
#       cannot run fails, by name.
if not runs:
    out.append(("the log window's checks", "not run: no window found", "run"))

if len(runs) >= 1:
    left, right = runs[0]
    top = next((y for y in range(h) if at((left + right) // 2, y) != bg), 0)
    log_top = top

    #       Every row of the log starts at the left.
    #
    #       This is the one the missing carriage return broke. A message that
    #       begins where the last one ended leaves its row blank on the left
    #       and its text out in the middle, so counting rows whose first lit
    #       pixel is near the margin says whether the log is a log or a mess.
    def lit(x, y):
        r, g, b = at(x, y)
        return r + g + b > 180

    margin = 0
    rows = 0
    for row in range(3, 26):
        band = range(top + 24 + row * 16, min(top + 24 + row * 16 + 16, h))
        first = None
        for x in range(left + 2, right - 2):
            if any(lit(x, y) for y in band):
                first = x
                break
        if first is None:
            continue
        rows += 1
        if first - left < 28:
            margin += 1

    out.append(("log rows at the margin", "yes" if margin >= rows - 4 else
                "%d of %d" % (margin, rows), "yes"))

    # Three distinct wheel detents should move three conventional lines each,
    # with no speed multiplier merely because they arrived close together.
    # Compare the static log before and after: its old pixels move down by
    # nine 16-pixel rows. Events are separated enough for the compositor to
    # consume each one, but remain inside the old acceleration window.
    bottom = next((y for y in range(h - 1, top, -1)
                   if at((left + right) // 2, y) != bg), h - 1)
    moveto((left + right) // 2, min(top + 80, bottom - 4))
    for _ in range(3):
        send([{"type": "btn", "data": {"down": True,
                                        "button": "wheel-up"}},
              {"type": "btn", "data": {"down": False,
                                        "button": "wheel-up"}}])
        time.sleep(0.08)

    shot("wheel")
    wheel_w, wheel_h, wheel_px = load("wheel")

    def pixel(data, width, x, y):
        offset = (y * width + x) * 3
        return data[offset:offset + 3]

    content_top = min(top + 20, bottom)
    content_right = max(left + 1, right - 18)
    scores = []
    for shift in range(16, min(320, bottom - content_top), 16):
        same_pixels = 0
        evidence = 0
        for y in range(content_top + shift, bottom - 2):
            for x in range(left + 4, content_right):
                old = pixel(px, w, x, y - shift)
                new = pixel(wheel_px, wheel_w, x, y)
                if sum(old) > 180 or sum(new) > 180:
                    evidence += 1
                    if old == new:
                        same_pixels += 1
        scores.append((same_pixels / max(evidence, 1), shift))

    wheel_shift = max(scores, key=lambda item: item[0])[1] if scores else 0
    out.append(("wheel is three lines", str(wheel_shift), "144"))

    #   A terminal from the keyboard, and where the second one lands.
    #
    #   Control-Shift-T asks the compositor for one, which is the only way to
    #   get a window without a program already running to ask for it. The new
    #   one is centred like the first, so without a cascade it lands on top of
    #   it exactly -- same size, same place, pixel for pixel -- and opening a
    #   terminal looks like nothing happened at all. Measured and not assumed:
    #   the two overlapping windows make one run across the middle of the
    #   screen, and that run is one titlebar wider than the single window was.
    def spans(name):
        rw, rh, rpx = load(name)

        def rat(x, y):
            o = (y * rw + x) * 3
            return rpx[o], rpx[o + 1], rpx[o + 2]

        found, first = [], None
        for x in range(rw):
            on = rat(x, rh // 2) != bg
            if on and first is None:
                first = x
            elif not on and first is not None:
                if x - first > 40:
                    found.append((first, x - 1))
                first = None
        if first is not None and rw - first > 40:
            found.append((first, rw - 1))
        return found

    before_spawn = spans("first")
    term_left, term_right = before_spawn[-1]
    term_top = next(y for y in range(h) if at((term_left + term_right) // 2, y) != bg)

    chord("ctrl", "shift", "t")
    time.sleep(3.0)
    shot("spawned", 0.5)
    after_spawn = spans("spawned")

    out.append(("Control-Shift-T opens a window",
                "yes" if len(after_spawn) == len(before_spawn) and
                after_spawn and after_spawn[-1] != before_spawn[-1] else "no",
                "yes"))

    #   The step, from the picture and not from a number written here.
    #
    #   Everything the compositor draws is multiplied by the scale, so a
    #   cascade asserted as twenty pixels would be a check that only passes on
    #   one setting. It moves the window by the same distance
    #   down as across, and that is what is asserted: the run grew by exactly
    #   as much as the new window's top sits below the old one's.
    sw, sh, spx = load("spawned")

    def spixel(x, y):
        o = (y * sw + x) * 3
        return spx[o], spx[o + 1], spx[o + 2]

    grew = 0
    dropped = -1

    if after_spawn:
        new_left, new_right = after_spawn[-1]
        grew = (new_right - new_left) - (term_right - term_left)
        #   Clear of the window behind it, so this is the new window's own
        #   top edge and not the one it is stacked on.
        new_top = next((y for y in range(sh) if spixel(new_right - 4, y) != bg),
                       term_top)
        dropped = new_top - term_top

    out.append(("the second one cascades", "%d px across" % grew,
                "%d px across" % dropped if dropped > 0 else "a step down"))

    #   What a terminal the compositor starts runs at.
    #
    #   The compositor's thread is SCHED_FIFO, and a task forked from a FIFO
    #   task stays FIFO unless its parent asked for a reset. Control-Shift-T's
    #   terminal is started from that thread, so without the reset its shell
    #   and everything run in it were FIFO 1 beside the cursor, and a busy
    #   loop typed there held every processor against the desktop. Asked of
    #   the kernel from inside the new window, which has the keyboard: cat
    #   writes its own stat, whose 41st field is the policy, to the serial
    #   line, and is read back below with the rest of the transcript.
    type_text("cat /proc/self/stat ")
    chord("shift", "dot")
    type_text(" /dev/tty")
    chord("shift", "s")
    type_text("0\n")
    time.sleep(1.0)

    #   Through the whole of its ring, so what it holds when the X closes it
    #   is what a scrolled terminal holds, not an idle one.
    type_text("seq 700\n")
    time.sleep(1.5)

    #   The X in the titlebar, which is the only thing on a window that ends
    #   a program rather than moving it. Aimed at the glyph the compositor
    #   actually drew -- the rightmost title-coloured text in the new
    #   window's own titlebar -- because working out where it ought to be is
    #   how a check passes while the button is somewhere else entirely.
    if after_spawn and dropped > 0:
        band = range(new_top + 4, new_top + dropped - 4)
        marks = [x for x in range(new_right, new_left, -1)
                 for y in band if spixel(x, y) == (223, 231, 239)]

        if marks:
            moveto(marks[0] - 3, new_top + dropped // 2)
            send([{"type": "btn", "data": {"down": True, "button": "left"}}])
            time.sleep(0.08)
            send([{"type": "btn", "data": {"down": False, "button": "left"}}])
            time.sleep(3.0)

        shot("closed", 0.5)
        out.append(("the X closes a window",
                    "yes" if marks and spans("closed") == before_spawn else "no",
                    "yes"))


#       A click on a titlebar takes the focus, which the titlebar says.
if len(runs) < 2:
    out.append(("the checks between two windows", "not run: %d windows" % len(runs), "run"))

wider_cols = 0
wider_note = "no second window"
if len(runs) >= 2:
    a_left, a_right = runs[0]
    b_left, b_right = runs[1]
    a_top = next((y for y in range(h) if at((a_left + a_right) // 2, y) != bg), 0)
    before = at((a_left + a_right) // 2, a_top + 4)

    moveto((a_left + a_right) // 2, a_top + 6)
    send([{"type": "btn", "data": {"down": True, "button": "left"}}])
    time.sleep(0.3)
    send([{"type": "btn", "data": {"down": False, "button": "left"}}])
    time.sleep(1.5)

    shot("focused")
    w2, h2, px = load("focused")
    after = at((a_left + a_right) // 2, a_top + 4)

    out.append(("focus follows a click", "moved" if after != before else "same",
                "moved"))

    # The log window is anchored near the left edge.  The graphical terminal
    # asks to be centred and is therefore the second run.  Exercise the route
    # a person on the machine actually uses: USB keyboard -> compositor ->
    # terminal -> pty -> shell.  The monitor redraws sixteen times, long enough
    # to catch faults tied to a refresh rather than merely to startup.
    b_top = next((y for y in range(h2)
                  if at((b_left + b_right) // 2, y) != bg), 0)
    b_bottom = next((y for y in range(h2 - 1, b_top, -1)
                     if at((b_left + b_right) // 2, y) != bg), h2 - 1)

    moveto((b_left + b_right) // 2, b_top + 6)
    send([{"type": "btn", "data": {"down": True, "button": "left"}}])
    time.sleep(0.2)
    send([{"type": "btn", "data": {"down": False, "button": "left"}}])
    time.sleep(0.5)

    # A terminal row is kept at its written length and Canvas folds it at the
    # width on screen. Narrowing must therefore add visible text rows without
    # losing the tail, and widening must unfold the same cells again. Exercise
    # the actual edge-drag path: compositor request -> shared window page ->
    # terminal regrid -> immediate commit -> compositor redraw.
    type_text("echo " + "abcdefghij" * 14 + "\n")
    time.sleep(0.5)
    shot("terminal-wide", 0.3)
    resize_w, resize_h, terminal_wide = load("terminal-wide")

    def runs_in(data, width, y):
        found, begin = [], None
        background = bytes(bg)
        for x in range(width):
            on = pixel(data, width, x, y) != background
            if on and begin is None:
                begin = x
            elif not on and begin is not None:
                if x - begin > 40:
                    found.append((begin, x - 1))
                begin = None
        if begin is not None and width - begin > 40:
            found.append((begin, width - 1))
        return found

    def ink_rows(data, width, height, left, right, top, bottom):
        rows = []
        for band_top in range(top + 20, min(bottom, height - 1), 16):
            band_bottom = min(band_top + 16, bottom, height)
            lit_pixels = 0
            for y in range(band_top, band_bottom):
                for x in range(left + 8, max(left + 8, right - 18)):
                    if sum(pixel(data, width, x, y)) > 180:
                        lit_pixels += 1
            if lit_pixels > 8:
                rows.append(band_top)
        return rows

    def body_difference(a, b, width, left, right, top, bottom):
        different = 0
        for y in range(top + 24, bottom - 2):
            for x in range(left + 8, right - 18):
                offset = (y * width + x) * 3
                if a[offset:offset + 3] != b[offset:offset + 3]:
                    different += 1
        return different

    wide_row_positions = ink_rows(terminal_wide, resize_w, resize_h,
                                  b_left, b_right, b_top, b_bottom)
    wide_rows = len(wide_row_positions)
    old_width = b_right - b_left + 1
    edge_y = (b_top + b_bottom) // 2

    def resize_cursor_pixels(data, width, height, x, y):
        # CURSOR_RESIZE_H has exactly 25 fill pixels at scale one. No
        # compositor ink uses pure white (terminal white is dfe7ef), so this
        # identifies the visible cursor rather than text or the frame below it.
        return sum(1 for py in range(max(y - 7, 0), min(y + 13, height))
                   for px in range(max(x - 7, 0), min(x + 9, width))
                   if pixel(data, width, px, py) == b"\xff\xff\xff")

    moveto(b_right - 1, edge_y)
    send([{"type": "btn", "data": {"down": True, "button": "left"}}])
    time.sleep(0.08)

    # Sample four positions in one held resize. Checking only the final window
    # geometry cannot prove that the visible cursor stayed live during it.
    cursor_samples = []
    for distance in (70, 140, 210, 280):
        target_x = b_right - distance
        moveto(target_x, edge_y)
        name = "terminal-resize-%d" % distance
        shot(name, 0.12)
        sample_w, sample_h, sample_px = load(name)
        cursor_samples.append(resize_cursor_pixels(
            sample_px, sample_w, sample_h, target_x, edge_y))

    narrow_w, narrow_h, terminal_narrow = sample_w, sample_h, sample_px

    # The harness screendump exposes the rendered cursor, so every applied
    # position can be inspected directly without claiming its rendering path.
    out.append(("visible cursor follows resize",
                "yes" if cursor_samples == [25, 25, 25, 25] else
                str(cursor_samples), "yes"))

    narrow_runs = runs_in(terminal_narrow, narrow_w, h // 2)
    terminal_run = (min(narrow_runs, key=lambda run: abs(run[0] - b_left))
                    if narrow_runs else None)
    if terminal_run:
        narrow_left, narrow_right = terminal_run
        narrow_row_positions = ink_rows(terminal_narrow, narrow_w, narrow_h,
                                        narrow_left, narrow_right, b_top, b_bottom)
        narrow_rows = len(narrow_row_positions)
        narrow_extent = narrow_right - narrow_left + 1
    else:
        narrow_left, narrow_right = b_left, b_right
        narrow_rows = 0
        narrow_row_positions = []
        narrow_extent = old_width

    out.append(("terminal edge resizes",
                "yes" if narrow_extent + 160 < old_width else
                "%d to %d" % (old_width, narrow_extent), "yes"))
    narrow_redraw = body_difference(terminal_wide, terminal_narrow, narrow_w,
                                    narrow_left, narrow_right, b_top, b_bottom)
    out.append(("terminal resize redraws",
                "yes" if narrow_redraw > 200 else
                "%d pixels" % narrow_redraw, "yes"))

    # Keep the original edge grabbed. A second press has to hit a six-pixel
    # target in an asynchronously redrawn frame and tests reacquisition more
    # than it tests resize; the one continuous drag is what a person does.
    moveto(b_right - 1, edge_y)
    send([{"type": "btn", "data": {"down": False, "button": "left"}}])
    shot("terminal-wide-again", 0.4)
    again_w, again_h, terminal_again = load("terminal-wide-again")
    again_runs = runs_in(terminal_again, again_w, h // 2)
    again_run = (min(again_runs, key=lambda run: abs(run[0] - b_left))
                 if again_runs else None)
    if again_run:
        again_rows = len(ink_rows(terminal_again, again_w, again_h,
                                  again_run[0], again_run[1], b_top, b_bottom))
        again_extent = again_run[1] - again_run[0] + 1
        restored_difference = body_difference(
            terminal_wide, terminal_again, again_w,
            again_run[0], again_run[1], b_top, b_bottom)
    else:
        again_rows = 0
        again_extent = 0
        restored_difference = old_width * (b_bottom - b_top)

    out.append(("terminal widens back",
                "yes" if abs(again_extent - old_width) <= 16 and
                again_rows == wide_rows and restored_difference < 64 else
                "%dx%d rows %d/%d pixels %d" %
                (old_width, again_extent, wide_rows, again_rows,
                 restored_difference), "yes"))

    #   Wider than it opened. A terminal's lines start as far apart as its
    #   window opens and are spread when it is given more columns than that
    #   (pane_restride), so a line longer than the window first was must
    #   still come out on one row once the window is that wide. Dragged well
    #   past where it opened, a 120 character line has to reach further right
    #   than any line the opening stride can hold; then back to the width it
    #   had, for everything below.
    wider_cols = 0
    wider_note = "not dragged"
    if again_run:
        moveto(b_right - 1, edge_y)
        send([{"type": "btn", "data": {"down": True, "button": "left"}}])
        time.sleep(0.08)
        for distance in (100, 200, 300, 400):
            moveto(min(b_right - 1 + distance, again_w - 24), edge_y)
            time.sleep(0.12)
        time.sleep(0.3)
        send([{"type": "btn", "data": {"down": False, "button": "left"}}])
        time.sleep(0.5)
        type_text("echo " + "0123456789" * 12 + "\n")
        time.sleep(1.0)
        shot("terminal-wider", 0.3)
        wider_w, wider_h, terminal_wider = load("terminal-wider")
        wider_runs = runs_in(terminal_wider, wider_w, h // 2)
        wider_run = (min(wider_runs, key=lambda run: abs(run[0] - again_run[0]))
                     if wider_runs else None)
        if wider_run:
            reach = max((x for y in range(b_top + 24, min(b_bottom, wider_h) - 2)
                         for x in range(wider_run[0] + 8, wider_run[1] - 18)
                         if sum(pixel(terminal_wider, wider_w, x, y)) > 180),
                        default=wider_run[0] + 8)
            wider_cols = (reach - wider_run[0] - 8) // 8 + 1
            wider_note = "window %d-%d, was %d-%d" % (wider_run[0], wider_run[1],
                                                     b_left, b_right)
            moveto(wider_run[1] - 1, edge_y)
            send([{"type": "btn", "data": {"down": True, "button": "left"}}])
            time.sleep(0.08)
            moveto(again_run[1], edge_y)
            time.sleep(0.3)
            send([{"type": "btn", "data": {"down": False, "button": "left"}}])
            time.sleep(0.5)

    shot("shell-before-monitor")
    before_w, before_h, before_monitor = load("shell-before-monitor")
    type_text("/mointor.sh 0.5 16\n")

    time.sleep(2.5)
    shot("monitor-first")
    first_w, first_h, first_monitor = load("monitor-first")
    time.sleep(2.0)
    shot("monitor-second")
    second_w, second_h, second_monitor = load("monitor-second")

    def changed(a, b):
        different = 0
        top = min(b_top + 20, second_h)
        bottom = min(b_bottom, second_h - 1)
        for y in range(top, bottom + 1):
            for x in range(b_left, min(b_right + 1, second_w)):
                offset = (y * second_w + x) * 3
                if a[offset:offset + 3] != b[offset:offset + 3]:
                    different += 1
        return different

    appeared = changed(before_monitor, first_monitor)
    redrawn = changed(first_monitor, second_monitor)
    out.append(("monitor reached screen", "yes" if appeared > 200 else
                "%d pixels" % appeared, "yes"))
    out.append(("monitor redraws", "yes" if redrawn > 32 else
                "%d pixels" % redrawn, "yes"))

    # Let all sixteen updates complete before looking for the fault report.
    time.sleep(5)

    #       The same tool with no frame count, which runs until something
    #       stops it, and then control-C to stop it. A full-screen tool that
    #       keeps redrawing is the one shape that can leave a terminal with
    #       no reader and no way back, and the terminal is then frozen for
    #       good: the shell is alive but nothing it prints arrives. Both
    #       halves are asserted here -- that the tool is still redrawing
    #       while it runs, and that the shell answers afterwards.
    type_text("monitor 0.3\n")
    time.sleep(3)
    shot("unbounded-first")
    u1_w, u1_h, unbounded_first = load("unbounded-first")
    time.sleep(2)
    shot("unbounded-second")
    u2_w, u2_h, unbounded_second = load("unbounded-second")
    out.append(("unbounded monitor redraws",
                "yes" if changed(unbounded_first, unbounded_second) > 32
                else "%d pixels" % changed(unbounded_first, unbounded_second),
                "yes"))

    chord("ctrl", "c")
    time.sleep(1.5)
    shot("after-interrupt")
    ai_w, ai_h, after_interrupt = load("after-interrupt")
    type_text("echo backagain\n")
    time.sleep(2)
    shot("after-interrupt-command")
    ac_w, ac_h, after_command = load("after-interrupt-command")
    out.append(("shell answers after the tool",
                "yes" if changed(after_interrupt, after_command) > 32
                else "%d pixels" % changed(after_interrupt, after_command),
                "yes"))

    #       Control-C at a shell the terminal's shell is running. The line
    #       discipline sends the interrupt to the whole foreground group, a
    #       non-interactive shell among it, and that shell used to ignore it
    #       as if it were the one being typed at: the sleep died, the rest of
    #       the string ran and the terminal's shell was told 0. The answers
    #       go to the serial line, which the typed line never reaches.
    def type_shell(line):
        shifted = {'"': "apostrophe", "$": "4", ">": "dot", "?": "slash"}
        plain = {" ": "spc", ".": "dot", "/": "slash", "-": "minus", ";": "semicolon",
                 "\n": "ret"}
        for character in line:
            if character in shifted:
                chord("shift", shifted[character])
            elif character.isupper():
                chord("shift", character.lower())
            else:
                key(plain.get(character, character))

    type_shell('sh -c "sleep 20; echo stringran-on > /dev/ttyS0"\n')
    time.sleep(2)
    chord("ctrl", "c")
    time.sleep(1)
    type_shell("echo interrupted-$? > /dev/ttyS0\n")
    serial_text = b""
    for _ in range(40):
        serial_text = open(work + "/serial", "rb").read()
        if re.search(rb"interrupted-\d+", serial_text):
            break
        time.sleep(0.5)
    stopped = re.findall(rb"interrupted-(\d+)", serial_text)
    out.append(("Control-C stops a shell run from the terminal",
                stopped[-1].decode() if stopped else "no answer", "130"))
    out.append(("and the rest of its string never runs",
                str(serial_text.count(b"stringran-on")), "0"))

    # A framed pixel window cannot grow beyond the mapping its client owns.
    # This used to maximize to desktop dimensions anyway, then compose read
    # those invented pixels past the end of the mapping. The window demo's
    # blue pane is exactly 200x120; double-click its titlebar and prove those
    # are still the only blue pixels.
    type_text("/window\n")
    time.sleep(0.5)
    shot("pixel-window", 0.3)
    pixel_w, pixel_h, pixel_before = load("pixel-window")

    def colour_bounds(data, width, height, colour):
        xs, ys = [], []
        for y in range(height):
            row = data[y * width * 3:(y + 1) * width * 3]
            for x in range(width):
                if row[x * 3:x * 3 + 3] == colour:
                    xs.append(x)
                    ys.append(y)
        if not xs:
            return None
        return min(xs), min(ys), max(xs), max(ys)

    blue = colour_bounds(pixel_before, pixel_w, pixel_h, b"\x00\x66\xcc")
    if blue:
        blue_left, blue_top, blue_right, blue_bottom = blue
        moveto((blue_left + blue_right) // 2, max(blue_top - 10, 0))
        for _ in range(2):
            send([{"type": "btn", "data": {"down": True, "button": "left"}}])
            time.sleep(0.08)
            send([{"type": "btn", "data": {"down": False, "button": "left"}}])
            time.sleep(0.12)

        shot("pixel-maximized", 0.3)
        max_w, max_h, pixel_after = load("pixel-maximized")
        blue_after = colour_bounds(pixel_after, max_w, max_h,
                                   b"\x00\x66\xcc")
    else:
        blue_after = None

    if blue_after:
        blue_width = blue_after[2] - blue_after[0] + 1
        blue_height = blue_after[3] - blue_after[1] + 1
        pixel_extent = "%dx%d" % (blue_width, blue_height)
    else:
        pixel_extent = "absent"
    out.append(("pixel maximize is bounded", pixel_extent, "200x120"))

    if blue_after:
        max_left, max_top, max_right, max_bottom = blue_after
        title_x = (max_left + max_right) // 2
        title_y = max(max_top - 10, 0)
        moveto(title_x, title_y)
        send([{"type": "btn", "data": {"down": True, "button": "left"}}])
        time.sleep(0.08)
        moveto(min(title_x + 120, W - 1), min(title_y + 80, H - 1))
        send([{"type": "btn", "data": {"down": False, "button": "left"}}])
        shot("pixel-restored", 0.3)
        drag_w, drag_h, pixel_dragged = load("pixel-restored")
        blue_dragged = colour_bounds(pixel_dragged, drag_w, drag_h,
                                     b"\x00\x66\xcc")
    else:
        blue_dragged = None

    restored = (blue_dragged is not None and
                blue_dragged[0] != blue_after[0] and
                blue_dragged[2] - blue_dragged[0] + 1 == 200 and
                blue_dragged[3] - blue_dragged[1] + 1 == 120)
    out.append(("maximized drag restores", "yes" if restored else "no", "yes"))

    # One held Alt with two Tab presses must walk past the next window to the
    # third, rather than bouncing between the top two. The orange 400x260
    # window is third in this demo; raising it changes the pixel where its
    # titlebar was previously obscured.
    orange = (colour_bounds(pixel_dragged, drag_w, drag_h, b"\xff\x99\x00")
              if blue_after else None)
    if orange:
        orange_x = (orange[0] + orange[2]) // 2
        orange_y = max(orange[1] - 10, 0)
        orange_before = pixel(pixel_dragged, drag_w, orange_x, orange_y)
    else:
        orange_before = None

    send([{"type": "key", "data": {"down": True,
                                     "key": {"type": "qcode", "data": "alt"}}},
          {"type": "key", "data": {"down": True,
                                     "key": {"type": "qcode", "data": "tab"}}},
          {"type": "key", "data": {"down": False,
                                     "key": {"type": "qcode", "data": "tab"}}},
          {"type": "key", "data": {"down": True,
                                     "key": {"type": "qcode", "data": "tab"}}},
          {"type": "key", "data": {"down": False,
                                     "key": {"type": "qcode", "data": "tab"}}},
          {"type": "key", "data": {"down": False,
                                     "key": {"type": "qcode", "data": "alt"}}}])
    time.sleep(0.2)
    shot("third-focused", 0.3)
    third_w, third_h, third_px = load("third-focused")
    third_changed = (orange_before is not None and
                     pixel(third_px, third_w, orange_x, orange_y) !=
                     orange_before)
    out.append(("Alt-Tab reaches third", "yes" if third_changed else "no",
                "yes"))

    # From the newly raised orange window, one step selects the blue window
    # again so the minimize/restore checks below have an unambiguous target.
    chord("alt", "tab")

    # Alt-F9 is a compositor shortcut, not a byte sent to the focused
    # program. Alt-Tab includes minimized clients and restores the selected
    # one when Alt is released.
    chord("alt", "f9")
    shot("pixel-minimized", 0.3)
    min_w, min_h, pixel_minimized = load("pixel-minimized")
    blue_minimized = colour_bounds(pixel_minimized, min_w, min_h,
                                   b"\x00\x66\xcc")
    out.append(("Alt-F9 minimizes", "yes" if blue_minimized is None else "no",
                "yes"))

    chord("alt", "tab")
    shot("pixel-restored-by-key", 0.3)
    key_w, key_h, pixel_key = load("pixel-restored-by-key")
    blue_key = colour_bounds(pixel_key, key_w, key_h, b"\x00\x66\xcc")
    key_extent = ("absent" if blue_key is None else
                  "%dx%d" % (blue_key[2] - blue_key[0] + 1,
                             blue_key[3] - blue_key[1] + 1))
    out.append(("Alt-Tab restores", key_extent, "200x120"))

#       Snapping, at the end because it leaves a window somewhere new.
#
#       A drag that ends against an edge of the screen is the window asking
#       for that half of it, which is what throwing a window at the side has
#       meant since the idea existed. Top is the whole screen, and taking the
#       window off again puts back the rectangle its program had -- saved once
#       on the way out of floating, so left, then right, then off lands where
#       it started rather than on the left half.
#
#       Read as how much of one column of the screen a window covers, and not
#       as where the edges of a run are: by this point the desktop has the
#       demo windows on it, runs of non-background merge every window they
#       touch, and the answer stops meaning anything. A snapped window is the
#       full height of the screen and nothing else here is -- the largest of
#       the demos covers an eighth of a column -- so a column that is nearly
#       all window is a snapped window, wherever the others happen to be.
if runs:
    def covered(name, x):
        """How much of one column of the screen is not desktop."""
        rw, rh, rpx = load(name)
        rows = range(0, rh, 4)
        lit = 0
        for y in rows:
            o = (y * rw + x) * 3
            if (rpx[o], rpx[o + 1], rpx[o + 2]) != bg:
                lit += 1
        return lit * 100 // len(list(rows))

    def throw(name, to_x, to_y, grab):
        gx, gy = grab
        moveto(gx, gy)
        send([{"type": "btn", "data": {"down": True, "button": "left"}}])
        time.sleep(0.1)
        for stepped in range(1, 9):
            moveto(gx + (to_x - gx) * stepped // 8,
                   gy + (to_y - gy) * stepped // 8)
        send([{"type": "btn", "data": {"down": False, "button": "left"}}])
        time.sleep(1.6)
        shot(name, 0.5)

    chord("ctrl", "shift", "t")
    time.sleep(3.0)
    shot("snap-start", 0.5)
    snap_w, snap_h, snap_px = load("snap-start")

    def snap_at(x, y):
        o = (y * snap_w + x) * 3
        return snap_px[o], snap_px[o + 1], snap_px[o + 2]

    #   The new terminal is the frontmost window, and the rightmost run at the
    #   middle of the screen reaches its right edge.
    start_runs, first_x = [], None
    for x in range(snap_w):
        on = snap_at(x, snap_h // 2) != bg
        if on and first_x is None:
            first_x = x
        elif not on and first_x is not None:
            if x - first_x > 40:
                start_runs.append((first_x, x - 1))
            first_x = None
    if first_x is not None and snap_w - first_x > 40:
        start_runs.append((first_x, snap_w - 1))

    hold_left, hold_right = start_runs[-1]
    hold_top = next(y for y in range(snap_h)
                    if snap_at(hold_right - 4, y) != bg)
    hold = (hold_right - 40, hold_top + 9)
    edge = snap_w - 1
    FULL = 90

    throw("snap-left", 3, snap_h // 2, hold)
    at_left, at_right = covered("snap-left", 0), covered("snap-left", edge)
    left_ok = at_left >= FULL and at_right < FULL
    out.append(("a drag to the left edge takes the left half",
                "yes" if left_ok else "%d%% of the left column, %d%% of the right"
                % (at_left, at_right), "yes"))

    inside = covered("snap-left", snap_w // 2 - 30)
    past = covered("snap-left", snap_w // 2 + 30)
    out.append(("and stops at the middle",
                "yes" if inside >= FULL and past < FULL else
                "%d%% just inside, %d%% just past" % (inside, past), "yes"))

    if left_ok:
        hold = (snap_w // 4, 11)

    throw("snap-right", edge - 2, snap_h // 2, hold)
    at_left, at_right = covered("snap-right", 0), covered("snap-right", edge)
    right_ok = at_right >= FULL and at_left < FULL
    out.append(("a drag to the right edge takes the right half",
                "yes" if right_ok else "%d%% of the left column, %d%% of the right"
                % (at_left, at_right), "yes"))

    if right_ok:
        hold = (snap_w - snap_w // 4, 11)

    #   A cell short of the far edge, because a window of text is a whole
    #   number of cells: half a screen rarely divides by eight, and what is
    #   left over sits at the edge the window was not thrown at. Snapped
    #   right that is the left, so the check above can ask for the last
    #   column; filling the screen has no such edge and keeps the remainder
    #   on the right.
    throw("snap-top", snap_w // 2, 2, hold)
    at_left, at_right = covered("snap-top", 0), covered("snap-top", edge - 8)
    top_ok = at_left >= FULL and at_right >= FULL
    out.append(("a drag to the top fills the screen",
                "yes" if top_ok else "%d%% of the left column, %d%% of the right"
                % (at_left, at_right), "yes"))

    if top_ok:
        hold = (snap_w // 2, 11)

    #   And off again: a window that is not against any edge and is no longer
    #   the height of the screen is one that got its own rectangle back.
    throw("snap-off", snap_w // 3, snap_h // 2, hold)
    at_left, at_right = covered("snap-off", 0), covered("snap-off", edge)
    out.append(("dragging off puts the window back",
                "yes" if at_left < FULL and at_right < FULL else
                "%d%% of the left column, %d%% of the right" % (at_left, at_right),
                "yes"))

#       The kernel log's ring is cut for the window it opens as and cut again
#       when the window grows past it, since nothing maps it. Last, because a
#       click on its titlebar takes the focus. Filled to the screen, the log
#       is recut about three times as wide and still starts every row at the
#       margin: the lines moved over whole and the emulator wraps at the new
#       width. The serial side is read with the rest below.
if runs:
    left, right = runs[0]
    moveto(left + 30, log_top + 9)
    for _ in range(2):
        send([{"type": "btn", "data": {"down": True, "button": "left"}}])
        time.sleep(0.08)
        send([{"type": "btn", "data": {"down": False, "button": "left"}}])
        time.sleep(0.12)
    time.sleep(1.0)
    shot("log-filled", 0.5)
    fw, fh, fpx = load("log-filled")

    def filled_lit(x, y):
        o = (y * fw + x) * 3
        return fpx[o] + fpx[o + 1] + fpx[o + 2] > 180

    starts = []
    for row in range(3, 26):
        band = range(24 + row * 16, min(24 + row * 16 + 16, fh))
        first = next((x for x in range(2, fw // 2)
                      if any(filled_lit(x, y) for y in band)), None)
        if first is not None:
            starts.append(first)
    #   Filled, the window is what covers the right half of the screen: a
    #   log line is rarely half a screen long, so this asks the window, not
    #   the text in it.
    row_y = fh // 2
    covering = sum(1 for x in range(fw // 2, fw - 8)
                   if tuple(fpx[(row_y * fw + x) * 3:(row_y * fw + x) * 3 + 3]) != bg)
    out.append(("the log filled to the screen starts at the margin",
                "yes" if starts and sum(x < 28 for x in starts) >= len(starts) - 4
                else str(starts), "yes"))
    out.append(("and covers the screen",
                "yes" if covering * 10 >= (fw // 2 - 8) * 9 else
                "%d of %d columns" % (covering, fw // 2 - 8), "yes"))

try:
    serial = open(work + "/serial", "rb").read().lower()
except OSError:
    serial = b""

if not runs:
    out.append(("the USB mouse checks", "not run: no window found", "run"))

#       A USB mouse moves the cursor. The arrow's fill is 55 pixels of pure
#       white, which nothing else on the desktop uses, so counting them at the
#       expected place is the cursor being there. The tablet parks the cursor
#       first so the count is taken from a known spot on bare desktop, and
#       the movement goes in small reports a few milliseconds apart, the way
#       a hand moves, so the compositor's acceleration leaves the distance
#       alone. Each mouse is selected through the monitor: naming the device
#       in input-send-event is not an option, QEMU 11 aborts on it.
if len(runs) >= 1:
    def arrow_pixels(data, width, height, x, y):
        return sum(1 for py in range(max(y, 0), min(y + 20, height))
                   for px in range(max(x, 0), min(x + 16, width))
                   if pixel(data, width, px, py) == b"\xff\xff\xff")

    def mouse_rel(dx, dy, steps):
        for step in range(steps):
            send([{"type": "rel", "data": {"axis": "x", "value": dx}},
                  {"type": "rel", "data": {"axis": "y", "value": dy}}])
            time.sleep(0.01)
        time.sleep(0.2)

    mice = [line.split("#")[1].split(":")[0]
            for line in monitor("info mice").splitlines()
            if "HID Mouse" in line]
    out.append(("usb mice attached", str(len(mice)), "2"))

    # A different parking spot for each mouse: the tablet reports nothing for
    # a position equal to its last, so parking twice at one spot would leave
    # the cursor where the previous mouse put it.
    for turn, index in enumerate(mice):
        park_x, park_y = w - 200 - 60 * turn, h - 200 - 40 * turn
        moveto(park_x, park_y)
        shot("mouse-parked-" + index, 0.3)
        parked_w, parked_h, parked = load("mouse-parked-" + index)
        before = arrow_pixels(parked, parked_w, parked_h, park_x, park_y)
        monitor("mouse_set " + index)
        mouse_rel(-3, -2, 40)
        shot("mouse-moved-" + index, 0.3)
        moved_w, moved_h, moved = load("mouse-moved-" + index)
        after = arrow_pixels(moved, moved_w, moved_h, park_x - 120, park_y - 80)
        still = arrow_pixels(moved, moved_w, moved_h, park_x, park_y)
        out.append(("usb mouse " + index + " moves the cursor",
                    "yes" if before == 55 and after == 55 and still == 0
                    else "%d %d %d" % (before, after, still), "yes"))

# The kernel names them "QEMU QEMU USB Mouse"; the serial log is lower case.
out.append(("pointer lists the mice", str(serial.count(b"usb mouse: ")), "2"))

#       The policy cat read for itself in the Control-Shift-T terminal: the
#       41st field of /proc/self/stat, 0 for SCHED_OTHER and 1 for FIFO. Found
#       by its shape and not its name, because cat is resident in the shell
#       and runs in a forked child that is still called shell. A comm has no
#       spaces here, so the state and the fields after it split on whitespace.
stat = re.search(rb"\d+ \([a-z0-9_./-]+\) ([a-z] (?:-?\d+ ){40,}-?\d+)", serial)
fields = stat.group(1).split() if stat else []
out.append(("a terminal from the keyboard is not real time",
            fields[38].decode() if len(fields) > 38 else "no stat line", "0"))

#       A terminal's line ring is cut once and never grows, so the size it is
#       cut for decides the largest that window can ever become. Cutting it
#       for the desktop of the moment froze that at whatever the screen was
#       when the terminal opened, and the screen is not a constant: it is the
#       sum of the outputs, recomputed whenever a connector is probed or a
#       monitor arrives, which on real hardware happens after the first
#       terminal exists. This display is 2560 wide, so a ring cut for it holds
#       about 319 columns; one cut for the ceiling holds far more. Anything in
#       between means the ring followed the mode again.
ring = re.findall(rb"ring holds (\d+)x(\d+)", serial)
out.append(("terminal ring is cut for the ceiling",
            "yes" if ring and min(int(w) for w, _ in ring) >= 400
            else str([(int(w), int(h)) for w, h in ring]), "yes"))

#       And paid for only as it is written. The ring above is about two
#       megabytes, of which a terminal that ran a command or two has written a
#       few lines, so the terminal the X closes reports holding a small part
#       of it. A ring allocated whole, as every one was before, holds all of
#       it; this is the idle-memory ratchet for the lazily held ring.
held = [(int(a), int(b)) for a, b in re.findall(rb"ring held (\d+) of (\d+) kib", serial)]
out.append(("a closed terminal held a small part of its ring",
            "yes" if held and all(a * 4 <= b for a, b in held) else str(held), "yes"))

#       Scrolled through all of it, too: the terminal the X closes ran seq 700
#       first, and its lines are as far apart as it is wide rather than as
#       the ceiling, so a full ring is still a small part of the reservation.
#       With lines a page apart it held all of it again.
apart = [int(a) for a in re.findall(rb"ring holds \d+x\d+ \(\d+ kib\), lines (\d+) apart", serial)]
out.append(("a terminal's lines start as far apart as it opens",
            "yes" if apart and max(apart) <= 160 else str(apart), "yes"))

#       And spread when it is widened past that: the line typed into the
#       widened terminal reached past the widest stride any window opened at,
#       and the compositor said it recut that ring at least that wide.
widened = [int(w) for w in re.findall(rb"window ring recut to (\d+)x", serial)]
out.append(("a widened terminal draws lines wider than it opened",
            "yes" if runs and apart and widened and
            wider_cols > max(apart) and max(widened) >= wider_cols
            else "%s cols drawn (%s), apart %s, recut %s" %
                 (wider_cols, wider_note, apart, widened), "yes"))

#       The kernel log's ring is cut for its own window, and the fill above
#       recut it. Cut for the ceiling it held about 2 MiB from boot on.
cut = re.findall(rb"kernel log grid \d+x\d+, ring cut to (\d+)x\d+ \((\d+) kib\)", serial)
recut = [int(w) for w in re.findall(rb"kernel log ring recut to (\d+)x", serial)]
out.append(("the kernel log's ring is cut for its window",
            "yes" if cut and all(int(k) <= 640 for _, k in cut) else str(cut), "yes"))
out.append(("and recut for the screen it was filled to",
            "yes" if runs and recut and max(recut) >= 300 else str(recut), "yes"))

for name, marker in (("no protection fault", b"general protection fault"),
                     ("no oops", b"oops:"),
                     ("no kernel panic", b"kernel panic")):
    out.append((name, "present" if marker in serial else "absent", "absent"))

#       A coverage image writes what it reached, typed into whichever
#       terminal has the keyboard; see coverage_guest in test/run. Run, not
#       sourced: a sourced file is a parser source, and the applets in it
#       refuse to start under one.
if os.environ.get("MOONWATER_CANVAS_COVERAGE"):
    type_text("/coverage-dump\n")
    for _ in range(120):
        try:
            if open(os.environ["MOONWATER_CANVAS_COVERAGE"], "rb").read().rstrip().endswith(b"b2sK"):
                break
        except OSError:
            pass
        time.sleep(0.5)

guest.quit()
time.sleep(1)
guest.terminate()
try:
    guest.wait(10)
except Exception:
    guest.kill()

#       The machine as it boots off a stick: no console= at all, so
#       /dev/console is tty1 and init's shell reads it. Every other lane names
#       ttyS0 and moves that shell off the VT, which is exactly why none of
#       them could see keys typed into a window reach it as well -- every line
#       ran twice, once as root where nobody could see. A line typed into the
#       boot terminal must reach one shell, so it arrives on the serial port
#       once; the port is still there with no console on it.
#
#       And a console switch is not a way round it. A program calling
#       VT_ACTIVATE -- chvt, from any distribution in a bowl -- puts another
#       console in front, and a console muted only while it was in front let
#       every key through to whatever read the one that replaced it. The
#       image has no such program, so a tiny one rides in on a stick.
stick = work + "/stick"
os.makedirs(stick, exist_ok=True)
open(work + "/vtswitch.c", "w").write(r'''
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/ioctl.h>
#include <linux/vt.h>
int main(int argc, char **argv)
{
        int n = argc > 1 ? atoi(argv[1]) : 2;
        int fd = open("/dev/tty0", O_RDWR | O_NOCTTY);
        struct vt_stat st;
        if (fd < 0 || ioctl(fd, VT_ACTIVATE, n) || ioctl(fd, VT_WAITACTIVE, n) ||
            ioctl(fd, VT_GETSTATE, &st))
                return 1;
        printf("VTSWITCH active %u\n", st.v_active);
        return 0;
}
''')
switcher = subprocess.run(["cc", "-O2", "-static", "-o", stick + "/vtswitch",
                           work + "/vtswitch.c"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

#       And a program that takes the display for itself, the way Weston does:
#       master of the card, a mode of its own, held, and optionally master
#       given back while it keeps running. It says when it holds the card,
#       and nothing is typed before it does.
open(work + "/drmhold.c", "w").write(r'''
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <sys/mman.h>
#include <unistd.h>
#include <drm/drm.h>
#include <drm/drm_mode.h>
int main(int argc, char **argv)
{
        int hold = argc > 1 ? atoi(argv[1]) : 5, drop = argc > 2 ? atoi(argv[2]) : 0;
        int after = argc > 3 ? atoi(argv[3]) : 0;
        int fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
        struct drm_mode_card_res res = {0};
        uint32_t connectors[16], crtcs[16], encoders[16];
        if (fd < 0 || ioctl(fd, DRM_IOCTL_SET_MASTER, 0) ||
            ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res) ||
            res.count_connectors > 16 || res.count_crtcs > 16 || res.count_encoders > 16)
                return printf("DRMHOLD failed\n"), 1;
        res.connector_id_ptr = (uintptr_t)connectors;
        res.crtc_id_ptr = (uintptr_t)crtcs;
        res.encoder_id_ptr = (uintptr_t)encoders;
        res.count_fbs = 0;
        if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res))
                return printf("DRMHOLD failed\n"), 1;
        for (uint32_t i = 0; i < res.count_connectors; i++)
        {
                struct drm_mode_get_connector conn = {.connector_id = connectors[i]};
                struct drm_mode_modeinfo modes[64];
                struct drm_mode_create_dumb dumb = {0};
                struct drm_mode_map_dumb map = {0};
                struct drm_mode_fb_cmd fb = {0};
                struct drm_mode_crtc crtc = {0};
                uint32_t id = connectors[i];
                uint8_t *pixels;
                if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn) || conn.connection != 1 ||
                    !conn.count_modes || conn.count_modes > 64)
                        continue;
                conn.modes_ptr = (uintptr_t)modes;
                conn.count_props = conn.count_encoders = 0;
                if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn))
                        continue;
                dumb.width = modes[0].hdisplay;
                dumb.height = modes[0].vdisplay;
                dumb.bpp = 32;
                if (ioctl(fd, DRM_IOCTL_MODE_CREATE_DUMB, &dumb))
                        break;
                fb.width = dumb.width; fb.height = dumb.height; fb.bpp = 32; fb.depth = 24;
                fb.pitch = dumb.pitch; fb.handle = dumb.handle;
                map.handle = dumb.handle;
                if (ioctl(fd, DRM_IOCTL_MODE_ADDFB, &fb) || ioctl(fd, DRM_IOCTL_MODE_MAP_DUMB, &map))
                        break;
                pixels = mmap(0, dumb.size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, map.offset);
                if (pixels == MAP_FAILED)
                        break;
                memset(pixels, 0xff, dumb.size);
                crtc.crtc_id = crtcs[0]; crtc.fb_id = fb.fb_id;
                crtc.set_connectors_ptr = (uintptr_t)&id; crtc.count_connectors = 1;
                crtc.mode = modes[0]; crtc.mode_valid = 1;
                if (ioctl(fd, DRM_IOCTL_MODE_SETCRTC, &crtc))
                        break;
                printf("DRMHOLD master\n");
                fflush(stdout);
                sleep(hold);
                if (drop)
                {
                        ioctl(fd, DRM_IOCTL_DROP_MASTER, 0);
                        printf("DRMHOLD dropped\n");
                        fflush(stdout);
                        sleep(after);
                }
                printf("DRMHOLD done\n");
                return 0;
        }
        return printf("DRMHOLD failed\n"), 1;
}
''')
holder = subprocess.run(["cc", "-O2", "-static", "-o", stick + "/drmhold",
                         work + "/drmhold.c"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

#       A program that reads the tablet the way a compositor does, and says how
#       long each report waited between the kernel stamping it and this read
#       having it: the delivery of a report to whoever reads it, in
#       microseconds. The stamp is the monotonic clock the evdev handler took
#       as the report left the device's driver, so the figure is the handlers
#       and the wakeup, not the device.
open(work + "/evlat.c", "w").write(r'''
#include <dirent.h>
#include <fcntl.h>
#include <linux/input.h>
#include <poll.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <time.h>
#include <unistd.h>
static int order(const void *a, const void *b)
{
        long x = *(const long *)a, y = *(const long *)b;
        return x < y ? -1 : x > y;
}
int main(int argc, char **argv)
{
        int seconds = argc > 1 ? atoi(argv[1]) : 4, fd = -1, clock = CLOCK_MONOTONIC;
        long *waited = malloc(sizeof(long) * 200000);
        unsigned count = 0;
        struct timespec now, end;
        for (int number = 0; number < 32 && fd < 0; number++)
        {
                char path[96], name[96] = "";
                FILE *file;
                snprintf(path, sizeof(path), "/sys/class/input/event%d/device/name", number);
                if (!(file = fopen(path, "r")))
                        continue;
                if (!fgets(name, sizeof(name), file))
                        name[0] = 0;
                fclose(file);
                if (strstr(name, "Tablet"))
                {
                        snprintf(path, sizeof(path), "/dev/input/event%d", number);
                        fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
                }
        }
        if (fd < 0 || !waited || ioctl(fd, EVIOCSCLOCKID, &clock))
                return printf("evlat-none\n"), 1;
        clock_gettime(CLOCK_MONOTONIC, &end);
        end.tv_sec += seconds;
        for (;;)
        {
                struct pollfd wait = {.fd = fd, .events = POLLIN};
                struct input_event events[64];
                ssize_t got;
                clock_gettime(CLOCK_MONOTONIC, &now);
                if (now.tv_sec > end.tv_sec || (now.tv_sec == end.tv_sec && now.tv_nsec >= end.tv_nsec))
                        break;
                if (poll(&wait, 1, 100) <= 0)
                        continue;
                clock_gettime(CLOCK_MONOTONIC, &now);
                got = read(fd, events, sizeof(events));
                for (ssize_t at = 0; at < got / (ssize_t)sizeof(events[0]); at++)
                        if (events[at].type == EV_SYN && events[at].code == SYN_REPORT && count < 200000)
                                waited[count++] = (now.tv_sec - events[at].time.tv_sec) * 1000000L +
                                                  (now.tv_nsec / 1000 - events[at].time.tv_usec);
        }
        if (!count)
                return printf("evlat-none\n"), 1;
        qsort(waited, count, sizeof(long), order);
        printf("evlat-%u-%ld-%ld-%ld\n", count, waited[count / 2], waited[count * 99 / 100],
               waited[count - 1]);
        return 0;
}
''')
reader = subprocess.run(["cc", "-O2", "-static", "-o", stick + "/evlat",
                         work + "/evlat.c"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

#       The same holder, with a count of how often the canvas thread wakes
#       while it keeps the card: its voluntary switches from 2 s after the
#       start to 6 s, a second at a time.
open(stick + "/holdwake", "w").write(r'''p=$(grep -l '^moonwater/canva' /proc/[0-9]*/comm | head -n 1 | cut -d/ -f3)
count() { sed -n 's/^voluntary_ctxt_switches:[^0-9]*//p' /proc/$p/status; }
( sleep 2; a=$(count); sleep 4; b=$(count); echo "wakes-$(( (b - a) / 4 ))-per-second" ) &
( sleep 2; /mnt/evlat 3 ) &
exec /mnt/drmhold "$@"
''')

#       Two more a shell runs from the stick: what `moonwater canvas` says,
#       and whether the kernel has warned about anything since it booted.
open(stick + "/state", "w").write('''moonwater canvas > /tmp/canvas-state 2>&1
echo "canvas-on-$(grep -c 'Canvas is on' /tmp/canvas-state)-off-$(grep -c 'Canvas is off' /tmp/canvas-state)" > /dev/ttyS0
''')
#       An idle desktop: two readings of `moonwater canvas` eight seconds apart
#       with nobody touching anything (the three seconds first let the frame
#       timer's two-second idle tail run out). The hold on the processor's
#       idle states must be let go of, and neither the canvas thread nor the
#       frame timer may be waking: a desktop that wakes or holds while nobody
#       is at it keeps the clock up and the battery going.
open(stick + "/idlecheck", "w").write(r'''sleep 3
moonwater canvas > /tmp/idle1 2>&1
sleep 8
moonwater canvas > /tmp/idle2 2>&1
n() { sed -n "s/.*$2 \\([0-9][0-9]*\\).*/\\1/p" "$1" | head -n 1; }
w=$(( $(n /tmp/idle2 woke) - $(n /tmp/idle1 woke) ))
t=$(( $(n /tmp/idle2 fired) - $(n /tmp/idle1 fired) ))
h=$(sed -n 's/.*hold: \([a-z]*\),.*/\1/p' /tmp/idle2)
echo "idlecheck-$h-$w-$t" > /dev/ttyS0
''')
#       A holder that comes back, as KDE's wrapper brings KWin back when KWin
#       is killed: three runs of the holder in a loop of one shell, which a
#       key that ends only the holder would leave holding the card again.
open(stick + "/respawn", "w").write(r'''n=0
while [ $n -lt 3 ]; do /mnt/drmhold 6 0 0; n=$((n+1)); done
''')
#       How many windows Canvas has, said on the serial port.
open(stick + "/windows", "w").write(r'''moonwater canvas > /tmp/windows 2>&1
echo "windows-$(sed -n 's/.*Canvas is on: [^,]*, \([0-9]*\) window.*/\1/p' /tmp/windows)" > /dev/ttyS0
''')
#       A bowl profile that is only a program holding the display, installed
#       where bowl profile puts one, chosen as the desktop, started, looked at,
#       and ended from the same shell that started it. Run in one script
#       because Canvas drops every key while the session holds the card. Its
#       output is the serial port's, since a session's own goes to its log.
open(stick + "/profile", "w").write("#!/bin/sh\n# bowl profile desktop\nexec /mnt/drmhold 120 0 0 > /dev/ttyS0 2>&1\n")
open(stick + "/desk", "w").write(r'''moonwater desktop > /dev/ttyS0 2>&1
moonwater desktop desktop > /dev/ttyS0 2>&1
mkdir -p /bowls/bin
cp /mnt/profile /bowls/bin/desktop
chmod 755 /bowls/bin/desktop
moonwater desktop desktop > /dev/ttyS0 2>&1
moonwater desktop > /dev/ttyS0 2>&1
rm -f /run/moonwater/desktop.booted
moonwater desktop boot
sleep 6
moonwater desktop > /dev/ttyS0 2>&1
moonwater desktop stop > /dev/ttyS0 2>&1
sleep 3
moonwater desktop > /dev/ttyS0 2>&1
moonwater desktop canvas > /dev/ttyS0 2>&1
moonwater desktop > /dev/ttyS0 2>&1
echo desk-done > /dev/ttyS0
''')
open(stick + "/kcheck", "w").write('''echo "kernel-warnings-$(dmesg | grep -c -E 'WARNING|BUG:|Oops|circular locking|possible recursive')" > /dev/ttyS0
''')

leak_guest = Guest(desktop(image) + [
    "-drive", "if=none,id=stick,format=raw,file=fat:ro:" + stick + ",readonly=on",
    "-device", "usb-storage,drive=stick,removable=on",
    "-no-reboot", "-display", "none", "-serial", "file:" + work + "/leak-serial",
    # The cursor plane is off here too: this guest counts the cursor's pixels in
    # a screendump, and QEMU's screendump has no cursor plane in it.
    "-append", "drm_client_lib.active= moonwater.cursor_plane=0 " + os.environ.get("CANVAS_APPEND", "")],
    work + "/leak-qmp", work + "/leak-mon", work)

