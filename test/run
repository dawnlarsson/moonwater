disk_checks use

#
#       Two disks, both carrying this very build: a copy of the one under new
#       GPT identifiers. Nothing says which the session started from, so
#       neither is taken because the kernel listed it first.
#
if command -v sfdisk > /dev/null 2>&1; then
        cp "$work/disk.img" "$work/disk2.img"
        sfdisk --disk-id "$work/disk2.img" "$(cat /proc/sys/kernel/random/uuid)" > /dev/null 2>&1
        sfdisk --part-uuid "$work/disk2.img" 1 "$(cat /proc/sys/kernel/random/uuid)" > /dev/null 2>&1
